{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "NODE_ENV",
        "CI",
        "HOSPEDA_GIT_SHA",
        "HOSPEDA_API_URL",
        "HOSPEDA_SITE_URL",
        "HOSPEDA_ADMIN_URL",
        "HOSPEDA_REVALIDATION_SECRET",
        "VITE_*",
        "PUBLIC_*",
        "POSTHOG_HOST",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_PERSONAL_API_KEY",
        "POSTHOG_RELEASE",
        "POSTHOG_DEPLOY_SHA",
        "POSTHOG_ANNOTATION_CONTENT",
        "POSTHOG_ANNOTATION_DATE",
        "POSTHOG_DRY_RUN",
        "HOSPEDA_REDIS_URL",
        "HOSPEDA_CRON_SECRET",
        "HOSPEDA_CLOUDINARY_CLOUD_NAME",
        "HOSPEDA_CLOUDINARY_API_KEY",
        "HOSPEDA_CLOUDINARY_API_SECRET",
        "HOSPEDA_MEDIA_MAX_FILE_SIZE_MB",
        "ALLOW_PLACEHOLDER_ENV_URLS"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".astro/**"],
            "env": ["SKIP_PACKAGE_DTS"]
        },
        "admin#build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".output/**", ".tanstack/**", "src/routeTree.gen.ts"]
        },
        "@repo/i18n#build": {
            "dependsOn": ["^build"],
            "inputs": ["src/locales/**/*.json", "scripts/generate-types.ts"],
            "outputs": ["src/types.ts"]
        },
        "@repo/i18n#typecheck": {
            "dependsOn": ["^build", "build"]
        },
        "lint": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "format": {
            "outputs": []
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": [],
            "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
            "env": ["VITEST_SHARD"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "test:coverage": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"],
            "env": ["VITEST_SHARD"]
        },
        "test:integration": {
            "dependsOn": ["^build"],
            "cache": false,
            "env": ["HOSPEDA_TEST_DATABASE_URL"]
        }
    },
    "concurrency": "10"
}
