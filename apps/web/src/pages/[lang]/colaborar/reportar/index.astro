---
/**
 * @file colaborar/reportar/index.astro
 * @description Destination-info report page (SPEC-191 FR-3, BETA-69): mounts
 * the contribution form locked to `report_destination_info`. The optional
 * `?destino=<slug>` context is read client-side by the ContributionForm
 * island; the island seeds the message with the destination and forwards the
 * slug to analytics.
 * @route /{lang}/colaborar/reportar/?destino=<slug>
 * @rendering SSR + Cloudflare cache (HOS-74 — see [lang]/index.astro)
 */

import ContributionBackLink from '@/components/contributions/ContributionBackLink.astro';
import { ContributionForm } from '@/components/contributions/ContributionForm.client';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import SectionHeader from '@/components/shared/layout/SectionHeader.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';

import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// --- Edge cacheability (HOS-369 W2-2) ---
// No session, no API call — the content is i18n + code, so it only changes on
// deploy. Tagged `site-config`: the only tag with a live purger. The TTL comes
// from the `static` cache class (see `lib/cache/cache-classes.ts`); what
// bounds the post-deploy staleness window is HOS-427's deploy purge, which
// evicts the environment catch-all tag this response carries. Note that purge
// fires 45s after the container serves its FIRST REQUEST, not after the deploy,
// and nothing bounds when that first request arrives — see HOS-428.
applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'static',
    tags: [CACHE_TAG_SITE_CONFIG]
});
---

<DefaultLayout
    locale={locale}
    title={t('contributions.report.title', 'Reportar información incorrecta')}
    description={t(
        'contributions.report.description',
        '¿Encontraste un dato incorrecto o desactualizado en un destino? Contanos y lo corregimos.'
    )}
>
    <section class="reportar section">
        <div class="reportar__container">
            <ContributionBackLink locale={locale} />

            <div data-reveal="up">
                <SectionHeader
                    tagline={t('contributions.report.tagline', 'Ayudanos a mejorar')}
                    title={t('contributions.report.heading', 'Reportá información incorrecta')}
                    subtitle={t(
                        'contributions.report.subtitle',
                        '¿Viste un dato que no cierra en un destino? Contanos qué encontraste y el equipo lo revisa. Si llegaste desde la página de un destino, ya lo dejamos indicado en el mensaje.'
                    )}
                />
            </div>

            <div
                class="reportar__form"
                data-reveal="up"
            >
                <ContributionForm
                    presetType="report_destination_info"
                    locale={locale}
                    client:visible
                />
            </div>
        </div>
    </section>
</DefaultLayout>

<style>
    .reportar__container {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 var(--space-container-x);
    }

    .reportar__form {
        margin-top: var(--space-6, 1.5rem);
    }
</style>
