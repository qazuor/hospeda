---
/**
 * @file publicar-experiencia/index.astro
 * @description Public experience vertical landing (HOS-690). Mirrors
 * `/publicar-restaurante`, parametrized by the `experience` vertical.
 *
 * Rebuilt from "hero + CommerceLead lead form" into a full marketing page:
 * hero, benefits, how-it-works, price, FAQ. §6.5/§6.12 of the HOS-589 spec
 * describe this shape; before HOS-690 the page was only a hero over the lead
 * form, so every section below the hero is new content, not a preserved
 * block.
 *
 * The lead form (`CommerceLead`) that used to live here is NOT deleted — it
 * still backs the commerce onboarding create-listing flow and
 * `CommerceCreateForm.client.tsx` still imports its `DestinationOption` type.
 * Retiring the component/route itself is HOS-693's job.
 *
 * @route     /[lang]/publicar-experiencia/
 * @rendering SSR (on-demand, no prerender); edge-cacheable via the `pricing`
 *   cache class, tagged `CACHE_TAG_PRICING` (HOS-690 AC-37) — see
 *   `apps/web/src/lib/cache/response-cache.ts`. Neither the price nor the
 *   copy on this page depends on the visitor, so it no longer parses the
 *   session (removed from `SESSION_OPTIONAL_SEGMENTS`, added to
 *   `CACHEABLE_ROUTE_FAMILIES`).
 */

import { CACHE_TAG_PRICING } from '@repo/cache-tags';
import { CheckIcon, MapIcon, SettingsIcon, ShieldIcon } from '@repo/icons';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import GradientButton from '@/components/shared/ui/GradientButton.astro';
import { resolveCommerceLandingOffer } from '@/lib/billing/commerce-landing-plan';
import { fetchPublicPlans } from '@/lib/billing/fetch-plans';
import { buildCommerceStartUrl } from '@/lib/commerce/start-url';
import {
    COMMERCE_ENTITLEMENT_FALLBACK_LABEL,
    COMMERCE_ENTITLEMENT_I18N_SUFFIX
} from '@/lib/commerce/entitlement-labels';
import { deriveCommercePlanTierDiffs, toCommercePlanOption } from '@/lib/commerce/plan-options';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { getIntlLocale } from '@/lib/pricing-plans';
import BaseLayout from '@/layouts/BaseLayout.astro';

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const title = t('commerce.lead.experience.title');
const subtitle = t('commerce.lead.experience.subtitle');

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Cache at the edge (HOS-690 AC-37). This landing's HTML is now identical for
// every visitor — only a plan price edit or a deploy changes it — so it moved
// off `SESSION_OPTIONAL_SEGMENTS` and onto the `pricing` cache class, tagged
// so a plan write purges it (see `PlanService.triggerPricingRevalidation`).
// Goes through `applyCacheHeaders` rather than setting `Cache-Control`
// directly: a tag that fails to namespace would otherwise ship a cacheable
// response nothing could purge (HOS-426).
applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'pricing',
    tags: [CACHE_TAG_PRICING]
});

// ONE fetch feeds BOTH the price and the trial length (HOS-941 R-2). The
// experience vertical's single sellable tier (HOS-688 §6.8) is scoped by
// `?domain=experience` on the public plans endpoint (HOS-685); `category`
// on this plan is `'owner'` only to satisfy `PlanCategory`'s type — the
// real discriminator is `product_domain`, already applied server-side by
// the `domain` query param, so the resolver narrows nothing beyond
// `isActive`. Selecting the plan here and the trial there would let the
// two lines of the card describe different plans, so both come out of the
// same call. See `lib/billing/commerce-landing-plan.ts`.
const plansResult = await fetchPublicPlans({ domain: 'experience' });
const { plan: experiencePlan, trialDays, tiers } = resolveCommerceLandingOffer({ plansResult });

/**
 * HOS-1119: mirrors `/publicar-restaurante/`'s own flag. Experience carries a
 * single active tier today, so this is `false` and the page renders
 * byte-identical to before this change — but the branch is parametrized the
 * same way so a future second experience tier needs no page rewrite.
 */
const hasMultipleTiers = tiers.length > 1;
const tierDiffs = hasMultipleTiers
    ? deriveCommercePlanTierDiffs(tiers.map(toCommercePlanOption))
    : [];

/**
 * The trial line on the price card, or `null` when none may be promised.
 *
 * `tPlural` and not `t`: the CLDR `_one`/`_other` pair is what makes "1 día
 * de prueba" and "30 días de prueba" both grammatical in all three locales,
 * and the number is INTERPOLATED from the plan — no locale file carries a
 * trial length any more (HOS-941 R-2). This key used to read literally "30
 * días de prueba gratis", which matched the catalogue only by coincidence:
 * it would have kept promising 30 the day an operator edited the plan in
 * admin, and nothing would have failed. That is HOS-525, where marketing
 * promised hosts 30 days while the checkout granted 14.
 *
 * `null` renders NOTHING — never "0 días", never a number inherited from
 * the other vertical or from a constant. It covers a failed fetch and a plan
 * that genuinely offers no trial, and a visitor must not be able to tell
 * those apart.
 */
const trialLabel =
    trialDays === null ? null : tPlural('commerce.landing.experience.price.trial', trialDays);

/**
 * The price FAQ answer — the same number, from the same plan.
 *
 * It needs its own no-trial string rather than the clause being spliced out
 * at render time: the trial is embedded mid-sentence, and cutting it
 * mechanically would leave the sentence limping in whichever locale the
 * splitter was not written for. `a1NoTrial` is written to stand on its own
 * in each language.
 */
const priceFaqAnswer =
    trialDays === null
        ? t('commerce.landing.experience.faq.a1NoTrial')
        : tPlural('commerce.landing.experience.faq.a1', trialDays);

const intlLocale = getIntlLocale(locale);

/** Format ARS cents to a locale-aware currency string (mirrors PricingCardsGrid). */
function formatPriceArs(cents: number): string {
    const pesos = cents / 100;
    try {
        return new Intl.NumberFormat(intlLocale, {
            style: 'currency',
            currency: 'ARS',
            maximumFractionDigits: 0,
            minimumFractionDigits: 0
        }).format(pesos);
    } catch {
        return `$${pesos.toLocaleString('es-AR')}`;
    }
}

const benefits = [
    {
        Icon: MapIcon,
        titleKey: 'commerce.landing.experience.benefits.item1.title',
        descKey: 'commerce.landing.experience.benefits.item1.desc'
    },
    {
        Icon: SettingsIcon,
        titleKey: 'commerce.landing.experience.benefits.item2.title',
        descKey: 'commerce.landing.experience.benefits.item2.desc'
    },
    {
        Icon: ShieldIcon,
        titleKey: 'commerce.landing.experience.benefits.item3.title',
        descKey: 'commerce.landing.experience.benefits.item3.desc'
    }
] as const;

const steps = [
    {
        num: '01',
        titleKey: 'commerce.landing.experience.howItWorks.step1.title',
        descKey: 'commerce.landing.experience.howItWorks.step1.desc'
    },
    {
        num: '02',
        titleKey: 'commerce.landing.experience.howItWorks.step2.title',
        descKey: 'commerce.landing.experience.howItWorks.step2.desc'
    },
    {
        num: '03',
        titleKey: 'commerce.landing.experience.howItWorks.step3.title',
        descKey: 'commerce.landing.experience.howItWorks.step3.desc'
    }
] as const;

const priceFeatureKeys = [
    'commerce.landing.experience.price.feature1',
    'commerce.landing.experience.price.feature2',
    'commerce.landing.experience.price.feature3'
] as const;

/**
 * The FAQ, with every answer RESOLVED here rather than left as a key for the
 * template to translate. `a1` is the price answer and it is the one whose
 * shape depends on the catalogue, which a key-per-question array cannot
 * express. Resolving all three the same way keeps the rendered page and the
 * `FAQPage` JSON-LD reading from one value each, so the structured data can
 * never advertise a trial the visible answer omits.
 */
const faqs = [
    { q: t('commerce.landing.experience.faq.q1'), a: priceFaqAnswer },
    { q: t('commerce.landing.experience.faq.q2'), a: t('commerce.landing.experience.faq.a2') },
    { q: t('commerce.landing.experience.faq.q3'), a: t('commerce.landing.experience.faq.a3') }
] as const;

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
            '@type': 'Answer',
            text: faq.a
        }
    }))
};

// HOS-810: the CTA no longer stops at `auth/signup`, which redirected an
// already-signed-in visitor to `/mi-cuenta/` — a page with no link onward to
// the commerce create form, closing the loop this landing opens. It now
// carries that form as its post-auth return destination, so signup forwards a
// signed-in visitor straight there and still renders its form for everyone
// else. Stays one constant href, because this page is edge-cached and must
// keep parsing no session (see `lib/commerce/start-url.ts`).
const signupUrl = buildCommerceStartUrl({ locale, vertical: 'experience' });
---

<BaseLayout locale={locale} title={title} description={subtitle}>
    <SEOHead
        slot="head"
        title={title}
        description={subtitle}
        locale={locale}
        canonical={canonicalUrl}
        noindex={false}
    />
    <JsonLd slot="head" data={faqJsonLd} />

    <Breadcrumbs locale={locale} items={[{ label: title }]} />

    <section class="pub-exp__hero section">
        <div class="pub-exp__container section__container">
            <div class="pub-exp__header" data-reveal="up">
                <h1 class="pub-exp__title">{title}</h1>
                <p class="pub-exp__subtitle">{subtitle}</p>
                <GradientButton
                    href={signupUrl}
                    label={t('commerce.landing.experience.price.cta', 'Empezar ahora')}
                    variant="primary"
                    icon="true"
                />
            </div>
        </div>
    </section>

    <section class="pub-exp__benefits section section--warm">
        <div class="pub-exp__container section__container">
            <p class="pub-exp__tagline" data-reveal="up">
                {t('commerce.landing.experience.benefits.tagline')}
            </p>
            <h2 class="pub-exp__section-title" data-reveal="up">
                {t('commerce.landing.experience.benefits.title')}
            </h2>
            <div class="pub-exp__benefits-grid">
                {
                    benefits.map((b, i) => (
                        <div
                            class="pub-exp__benefit-card"
                            data-reveal="up"
                            data-stagger-index={Math.min(i, 6)}
                            data-stagger-step="100"
                        >
                            <div class="pub-exp__benefit-icon" aria-hidden="true">
                                <b.Icon size={28} weight="regular" />
                            </div>
                            <h3 class="pub-exp__benefit-title">{t(b.titleKey)}</h3>
                            <p class="pub-exp__benefit-desc">{t(b.descKey)}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="pub-exp__steps section">
        <div class="pub-exp__container section__container">
            <p class="pub-exp__tagline" data-reveal="up">
                {t('commerce.landing.experience.howItWorks.tagline')}
            </p>
            <h2 class="pub-exp__section-title" data-reveal="up">
                {t('commerce.landing.experience.howItWorks.title')}
            </h2>
            <div class="pub-exp__steps-grid">
                {
                    steps.map((s, i) => (
                        <div
                            class="pub-exp__step"
                            data-reveal="up"
                            data-stagger-index={Math.min(i, 6)}
                            data-stagger-step="100"
                        >
                            <span class="pub-exp__step-num">{s.num}</span>
                            <h3 class="pub-exp__step-title">{t(s.titleKey)}</h3>
                            <p class="pub-exp__step-desc">{t(s.descKey)}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="pub-exp__price section section--warm">
        <div class="pub-exp__container section__container">
            <p class="pub-exp__tagline" data-reveal="up">
                {hasMultipleTiers
                    ? t('commerce.landing.experience.price.taglineMulti')
                    : t('commerce.landing.experience.price.tagline')}
            </p>
            <h2 class="pub-exp__section-title" data-reveal="up">
                {t('commerce.landing.experience.price.title')}
            </h2>
            <div class="pub-exp__price-card" data-reveal="up">
                {
                    experiencePlan ? (
                        <Fragment>
                            <p class="pub-exp__price-amount">
                                {hasMultipleTiers && t('commerce.landing.experience.price.fromPrefix')}
                                {formatPriceArs(experiencePlan.monthlyPriceArs)}
                                <span class="pub-exp__price-suffix">
                                    {t('commerce.landing.experience.price.priceSuffix')}
                                </span>
                            </p>
                            {trialLabel && (
                                <p class="pub-exp__price-trial">{trialLabel}</p>
                            )}
                            <ul class="pub-exp__price-features">
                                {priceFeatureKeys.map((key) => (
                                    <li class="pub-exp__price-feature">
                                        <CheckIcon size={18} weight="bold" aria-hidden="true" />
                                        {t(key)}
                                    </li>
                                ))}
                            </ul>
                            <GradientButton
                                href={signupUrl}
                                label={t('commerce.landing.experience.price.cta')}
                                variant="accent"
                                shape="rounded"
                                icon="true"
                            />
                        </Fragment>
                    ) : (
                        <p class="pub-exp__price-unavailable">
                            {t('commerce.landing.experience.price.unavailable')}
                        </p>
                    )
                }
            </div>

            {
                hasMultipleTiers && (
                    <div class="pub-exp__tiers" data-reveal="up">
                        <h3 class="pub-exp__tiers-title">
                            {t('commerce.landing.experience.price.tiersTitle')}
                        </h3>
                        <ul class="pub-exp__tiers-list">
                            {tierDiffs.map(({ plan, addedEntitlements }) => (
                                <li class="pub-exp__tier">
                                    <div class="pub-exp__tier-header">
                                        <span class="pub-exp__tier-name">{plan.name}</span>
                                        <span class="pub-exp__tier-price">
                                            {formatPriceArs(plan.monthlyPriceArs)}
                                            <span class="pub-exp__price-suffix">
                                                {t('commerce.landing.experience.price.priceSuffix')}
                                            </span>
                                        </span>
                                    </div>
                                    {addedEntitlements.length > 0 && (
                                        <ul class="pub-exp__tier-adds">
                                            {addedEntitlements.map((key) => (
                                                <li>
                                                    {t(
                                                        `commerce.owner.entitlements.${
                                                            COMMERCE_ENTITLEMENT_I18N_SUFFIX[key] ?? key
                                                        }`,
                                                        COMMERCE_ENTITLEMENT_FALLBACK_LABEL[key] ?? key
                                                    )}
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
        </div>
    </section>

    <section class="pub-exp__faq section">
        <div class="pub-exp__container section__container">
            <p class="pub-exp__tagline" data-reveal="up">
                {t('commerce.landing.experience.faq.tagline')}
            </p>
            <h2 class="pub-exp__section-title" data-reveal="up">
                {t('commerce.landing.experience.faq.title')}
            </h2>
            <div class="pub-exp__faq-list" data-reveal="up">
                {
                    faqs.map((faq) => (
                        <details class="pub-exp__faq-item">
                            <summary class="pub-exp__faq-question">{faq.q}</summary>
                            <p class="pub-exp__faq-answer">{faq.a}</p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .pub-exp__hero {
        padding-block: var(--space-section, 120px);
        background-color: var(--core-background);
    }
    .pub-exp__container {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
    .pub-exp__header {
        text-align: center;
        max-width: 700px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-5, 1.25rem);
    }
    .pub-exp__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.875rem, 5vw, 3rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-4, 1rem);
        line-height: 1.15;
    }
    .pub-exp__subtitle {
        font-family: var(--font-sans);
        font-size: var(--text-body-lg, 1.0625rem);
        color: var(--core-muted-foreground);
        margin: 0;
        line-height: 1.6;
    }

    .pub-exp__section-title,
    .pub-exp__tagline {
        text-align: center;
    }

    .pub-exp__tagline {
        font-family: var(--font-decorative);
        font-weight: 700;
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        /* HOS-690 a11y fix: --brand-accent (#f07900) on --surface-warm (#e0f1ff)
           measures 2.44:1, below the 3:1 AA large-text minimum (a11y sweep,
           color-contrast, serious). --core-foreground is the design system's
           always-AA-safe text token on any light surface. */
        color: var(--core-foreground);
        margin: 0 0 var(--space-2);
    }

    .pub-exp__section-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-8);
    }

    /* Benefits */
    .pub-exp__benefits-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-card-gap);
        text-align: left;
    }
    .pub-exp__benefit-card {
        background-color: var(--core-card);
        border-radius: var(--radius-card);
        padding: var(--space-6);
        box-shadow: var(--shadow-card);
    }
    .pub-exp__benefit-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: var(--radius-md);
        background-color: var(--brand-primary-a10);
        color: var(--brand-primary);
        margin-bottom: var(--space-4);
    }
    .pub-exp__benefit-title {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: var(--text-lg);
        color: var(--core-foreground);
        margin: 0 0 var(--space-2);
    }
    .pub-exp__benefit-desc {
        font-family: var(--font-sans);
        font-size: var(--text-body);
        color: var(--core-muted-foreground);
        line-height: 1.6;
        margin: 0;
    }

    /* Steps */
    .pub-exp__steps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-card-gap);
        text-align: center;
    }
    .pub-exp__step-num {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--brand-primary-a20);
        display: block;
        margin-bottom: var(--space-3);
    }
    .pub-exp__step-title {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: var(--text-lg);
        color: var(--core-foreground);
        margin: 0 0 var(--space-2);
    }
    .pub-exp__step-desc {
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
        color: var(--core-muted-foreground);
        line-height: 1.6;
        margin: 0;
    }

    /* Price */
    .pub-exp__price-card {
        max-width: 420px;
        margin-inline: auto;
        text-align: center;
        background-color: var(--core-card);
        border-radius: var(--radius-card);
        padding: var(--space-8);
        box-shadow: var(--shadow-card);
    }
    .pub-exp__price-amount {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 2.75rem);
        color: var(--core-foreground);
        margin: 0;
    }
    .pub-exp__price-suffix {
        font-family: var(--font-sans);
        font-size: var(--text-body);
        color: var(--core-muted-foreground);
        font-weight: 400;
    }
    .pub-exp__price-trial {
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
        color: var(--brand-accent);
        margin: var(--space-2) 0 var(--space-4);
    }
    .pub-exp__price-features {
        list-style: none;
        margin: 0 0 var(--space-6);
        padding: 0;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }
    .pub-exp__price-feature {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--core-foreground);
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
    }
    .pub-exp__price-feature :global(svg) {
        color: var(--brand-primary);
        flex-shrink: 0;
    }
    .pub-exp__price-unavailable {
        color: var(--core-muted-foreground);
        font-family: var(--font-sans);
    }

    /* Tier comparison (HOS-1119) — only rendered when the vertical has more
       than one active tier. */
    .pub-exp__tiers {
        max-width: 560px;
        margin: var(--space-8, 2rem) auto 0;
    }
    .pub-exp__tiers-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-lg);
        color: var(--core-foreground);
        text-align: center;
        margin: 0 0 var(--space-4);
    }
    .pub-exp__tiers-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }
    .pub-exp__tier {
        background-color: var(--core-card);
        border-radius: var(--radius-sm, 8px);
        padding: var(--space-4);
        text-align: left;
    }
    .pub-exp__tier-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
        flex-wrap: wrap;
    }
    .pub-exp__tier-name {
        font-family: var(--font-sans);
        font-weight: 600;
        color: var(--core-foreground);
    }
    .pub-exp__tier-price {
        font-family: var(--font-sans);
        font-weight: 700;
        color: var(--core-foreground);
        white-space: nowrap;
    }
    .pub-exp__tier-adds {
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .pub-exp__tier-adds li {
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
        color: var(--core-muted-foreground);
    }
    .pub-exp__tier-adds li::before {
        content: '+ ';
        color: var(--success, oklch(0.55 0.18 145));
        font-weight: 700;
    }

    /* FAQ */
    .pub-exp__faq-list {
        max-width: 700px;
        margin: 0 auto;
        text-align: left;
    }
    .pub-exp__faq-item {
        border-bottom: 1px solid var(--border);
        padding: var(--space-4) 0;
    }
