---
/**
 * @file publicar-experiencia/index.astro
 * @description Permanent redirect to `/planes/experiencias/`, the experience
 * sales page (HOS-941 D-8).
 *
 * See `/publicar-restaurante/index.astro` for the rationale — same decision,
 * other vertical, including why the target is the SALES page rather than the
 * pricing one and why this could not land before H7 built
 * `/planes/experiencias/precios/`.
 *
 * @route     /{lang}/publicar-experiencia/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';

export const prerender = false;

const locale = Astro.locals.locale;

// The query string is FORWARDED, not rebuilt away. `?interval=` on the
// trial-ending nudge is the live case: dropping it shows monthly prices to a
// customer who chose annual, and nothing about the redirect looks wrong when it
// happens. See `lib/pricing-redirect.ts`.
return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: 'planes/experiencias',
        search: Astro.url.search
    }),
    301
);
---
