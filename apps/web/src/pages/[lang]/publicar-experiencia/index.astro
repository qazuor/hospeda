---
/**
 * @file publicar-experiencia/index.astro
 * @description Permanent redirect to `/{lang}/publicar/experiencias/`, the
 * experiences publish page (HOS-1156 D-6).
 *
 * See `/publicar-restaurante/index.astro` for the rationale — same decision,
 * other vertical, including why this target overrides HOS-941 D-8 and why the
 * query string is forwarded rather than rebuilt away.
 *
 * @route     /{lang}/publicar-experiencia/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PUBLISH_PAGE_PATH_BY_VERTICAL.experience,
        search: Astro.url.search
    }),
    301
);
---
