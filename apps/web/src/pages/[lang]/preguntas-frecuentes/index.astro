---
/** Public, session-blind FAQ with progressive search and shared disclosures. */
import { CACHE_TAG_PRICING, CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import FAQPageJsonLd from '@/components/seo/FAQPageJsonLd.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import FaqAccordion from '@/components/shared/ui/FaqAccordion.astro';
import ScrollableNav from '@/components/shared/ui/ScrollableNav.astro';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { getBrandPhoneWhatsAppUrl } from '@/lib/brand-phone';
import { getPlanName } from '@/lib/billing/plan-name';
import { fetchAudiencePlans } from '@/lib/billing/audience-plans';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { buildFaqDirectory } from '@/lib/faq/directory';
import { createTranslations } from '@/lib/i18n';
import { breadcrumbLabel } from '@/lib/navigation/breadcrumb-labels';
import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale;
const { t } = createTranslations(locale);
applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'pricing',
    tags: [CACHE_TAG_SITE_CONFIG, CACHE_TAG_PRICING]
});

const audiencePlans = await Promise.all((['tourist', 'host'] as const).map(async (audience) => {
    const plans = await fetchAudiencePlans({ audience });
    return {
        href: buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE[audience === 'host' ? 'owner' : 'tourist'] }),
        label: t(audience === 'tourist' ? 'faq.search.touristPlans' : 'faq.search.hostPlans'),
        names: plans.map((plan) => getPlanName({ plan, t }))
    };
}));

const groups = buildFaqDirectory({ locale });
const faqSections = groups.flatMap(({ items }) => items.map(({ question, answer }) => ({
    heading: question, body: answer
})));
const contactHref = buildUrl({ locale, path: '/contacto/' });
---

<DefaultLayout locale={locale} title={t('faq.title')} description={t('faq.description')}>
    <FAQPageJsonLd slot="head-extra" sections={faqSections} name={t('faq.title')} description={t('faq.description')} inLanguage={locale} />
    <header class="faq-hero section section--warm">
        <div class="faq-container">
            <Breadcrumbs locale={locale} items={[{ label: breadcrumbLabel({ t, key: 'faq' }) }]} />
            <p>{t('faq.hero.tagline')}</p>
            <h1>{t('faq.hero.title')}</h1>
            <p>{t('faq.hero.subtitle')}</p>
            <a href={contactHref}>{t('faq.hero.ctaContact')}</a>
        </div>
    </header>

    <faq-directory class="faq-container" id="faq-top" tabindex="-1">
        <label class="faq-search" hidden data-faq-search>
            {t('faq.search.label')}
            <input type="search" autocomplete="off" aria-controls="faq-answers" />
        </label>
        <p class="faq-jump" aria-hidden="true">{t('faq.nav.jumpTo')}</p>
        <ScrollableNav ariaLabel={t('faq.nav.label')} desktopGrid>
            {groups.map(({ id, title }) => <a class="faq-chip" href={`#${id}`}>{title}</a>)}
        </ScrollableNav>
        <p role="status" hidden data-faq-empty>{t('faq.search.empty')}</p>
        <div class="faq-answers" id="faq-answers"><FaqAccordion groups={groups} /></div>
        <div class="faq-links">
            {audiencePlans.map(({ href, label, names }) => (
                <div><a href={href}>{label}</a>{names.length > 0 && <p>{new Intl.ListFormat(locale).format(names)}</p>}</div>
            ))}
            <a href="#faq-top">{t('common.scrollToTop')}</a>
        </div>
    </faq-directory>

    <section class="section section--warm">
        <div class="faq-container">
            <h2>{t('faq.stillNeedHelp.title')}</h2>
            <p>{t('faq.stillNeedHelp.subtitle')}</p>
            <div class="faq-links">
                <a href={contactHref}>{t('faq.stillNeedHelp.ctaContact')}</a>
                <a href={getBrandPhoneWhatsAppUrl()} target="_blank" rel="noopener noreferrer">{t('faq.stillNeedHelp.ctaWhatsApp')}</a>
            </div>
        </div>
    </section>
</DefaultLayout>

<script>
    import { filterFaqDirectory } from '@/lib/faq/search';

    class FaqDirectory extends HTMLElement {
        connectedCallback() {
            const search = this.querySelector<HTMLElement>('[data-faq-search]');
            const input = search?.querySelector('input');
            if (!search || !input) return;
            search.hidden = false;
            input.oninput = () => filterFaqDirectory({ root: this, query: input.value });
            for (const chip of this.querySelectorAll<HTMLAnchorElement>('.faq-chip')) {
                chip.onclick = () => {
                    if (input.value) {
                        input.value = '';
                        filterFaqDirectory({ root: this, query: '' });
                    }
                };
            }
        }
    }
    if (!customElements.get('faq-directory')) customElements.define('faq-directory', FaqDirectory);
</script>

<style>
    .faq-container {
        display: block;
        max-width: 95ch;
        margin-inline: auto;
        padding-inline: var(--space-container-x);
        min-width: 0;
    }
    .faq-hero { text-align: center; }
    faq-directory {
        padding-block: var(--space-6);
        scroll-margin-top: var(--navbar-height);
    }
    .faq-search:not([hidden]) {
        display: grid;
        gap: var(--space-2);
        font-weight: 600;
    }
    .faq-search input {
        width: 100%;
        padding: var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--core-card);
        color: var(--core-foreground);
        font: inherit;
    }
    .faq-jump { margin-block: var(--space-4) var(--space-2); }
    .faq-chip {
        flex: none;
        text-align: center;
        align-content: center;
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        color: var(--core-foreground);
        background: var(--core-card);
        text-decoration: none;
        scroll-snap-align: start;
    }
    .faq-chip:hover { border-color: var(--brand-primary); }
    .faq-answers { margin-block: var(--space-6); }
    .faq-links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); }
</style>
