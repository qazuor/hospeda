---
/**
 * @file signup.astro
 * @description Sign-up page — allows users to create a new account.
 *
 * Authenticated users are immediately redirected — to the destination carried
 * by a safe `returnUrl` / `redirect` query param when one is present, otherwise
 * to /mi-cuenta/ (HOS-810). That param is what lets an edge-cached marketing
 * landing point one constant CTA at "create your account OR, if you already
 * have one, go straight to the thing you came here to do": the landing itself
 * cannot branch on the session without losing its cache, this page already
 * parses it. See `src/lib/commerce/start-url.ts` for the full rationale.
 *
 * The param does NOT survive a brand-new registration, and that is a known
 * gap, not an oversight: the API does NOT auto sign-in the user (email
 * verification is required), so registration continues to verify-email-sent
 * and the destination is lost at the verification hop. The "already have an
 * account" link below forwards the param, so the existing-user path keeps it.
 *
 * Both `returnUrl` and `redirect` are accepted, mirroring `signin.astro`;
 * `returnUrl` wins when both are present. The value is attacker-controlled, so
 * it goes through the shared `resolveSafeReturnPath` open-redirect guard.
 *
 * @route    /[lang]/auth/signup/
 * @rendering SSR (auth state from locals; reads `returnUrl`/`redirect` query params)
 */

import { resolveSafeReturnPath } from '@/lib/auth-redirect';
import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { SignUp } from '@/components/auth/SignUp.client';
import { SparkleIcon, UsersIcon } from '@repo/icons';

// Locale is injected by middleware — always a valid SupportedLocale.
const locale = Astro.locals.locale as SupportedLocale;

// Post-auth destination carried by `returnUrl` (canonical) or `redirect`
// (legacy alias); `returnUrl` wins when both are present. Validated against the
// same open-redirect guard signin.astro uses — the raw value is query input.
const rawReturn =
    Astro.url.searchParams.get('returnUrl') ?? Astro.url.searchParams.get('redirect') ?? '';
const returnPath = resolveSafeReturnPath({ rawReturn, locale });

// Redirect authenticated users to that destination (the account dashboard when
// no safe one was provided). Honouring the param HERE is the whole mechanism
// behind HOS-810: a signed-in visitor who clicks "Empezar ahora" on a cached
// commerce landing arrives at this page and is forwarded to the create form,
// instead of being dumped on /mi-cuenta/ with no link onward.
if (Astro.locals.user) {
    return Astro.redirect(returnPath);
}

const t = createT(locale);

const title = t('auth-ui.pages.signup.title', 'Crear cuenta');
const description = t('auth-ui.pages.signup.description', 'Creá tu cuenta en Hospeda');

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// After registration, redirect user to a "check your email" page since
// the account is created without an active session (email verification is
// required before sign-in). The verify-email-sent page reassures the user
// and offers to resend the verification email.
//
// Anchor on `Astro.url.origin` (the actual request host) so users
// signing up from staging.hospeda.com.ar don't get bounced to the
// canonical apex post-registration.
const redirectTo = new URL(
    buildUrl({ locale, path: 'auth/verify-email-sent' }),
    Astro.url.origin
).href;

// OAuth providers (Google, Facebook) verify email themselves, so the
// user is fully authenticated when the callback returns. Sending them
// to /auth/verify-email-sent/ would be confusing ("check your inbox"
// when there's no email to check). Land them on the account dashboard
// instead — or on the requested destination, when one was carried in
// (HOS-810).
//
// This is the ONE registration path where the return destination CAN
// survive, and it survives for the same reason the confusing page does not
// apply: the provider vouches for the address, so a session exists the
// moment the callback returns. The password path has no session to redirect
// with until the verification e-mail is opened, which is why it keeps going
// to verify-email-sent. `returnPath` is already through the open-redirect
// guard and is relative, so anchoring it on the request origin cannot leave
// this host.
const oauthRedirectTo = new URL(returnPath, Astro.url.origin).href;

// Localized secondary link labels via i18n
const haveAccountLabel = t('auth-ui.signUp.alreadyHaveAccount', 'Already have an account?');
const signInLabel = t('auth-ui.signUp.signInLink', 'Sign In');

// Forward the return destination to sign-in so a visitor who already has an
// account keeps it end to end (signin.astro reads the same param). Only when a
// destination was actually requested — a bare link stays bare, so nothing
// changes for the ordinary "I came here to sign up" visitor.
const signInHref =
    rawReturn === ''
        ? buildUrl({ locale, path: 'auth/signin' })
        : `${buildUrl({ locale, path: 'auth/signin' })}?returnUrl=${encodeURIComponent(returnPath)}`;
---

<AuthLayout locale={locale} title={title} description={description}>
    <div slot="decoratives" class="signup-deco" aria-hidden="true">
        <div class="signup-deco__blob"></div>
        <span class="signup-deco__shape signup-deco__shape--sparkle">
            <SparkleIcon size={84} weight="duotone" />
        </span>
        <span class="signup-deco__badge signup-deco__badge--users">
            <UsersIcon size="md" weight="duotone" />
        </span>
        <span class="signup-deco__dot signup-deco__dot--1"></span>
        <span class="signup-deco__dot signup-deco__dot--2"></span>
        <span class="signup-deco__dot signup-deco__dot--3"></span>
    </div>

    <SignUp
        client:load
        locale={locale}
        redirectTo={redirectTo}
        oauthRedirectTo={oauthRedirectTo}
        showOAuth={true}
    />

    <div class="auth-page__footer">
        <span class="auth-page__footer-text">{haveAccountLabel}</span>
        {' '}
        <a
            href={signInHref}
            class="auth-page__link auth-page__link--strong"
        >
            {signInLabel}
        </a>
    </div>
</AuthLayout>

<style is:global>
    /* Decoratives — rendered inside the AuthLayout 'decoratives' slot, outside .auth-card. */
    .signup-deco {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .signup-deco__blob {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(360px, 60vw, 720px);
        height: clamp(360px, 60vw, 720px);
        border-radius: 50%;
        background: radial-gradient(
            circle at 40% 40%,
            var(--brand-accent-a15),
            var(--brand-primary-a05) 55%,
            transparent 75%
        );
        filter: blur(4px);
    }

    .signup-deco__shape {
        position: absolute;
        display: inline-flex;
    }

    .signup-deco__shape--sparkle {
        top: 12%;
        right: 9%;
        color: var(--brand-accent);
        opacity: 0.4;
        transform: rotate(15deg);
    }

    .signup-deco__badge {
        position: absolute;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background-color: var(--core-card);
        box-shadow: var(--shadow-card);
        color: var(--brand-primary);
    }

    .signup-deco__badge--users {
        bottom: 16%;
        left: 8%;
    }

    .signup-deco__dot {
        position: absolute;
        border-radius: 50%;
    }
    .signup-deco__dot--1 {
        top: 30%;
        left: 10%;
        width: 10px;
        height: 10px;
        background-color: var(--brand-primary-a30);
    }
    .signup-deco__dot--2 {
        top: 22%;
        left: 22%;
        width: 7px;
        height: 7px;
        background-color: var(--brand-accent-a30);
    }
    .signup-deco__dot--3 {
        bottom: 26%;
        right: 14%;
        width: 11px;
        height: 11px;
        background-color: var(--brand-accent-a25);
    }

    @media (max-width: 700px) {
        .signup-deco__shape,
        .signup-deco__badge {
            display: none;
        }
    }
</style>

<style>
    .auth-page {
        display: flex;
        min-height: calc(100vh - var(--navbar-height, 5rem));
        align-items: center;
        justify-content: center;
        padding: var(--space-8, 2rem) var(--space-4, 1rem);
    }

    .auth-page__card {
        width: 100%;
        max-width: 28rem;
        border-radius: var(--radius-card);
        border: 1px solid var(--border);
        background-color: var(--core-card);
        padding: var(--space-8, 2rem);
        box-shadow: var(--shadow-card);
    }

    .auth-page__footer {
        margin-top: var(--space-6, 1.5rem);
        text-align: center;
    }

    .auth-page__footer-text {
        font-size: var(--text-body-sm);
        color: var(--core-muted-foreground);
    }

    .auth-page__link {
        font-size: var(--text-body-sm);
        color: var(--brand-primary);
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .auth-page__link:hover {
        color: var(--brand-primary-l85);
    }

    .auth-page__link:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    .auth-page__link--strong {
        font-weight: 600;
    }
</style>
