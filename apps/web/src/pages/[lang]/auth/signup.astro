---
/**
 * @file signup.astro
 * @description Sign-up page — thin wrapper around the unified `AuthTabs`
 * island with the sign-up tab active (HOS-959). `signin.astro` renders the
 * SAME island with `initialTab="signin"`; the two pages differ only in
 * `initialTab` and their own SEO title/description/decoratives. The tab
 * switch inside `AuthTabs` is client-side only (no navigation), so this page
 * computes redirect configuration for BOTH tabs via the shared
 * `resolveAuthTabsRedirectConfig` helper — see that file's header doc for
 * why a single-tab computation would not be enough.
 *
 * Authenticated users are immediately redirected — to a validated
 * `callbackUrl` (SPEC-182) when present, otherwise to the destination
 * carried by a safe `returnUrl`/`redirect` query param, otherwise to
 * /mi-cuenta/ (HOS-810). That param is what lets an edge-cached marketing
 * landing point one constant CTA at "create your account OR, if you already
 * have one, go straight to the thing you came here to do": the landing
 * itself cannot branch on the session without losing its cache, this page
 * already parses it. See `src/lib/commerce/start-url.ts` for the full
 * rationale.
 *
 * The password-REGISTRATION path does NOT honor `returnUrl`/`callbackUrl` —
 * that is a known gap (HOS-838), not an oversight: the API does not
 * auto-sign-in the user (email verification is required), so registration
 * always lands on `/auth/verify-email-sent/` and the destination is lost at
 * the verification hop. OAuth registration DOES authenticate immediately, so
 * it honors both params exactly like sign-in (HOS-959 — this is a
 * deliberate, owner-approved behavior ADDITION: previously `signup.astro`
 * ignored `callbackUrl` entirely, even for OAuth).
 *
 * Both `returnUrl` and `redirect` are accepted, mirroring `signin.astro`;
 * `returnUrl` wins when both are present. The value is attacker-controlled, so
 * it goes through the shared `resolveSafeReturnPath` open-redirect guard.
 *
 * @route    /[lang]/auth/signup/
 * @rendering SSR (auth state from locals; reads query params from `Astro.url`)
 */

import { AuthTabs } from '@/components/auth/AuthTabs.client';
import { resolveAuthTabsRedirectConfig } from '@/lib/auth-tabs-config';
import { getAdminUrl, getSiteUrl, isProduction } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { SparkleIcon, UsersIcon } from '@repo/icons';

// Locale is injected by middleware — always a valid SupportedLocale.
const locale = Astro.locals.locale as SupportedLocale;

// SECURITY: `returnUrl`/`redirect`/`callbackUrl` are attacker-controlled
// query input. `resolveAuthTabsRedirectConfig` runs them through the shared
// open-redirect guard (`resolveSafeReturnPath`) and the `callbackUrl`
// allowlist (`validateCallbackUrl`, SPEC-182) — see that file for the full
// rationale. `signInConfig`/`signUpConfig` are handed straight to the
// island; `returnPath`/`validatedCallbackUrl` are only needed here for the
// already-authenticated redirect below and the "already have an account"
// footer link.
const { returnPath, validatedCallbackUrl, signInConfig, signUpConfig } = resolveAuthTabsRedirectConfig(
    {
        astroUrl: Astro.url,
        locale,
        siteUrl: getSiteUrl(),
        adminUrl: getAdminUrl(),
        isProduction: isProduction()
    }
);

// Redirect authenticated users to that destination (the account dashboard
// when no safe one was provided; a validated callbackUrl takes precedence,
// mirroring signin.astro — HOS-959). Honouring the param HERE is the whole
// mechanism behind HOS-810: a signed-in visitor who clicks "Empezar ahora" on
// a cached commerce landing arrives at this page and is forwarded to the
// create form, instead of being dumped on /mi-cuenta/ with no link onward.
if (Astro.locals.user) {
    return Astro.redirect(validatedCallbackUrl ?? returnPath);
}

const t = createT(locale);

const title = t('auth-ui.pages.signup.title', 'Crear cuenta');
const description = t('auth-ui.pages.signup.description', 'Creá tu cuenta en Hospeda');

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// SPEC-120: pick up OAuth failure signal from the API redirect. Mirrors
// signin.astro exactly (HOS-959) — the shared OAuth block in `AuthTabs` can
// be reached from either URL, so a failure returning to `/auth/signup` must
// surface the same banner.
const rawErrorCode = Astro.url.searchParams.get('error');
const oauthErrorCode = rawErrorCode
    ? /^[a-z_]{1,64}$/.test(rawErrorCode)
        ? rawErrorCode
        : 'unknown'
    : undefined;

const rawErrorDescription = Astro.url.searchParams.get('error_description');
const oauthErrorDescription = rawErrorDescription
    ? rawErrorDescription.slice(0, 200)
    : undefined;

const rawProvider = Astro.url.searchParams.get('provider');
const oauthProvider =
    rawProvider && /^[a-z]{1,32}$/.test(rawProvider) ? rawProvider : undefined;

const initialOAuthError = oauthErrorCode
    ? {
          code: oauthErrorCode,
          description: oauthErrorDescription,
          provider: oauthProvider
      }
    : undefined;

// Pathnames the island rewrites into the URL bar on a client-side tab
// switch (`AuthTabs` builds these itself, never by string-editing
// `window.location.pathname`).
const signInPath = buildUrl({ locale, path: 'auth/signin' });
const signUpPath = buildUrl({ locale, path: 'auth/signup' });

// Localized secondary link labels via i18n
const haveAccountLabel = t('auth-ui.signUp.alreadyHaveAccount', 'Already have an account?');
const signInLabel = t('auth-ui.signUp.signInLink', 'Sign In');

// Forward the return destination to sign-in so a visitor who already has an
// account keeps it end to end (signin.astro reads the same param). Only when a
// destination was actually requested — a bare link stays bare, so nothing
// changes for the ordinary "I came here to sign up" visitor.
const rawReturn =
    Astro.url.searchParams.get('returnUrl') ?? Astro.url.searchParams.get('redirect') ?? '';
const signInHref =
    rawReturn === ''
        ? buildUrl({ locale, path: 'auth/signin' })
        : `${buildUrl({ locale, path: 'auth/signin' })}?returnUrl=${encodeURIComponent(returnPath)}`;
---

<AuthLayout locale={locale} title={title} description={description}>
    <div slot="decoratives" class="signup-deco" aria-hidden="true">
        <div class="signup-deco__blob"></div>
        <span class="signup-deco__shape signup-deco__shape--sparkle">
            <SparkleIcon size={84} weight="duotone" />
        </span>
        <span class="signup-deco__badge signup-deco__badge--users">
            <UsersIcon size="md" weight="duotone" />
        </span>
        <span class="signup-deco__dot signup-deco__dot--1"></span>
        <span class="signup-deco__dot signup-deco__dot--2"></span>
        <span class="signup-deco__dot signup-deco__dot--3"></span>
    </div>

    <AuthTabs
        client:load
        locale={locale}
        initialTab="signup"
        signInPath={signInPath}
        signUpPath={signUpPath}
        signInConfig={signInConfig}
        signUpConfig={signUpConfig}
        initialOAuthError={initialOAuthError}
    />

    <div class="auth-page__footer">
        <span class="auth-page__footer-text">{haveAccountLabel}</span>
        {' '}
        <a
            href={signInHref}
            class="auth-page__link auth-page__link--strong"
        >
            {signInLabel}
        </a>
    </div>
</AuthLayout>

<style is:global>
    /* Decoratives — rendered inside the AuthLayout 'decoratives' slot, outside .auth-card. */
    .signup-deco {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .signup-deco__blob {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(360px, 60vw, 720px);
        height: clamp(360px, 60vw, 720px);
        border-radius: 50%;
        background: radial-gradient(
            circle at 40% 40%,
            var(--brand-accent-a15),
            var(--brand-primary-a05) 55%,
            transparent 75%
        );
        filter: blur(4px);
    }

    .signup-deco__shape {
        position: absolute;
        display: inline-flex;
    }

    .signup-deco__shape--sparkle {
        top: 12%;
        right: 9%;
        color: var(--brand-accent);
        opacity: 0.4;
        transform: rotate(15deg);
    }

    .signup-deco__badge {
        position: absolute;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background-color: var(--core-card);
        box-shadow: var(--shadow-card);
        color: var(--brand-primary);
    }

    .signup-deco__badge--users {
        bottom: 16%;
        left: 8%;
    }

    .signup-deco__dot {
        position: absolute;
        border-radius: 50%;
    }
    .signup-deco__dot--1 {
        top: 30%;
        left: 10%;
        width: 10px;
        height: 10px;
        background-color: var(--brand-primary-a30);
    }
    .signup-deco__dot--2 {
        top: 22%;
        left: 22%;
        width: 7px;
        height: 7px;
        background-color: var(--brand-accent-a30);
    }
    .signup-deco__dot--3 {
        bottom: 26%;
        right: 14%;
        width: 11px;
        height: 11px;
        background-color: var(--brand-accent-a25);
    }

    @media (max-width: 700px) {
        .signup-deco__shape,
        .signup-deco__badge {
            display: none;
        }
    }
</style>
