---
/**
 * @file signin.astro
 * @description Sign-in page — thin wrapper around the unified `AuthTabs`
 * island with the sign-in tab active (HOS-959). `signup.astro` renders the
 * SAME island with `initialTab="signup"`; the two pages differ only in
 * `initialTab` and their own SEO title/description/decoratives. The tab
 * switch inside `AuthTabs` is client-side only (no navigation), so this page
 * computes redirect configuration for BOTH tabs via the shared
 * `resolveAuthTabsRedirectConfig` helper — see that file's header doc for
 * why a single-tab computation would not be enough.
 *
 * Authenticated users are immediately redirected — to a validated
 * `callbackUrl` (SPEC-182) when present, otherwise to the post-login
 * destination from a safe `returnUrl`/`redirect` query param, otherwise to
 * /mi-cuenta/.
 *
 * Both `returnUrl` and `redirect` are accepted as query param names so older
 * callsites that built links with `?redirect=...` keep working. `returnUrl`
 * takes precedence when both are present.
 *
 * @route    /[lang]/auth/signin/
 * @rendering SSR (reads query params from `Astro.url`; reads auth state from locals)
 */

import { AuthTabs } from '@/components/auth/AuthTabs.client';
import { resolveAuthTabsRedirectConfig } from '@/lib/auth-tabs-config';
import { getAdminUrl, getSiteUrl, isProduction } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { HomeIcon, LocationIcon } from '@repo/icons';

// Locale is injected by middleware — always a valid SupportedLocale.
const locale = Astro.locals.locale as SupportedLocale;

// SECURITY: `returnUrl`/`redirect`/`callbackUrl` are attacker-controlled
// query input. `resolveAuthTabsRedirectConfig` runs them through the shared
// open-redirect guard (`resolveSafeReturnPath`) and the `callbackUrl`
// allowlist (`validateCallbackUrl`, SPEC-182) — see that file for the full
// rationale. `signInConfig`/`signUpConfig` are handed straight to the
// island; `returnPath`/`validatedCallbackUrl` are only needed here for the
// already-authenticated redirect below.
const { returnPath, validatedCallbackUrl, signInConfig, signUpConfig } = resolveAuthTabsRedirectConfig(
    {
        astroUrl: Astro.url,
        locale,
        siteUrl: getSiteUrl(),
        adminUrl: getAdminUrl(),
        isProduction: isProduction()
    }
);

// Redirect authenticated users to the requested destination (or the account
// dashboard when no safe destination was provided). Without honoring the
// param here, callsites that link to /auth/signin?...=<path> would silently
// land on /mi-cuenta whenever the session is already valid — defeating the
// purpose of the redirect query. A valid callbackUrl takes precedence.
if (Astro.locals.user) {
    return Astro.redirect(validatedCallbackUrl ?? returnPath);
}

const t = createT(locale);

const title = t('auth-ui.pages.signin.title', 'Iniciar sesión');
const description = t(
    'auth-ui.pages.signin.description',
    'Iniciá sesión en tu cuenta de Hospeda'
);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// SPEC-120: pick up OAuth failure signal from the API redirect.
//
// Better Auth `^1.4.18` redirects to errorCallbackURL with `?error=<code>`
// (and optionally `&error_description=...`) when the OAuth flow fails — user
// cancel, provider rejection, or any RFC 6749 §4.1.2.1 error. The API wrapper
// also injects `&provider=<name>` so the banner can name the provider.
//
// We validate each value with a strict allowlist regex before forwarding to
// the island: these come straight from a user-controlled redirect chain and
// flow into both i18n key lookups and console.warn output. An unexpected
// `error` code falls back to `'unknown'` (the i18n catch-all key).
//
// HOS-959: `signup.astro` parses this identically — the shared OAuth block
// in `AuthTabs` can be reached from either URL, so a failure returning to
// `/auth/signup` must surface the same banner.
const rawErrorCode = Astro.url.searchParams.get('error');
const oauthErrorCode = rawErrorCode
    ? /^[a-z_]{1,64}$/.test(rawErrorCode)
        ? rawErrorCode
        : 'unknown'
    : undefined;

const rawErrorDescription = Astro.url.searchParams.get('error_description');
const oauthErrorDescription = rawErrorDescription
    ? rawErrorDescription.slice(0, 200)
    : undefined;

const rawProvider = Astro.url.searchParams.get('provider');
const oauthProvider =
    rawProvider && /^[a-z]{1,32}$/.test(rawProvider) ? rawProvider : undefined;

const initialOAuthError = oauthErrorCode
    ? {
          code: oauthErrorCode,
          description: oauthErrorDescription,
          provider: oauthProvider
      }
    : undefined;

// Pathnames the island rewrites into the URL bar on a client-side tab
// switch (`AuthTabs` builds these itself, never by string-editing
// `window.location.pathname`).
const signInPath = buildUrl({ locale, path: 'auth/signin' });
const signUpPath = buildUrl({ locale, path: 'auth/signup' });

// Localized secondary link labels via i18n
const noAccountLabel = t('auth-ui.signIn.dontHaveAccount', "Don't have an account?");
const signUpLabel = t('auth-ui.signIn.signUpLink', 'Sign Up');
const forgotPasswordLabel = t('auth-ui.signIn.forgotPassword', 'Forgot password?');
---

<AuthLayout locale={locale} title={title} description={description}>
    <div slot="decoratives" class="signin-deco" aria-hidden="true">
        <div class="signin-deco__blob"></div>
        <span class="signin-deco__shape signin-deco__shape--home">
            <HomeIcon size={84} weight="duotone" />
        </span>
        <span class="signin-deco__badge signin-deco__badge--pin">
            <LocationIcon size="md" weight="duotone" />
        </span>
        <span class="signin-deco__dot signin-deco__dot--1"></span>
        <span class="signin-deco__dot signin-deco__dot--2"></span>
    </div>

    <div class="auth-page-content">
            <AuthTabs
                client:load
                locale={locale}
                initialTab="signin"
                signInPath={signInPath}
                signUpPath={signUpPath}
                signInConfig={signInConfig}
                signUpConfig={signUpConfig}
                initialOAuthError={initialOAuthError}
            />

            <div class="auth-page__links">
                <a
                    href={buildUrl({ locale, path: 'auth/forgot-password' })}
                    class="auth-page__link"
                >
                    {forgotPasswordLabel}
                </a>
            </div>

            <div class="auth-page__footer auth-page__footer--tight">
                <span class="auth-page__footer-text">{noAccountLabel}</span>
                {' '}
                <a
                    href={buildUrl({ locale, path: 'auth/signup' })}
                    class="auth-page__link auth-page__link--strong"
                >
                    {signUpLabel}
                </a>
            </div>
    </div>
</AuthLayout>

<style is:global>
    /* Decoratives — rendered inside the AuthLayout 'decoratives' slot, outside .auth-card. */
    .signin-deco {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .signin-deco__blob {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(360px, 60vw, 720px);
        height: clamp(360px, 60vw, 720px);
        border-radius: 50%;
        background: radial-gradient(
            circle at 50% 50%,
            var(--brand-primary-a15),
            var(--brand-accent-a05) 55%,
            transparent 75%
        );
        filter: blur(4px);
    }

    .signin-deco__shape {
        position: absolute;
        display: inline-flex;
    }

    .signin-deco__shape--home {
        top: 14%;
        left: 8%;
        color: var(--brand-primary);
        opacity: 0.35;
        transform: rotate(-12deg);
    }

    .signin-deco__badge {
        position: absolute;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background-color: var(--core-card);
        box-shadow: var(--shadow-card);
        color: var(--brand-accent);
    }

    .signin-deco__badge--pin {
        bottom: 18%;
        right: 10%;
    }

    .signin-deco__dot {
        position: absolute;
        border-radius: 50%;
    }
    .signin-deco__dot--1 {
        top: 28%;
        right: 14%;
        width: 12px;
        height: 12px;
        background-color: var(--brand-primary-a30);
    }
    .signin-deco__dot--2 {
        bottom: 28%;
        left: 12%;
        width: 9px;
        height: 9px;
        background-color: var(--brand-accent-a30);
    }

    @media (max-width: 700px) {
        .signin-deco__shape,
        .signin-deco__badge {
            display: none;
        }
    }
</style>
