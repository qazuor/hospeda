---
/**
 * @file suscriptores/planes/comparar/index.astro
 * @description Permanent redirect to `/planes/anfitriones/precios/`, where the
 * host comparison table now lives (HOS-941 D-4 + D-11).
 *
 * The table did not disappear; it stopped having a URL. Its job is "which of
 * these three suits me", which is the pricing page's question, and nobody
 * searches for "tabla comparativa de planes" — so a URL of its own captured no
 * intent while putting the densest, most SEO-valuable content on the site
 * behind a click almost nobody took. It now renders inline under the cards.
 *
 * The complex-plan teaser went with it: this page used to load those plans so
 * `PlanComparisonTable` could filter them out and render "próximamente" in
 * their place, and the component still does exactly that on its new home.
 *
 * @route     /{lang}/suscriptores/planes/comparar/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';
import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';

export const prerender = false;

const locale = Astro.locals.locale;

// The query string is FORWARDED, not rebuilt away. `?interval=` on the
// trial-ending nudge is the live case: dropping it shows monthly prices to a
// customer who chose annual, and nothing about the redirect looks wrong when it
// happens. See `lib/pricing-redirect.ts`.
return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PRICING_PAGE_PATH_BY_AUDIENCE.owner,
        search: Astro.url.search
    }),
    301
);
---
