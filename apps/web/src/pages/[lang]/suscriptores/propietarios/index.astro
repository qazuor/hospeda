---
/**
 * @file suscriptores/propietarios/index.astro
 * @description Permanent redirect to the host audience's sales page,
 * `/planes/anfitriones/` (HOS-941 D-12, HOS-985 AC-60).
 *
 * ## Why this page is gone rather than kept
 *
 * It was `/publicar/` without what makes `/publicar/` useful (HOS-941 F-3):
 * the same sections in the same order, rendering the same `owners.*` keys,
 * with `publicar` adding the auth-aware parts on top. Two landings reading one
 * copy source is how HOS-331 happened — the surfaces drift the moment one of
 * them is edited and the other is forgotten.
 *
 * Its content did not disappear: `/planes/anfitriones/` renders the same
 * `owners.*` keys through the shared sales-page components, and calls the same
 * `resolveOwnerFaqAnswer` so the trial length still comes from the catalogue
 * (HOS-941 R-2). Nothing here needed migrating — only the URL changes.
 *
 * 301 and not 302: this URL has been the owner landing since the site
 * launched, it is linked from the footer on every page, and it is whatever is
 * indexed and bookmarked. It changes LOCATION, which is the status that
 * transfers the ranking signal.
 *
 * Removed from `static-sitemap-pages.ts` in this same change — a sitemap that
 * keeps advertising a redirect-only URL hands crawlers a page that never
 * serves content again.
 *
 * @route /{lang}/suscriptores/propietarios/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildUrl } from '@/lib/urls';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(buildUrl({ locale, path: 'planes/anfitriones' }), 301);
---
