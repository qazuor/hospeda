---
/**
 * @file suscriptores/turistas/comparar/index.astro
 * @description Permanent redirect to `/planes/turistas/precios/`, where the
 * traveller comparison table now lives (HOS-941 D-4 + D-11).
 *
 * See `/suscriptores/planes/comparar/index.astro` for the rationale — same
 * decision, other audience.
 *
 * @route     /{lang}/suscriptores/turistas/comparar/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(
    buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE.tourist }),
    301
);
---
