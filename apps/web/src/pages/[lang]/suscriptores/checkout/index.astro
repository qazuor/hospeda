---
/**
 * @file suscriptores/checkout/index.astro
 * @description Protected minimal checkout for starting a subscription, with the
 * legacy role-aware plans redirect retained when no valid option is supplied.
 * @route /{lang}/suscriptores/checkout/
 * @rendering SSR; private and uncacheable because the page resolves the session.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import { SignupCheckout } from '@/components/billing/SignupCheckout.client';
import { resolveSubscriptionPlansPath } from '@/lib/account-roles';
import { parseSessionUser, requestHasSessionCookie } from '@/lib/middleware-helpers';
import { buildLoginRedirect } from '@/lib/auth-redirect';
import { parseSignupOptionId } from '@/lib/billing/signup-checkout';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { billingSubscriptionApi } from '@/lib/api/endpoints-protected';
import {
    resolveSignupTrialNotice,
    resolveSignupTouristVipNotice,
    type SignupTouristVipNotice,
    type SignupTrialNotice
} from '@/lib/billing/signup-checkout';

export const prerender = false;

const locale = Astro.locals.locale;
const optionId = parseSignupOptionId({ search: Astro.url.search });
const cookieHeader = Astro.request.headers.get('cookie');
const hasSession = requestHasSessionCookie(cookieHeader);
const user = hasSession ? await parseSessionUser({ cookieHeader }) : null;
Astro.response.headers.set('Cache-Control', 'private, no-store');

if (!optionId) {
    return new Response(null, {
        status: 302,
        headers: {
            Location: buildUrl({ locale, path: resolveSubscriptionPlansPath({ roles: user?.roles ?? null }) }),
            'Cache-Control': 'private, no-store'
        }
    });
}

if (!user) {
    return new Response(null, {
        status: 302,
        headers: {
            Location: buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }),
            'Cache-Control': 'private, no-store'
        }
    });
}

const { t } = createTranslations(locale);
const title = t('billing.checkout.signup.title');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const plansHref = buildUrl({ locale, path: resolveSubscriptionPlansPath({ roles: user.roles }) });
let trialNotice: SignupTrialNotice | null;
let touristVipNotice: SignupTouristVipNotice | null;
try {
    const result = await billingSubscriptionApi.signupNotice({
        billingOptionId: optionId,
        cookieHeader: cookieHeader ?? undefined
    });
    trialNotice = resolveSignupTrialNotice({ result });
    touristVipNotice = resolveSignupTouristVipNotice({ result });
} catch {
    trialNotice = { kind: 'UNKNOWN' } as const;
    touristVipNotice = { kind: 'UNKNOWN' } as const;
}
---

<BaseLayout locale={locale} title={title} description={title}>
    <SEOHead slot="head" title={title} description={title} locale={locale} canonical={canonicalUrl} noindex={true} />
    <SignupCheckout
        client:load
        locale={locale}
        billingOptionId={optionId}
        accountEmail={user.email}
        plansHref={plansHref}
        trialNotice={trialNotice}
        touristVipNotice={touristVipNotice}
    />
</BaseLayout>
