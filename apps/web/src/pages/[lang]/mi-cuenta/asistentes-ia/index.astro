---
/**
 * @file mi-cuenta/asistentes-ia/index.astro
 * @description "Asistentes de IA" account section (HOS-2184 T-028): how to
 * connect an AI assistant to Hospeda over MCP and the list of connected ones.
 * @route /{lang}/mi-cuenta/asistentes-ia/
 * @rendering SSR
 *
 * The per-user list is fetched by the `AiAssistantsPanel` island in the
 * browser. The `AiAssistantsTabs` nav links to the assistant history
 * (`historial/`, HOS-2348). The only server-side input is the MCP URL, which is the same for
 * everyone (`null` while the feature is off).
 *
 * HOS-2562: only a real client (a person with a business vertical) may open
 * it. Anybody else gets the in-layout 404 (`no-encontrado`), indistinguishable
 * from a route that does not exist. Same rule as the API's OAuth gate.
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { AiAssistantsTabs } from '@/components/account/AiAssistantsTabs';
import { AiAssistantsPanel } from '@/components/account/AiAssistantsPanel.client';
import { getApiUrl } from '@/lib/env';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { getConfiguredMcpUrl } from '@/lib/mcp-discovery';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { buildAccountNotFoundTarget } from '@/lib/account-not-found';
import { canUseAiAssistants } from '@/lib/ai-assistants-access';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

if (!canUseAiAssistants({ user })) {
	return Astro.rewrite(buildAccountNotFoundTarget({ locale }));
}

const { t } = createTranslations(locale);
const title = t('account.aiAssistants.title', 'Asistentes de IA');
const description = t(
	'account.aiAssistants.description',
	'Conectá asistentes de IA a tu cuenta de Hospeda y administrá los que ya conectaste.',
);
const mcpUrl = await getConfiguredMcpUrl();
---

<AccountLayout locale={locale} title={title} description={description} activeSection="asistentes-ia">
	<PageHeader title={title} description={description} locale={locale}>
		<PageHelpLink slot="help" locale={locale} />
	</PageHeader>

	<AiAssistantsTabs locale={locale} current="assistants" />

	<AiAssistantsPanel client:load locale={locale} apiUrl={getApiUrl()} mcpUrl={mcpUrl} />
</AccountLayout>
