---
/**
 * @file mi-cuenta/favoritos/colecciones/[id].astro
 * @description Collection detail page on the account kit (HOS-2480). Reads
 * one bookmark collection with its paginated bookmarks and hands it to the
 * `CollectionDetailView` island (PageHeader with a back link, Edit/Delete,
 * type NavTabs, EntityCard grid, link Pagination).
 *
 * Filters and pagination are driven by URL search params:
 *   - `?entityType=ACCOMMODATION` — filter by entity type (omit for "All")
 *   - `?bookmarksPage=N`          — pagination (defaults to 1)
 *
 * @route /{lang}/mi-cuenta/favoritos/colecciones/{id}/
 * @rendering SSR
 */

import { getApiUrl } from '@/lib/env';
import AccountLayout from '@/layouts/AccountLayout.astro';
import {
	CollectionDetailView,
	type CollectionDetailRead
} from '@/components/account/favorites/CollectionDetailView.client';
import { userBookmarkCollectionsApi } from '@/lib/api/endpoints-protected';
import { parseCollectionEntityType } from '@/lib/collection-entity-types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { webLogger } from '@/lib/logger';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	const returnUrl = Astro.url.pathname;
	return Astro.redirect(
		buildUrl({ locale, path: `auth/signin` }) + `?returnUrl=${encodeURIComponent(returnUrl)}`
	);
}

const { id } = Astro.params;

if (!id) {
	return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta/favoritos' }));
}

// Only types in COLLECTION_ENTITY_TYPES are accepted (HOS-2423); anything
// else falls back to "All".
const activeEntityType = parseCollectionEntityType({
	value: Astro.url.searchParams.get('entityType')
});
const rawPage = Astro.url.searchParams.get('bookmarksPage');
const currentPage = rawPage && /^\d+$/.test(rawPage) ? Math.max(1, parseInt(rawPage, 10)) : 1;
const PAGE_SIZE = 12;

const { t } = createTranslations(locale);

// Forward the session cookie: without it the protected endpoint answers 401.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;

const result = await userBookmarkCollectionsApi.getById({
	id,
	bookmarksPage: currentPage,
	bookmarksPageSize: PAGE_SIZE,
	entityType: activeEntityType,
	cookieHeader
});

// 404 (missing), 400 (not a UUID) and 403 (someone else's collection) are not
// retryable and must not confirm that a foreign id exists: back to favorites.
// Only a 5xx or another unexpected failure reaches the island's ErrorState.
if (!result.ok) {
	const status = result.error.status;
	if (status === 404 || status === 400 || status === 403) {
		webLogger.warn('[coleccion-detail] collection unavailable, redirecting', { id, status });
		return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta/favoritos' }));
	}
	webLogger.error('[coleccion-detail] failed to fetch collection', result.error);
}

const collection = result.ok ? result.data : null;
const read: CollectionDetailRead = collection
	? {
			ok: true,
			collection: {
				id: collection.id,
				name: collection.name,
				description: collection.description ?? null,
				color: collection.color ?? null,
				icon: collection.icon ?? null
			},
			bookmarks: collection.bookmarks?.data ?? [],
			total: collection.bookmarks?.pagination.total ?? collection.bookmarkCount ?? 0,
			totalPages: collection.bookmarks?.pagination.totalPages ?? 0
		}
	: { ok: false };

const pageTitle = collection
	? `${t('account.favorites.collections.title')} · ${collection.name}`
	: t('account.favorites.collections.title');
---

<AccountLayout locale={locale} title={pageTitle} activeSection="favoritos">
	<CollectionDetailView
		client:load
		locale={locale}
		apiUrl={getApiUrl()}
		collectionId={id}
		read={read}
		activeEntityType={activeEntityType}
		currentPage={currentPage}
	/>
</AccountLayout>
