---
/**
 * @file mi-cuenta/favoritos/index.astro
 * @description Account favorites page with collection usage counter.
 * @route /{lang}/mi-cuenta/favoritos/
 * @rendering SSR
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import AccountSectionCard from '@/components/account/AccountSectionCard.astro';
import { UserFavoritesList } from '@/components/account/UserFavoritesList.client';
import { CreateCollectionCTA } from '@/components/account/CreateCollectionCTA.client';
import { CollectionUsageMeter } from '@/components/account/CollectionUsageMeter.client';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { getApiUrl } from '@/lib/env';
import { webLogger } from '@/lib/logger';
import type { BookmarkCollectionUsage } from '@/lib/api';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

const { t } = createTranslations(locale);
const title = t('account.pages.favorites.title', 'Favoritos');
const apiUrl = getApiUrl();

// ---------------------------------------------------------------------------
// Server-side fetch: collection usage counter.
// Non-blocking: on error we skip the counter rather than failing the page.
// Session cookie is forwarded to authenticate the request.
// ---------------------------------------------------------------------------

let collectionUsage: BookmarkCollectionUsage | null = null;

// True when the usage fetch below answered 403 `ENTITLEMENT_REQUIRED` — the
// actor's plan doesn't include collections at all. Kept separate from
// `collectionUsage === null` (which also covers "no cookie" / network error /
// any other failure) so the CTA can tell "we don't know" apart from "you
// don't have this feature" and disable itself with the right message
// (HOS-899) instead of leaving `isAtLimit` false, which left the button
// wrongly enabled for a gated actor.
let collectionsAccessDenied = false;

try {
	const cookieHeader = Astro.request.headers.get('cookie');

	if (cookieHeader) {
		const apiBase = getApiUrl();
		const response = await fetch(
			`${apiBase}/api/v1/protected/user-bookmark-collections?page=1&pageSize=1`,
			{
				headers: {
					cookie: cookieHeader,
					Accept: 'application/json'
				}
			}
		);

		if (response.ok) {
			const body = (await response.json()) as {
				data?: { usage?: BookmarkCollectionUsage };
			};
			collectionUsage = body.data?.usage ?? null;
		} else if (response.status === 403) {
			try {
				const errorBody = (await response.json()) as {
					error?: { code?: string | null };
				};
				if (errorBody.error?.code === 'ENTITLEMENT_REQUIRED') {
					collectionsAccessDenied = true;
				} else {
					webLogger.warn(
						'[favoritos] collections usage fetch returned status',
						response.status
					);
				}
			} catch {
				webLogger.warn('[favoritos] collections usage fetch returned status', response.status);
			}
		} else {
			webLogger.warn('[favoritos] collections usage fetch returned status', response.status);
		}
	}
} catch (err) {
	webLogger.error('[favoritos] failed to fetch collection usage', err);
}

const isAtLimit =
	collectionUsage !== null && collectionUsage.current >= collectionUsage.max;

// Note: `isAtLimit` intentionally does NOT fold `collectionsAccessDenied` in —
// they're distinct facts (see the comment on `collectionsAccessDenied` above)
// and are passed to `CreateCollectionCTA` as separate props so it can render
// the right message for each.

// The "X / max" counter + progress bar used to be rendered inline here.
// HOS-999 moved it to the CollectionUsageMeter island so it can react to a
// `hospeda:collection-created` broadcast (see collection-created-event.ts)
// without a full page reload — `collectionUsage` below is passed as its
// SSR-seeded `initial` prop (SSR-first principle, apps/web/CLAUDE.md).
---

<AccountLayout locale={locale} title={title} activeSection="favoritos">
	<AccountSectionCard>
		<div class="favoritos-header">
			<div class="favoritos-header__title">
				<AccountPageHeader title={title} />
			</div>

			<CollectionUsageMeter
				client:load
				locale={locale}
				initial={collectionUsage}
			/>

			<CreateCollectionCTA
				client:load
				locale={locale}
				isAtLimit={isAtLimit}
				maxCollections={collectionUsage?.max ?? 0}
				accessDenied={collectionsAccessDenied}
			/>
		</div>

		<UserFavoritesList client:load locale={locale} apiUrl={apiUrl} />
	</AccountSectionCard>
</AccountLayout>

<style>
	.favoritos-header {
		display: flex;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.favoritos-header__title {
		flex: 1 1 auto;
	}

	/* Collection usage counter styling now lives in
	   CollectionUsageMeter.module.css — the markup moved to that island
	   (HOS-999) and Astro's scoped CSS only reaches markup literally in this
	   file, not a React island's rendered output. */

	@media (max-width: 480px) {
		.favoritos-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
