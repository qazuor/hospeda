---
/**
 * @file mi-cuenta/favoritos/index.astro
 * @description Account favorites page on the account kit (HOS-2480): the
 * `FavoritesView` island renders the `PageHeader`, the «Sin colección» and
 * «Mis colecciones» Sections and the collections gate.
 *
 * The page reads two things on the server, as it already did: the catalog
 * plans that carry collections (HOS-2544, the catalog reader is server-only)
 * and the collections usage with the session cookie, which seeds the gate so
 * «Crear colección» never flashes enabled for a user without the plan. A
 * failed usage read is «unknown» (null), never a fake cap.
 *
 * @route /{lang}/mi-cuenta/favoritos/
 * @rendering SSR
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { FavoritesView } from '@/components/account/favorites/FavoritesView.client';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { getApiUrl } from '@/lib/env';
import { EntitlementKeyEnum } from '@repo/schemas';
import { fetchPublicPlans, planNamesWithEntitlement } from '@/lib/billing/fetch-plans';
import { webLogger } from '@/lib/logger';
import type { BookmarkCollectionUsage } from '@/lib/api';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const { t } = createTranslations(locale);
const title = t('account.pages.favorites.title');
const apiUrl = getApiUrl();

// HOS-2544: the collections gate names the catalog plans that carry collections.
const gatePlanNames = planNamesWithEntitlement({
	result: await fetchPublicPlans({ vertical: 'tourist' }),
	entitlement: EntitlementKeyEnum.CAN_USE_COLLECTIONS
});

// Collections usage, read with the session cookie. Non-blocking: any failure
// leaves the usage unknown (null) and the island re-reads it.
let collectionUsage: BookmarkCollectionUsage | null = null;

// True when the read answered 403 `ENTITLEMENT_REQUIRED`: the plan has no
// collections at all (HOS-899), a different fact from «unknown».
let collectionsAccessDenied = false;

try {
	const cookieHeader = Astro.request.headers.get('cookie');
	if (cookieHeader) {
		const response = await fetch(
			`${apiUrl}/api/v1/protected/user-bookmark-collections?page=1&pageSize=1`,
			{ headers: { cookie: cookieHeader, Accept: 'application/json' } }
		);
		if (response.ok) {
			const body = (await response.json()) as { data?: { usage?: BookmarkCollectionUsage } };
			collectionUsage = body.data?.usage ?? null;
		} else if (response.status === 403) {
			try {
				const errorBody = (await response.json()) as { error?: { code?: string | null } };
				collectionsAccessDenied = errorBody.error?.code === 'ENTITLEMENT_REQUIRED';
			} catch {
				webLogger.warn('[favoritos] collections usage fetch returned status', response.status);
			}
		} else {
			webLogger.warn('[favoritos] collections usage fetch returned status', response.status);
		}
	}
} catch (err) {
	webLogger.error('[favoritos] failed to fetch collection usage', err);
}
---

<AccountLayout locale={locale} title={title} activeSection="favoritos">
	<FavoritesView
		client:load
		locale={locale}
		apiUrl={apiUrl}
		gatePlanNames={gatePlanNames}
		initialUsage={collectionUsage}
		initialAccessDenied={collectionsAccessDenied}
	/>
</AccountLayout>
