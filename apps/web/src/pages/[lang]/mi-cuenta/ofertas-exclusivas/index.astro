---
/**
 * @file mi-cuenta/ofertas-exclusivas/index.astro
 * @description Permanent redirect to the public `/{lang}/promociones/` page
 * (HOS-2589 D-2, AC-32). The exclusive-deals list is gone: every tourist now sees
 * promotions there under the free / VIP model. The locale and the query string are
 * preserved.
 *
 * @route     /[lang]/mi-cuenta/ofertas-exclusivas/
 * @rendering SSR (prerender = false) — emits a 301 and no body.
 */
import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(
    buildPricingRedirectTarget({ locale, path: 'promociones', search: Astro.url.search }),
    301
);
---
