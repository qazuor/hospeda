---
/**
 * @file mi-cuenta/publicaciones/index.astro
 * @description Editor own-content listing on the account kit (HOS-2505): every
 * post authored by the user, in every moderation and lifecycle state, through
 * the shared `MyContentList` template (`OwnContentListView`). Structural twin
 * of `mi-cuenta/eventos`.
 *
 * Auth: middleware AND this page check for a session.
 *
 * Gate: only users whose role grants `POST_CREATE` (see `hasPostsNavAccess`
 * in `@/lib/nav-gating`) manage posts. Anyone else sees a `LockedState`
 * (`reason.kind = 'permission'`) with the editor application link, like
 * events (spec HOS-2416 §8, D9 «sin acceso único»). It used to redirect
 * silently to `/mi-cuenta`; it never does now, and the list is not even
 * requested.
 *
 * Data: `postEditApi.listOwn` (`lib/api/`) forwards the session cookie to
 * `GET /api/v1/protected/posts`; authorship comes from the session, never
 * from a query filter. Paginated with `?page=N` (HOS-2440): no silent cap.
 *
 * @route    /[lang]/mi-cuenta/publicaciones/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import {
    ACCOUNT_LIST_PAGE_SIZE,
    buildAccountPageHref,
    parsePageParam,
    resolveAccountPageState
} from '@/lib/account-pagination';
import { hasPostsNavAccess } from '@/lib/nav-gating';
import { webLogger as logger } from '@/lib/logger';
import { postEditApi } from '@/lib/api/endpoints-protected';
import { transformPostEditCardList } from '@/lib/api/transforms';
import type { PostEditListItem } from '@/lib/api/types';
import AccountLayout from '@/layouts/AccountLayout.astro';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import {
    OwnContentListView,
    type OwnContentListStatus
} from '@/components/account/my-content/OwnContentListView';
import { ContentListReloadError } from '@/components/account/my-content/ContentListReloadError.client';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// Gate: only editor-tier roles see their own-content dashboard.
const canManagePosts = hasPostsNavAccess({ roles: user.roles });

let posts: readonly PostEditListItem[] = [];
let fetchError = false;

// HOS-2440: paginated (`?page=N`) instead of silently cut at 50.
const requestedPage = parsePageParam({ value: Astro.url.searchParams.get('page') });
let totalItems: number | null = null;

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;

const result = canManagePosts
    ? await postEditApi.listOwn({
          cookieHeader,
          page: requestedPage,
          pageSize: ACCOUNT_LIST_PAGE_SIZE,
          sortBy: 'createdAt',
          sortOrder: 'desc'
      })
    : null;

if (result) {
    if (result.ok) {
        posts = transformPostEditCardList({ items: result.data.items });
        totalItems = result.data.pagination?.total ?? null;
    } else {
        fetchError = true;
        logger.error('[mi-cuenta/publicaciones] Failed to fetch own posts', result.error.message);
    }
}

const { t } = createTranslations(locale);
const title = t('account.myContent.posts.list.title');
const subtitle = t('account.myContent.posts.list.subtitle');

const pageState = resolveAccountPageState({ requestedPage, total: totalItems });
if (!fetchError && pageState.isPastEnd) {
    // A stale `?page=` past the end must not read as "you have none".
    return Astro.redirect(
        buildAccountPageHref({ locale, path: 'mi-cuenta/publicaciones', page: pageState.totalPages })
    );
}

const status: OwnContentListStatus = !canManagePosts
    ? 'locked'
    : fetchError
      ? 'error'
      : posts.length === 0
        ? 'empty'
        : 'ready';

const items = posts.map((post) => ({
    id: post.id,
    title: post.title,
    moderationState: post.moderationState,
    visibility: post.visibility,
    lifecycleState: post.lifecycleState
}));
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="publicaciones">
    <OwnContentListView
        locale={locale}
        kind="posts"
        status={status}
        items={items}
        page={pageState.page}
        pageCount={pageState.totalPages}
    >
        <PageHelpLink slot="help" locale={locale} />
        {status === 'error' && <ContentListReloadError slot="errorRegion" client:visible locale={locale} />}
    </OwnContentListView>
</AccountLayout>
