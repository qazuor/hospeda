---
/**
 * @file mi-cuenta/publicaciones/nuevo.astro
 * @description Editor self-service post create page (HOS-374 §5.2.2). Mounts
 * `PostCreateForm`, which collects the minimum required fields and redirects
 * to the real editor (`[id]/editar.astro`) on success.
 *
 * Two gates, matching this route's siblings (`index.astro`, `[id]/editar.astro`):
 *  1. Session — middleware AND this page, matching the `/mi-cuenta` convention.
 *  2. Role — `hasPostsNavAccess` (POST_CREATE), the same gate the listing and
 *     the editor already use. Without it the page shows a `LockedState`
 *     (`kind: 'permission'`) instead of redirecting (HOS-2505, D9).
 *
 * @route     /[lang]/mi-cuenta/publicaciones/nuevo/
 * @rendering SSR (prerender = false — authenticated, editor-only)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { LockedState, PageHeader } from '@/components/account/ui';
import { PostCreateForm } from '@/components/post/editor/PostCreateForm.client';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildAccountBreadcrumbs } from '@/lib/account/account-breadcrumbs';
import { getAccountSectionLabel } from '@/lib/account-nav-model';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { hasPostsNavAccess } from '@/lib/nav-gating';
import { buildUrl } from '@/lib/urls';

import { guardPublisherArea } from '@/lib/account/publisher-access';

export const prerender = false;
const denied = guardPublisherArea({ astro: Astro, area: 'postCreate' });
if (denied) return denied;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const canCreatePosts = hasPostsNavAccess({ permissions: user.permissions });

const title = t('account.myContent.posts.create.pageTitle', 'Nueva publicación');
const subtitle = t(
    'account.myContent.posts.create.subtitle',
    'Completá lo básico ahora — vas a poder sumar fotos y más detalles después en el editor.'
);
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="publicaciones">
    <PageHeader
        title={title}
        description={subtitle}
        locale={locale}
        breadcrumbs={buildAccountBreadcrumbs({
            t,
            parents: [{ label: getAccountSectionLabel({ t, section: 'publicaciones' }), path: 'mi-cuenta/publicaciones' }],
            current: title
        })}
    >
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    {canCreatePosts ? (
            <PostCreateForm
                client:load
                locale={locale}
            />
    ) : (
        <LockedState
            locale={locale}
            reason={{
                kind: 'permission',
                feature: t('account.myContent.contentList.posts.locked.feature'),
                description: t('account.myContent.contentList.posts.locked.description'),
                helpHref: buildUrl({ locale, path: 'colaborar/editores' })
            }}
        />
    )}
</AccountLayout>
