---
/**
 * @file mi-cuenta/aliados/index.astro
 * @description "Sumate como aliado" discovery-door hub page (HOS-131 §6.2,
 * expanded HOS-134 §5.3, HOS-278). Lists the four B2B alliance roles, all
 * backed by a real qualified lead-capture landing since HOS-277: `sponsor`
 * and `partner` stay lead-only forever (an admin evaluates and provisions
 * manually — no self-service "acquired" state exists for them);
 * `serviceProvider` becomes a real, self-service-editable `host_trades`
 * directory listing once an admin approves the lead (HOS-278) — this page
 * fetches `GET /host-trades/mine` and, when a row comes back, force-acquires
 * that door option (`resolveDoorOptionState`'s `acquiredOptionIds` override,
 * `src/lib/nav-gating.ts`) so it shows "Gestionar" → `/mi-cuenta/proveedor`
 * instead of the acquire CTA; `editor` resolves `acquired` once the user
 * holds `POST_CREATE`/`EVENT_CREATE`, linking the relevant own-content
 * listing.
 *
 * @route     /[lang]/mi-cuenta/aliados/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import { ACCOUNT_DISCOVERY_DOORS } from '@/config/discovery-doors';
import AllianceApplicationsSection from '@/components/account/AllianceApplicationsSection.astro';
import { AllianceClaimBanner } from '@/components/account/AllianceClaimBanner.client';
import DiscoveryDoorHub from '@/components/account/DiscoveryDoorHub.astro';
import { allianceLeadsApi, hostTradesApi } from '@/lib/api/endpoints-protected';
import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { getAdminUrl } from '@/lib/env';
import { isVisibleByRoles, resolveDoorLabelKey } from '@/lib/nav-gating';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;

// Auth guard: middleware protects /mi-cuenta/* automatically, safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

const door = ACCOUNT_DISCOVERY_DOORS.find((candidate) => candidate.id === 'partner');
if (!door) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}

const { t } = createTranslations(locale);
const labelKey = resolveDoorLabelKey({
    door,
    visibility: (node) => isVisibleByRoles(node, user.roles)
});
const title = t(labelKey);
const description = t(door.subtitleI18nKey);

// HOS-278 AC-14 — the page now answers "and then what happened?" as well as
// "what can I apply for?".
//
// Degrades to an empty list on ANY failure rather than erroring the page: the
// applications panel is an addition to a discovery hub that stood on its own
// for two specs, and a 500 on the API must not take the hub down with it. The
// section renders nothing at all when the list is empty, so the fallback is
// simply the page as it was.
// The second fetch resolves the `serviceProvider` door option's "acquired"
// signal (HOS-278 §8) and degrades to null on ANY failure for the same reason:
// a 500 there just means the option falls back to its unacquired CTA for this
// render.
//
// Both run in parallel — neither depends on the other, and this is an
// uncacheable actor-scoped SSR page, so chaining them would add a full API
// round-trip to its TTFB for nothing.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const [myLeadsResult, myTradeResult] = await Promise.all([
    allianceLeadsApi.mine({ cookieHeader }),
    hostTradesApi.mine({ cookieHeader })
]);
const myLeads = myLeadsResult.ok ? myLeadsResult.data.leads : [];
const myTrade = myTradeResult.ok ? myTradeResult.data.trade : null;

// HOS-278 AC-4 — this is where the claim invitation email lands.
//
// Only a boolean crosses into the island. The token stays in the address bar
// for the island to read and then strip: serializing it as a prop would print
// a single-use secret into the document, where a screenshot or a copied page
// source outlives the click it was meant for.
const hasPendingClaim =
    Astro.url.searchParams.has('claim') && Astro.url.searchParams.has('lead');
---

<AccountLayout locale={locale} title={title} description={description} activeSection="aliados">
    <AccountPageHeader title={title} />
    {hasPendingClaim && <AllianceClaimBanner client:load locale={locale} />}
    <AllianceApplicationsSection locale={locale} leads={myLeads} />
    <DiscoveryDoorHub
        locale={locale}
        door={door}
        roles={user.roles}
        adminUrl={getAdminUrl()}
        acquiredOptionIds={myTrade ? ['serviceProvider'] : []}
    />
</AccountLayout>
