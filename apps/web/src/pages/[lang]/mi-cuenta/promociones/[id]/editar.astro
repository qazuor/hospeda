---
/**
 * @file mi-cuenta/promociones/[id]/editar.astro
 * @description Edit an owner promotion, on the account kit editor template
 * (HOS-2505): kit `PageHeader` with a back link, then the `PromotionForm`
 * island in edit mode (kit field Sections + `StickySaveBar`).
 *
 * The island reads the record client-side (`ownerPromotionApi.getById`) and
 * shows a Skeleton meanwhile: the form needs no other catalog that would
 * justify an SSR fetch. The page reads only the catalog plan names for the
 * exclusive-deals audience hint (HOS-2544; the catalog reader is server-only).
 *
 * @route    /[lang]/mi-cuenta/promociones/[id]/editar
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import AccountLayout from '@/layouts/AccountLayout.astro';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { PageHeader } from '@/components/account/ui';
import { PromotionForm } from '@/components/host/PromotionForm.client';
import { EntitlementKeyEnum } from '@repo/schemas';
import { fetchPublicPlans, planNamesWithEntitlement } from '@/lib/billing/fetch-plans';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const title = t('host.promotions.actions.edit');
const description = t('host.promotions.pageDescription');
const listUrl = buildUrl({ locale, path: 'mi-cuenta/promociones' });

// HOS-2544: the audience hint names the catalog plans that carry exclusive deals.
const audiencePlanNames = planNamesWithEntitlement({
    result: await fetchPublicPlans({ vertical: 'tourist' }),
    entitlement: EntitlementKeyEnum.EXCLUSIVE_DEALS
});

// Auth guard: middleware protects /mi-cuenta/* automatically, safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// Extract promotion ID from route params.
const promotionId = Astro.params.id;
if (!promotionId) {
    return Astro.redirect(listUrl);
}
---

<AccountLayout locale={locale} title={title} description={description} activeSection="promociones">
    <PageHeader
        title={title}
        description={description}
        locale={locale}
        back={{ label: t('host.promotions.kit.backToList'), href: listUrl }}
    >
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    <PromotionForm
        client:load
        locale={locale}
        mode="edit"
        promotionId={promotionId}
        audiencePlanNames={audiencePlanNames}
    />
</AccountLayout>
