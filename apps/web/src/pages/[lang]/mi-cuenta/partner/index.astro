---
/**
 * @file mi-cuenta/partner/index.astro
 * @description Partner self-service page for the owner's own `partners`
 * listing (HOS-278 D3, §8). Reached from the "Sumate como aliado" hub
 * (`mi-cuenta/aliados`) once `partner` resolves to `'acquired'` — see
 * `resolveDoorOptionState`'s `acquiredOptionIds` override in
 * `src/lib/nav-gating.ts` for how that state is derived from this same
 * `GET /partners/mine` fetch.
 *
 * Auth-only (no permission gate, HOS-278 AC-7): an approved partner is an
 * ordinary account, so ownership of the row — not a role or permission — is
 * what lets someone reach this page's content.
 *
 * Owner-only presence notice plus four renders, mirroring the provider ficha:
 * - fetch failed   -> friendly error state (never a crash).
 * - `partner: null`-> empty state ("you haven't applied / been approved yet"),
 *   linking back to the aliados hub. NOT an error, NOT a 404.
 * - `revokedAt` set -> prominent "taken down" state + the admin's
 *   `revokeReason` when present. No edit form is offered (the API would still
 *   accept a PATCH — this is a UX choice, not a hard block), matching the
 *   provider ficha.
 * - otherwise      -> a status banner reflecting §8's four partner states,
 *   plus the `PartnerEditForm` edit island.
 *
 * The status banner is the visible half of AC-11: it says "load your data",
 * "under review" or "your content is approved", and the approved copy switches
 * ONLY once `contentApprovedAt` is set — the same column the API gate reads,
 * so the page and the endpoint can never disagree about whether payment is
 * open.
 *
 * HOS-862: Partner payment uses a manual subscription created by administrative
 * action 6; the partner pays by bank transfer. The page shows any open installment.
 *
 * HOS-2477 made this page the partner's dashboard on the account kit: a
 * PageHeader with the listing's StatusPill, the state banner as a «próxima
 * acción» Alert, the numbers `mineStats` computes (PartnerStatsGrid island) and
 * the edit form, whose own Sections (identity, logo and texts, contact, social) are
 * flat siblings on the page — the form is NOT wrapped in another Section (HOS-2506).
 * Test ids and copy the e2e suite reads are kept.
 *
 * @route     /[lang]/mi-cuenta/partner/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { Alert, PageHeader, Section, StatusPill, type StatusTone } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { PartnerEditForm } from '@/components/account/PartnerEditForm.client';
import { PartnerStatsGrid } from '@/components/account/dashboard/PartnerStatsGrid.client';
import styles from '@/components/account/dashboard/Dashboard.module.css';
import { billingSubscriptionApi, partnersApi } from '@/lib/api/endpoints-protected';
import {
    hasActivePartnerSubscription as resolveHasActivePartnerSubscription,
    resolveManualInstallmentView
} from '@/lib/billing/manual-installment';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// Auth guard: middleware protects /mi-cuenta/* automatically, safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const title = t('account.partner.pageTitle', 'Mi ficha de aliado');
const subtitle = t('account.partner.pageSubtitle', 'Gestioná tu presencia como aliado de Hospeda');

const partnerResult = await partnersApi.mine({
    cookieHeader: Astro.request.headers.get('cookie') ?? undefined
});

const fetchFailed = !partnerResult.ok;
const partner = partnerResult.ok ? partnerResult.data.partner : null;
const presence = partnerResult.ok ? partnerResult.data.presence ?? null : null;

// `!= null` (not `!== null`) on purpose, and it is load-bearing twice over:
// `contentApprovedAt` is `z.coerce.date().nullish()` on the owner view, so an
// absent value can arrive as `undefined` — a key dropped by JSON serialization
// — not just `null`. A `!== null` test would read that `undefined` as
// "approved" and offer to charge a partner nobody reviewed, which is AC-11
// failing open. Same reason the provider page tests `revokedAt` this way.
const isContentApproved = partner !== null && partner.contentApprovedAt != null;
const showPresenceNotice = presence !== null && (presence.moderated || (isContentApproved && presence.publicPage === 'hidden' && presence.carousel === 'hidden'));
// Same `!= null` reasoning, and it pre-empts every other state below: a
// revoked partner is not "waiting for review" or "ready to pay", and offering
// either would contradict the email they just received.
const isRevoked = partner !== null && partner.revokedAt != null;
const hasSubmitted = partner !== null && partner.contentReviewState != null;
const isUnderReview = partner !== null && partner.contentReviewState === 'pending';
let hasActivePartnerSubscription = false;
try {
    hasActivePartnerSubscription = resolveHasActivePartnerSubscription(
        await billingSubscriptionApi.listMine({
            cookieHeader: Astro.request.headers.get('cookie') ?? undefined
        })
    );
} catch {
    hasActivePartnerSubscription = false;
}
// The header pill and the «próxima acción» tone follow the same state ladder
// as the banner below (revoked first, then approved, review, rejected, draft).
type ListingState = 'revoked' | 'active' | 'approved' | 'underReview' | 'rejected' | 'draft';
const listingState: ListingState = isRevoked
    ? 'revoked'
    : isContentApproved
      ? hasActivePartnerSubscription
          ? 'active'
          : 'approved'
      : isUnderReview
        ? 'underReview'
        : hasSubmitted
          ? 'rejected'
          : 'draft';
const STATE_TONE: Record<ListingState, StatusTone> = {
    revoked: 'danger',
    active: 'success',
    approved: 'info',
    underReview: 'warning',
    rejected: 'danger',
    draft: 'neutral'
};
const ALERT_TONE: Record<ListingState, 'info' | 'success' | 'warning' | 'danger'> = {
    revoked: 'danger',
    active: 'success',
    approved: 'info',
    underReview: 'info',
    rejected: 'warning',
    draft: 'info'
};
let installmentView = null;
try {
    installmentView = resolveManualInstallmentView({
        result: await billingSubscriptionApi.listManualInstallments({
            cookieHeader: Astro.request.headers.get('cookie') ?? undefined
        }),
        vertical: 'partner',
        locale,
        t
    });
} catch {
    installmentView = null;
}
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="partner" template="dashboard">
  <div class={styles.page}>
    <PageHeader locale={locale} title={title} description={subtitle} helpId="section:partner.dashboard">
        <PageHelpLink slot="help" locale={locale} />
        {partner !== null && (
            <StatusPill slot="status" tone={STATE_TONE[listingState]}>{t(`account.partner.statusPill.${listingState}`)}</StatusPill>
        )}
    </PageHeader>

    {showPresenceNotice && presence !== null && (
        <div data-testid="partner-presence-notice">
        <Section title={t('account.partner.presence.title')} helpId="section:partner.presence">
            <p>{t('account.partner.presence.notDeleted', 'No se borró nada: tu ficha y tus datos siguen guardados.')}</p>
            <p>{t('account.partner.presence.hidden', 'Mientras tanto, para el público tu página responde como si no existiera.')}</p>
            <p>{t('account.partner.presence.returnsAlone', 'Tu presencia vuelve sola cuando recuperes el plan que la otorga.')}</p>
            {presence.moderated && (
                <div data-testid="partner-presence-moderated" role="alert">
                    <p>{t('account.partner.presence.moderated', 'Un administrador moderó tu presencia. Aunque tengas el plan, no se verá hasta que se levante la moderación.')}</p>
                    {presence.moderationReason !== null && <p data-testid="partner-presence-moderation-reason">{presence.moderationReason}</p>}
                </div>
            )}
        </Section>
        </div>
    )}

    {
        fetchFailed ? (
            <Alert locale={locale} tone="danger">
                <p>
                    {t(
                        'account.partner.errors.fetchFailed',
                        'No pudimos cargar tu ficha de aliado. Recargá la página para reintentar.'
                    )}
                </p>
            </Alert>
        ) : partner === null ? (
            <Section title={t('account.partner.empty.title')} helpId="section:partner.empty">
                <p>
                    {t(
                        'account.partner.empty.text',
                        'Todavía no tenés una ficha de aliado. Postulate desde "Sumate como aliado" y, una vez aprobada tu solicitud, tu ficha va a aparecer acá.'
                    )}
                </p>
                <a href={buildUrl({ locale, path: 'sumate/partner' })}>
                    {t('account.partner.empty.cta', 'Ir a Sumate como aliado')}
                </a>
            </Section>
        ) : (
            <>
                <Alert locale={locale} tone={ALERT_TONE[listingState]} title={t('account.partner.nextAction.title')} helpId="section:partner.next-action">
                    {
                        isRevoked ? (
                            <>
                                <p role="alert">
                                    {t(
                                        'account.partner.status.revoked',
                                        'Tu ficha de aliado fue dada de baja y ya no se ve en el sitio.'
                                    )}
                                </p>
                                {partner.revokeReason && <p>{partner.revokeReason}</p>}
                                <p>
                                    {t(
                                        'account.partner.status.revokedContact',
                                        'Si querés más información, escribinos y te contamos los detalles.'
                                    )}
                                </p>
                            </>
                        ) : isContentApproved ? (
                            hasActivePartnerSubscription ? (
                                <p>
                                    {t(
                                        'account.partner.status.activeSubscription',
                                        'Tu suscripción de Partner está activa y al día.'
                                    )}
                                </p>
                            ) : (
                                <p>
                                    {t(
                                        'account.partner.status.approved',
                                        'Tu contenido está aprobado. El equipo de Hospeda arma tu suscripción y te escribe para coordinar el pago por transferencia.'
                                    )}
                                </p>
                            )
                        ) : isUnderReview ? (
                            <p>
                                {t(
                                    'account.partner.status.underReview',
                                    'Estamos revisando tu logo y tus textos. Te avisamos apenas terminemos; todavía no hay nada que pagar.'
                                )}
                            </p>
                        ) : hasSubmitted ? (
                            <p role="alert">
                                {t(
                                    'account.partner.status.rejected',
                                    'Revisamos tus datos y necesitamos que corrijas algo antes de seguir. El detalle está abajo, junto al formulario.'
                                )}
                            </p>
                        ) : (
                            <p>
                                {t(
                                    'account.partner.status.empty',
                                    'Tu postulación fue aprobada. Completá tu logo y tus textos para que un admin los revise. Todavía no estás publicado.'
                                )}
                            </p>
                        )
                    }
                </Alert>

                {!isRevoked && isContentApproved && <PartnerStatsGrid client:visible locale={locale} />}

                {!isRevoked && installmentView && (
                    <div data-testid="partner-installment">
                    <Section
                        title={t('account.partner.installment.title', 'Tu cuota a pagar')}
                        helpId="section:partner.installment"
                    >
                        <p>{installmentView.planLine}</p>
                        <p data-testid="partner-installment-amount">{installmentView.amountLine}</p>
                        <p data-testid="partner-installment-due">{installmentView.dueLine}</p>
                        <p>{t('account.partner.installment.howToPay', 'Se paga por transferencia bancaria. El equipo de Hospeda te manda por correo los datos para transferir. Cuando registremos el pago, tu suscripción queda al día.')}</p>
                    </Section>
                    </div>
                )}

                {!isRevoked && <PartnerEditForm locale={locale} partner={partner} client:load />}
            </>
        )
    }
  </div>
</AccountLayout>
