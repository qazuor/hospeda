---
/**
 * @file mi-cuenta/proveedor/index.astro
 * @description Provider self-service page for the owner's own `host_trades`
 * directory listing (HOS-278 §8). Reached from the "Sumate como aliado" hub
 * (`mi-cuenta/aliados`) once `serviceProvider` resolves to `'acquired'` — see
 * `resolveDoorOptionState`'s `acquiredOptionIds` override in
 * `src/lib/nav-gating.ts` for how that state is derived from this same
 * `GET /host-trades/mine` fetch.
 *
 * Auth-only (no permission gate, HOS-278 AC-7): an approved provider is an
 * ordinary tourist account, so ownership of the row — not a role or
 * permission — is what lets someone reach this page's content.
 *
 * Four renders:
 * - fetch failed  -> friendly error state (never a crash).
 * - `trade: null` -> empty state ("you haven't applied / been approved yet"),
 *   linking back to the aliados hub. NOT an error, NOT a 404.
 * - `trade.revokedAt` set -> prominent "listing taken down" state + the
 *   admin's `revokeReason` when present. No edit form is offered (the API
 *   would still accept a PATCH — this is a UX choice, not a hard block).
 * - otherwise -> header + the `HostTradeEditForm` edit island.
 *
 * @route     /[lang]/mi-cuenta/proveedor/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import AccountSectionCard from '@/components/account/AccountSectionCard.astro';
import { HostTradeEditForm } from '@/components/account/HostTradeEditForm.client';
import { ProviderQrPanel } from '@/components/host/host-trades/ProviderQrPanel.client';
import { ProviderReviewsPanel } from '@/components/host/host-trades/ProviderReviewsPanel.client';
import { ProviderUsagesPanel } from '@/components/host/host-trades/ProviderUsagesPanel.client';
import { hostTradesApi } from '@/lib/api/endpoints-protected';
import type { BenefitUsage, LinkedHost, OwnerReviewRow } from '@/lib/api/endpoints-protected';
import { PROVIDER_TABS, resolveProviderTab } from '@/lib/host/provider-tabs';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { webLogger as logger } from '@/lib/logger';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// Auth guard: middleware protects /mi-cuenta/* automatically, safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

const title = t('account.provider.pageTitle', 'Mi ficha de proveedor');
const subtitle = t('account.provider.pageSubtitle', 'Gestioná tu ficha en el directorio de proveedores');

const tradeResult = await hostTradesApi.mine({
    cookieHeader: Astro.request.headers.get('cookie') ?? undefined
});

const fetchFailed = !tradeResult.ok;
const trade = tradeResult.ok ? tradeResult.data.trade : null;
// `!= null` (not `!== null`) on purpose: `revokedAt` is `z.coerce.date().nullish()`
// on `HostTradeSchema`, so an absent value can arrive as `undefined` — a key
// dropped by JSON serialization — not just `null`. A `!== null` test would read
// that `undefined` as "revoked" and hide the edit form from every healthy
// provider. Same reason `revokeReason` is rendered by truthiness below.
const isRevoked = trade !== null && trade.revokedAt != null;

// ---------------------------------------------------------------------------
// Tabs (HOS-376 T-050)
//
// The active tab comes from the URL, so only its island is rendered and only
// its data is fetched. See `provider-tabs.ts` for why that beats client-side
// tabs here.
// ---------------------------------------------------------------------------

const activeTab = resolveProviderTab(Astro.url.searchParams.get('tab'));
const canShowTabs = trade !== null && !isRevoked && !fetchFailed;

const TAB_FALLBACK: Record<string, string> = {
    ficha: 'Mi ficha',
    usos: 'Usos',
    valoraciones: 'Valoraciones',
    qr: 'Mi QR'
};

const tabs = PROVIDER_TABS.map((tab) => ({
    id: tab,
    label: t(`account.provider.tabs.${tab}`, TAB_FALLBACK[tab] ?? tab),
    href: `${buildUrl({ locale, path: 'mi-cuenta/proveedor' })}${tab === 'ficha' ? '' : `?tab=${tab}`}`
}));

// Today in the market's timezone. The Node server runs UTC, so an ISO slice
// would hand an evening declaration tomorrow's date and then refuse it.
const MARKET_TIMEZONE = 'America/Argentina/Buenos_Aires';
const today = new Intl.DateTimeFormat('en-CA', {
    timeZone: MARKET_TIMEZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
}).format(new Date());

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;

let usages: readonly BenefitUsage[] = [];
let usagesTotal = 0;
let pendingUsages: readonly BenefitUsage[] = [];
let linkedHosts: readonly LinkedHost[] = [];
let reviews: readonly OwnerReviewRow[] = [];
let reviewsTotal = 0;
let qr: { svg: string; url: string; slug: string } | null = null;
let panelFailed = false;

if (canShowTabs && activeTab === 'usos') {
    // The inbox is a SEPARATE read, narrowed by the API to PENDING rows the HOST
    // declared — the ones whose counterpart is this provider (H-06/H-65/H-159).
    // Slicing the record page client-side instead would report an empty inbox
    // whenever the first page happens to hold the provider's own declarations.
    const [usagesResult, pendingResult, hostsResult] = await Promise.all([
        hostTradesApi.listOwnUsages({ page: 1, pageSize: 20, cookieHeader }),
        hostTradesApi.listOwnUsages({
            status: 'PENDING',
            declaredBy: 'HOST',
            page: 1,
            pageSize: 20,
            cookieHeader
        }),
        hostTradesApi.listLinkedHosts({ cookieHeader })
    ]);

    if (usagesResult.ok) {
        usages = usagesResult.data.items;
        usagesTotal = usagesResult.data.pagination.total;
    } else {
        panelFailed = true;
        logger.error('[proveedor] Could not load own usages', `status=${usagesResult.error.status}`);
    }
    if (pendingResult.ok) {
        pendingUsages = pendingResult.data.items;
    } else {
        panelFailed = true;
        logger.error(
            '[proveedor] Could not load the pending inbox',
            `status=${pendingResult.error.status}`
        );
    }
    // A failed selector is NOT a failed panel: the email channel still works,
    // and blocking the whole tab over it would take away the fallback exactly
    // when the primary path is broken.
    if (hostsResult.ok) linkedHosts = hostsResult.data.hosts;
}

if (canShowTabs && activeTab === 'valoraciones') {
    const result = await hostTradesApi.listOwnReviews({ page: 1, pageSize: 20, cookieHeader });
    if (result.ok) {
        reviews = result.data.items;
        reviewsTotal = result.data.pagination.total;
    } else {
        panelFailed = true;
        logger.error('[proveedor] Could not load own reviews', `status=${result.error.status}`);
    }
}

if (canShowTabs && activeTab === 'qr') {
    const result = await hostTradesApi.getMyQr({ cookieHeader });
    if (result.ok) {
        qr = result.data;
    } else {
        panelFailed = true;
        logger.error('[proveedor] Could not load the QR', `status=${result.error.status}`);
    }
}

// The suspension is shown WITH ITS REASON: taking away a provider's ability to
// record work without saying why is the one thing this panel must not do.
const suspendedReason =
    trade !== null && trade.declarationSuspendedAt != null
        ? (trade.declarationSuspendReason ??
          t(
              'account.provider.suspended.noReason',
              'Suspendimos temporalmente el registro de usos desde tu ficha.'
          ))
        : null;

const panelError = t(
    'account.provider.errors.panelFailed',
    'No pudimos cargar esta sección. Recargá la página para reintentar.'
);
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="proveedor">
    <AccountPageHeader title={title} description={subtitle} />

    {
        fetchFailed ? (
            <AccountSectionCard>
                <p role="alert">
                    {t(
                        'account.provider.errors.fetchFailed',
                        'No pudimos cargar tu ficha de proveedor. Recargá la página para reintentar.'
                    )}
                </p>
            </AccountSectionCard>
        ) : trade === null ? (
            <AccountSectionCard>
                <p>
                    {t(
                        'account.provider.empty.text',
                        'Todavía no tenés una ficha de proveedor. Postulate desde "Sumate como aliado" y, una vez aprobada tu solicitud, tu ficha va a aparecer acá.'
                    )}
                </p>
                <a href={buildUrl({ locale, path: 'mi-cuenta/aliados' })}>
                    {t('account.provider.empty.cta', 'Ir a Sumate como aliado')}
                </a>
            </AccountSectionCard>
        ) : isRevoked ? (
            <AccountSectionCard>
                <p role="alert">
                    {t(
                        'account.provider.revoked.text',
                        'Tu ficha fue dada de baja del directorio de proveedores.'
                    )}
                </p>
                {trade.revokeReason && <p>{trade.revokeReason}</p>}
                <p>
                    {t(
                        'account.provider.revoked.contact',
                        'Si querés más información, escribinos y te contamos los detalles.'
                    )}
                </p>
            </AccountSectionCard>
        ) : (
            <>
                {/* Tab navigation: plain links, so only the active panel's
                    island ships and every tab is linkable. */}
                <nav class="provider-tabs" aria-label={t('account.provider.tabs.label', 'Secciones de tu ficha')}>
                    {tabs.map((tab) => (
                        <a
                            class:list={['provider-tabs__link', tab.id === activeTab && 'provider-tabs__link--active']}
                            href={tab.href}
                            aria-current={tab.id === activeTab ? 'page' : undefined}
                        >
                            {tab.label}
                        </a>
                    ))}
                </nav>

                <AccountSectionCard>
                    {panelFailed ? (
                        <p role="alert">{panelError}</p>
                    ) : activeTab === 'usos' ? (
                        <ProviderUsagesPanel
                            client:load
                            locale={locale}
                            initialUsages={usages}
                            initialTotal={usagesTotal}
                            initialPending={pendingUsages}
                            initialLinkedHosts={linkedHosts}
                            today={today}
                            suspendedReason={suspendedReason}
                        />
                    ) : activeTab === 'valoraciones' ? (
                        <ProviderReviewsPanel
                            client:load
                            locale={locale}
                            initialReviews={reviews}
                            initialTotal={reviewsTotal}
                        />
                    ) : activeTab === 'qr' && qr ? (
                        <ProviderQrPanel
                            client:load
                            locale={locale}
                            svg={qr.svg}
                            slug={qr.slug}
                            targetUrl={qr.url}
                        />
                    ) : (
                        <HostTradeEditForm locale={locale} trade={trade} client:load />
                    )}
                </AccountSectionCard>
            </>
        )
    }
</AccountLayout>

<style>
    .provider-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2, 0.5rem);
        margin-bottom: var(--space-4, 1rem);
    }

    .provider-tabs__link {
        display: inline-flex;
        align-items: center;
        /* 44px keeps the tap target within the AA touch guideline. */
        min-height: 44px;
        padding: 0.5rem 1rem;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--core-muted-foreground);
        text-decoration: none;
        background-color: transparent;
        border: 1px solid var(--core-foreground-a08);
        border-radius: var(--radius-pill, 9999px);
    }

    .provider-tabs__link--active {
        color: var(--primary-foreground, #ffffff);
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }

    .provider-tabs__link:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }
</style>
