---
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import { AddonPurchase } from '@/components/billing/addon-purchase/AddonPurchase.client';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { parseReturnOrderRequestId } from '@/lib/billing/addon-purchase-return';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}
const { t } = createTranslations(locale);
const title = t('billing.addonPurchase.title');
const returnOrderRequestId = parseReturnOrderRequestId({ search: Astro.url.search });
---

<AccountLayout locale={locale} title={title} activeSection="suscripcion">
    <AccountPageHeader title={title} />
    <AddonPurchase client:load locale={locale} returnOrderRequestId={returnOrderRequestId} accountEmail={user.email} />
</AccountLayout>
