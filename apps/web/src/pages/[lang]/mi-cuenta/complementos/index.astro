---
/**
 * @file mi-cuenta/complementos/index.astro
 * @description Active add-on summary with the subscription tabs. Accounts without
 * subscriptions or active add-ons redirect to the dashboard, except when settling
 * a Mercado Pago return. New purchases live in each vertical's subscription section;
 * personal add-on reads and the return settlement stay in browser islands.
 *
 * @route /{lang}/mi-cuenta/complementos/
 * @rendering SSR
 */
import { PageHeader, Section } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import SubscriptionTabs from '@/components/account/SubscriptionTabs.astro';
import { AddonPurchase } from '@/components/billing/addon-purchase/AddonPurchase.client';
import { RecurringAddonWithdrawal } from '@/components/billing/recurring-addons/RecurringAddonWithdrawal.client';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { hasBillingPresence } from '@/lib/account-billing-presence';
import { parseReturnOrderRequestId } from '@/lib/billing/addon-purchase-return';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}
const { t } = createTranslations(locale);
// F-19 (HOS-2610): «Plan» and «Complementos» read as one page, so they share
// the H1 and the sidebar item of «Suscripción».
const title = t('account.pages.subscription.title', 'Suscripción');
const returnOrderRequestId = parseReturnOrderRequestId({ search: Astro.url.search });
const listingId = Astro.url.searchParams.get('listing');
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
if (!returnOrderRequestId && !await hasBillingPresence({ userId: user.id, cookieHeader })) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}
---

<AccountLayout locale={locale} title={title} activeSection="suscripcion">
    <div class="addons-page">
    <PageHeader locale={locale} title={title}>
        <PageHelpLink slot="help" locale={locale} />
        <SubscriptionTabs slot="tabs" locale={locale} current="addons" />
    </PageHeader>
    {returnOrderRequestId && <AddonPurchase
        client:load
        locale={locale}
        returnOrderRequestId={returnOrderRequestId}
        accountEmail={user.email}
    />}
    <Section
        id="recurring-addons"
        title={t('billing.addonPurchase.recurringAddons.title')}
        helpId="section:complementos.recurrentes"
    >
        <RecurringAddonWithdrawal client:visible locale={locale} listingId={listingId} />
    </Section>
    </div>
</AccountLayout>

<style>
    /* The account content slot has no flow gap: one stack owns the rhythm. */
    .addons-page {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }
</style>
