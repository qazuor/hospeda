---
/**
 * @file cambiar-contrasena/index.astro
 * @description Forced or voluntary change-password page (SPEC-239 T-055).
 *
 * Venue/experience owners provisioned with a server-generated password land here on
 * first login (middleware gate redirects them automatically when
 * `mustChangePassword = true`). Regular users can also reach this page
 * voluntarily from their account settings.
 *
 * The middleware already protects /mi-cuenta/* (redirects unauthenticated
 * visitors to sign-in), but we add a local safety net below.
 *
 * This route is whitelisted in the middleware must-change-password gate
 * (CHANGE_PASSWORD_SEGMENT) so the page can actually be submitted.
 *
 * @route    /[lang]/mi-cuenta/cambiar-contrasena/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { resolveSafeReturnPath } from '@/lib/auth-redirect';
import { parseProfileStatus } from '@/lib/middleware-helpers';
import { SET_PASSWORD_SEGMENT } from '@/lib/routes';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import FocusShell from '@/layouts/FocusShell.astro';
import { ChangePasswordForm } from '@/components/auth/ChangePasswordForm.client';

// Locale is injected and validated by middleware.
const locale = Astro.locals.locale as SupportedLocale;

// Auth safety net: middleware already redirects, but this guards against any
// future config drift.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const t = createT(locale);

const title = t('account.changePassword.title', 'Cambiar contraseña');
// HOS-2431: the gate-forced visit and a voluntary one need different copy.
// `mustChangePassword` is the flag the middleware's step 7.2 gate redirects on,
// carried on `locals.user` from the `/auth/me` payload.
const forced = user.mustChangePassword === true;
const description = forced
    ? t(
          'account.changePassword.subtitle',
          'Por seguridad, necesitás actualizar tu contraseña antes de continuar.'
      )
    : t('account.changePassword.subtitleVoluntary');

// HOS-2431: an account that only signs in with Google/Facebook has no current
// password to change, so a voluntary visit goes to the add-password flow instead
// of promising a form that cannot work. A forced visit never takes this branch:
// the forced accounts are provisioned with a password.
if (!forced) {
    const profileStatus = await parseProfileStatus({
        cookieHeader: Astro.request.headers.get('cookie')
    });
    if (profileStatus && !profileStatus.hasCredentialAccount) {
        const returnTo = Astro.url.searchParams.get('returnUrl');
        const setPasswordUrl = buildUrl({ locale, path: `mi-cuenta/${SET_PASSWORD_SEGMENT}` });
        return Astro.redirect(
            returnTo ? `${setPasswordUrl}?returnUrl=${encodeURIComponent(returnTo)}` : setPasswordUrl
        );
    }
}

// HOS-838: the destination the onboarding gate interrupted, carried here as
// `returnUrl` by the middleware. It is attacker-controlled by the time it
// reaches this page — anyone can hand-edit the query — so it goes through the
// shared open-redirect guard, which falls back to `/{locale}/mi-cuenta/`.
const rawReturnUrl = Astro.url.searchParams.get('returnUrl') ?? '';
const returnUrl = resolveSafeReturnPath({ rawReturn: rawReturnUrl, locale });

---

<FocusShell locale={locale} title={title} description={description}>

    <ChangePasswordForm
        client:load
        locale={locale}
        accountEmail={user.email}
        returnUrl={returnUrl}
        forced={forced}
    />
</FocusShell>
