---
/**
 * @file mi-cuenta/consultas/[conversationId].astro
 * @description Authenticated guest conversation thread on the account kit
 * (HOS-2481): a `PageHeader` with account breadcrumbs and the
 * `ConversationPanel` island with `viewer="guest"` (kit `ConversationThread` +
 * `Composer`, optimistic reply, no page reload).
 *
 * The thread is read here with the session cookie (the existing per-user read
 * of this exempt account page). A 404 — a missing conversation or one that
 * belongs to somebody else — rewrites to the in-layout not-found page, which
 * keeps the 404 status inside the account shell (HOS-2434). Any other failure
 * renders `ErrorState` with a retry inside the shell: a failed read is never
 * presented as a missing conversation.
 *
 * @route /{lang}/mi-cuenta/consultas/{conversationId}/
 * @rendering SSR (on-demand, auth-protected)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import { buildAccountBreadcrumbs } from '@/lib/account/account-breadcrumbs';
import { getAccountSectionLabel } from '@/lib/account-nav-model';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { ConversationPanel } from '@/components/account/conversations/ConversationPanel.client';
import { ConversationLoadError } from '@/components/account/conversations/ConversationLoadError.client';
import ListingGoneNotice from '@/components/account/ListingGoneNotice.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { buildAccountNotFoundTarget } from '@/lib/account-not-found';
import { protectedConversationsApi } from '@/lib/api/endpoints-protected';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const { conversationId } = Astro.params;
if (!conversationId) return Astro.rewrite(buildAccountNotFoundTarget({ locale, back: 'messages' }));

// Cursor from URL for older message pagination
const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
// Forward the session cookie so the protected endpoint can resolve the actor;
// without this the SSR fetch arrives anonymous and the thread fails to load.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const result = await protectedConversationsApi.getThread({
    id: conversationId,
    cursor,
    limit: 50,
    cookieHeader
});

// HOS-2434: only a real «not found» becomes the in-layout 404 page.
if (!result.ok && result.error.status === 404) {
    return Astro.rewrite(buildAccountNotFoundTarget({ locale, back: 'messages' }));
}

const thread = result.ok ? result.data : null;

let pageTitle = t('conversations.inbox.guestInboxTitle');
let canReply = false;
let listingAdmitsMessages = true;
let readAt: string | undefined;
let olderHref: string | undefined;

if (thread) {
    const { conversation, messages, nextCursor, listingAvailability } = thread;
    pageTitle = conversation.accommodationName ?? pageTitle;

    // Reply only while the conversation is open AND its listing still admits
    // messages (HOS-1492, rows 28 and 35). Otherwise the whole conversation
    // stays visible, read-only, under `ListingGoneNotice`.
    const closedStatuses = ['CLOSED', 'BLOCKED'];
    listingAdmitsMessages = listingAvailability === 'AVAILABLE';
    canReply = listingAdmitsMessages && !closedStatuses.includes(conversation.status.toUpperCase());

    // Owner read receipt: shown when the owner read after the guest's last message.
    const lastGuestMsg = [...messages].reverse().find((m) => m.senderType?.toLowerCase() === 'guest');
    if (
        conversation.lastReadAtByOwner &&
        lastGuestMsg &&
        new Date(conversation.lastReadAtByOwner) >= new Date(lastGuestMsg.createdAt)
    ) {
        readAt = conversation.lastReadAtByOwner;
    }

    // The API already computes the cursor of the previous page (or null).
    olderHref = nextCursor
        ? `${buildUrl({ locale, path: `mi-cuenta/consultas/${conversationId}` })}?cursor=${encodeURIComponent(nextCursor)}`
        : undefined;
}

const subtitle = thread
    ? t('conversations.thread.title', undefined, { senderName: thread.conversation.ownerName })
    : undefined;
---

<AccountLayout locale={locale} title={pageTitle} description={subtitle ?? pageTitle} activeSection="messages">
    <PageHeader title={pageTitle} description={subtitle} locale={locale} breadcrumbs={buildAccountBreadcrumbs({
        t,
        parents: [{ label: getAccountSectionLabel({ t, section: 'messages' }), path: 'mi-cuenta/consultas' }],
        current: pageTitle
    })}>
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    {thread ? (
        <ConversationPanel
            client:load
            locale={locale}
            viewer="guest"
            conversationId={conversationId}
            initialMessages={thread.messages}
            canReply={canReply}
            olderHref={olderHref}
            readAt={readAt}
        >
            {!listingAdmitsMessages ? (
                <ListingGoneNotice locale={locale} availability={thread.listingAvailability} />
            ) : canReply ? null : (
                <p role="status">
                    {thread.conversation.status.toUpperCase() === 'BLOCKED'
                        ? t('conversations.errors.conversationBlocked')
                        : t('conversations.status.closed')}
                </p>
            )}
        </ConversationPanel>
    ) : (
        <ConversationLoadError client:load locale={locale} helpId="section:messages.thread" />
    )}
</AccountLayout>
