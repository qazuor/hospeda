---
/**
 * @file mi-cuenta/consultas/index.astro
 * @description Authenticated guest inbox on the account kit (HOS-2481): one
 * `PageHeader` and the `ConversationInbox` island with `viewer="guest"`, which
 * renders the list `Section`.
 *
 * The page reads no per-user data: the island fetches the list in the browser,
 * so the region shows loading, error with retry, empty and ready states
 * (`AsyncRegion`). A failed read is an error, never the empty inbox
 * (HOS-2422). Every page of the paginated API is linked (`?page=`).
 *
 * @route /{lang}/mi-cuenta/consultas/
 * @rendering SSR (on-demand, auth-protected)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { ConversationInbox } from '@/components/account/conversations/ConversationInbox.client';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// Auth gate: middleware protects /mi-cuenta/* so user is always set here
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// Pagination from URL search params (the island reads that page).
const parsed = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(parsed) && parsed > 0 ? parsed : 1;

const title = t('conversations.inbox.guestInboxTitle');
---

<AccountLayout
    locale={locale}
    title={title}
    description={t('conversations.empty.guestInbox')}
    activeSection="messages"
>
    <PageHeader title={title} locale={locale} description={t('account.pages.guestInbox.headingDesc')}>
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    <ConversationInbox client:load locale={locale} viewer="guest" page={page} />
</AccountLayout>
