---
/**
 * @file mi-cuenta/consultas-propietario/index.astro
 * @description Authenticated owner inbox on the account kit (HOS-2482): the same
 * `ConversationInbox` island as the guest inbox, with `viewer="owner"`.
 *
 * Gate (HOS-2433): a signed-out visitor is sent to login with this URL as the
 * return path; a signed-in user without the owner permission
 * (`PermissionEnum.ACCOMMODATION_CREATE`, via `resolveOwnerInboxGate`) sees the
 * kit `LockedState` inside the shell. The decision is taken before any
 * conversation is read: the island that reads them is not mounted otherwise.
 *
 * The page reads no per-user data beyond that gate: the island fetches the list
 * in the browser, with error + retry, empty and ready states.
 *
 * @route /{lang}/mi-cuenta/consultas-propietario/
 * @rendering SSR (on-demand, auth-protected)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { ConversationInbox } from '@/components/account/conversations/ConversationInbox.client';
import { OwnerInboxLocked } from '@/components/account/conversations/OwnerInboxLocked';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { resolveOwnerInboxGate } from '@/lib/owner-inbox-gate';
import { guardPublisherArea } from '@/lib/account/publisher-access';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// Auth gate: middleware protects /mi-cuenta/* so user is always set here
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// HOS-2433 / HOS-2482: gate by PERMISSION, never by role name.
const denied = guardPublisherArea({ astro: Astro, area: 'inbox' });
if (denied) return denied;
const gate = resolveOwnerInboxGate({ permissions: user.permissions });

// Pagination from URL search params (the island reads that page).
const parsed = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(parsed) && parsed > 0 ? parsed : 1;

const title = t('conversations.inbox.ownerInboxTitle');
---

<AccountLayout locale={locale} title={title} description={title} activeSection="owner-messages">
    <PageHeader title={title} locale={locale} description={t('account.pages.ownerInbox.headingDesc')}>
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    {gate.action === 'locked' ? (
        <OwnerInboxLocked locale={locale} />
    ) : (
        <ConversationInbox client:load locale={locale} viewer="owner" page={page} />
    )}
</AccountLayout>
