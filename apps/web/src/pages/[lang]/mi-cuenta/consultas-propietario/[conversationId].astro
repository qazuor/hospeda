---
/**
 * @file mi-cuenta/consultas-propietario/[conversationId].astro
 * @description Authenticated owner conversation thread on the account kit
 * (HOS-2482): the same `ConversationPanel` island as the guest thread, with
 * `viewer="owner"`, and a labelled back link in the `PageHeader`.
 *
 * Gate (HOS-2433): signed-out → login with this URL as the return path;
 * signed-in without the owner permission (`resolveOwnerInboxGate`) → kit
 * `LockedState`, and the thread is never read. A 404 — a missing conversation
 * or one about somebody else's listing — rewrites to the in-layout not-found
 * page, keeping the 404 status inside the shell (HOS-2434). Any other failure
 * renders `ErrorState` with a retry.
 *
 * @route /{lang}/mi-cuenta/consultas-propietario/{conversationId}/
 * @rendering SSR (on-demand, auth-protected)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import { ConversationPanel } from '@/components/account/conversations/ConversationPanel.client';
import { ConversationLoadError } from '@/components/account/conversations/ConversationLoadError.client';
import { OwnerInboxLocked } from '@/components/account/conversations/OwnerInboxLocked';
import ListingGoneNotice from '@/components/account/ListingGoneNotice.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { buildAccountNotFoundTarget } from '@/lib/account-not-found';
import { resolveOwnerInboxGate } from '@/lib/owner-inbox-gate';
import { ownerConversationsApi } from '@/lib/api/endpoints-protected';
import type { OwnerConversationThreadResponse } from '@/lib/api/endpoints-protected';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// HOS-2433 / HOS-2482: gate by PERMISSION, never by role name, BEFORE any read.
const gate = resolveOwnerInboxGate({ roles: user.roles });

const { conversationId } = Astro.params;
if (!conversationId) return Astro.rewrite(buildAccountNotFoundTarget({ locale, back: 'ownerMessages' }));

let thread: OwnerConversationThreadResponse | null = null;
if (gate.action === 'continue') {
    // Cursor from URL for older message pagination
    const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
    // Forward the session cookie so the protected endpoint can resolve the actor
    const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
    const result = await ownerConversationsApi.getById({
        id: conversationId,
        cursor,
        limit: 50,
        cookieHeader
    });
    // HOS-2434: only a real «not found» becomes the in-layout 404 page.
    if (!result.ok && result.error.status === 404) {
        return Astro.rewrite(buildAccountNotFoundTarget({ locale, back: 'ownerMessages' }));
    }
    thread = result.ok ? result.data : null;
}

const back = {
    label: t('conversations.thread.backToOwnerInbox'),
    href: buildUrl({ locale, path: 'mi-cuenta/consultas-propietario' })
};

let pageTitle = t('conversations.inbox.ownerInboxTitle');
let subtitle: string | undefined;
let canReply = false;
let listingAdmitsMessages = true;
let olderHref: string | undefined;

if (thread) {
    const { conversation, nextCursor, listingAvailability } = thread;
    pageTitle = t('conversations.thread.title', undefined, {
        senderName: conversation.guestName || t('conversations.senderLabels.guest')
    });
    subtitle = conversation.accommodationName;

    // Reply only while the conversation is open AND its listing still admits
    // messages (HOS-1492, row 28). Otherwise the whole conversation stays
    // visible, read-only, under `ListingGoneNotice`.
    const closedStatuses = ['CLOSED', 'BLOCKED'];
    listingAdmitsMessages = listingAvailability === 'AVAILABLE';
    canReply = listingAdmitsMessages && !closedStatuses.includes(conversation.status.toUpperCase());

    olderHref = nextCursor
        ? `${buildUrl({ locale, path: `mi-cuenta/consultas-propietario/${conversationId}` })}?cursor=${encodeURIComponent(nextCursor)}`
        : undefined;
}
---

<AccountLayout locale={locale} title={pageTitle} description={subtitle ?? pageTitle} activeSection="owner-messages">
    <PageHeader title={pageTitle} description={subtitle} locale={locale} back={back} />

    {gate.action === 'locked' ? (
        <OwnerInboxLocked locale={locale} />
    ) : thread ? (
        <ConversationPanel
            client:load
            locale={locale}
            viewer="owner"
            conversationId={conversationId}
            initialMessages={thread.messages}
            canReply={canReply}
            olderHref={olderHref}
        >
            {!listingAdmitsMessages ? (
                <ListingGoneNotice locale={locale} availability={thread.listingAvailability} />
            ) : canReply ? null : (
                <p role="status">
                    {thread.conversation.status.toUpperCase() === 'BLOCKED'
                        ? t('conversations.errors.conversationBlocked')
                        : t('conversations.status.closed')}
                </p>
            )}
        </ConversationPanel>
    ) : (
        <ConversationLoadError client:load locale={locale} helpId="section:owner-messages.thread" />
    )}
</AccountLayout>
