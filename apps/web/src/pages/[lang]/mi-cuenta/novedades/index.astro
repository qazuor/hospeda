---
/**
 * @file novedades/index.astro
 * @description What's New panel page — shows all platform updates for hosts and venue/experience owners.
 *
 * SSR (not prerendered) — requires an authenticated user.
 *
 * @route /[lang]/mi-cuenta/novedades/
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { PageHeader } from '@/components/account/ui';
import { WhatsNewPageList } from '@/components/account/WhatsNewPageList.client';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';

const locale = (Astro.locals.locale ?? (Astro.params.lang as SupportedLocale | undefined) ?? 'es') as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const { t } = createTranslations(locale);

const title = t('account.pages.whatsNew.title');
const description = t('account.pages.whatsNew.desc');
---

<AccountLayout locale={locale} title={title} description={description} activeSection="novedades" template="reading">
    <PageHeader title={title} description={description} locale={locale}>
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    <WhatsNewPageList locale={locale} client:idle />
</AccountLayout>
