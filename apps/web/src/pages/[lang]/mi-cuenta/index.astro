---
/**
 * @file mi-cuenta/index.astro
 * @description Account dashboard — shows user info and navigation to sub-sections.
 *
 * Auth protection: both the middleware AND this page check for a valid user.
 * Middleware redirects before the page renders; the in-page guard is a safety net
 * for any SSR edge case where middleware did not run.
 *
 * Quick stats (bookmarks/reviews for tourists, properties/messages for hosts,
 * listings/messages for venue/experience owners — HOS-1293, subscription for all) are
 * fetched client-side so that we avoid SSR cookie-forwarding complexity and the
 * page can show a skeleton first.
 *
 * @route    /[lang]/mi-cuenta/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { hasAccommodationsNavAccess, hasListingNavAccess } from '@/lib/nav-gating';
import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountStatsGrid from '@/components/account/AccountStatsGrid.astro';
import AccountSectionCards from '@/components/account/AccountSectionCards.astro';
import { DashboardController } from '@/components/account/DashboardController.client';
import {
    UserIcon,
    SettingsIcon,
    ChatIcon,
    NewsletterIcon,
    BuildingIcon,
    BriefcaseIcon,
    DashboardIcon,
} from '@repo/icons';

// Locale is injected by middleware — always a valid SupportedLocale.
const locale = Astro.locals.locale as SupportedLocale;

// Auth guard: middleware should have redirected already, but this is the safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const t = createT(locale);

const title = t('account.pages.dashboard.title', 'Mi Cuenta');
const description = t(
    'account.pages.dashboard.description',
    'Gestiona tu perfil, favoritos, resenas y suscripcion'
);
const greeting = t('account.pages.dashboard.greeting', 'Hola');
const dashboardLabel = t('account.pages.dashboard.dashboardLabel', 'Panel de control');

// Determine host-tier access for conditional sections (HOS-296: over the
// whole role SET, via the single shared gating predicate).
const isHost = hasAccommodationsNavAccess({ roles: user.roles });

// H-151: the same treatment for the venue/experience owner. The dashboard already
// adapted between tourist and host; the merchant was the case it had never
// heard of, so someone whose listing sits in DRAFT saw a page that never
// mentioned their business — while the sidebar beside it showed "Mi comercio".
// This is the first screen they land on, and the one place "your listing is not
// public yet" can actually reach them.
//
// A SEPARATE condition, not an else: an account can hold both roles (HOS-296),
// and a host who also runs a restaurant must keep both sets of entries.
const isOwner = hasListingNavAccess({ roles: user.roles });

// Generate user initials (up to 2 characters) for the avatar placeholder.
const initials = user.name
    .split(' ')
    .map((word: string) => word[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

// Sections grid. We intentionally exclude Favoritos, Reseñas and
// Suscripción from this list — they already have dedicated stat
// cards directly above with the same link. Listing them in both
// places duplicated the navigation entry and made the dashboard feel
// cluttered. Keep this grid for items the stats row does NOT cover.
// Host roles get two extra cards prepended (properties + host dashboard).
const navItems = [
    ...(isHost
        ? [
              {
                  label: t('account.pages.dashboard.nav.myProperties', 'Mis propiedades'),
                  href: buildUrl({ locale, path: 'mi-cuenta/propiedades' }),
                  description: t(
                      'account.pages.dashboard.nav.myPropertiesDesc',
                      'Gestioná tus alojamientos publicados'
                  ),
                  Icon: BuildingIcon,
              },
              {
                  label: t('account.pages.dashboard.nav.hostDashboard', 'Panel del anfitrión'),
                  href: buildUrl({ locale, path: 'mi-cuenta/host-dashboard' }),
                  description: t(
                      'account.pages.dashboard.nav.hostDashboardDesc',
                      'Resumen de tu actividad como anfitrión'
                  ),
                  Icon: DashboardIcon,
              },
          ]
        : []),
    ...(isOwner
        ? [
              {
                  // Same label key and icon as the sidebar's venue/experience entry, so
                  // the two surfaces cannot drift apart in wording.
                  label: t('listing.owner.nav', 'Mi comercio'),
                  href: buildUrl({ locale, path: 'mi-cuenta/comercio' }),
                  description: t(
                      'account.pages.dashboard.nav.myListingDesc',
                      'Gestioná tu ficha, tus fotos y tu suscripción'
                  ),
                  Icon: BriefcaseIcon,
              },
          ]
        : []),
    {
        label: t('account.pages.dashboard.nav.editProfile', 'Editar perfil'),
        href: buildUrl({ locale, path: 'mi-cuenta/editar' }),
        description: t(
            'account.pages.dashboard.nav.editProfileDesc',
            'Actualizá tu información personal y foto de perfil'
        ),
        Icon: UserIcon,
    },
    {
        label: t('account.pages.dashboard.nav.myMessages', 'Mis consultas'),
        href: buildUrl({ locale, path: 'mi-cuenta/consultas' }),
        // H-151: the tourist-facing wording describes the OTHER party. A
        // merchant is the one who receives enquiries, so "conversaciones con
        // anfitriones" reads as someone else's inbox on their own dashboard.
        description: isOwner
            ? t(
                  'account.pages.dashboard.nav.myMessagesListingDesc',
                  'Consultas que recibís sobre tu comercio'
              )
            : t('account.pages.dashboard.nav.myMessagesDesc', 'Conversaciones con anfitriones'),
        Icon: ChatIcon,
    },
    {
        label: t('account.pages.dashboard.nav.preferences', 'Preferencias'),
        href: buildUrl({ locale, path: 'mi-cuenta/preferencias' }),
        description: t(
            'account.pages.dashboard.nav.preferencesDesc',
            'Configurá notificaciones, idioma y privacidad'
        ),
        Icon: SettingsIcon,
    },
    {
        label: t('account.pages.dashboard.nav.newsletter', 'Boletín de novedades'),
        href: buildUrl({ locale, path: 'mi-cuenta/newsletter' }),
        description: t(
            'account.pages.dashboard.nav.newsletterDesc',
            'Gestioná tu suscripción al boletín'
        ),
        Icon: NewsletterIcon,
    },
];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<AccountLayout locale={locale} title={title} description={description} activeSection="mi-cuenta">
    <!-- ── User header card ── -->
    <article id="user-header" class="account__header-card">
        <!-- Decorative warm gradient frame on the right edge -->
        <span class="account__header-glow" aria-hidden="true" />
        <span class="account__header-pattern" aria-hidden="true" />

        <div class="account__header-inner">
            <!-- Avatar: photo when available, initials fallback otherwise (BETA-32) -->
            <div class="account__avatar">
                <span class="account__avatar-ring" aria-hidden="true" />
                {user.image ? (
                    <img src={user.image} alt={user.name} class="account__avatar-img" width="104" height="104" />
                ) : (
                    <span class="account__avatar-initials">{initials}</span>
                )}
            </div>

            <!-- Name + email + small detail row -->
            <div class="account__user-info">
                <p class="account__user-eyebrow">{greeting}</p>
                <h1 class="account__user-name">{user.name}</h1>
                <p class="account__user-email">{user.email}</p>
            </div>

            <!-- CTA: edit profile -->
            <div class="account__header-actions">
                <a
                    href={buildUrl({ locale, path: 'mi-cuenta/editar' })}
                    class="account__header-cta"
                >
                    <UserIcon size={18} weight="regular" aria-hidden="true" />
                    {t('account.pages.dashboard.nav.editProfile', 'Editar perfil')}
                </a>
            </div>
        </div>
    </article>

    <!-- Main content: quick stats -->
    <div id="account-stats" class="account__main">
        <h2 class="account__section-title">{dashboardLabel}</h2>

        <!-- Stat cards row -->
        <AccountStatsGrid locale={locale} isHost={isHost} isOwner={isOwner} />

        <!-- Navigation cards grid (secondary) -->
        <AccountSectionCards locale={locale} navItems={navItems} />
    </div>

    <!-- What's New + Tour: auto-trigger controllers (D12 gate) -->
    <DashboardController
        locale={locale}
        userRoles={user.roles}
        client:idle
    />
</AccountLayout>

<style>
    /* ── Page container ── */
    .account {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding: var(--space-8, 2rem) var(--space-4, 1rem);
    }

    /* ── User header card ── */
    .account__header-card {
        position: relative;
        margin-bottom: var(--space-8, 2rem);
        border-radius: var(--radius-card);
        border: 1px solid var(--core-foreground-a08);
        background-color: var(--core-card);
        background-image: linear-gradient(
            135deg,
            var(--brand-primary-a05) 0%,
            var(--brand-accent-a05) 100%
        );
        box-shadow: var(--shadow-card);
        overflow: hidden;
        isolation: isolate;
    }

    /* Soft brand glow on the right shoulder. */
    .account__header-glow {
        position: absolute;
        top: -40%;
        right: -10%;
        width: 22rem;
        height: 22rem;
        border-radius: var(--radius-pill);
        background: radial-gradient(
            closest-side,
            var(--brand-primary-a20),
            transparent 70%
        );
        pointer-events: none;
        z-index: -1;
    }

    /* Faint dotted pattern at the bottom-left of the card. */
    .account__header-pattern {
        position: absolute;
        bottom: -1rem;
        left: -1rem;
        width: 10rem;
        height: 10rem;
        background-image: radial-gradient(
            circle,
            var(--brand-accent-a20) 1px,
            transparent 1.5px
        );
        background-size: 12px 12px;
        opacity: 0.55;
        pointer-events: none;
        z-index: -1;
    }

    .account__header-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-6, 1.5rem);
        padding: var(--space-8, 2rem);
        text-align: center;
    }

    @media (min-width: 640px) {
        .account__header-inner {
            flex-direction: row;
            text-align: left;
            align-items: center;
        }
    }

    .account__avatar {
        position: relative;
        flex-shrink: 0;
        display: flex;
        width: 6.5rem;
        height: 6.5rem;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-pill);
        background: linear-gradient(
            135deg,
            var(--brand-primary),
            var(--brand-primary-lm12)
        );
        color: var(--core-card);
        font-size: 2rem;
        font-weight: 700;
        font-family: var(--font-heading);
        box-shadow: 0 12px 24px var(--brand-primary-a25);
    }

    /* Outer ring around the avatar to lift it visually off the surface. */
    .account__avatar-ring {
        position: absolute;
        inset: -6px;
        border-radius: var(--radius-pill);
        border: 2px solid var(--brand-primary-a20);
        pointer-events: none;
    }

    .account__avatar-initials {
        position: relative;
        z-index: 1;
    }

    /* Avatar photo fills the circle, covering the gradient placeholder. */
    .account__avatar-img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--radius-pill);
    }

    .account__user-info {
        flex: 1;
        min-width: 0;
    }

    .account__user-eyebrow {
        margin: 0 0 var(--space-1);
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand-primary);
    }

    .account__user-name {
        margin: 0 0 var(--space-2);
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--core-foreground);
        line-height: 1.15;
        word-break: break-word;
    }

    .account__user-email {
        margin: 0;
        font-size: var(--text-body-sm);
        color: var(--core-muted-foreground);
        word-break: break-all;
    }

    .account__header-actions {
        flex-shrink: 0;
        display: flex;
        align-items: center;
    }

    .account__header-cta {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-5);
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
        font-weight: 600;
        color: var(--brand-primary);
        background-color: var(--core-card);
        border: 1px solid var(--brand-primary-a30);
        border-radius: var(--radius-button);
        text-decoration: none;
        transition:
            background-color var(--duration-fast) ease,
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease,
            box-shadow var(--duration-fast) ease;
    }

    .account__header-cta:hover {
        background-color: var(--brand-primary);
        color: var(--core-card);
        transform: translateY(-1px);
        box-shadow: 0 8px 16px var(--brand-primary-a25);
    }

    .account__header-cta:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    /* ── Main content ── */
    .account__main {
        display: flex;
        flex-direction: column;
        gap: var(--space-6, 1.5rem);
    }

    .account__section-title {
        margin: 0;
        font-size: var(--text-h3, 1.5rem);
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--core-foreground);
    }

</style>

<script>
    import { getApiUrl } from '@/lib/env';
    import type { UserStatsResponse } from '@repo/schemas';
    import {
        parsePlanNames,
        resolveDashboardFreeCard,
        resolveDashboardPlanStat,
        statusNeedsAction
    } from '@/lib/billing/dashboard-plan-stat';
    import {
        markStatsUnavailable,
        resolveHostStatValues,
        setStatValue
    } from '@/lib/dashboard-stat-state';
    import { formatNoticeInstant } from '@/lib/listing/listing-notices';
    import { TrialSummaryResponseSchema, type TrialSummaryResponse } from '@repo/schemas';
    import type { SupportedLocale } from '@/lib/i18n';
    import {
        summarizeListingVisibility,
        type ListingWithPublicationStatus
    } from '@/lib/listing/dashboard-listing-counts';

    /**
     * Reads the owner's trial in every vertical that can hold one
     * (`GET /protected/publish/trial-summary/:vertical`, the canonical trial read) and
     * returns the summaries that answered. Each read is capped at 3 s; a timeout or failure
     * leaves that vertical out, so the card keeps the free label. Never rejects.
     */
    const TRIAL_READ_TIMEOUT_MS = 3000;

    async function readDashboardTrialSummaries(): Promise<TrialSummaryResponse[]> {
        const apiUrl = getApiUrl();
        const reads = await Promise.all(
            ['accommodation', 'venue', 'experience'].map(async (vertical) => {
                try {
                    const res = await fetch(`${apiUrl}/api/v1/protected/publish/trial-summary/${vertical}`, {
                        credentials: 'include',
                        signal: AbortSignal.timeout(TRIAL_READ_TIMEOUT_MS)
                    });
                    if (!res.ok) return [];
                    const body = (await res.json()) as { data?: unknown };
                    const parsed = TrialSummaryResponseSchema.safeParse(body.data);
                    return parsed.success ? [parsed.data] : [];
                } catch {
                    return [];
                }
            })
        );
        return reads.flat();
    }

    /**
     * Fetch user stats from the protected API and update the dashboard counters.
     * Runs client-side to avoid SSR cookie-forwarding complexity.
     * A stat whose read fails shows "not available" — never a fabricated 0 (HOS-2424).
     */
    async function loadStats(): Promise<void> {
        const base = `${getApiUrl()}/api/v1/protected`;

        // Detect view mode from the DOM: host view renders stat-properties;
        // venue/experience-owner view (HOS-1293) renders stat-listings;
        // tourist view renders stat-favorites/stat-reviews. The three are
        // mutually exclusive — see AccountStatsGrid's isHost/isOwner
        // precedence (host wins over venue/experience wins over tourist).
        const isHostView = document.getElementById('stat-properties') !== null;
        const isListingView = document.getElementById('stat-listings') !== null;
        const isTouristView = !isHostView && !isListingView;

        // Started alongside the stats fetch so a free-plan owner never waits on it serially.
        // It never rejects (see readDashboardTrialSummaries), so leaving it unawaited is safe.
        const trialSummariesPromise = readDashboardTrialSummaries();

        try {
            // /users/me/stats feeds the subscription widget for ALL views.
            // Reviews are only fetched when the tourist view is active (the
            // stat-reviews element exists), avoiding a needless request for
            // hosts and venue/experience owners alike.
            const fetchPromises: Array<Promise<Response>> = [
                fetch(`${base}/users/me/stats`, { credentials: 'include' }),
            ];
            if (isTouristView) {
                fetchPromises.push(
                    fetch(`${base}/users/me/reviews?pageSize=1`, { credentials: 'include' })
                );
            }

            const [statsRes, reviewsRes] = await Promise.all(fetchPromises);

            // ── Subscription widget (common to both views) ──────────────────
            if (statsRes.ok) {
                const statsData = (await statsRes.json()) as { data?: UserStatsResponse };

                // Tourist-only: favorites counter.
                const favEl = document.getElementById('stat-favorites');
                if (favEl && statsData.data?.bookmarkCount !== undefined) {
                    setStatValue({ id: 'stat-favorites', value: String(statsData.data.bookmarkCount) });
                }

                const subEl = document.getElementById('stat-subscription');
                const statusEl = document.getElementById('stat-subscription-status');
                const responseData = statsData.data;
                const planStat = resolveDashboardPlanStat({
                    plan: responseData?.plan ?? null,
                    activeSubscriptionsCount: responseData?.activeSubscriptionsCount ?? 0,
                    subscriptions: responseData?.subscriptions ?? [],
                    planNames: parsePlanNames(subEl?.getAttribute('data-plan-names') ?? null)
                });
                const statusAttributeByKey = {
                    active: 'data-label-active',
                    'grace-period': 'data-label-grace-period',
                    suspended: 'data-label-suspended',
                    'cancel-scheduled': 'data-label-cancel-scheduled',
                    paused: 'data-label-paused',
                    'charge-declined': 'data-label-charge-declined',
                    'pending-authorization': 'data-label-pending-authorization'
                } as const;
                let subscriptionValue: string;
                let statusAttribute: string | null = null;
                let statusText: string | null = null;
                let actionKey: 'charge-declined' | 'pending-authorization' | null = null;
                switch (planStat.kind) {
                    case 'free': {
                        // The trial is Hospeda's own: `plan: null` here does NOT mean "free"
                        // while a trial runs (HOS-1996).
                        const card = resolveDashboardFreeCard({
                            trialSummaries: await trialSummariesPromise,
                            labels: {
                                free: subEl?.getAttribute('data-label-free') ?? 'Gratuito',
                                trial: statusEl?.getAttribute('data-label-trial') ?? 'En prueba',
                                trialEndsOn:
                                    statusEl?.getAttribute('data-label-trial-ends-on') ?? ''
                            },
                            // `data-locale`, not `lang`: `lang` carries the regional tag (es-AR).
                            formatDate: (iso) =>
                                formatNoticeInstant({
                                    iso,
                                    locale: document.documentElement.dataset
                                        .locale as SupportedLocale
                                })
                        });
                        subscriptionValue = card.value;
                        statusText = card.statusText;
                        break;
                    }
                    case 'multiple': {
                        const template =
                            planStat.count === 1
                                ? (subEl?.getAttribute('data-label-multiple-one') ?? '{{count}} suscripción activa')
                                : (subEl?.getAttribute('data-label-multiple-other') ?? '{{count}} suscripciones activas');
                        subscriptionValue = template
                            .replace('{{count}}', String(planStat.count))
                            .replace('{count}', String(planStat.count));
                        break;
                    }
                    case 'list': {
                        // HOS-2553: every live subscription with its exact status (max 3).
                        subscriptionValue = '';
                        const listEl = document.getElementById('stat-subscription-list');
                        if (listEl) {
                            listEl.replaceChildren(
                                ...planStat.rows.map((row) => {
                                    const item = document.createElement('li');
                                    const plan = document.createElement('span');
                                    plan.className = 'account__stat-sub-plan';
                                    plan.textContent = row.label;
                                    const rowStatus = document.createElement('span');
                                    rowStatus.className = 'account__stat-sub-status';
                                    rowStatus.textContent =
                                        statusEl?.getAttribute(statusAttributeByKey[row.statusKey]) ?? '';
                                    item.append(plan, rowStatus);
                                    return item;
                                })
                            );
                            listEl.hidden = false;
                        }
                        if (planStat.hasMore) {
                            const linkEl = document.getElementById('stat-subscription-link');
                            const viewAll = linkEl?.getAttribute('data-label-view-all');
                            if (linkEl && viewAll) linkEl.textContent = viewAll;
                        }
                        const needsAction = planStat.rows.find((row) => statusNeedsAction({ statusKey: row.statusKey }));
                        if (needsAction) actionKey = needsAction.statusKey;
                        break;
                    }
                    case 'single':
                        subscriptionValue = planStat.label;
                        statusAttribute = statusAttributeByKey[planStat.statusKey];
                        if (statusNeedsAction({ statusKey: planStat.statusKey })) actionKey = planStat.statusKey;
                        break;
                    default: {
                        const exhaustive: never = planStat;
                        throw new Error(`Unexpected dashboard plan state: ${exhaustive}`);
                    }
                }
                if (subEl) {
                    subEl.textContent = subscriptionValue;
                    subEl.classList.remove('stat-value--loading');
                    // The list replaces the single value; an empty value would leave a gap.
                    subEl.hidden = planStat.kind === 'list';
                }

                // HOS-2553: what to do about a declined charge or an unauthorized checkout.
                const actionEl = document.getElementById('stat-subscription-action');
                if (actionEl) {
                    const actionText = actionKey ? actionEl.getAttribute(`data-label-${actionKey}`) : null;
                    actionEl.textContent = actionText ?? '';
                    actionEl.hidden = !actionText;
                }

                if (statusEl) {
                    const statusLabel =
                        statusText ?? (statusAttribute ? statusEl.getAttribute(statusAttribute) : null);
                    statusEl.textContent = statusLabel ?? '';
                    statusEl.hidden = !statusLabel;
                }
            }

            // ── Tourist view: reviews counter ────────────────────────────────
            if (isTouristView && reviewsRes?.ok) {
                const reviewsData = (await reviewsRes.json()) as {
                    data?: { totals?: { total?: number } };
                };
                const revEl = document.getElementById('stat-reviews');
                if (revEl && reviewsData.data?.totals?.total !== undefined) {
                    setStatValue({ id: 'stat-reviews', value: String(reviewsData.data.totals.total) });
                }
            }

            // Defensive: a non-2xx response (e.g. 401/500) runs neither the
            // ok-branches above nor the catch below, which used to leave the
            // widgets shimmering forever (BETA-32). Any stat still loading here
            // has no value: show it as unavailable, never as a made-up 0 (HOS-2424).
            markStatsUnavailable({
                ids: ['stat-favorites', 'stat-reviews', 'stat-subscription'],
                onlyIfLoading: true
            });
        } catch (error) {
            console.error('[account] Failed to load stats:', error);
            markStatsUnavailable({
                ids: ['stat-favorites', 'stat-reviews', 'stat-subscription'],
                onlyIfLoading: true
            });
        }

        // ── Host view: properties + messages counters ────────────────────────
        // Runs independently of the tourist stats so a failure in one does not
        // affect the other. Only executes when the host DOM elements exist.
        if (isHostView) {
            try {
                const hostRes = await fetch(`${getApiUrl()}/api/v1/protected/host/dashboard`, {
                    credentials: 'include',
                });

                if (hostRes.ok) {
                    const hostData = (await hostRes.json()) as {
                        data?: {
                            properties?: { total?: number };
                            unreadConversations?: number;
                            unavailable?: string[];
                        };
                    };

                    // A section the API flagged as a failure fallback, or a value
                    // missing from the payload, is "not available" — never 0.
                    const hostStats = resolveHostStatValues({ data: hostData.data });
                    for (const [id, value] of [
                        ['stat-properties', hostStats.properties],
                        ['stat-messages', hostStats.messages]
                    ] as const) {
                        if (value === null) {
                            markStatsUnavailable({ ids: [id] });
                        } else {
                            setStatValue({ id, value: String(value) });
                        }
                    }
                } else {
                    markStatsUnavailable({ ids: ['stat-properties', 'stat-messages'] });
                }
            } catch (error) {
                console.error('[account] Failed to load host dashboard stats:', error);
                markStatsUnavailable({ ids: ['stat-properties', 'stat-messages'] });
            }
            return;
        }

        // ── Venue/experience-owner view: listings counter (HOS-1293) ──────────────────
        // Runs independently of the tourist stats, same as the host block above.
        // Only executes when the venue/experience DOM elements exist. No "messages"
        // counterpart — see AccountStatsGrid's comment on why this platform has
        // no conversation model for listings to count from.
        if (isListingView) {
            try {
                const [venueRes, experienceRes] = await Promise.all([
                    fetch(`${base}/venues/mine`, { credentials: 'include' }),
                    fetch(`${base}/experiences/mine`, { credentials: 'include' }),
                ]);

                // Combine both verticals' listing counts. If EITHER request
                // fails the sum is an undercount, so the card shows "not
                // available" instead of a number that reads as real (HOS-2424).
                const listings: ListingWithPublicationStatus[] = [];
                let listingsFetchOk = venueRes.ok && experienceRes.ok;
                if (venueRes.ok) {
                    const venueData = (await venueRes.json()) as {
                        data?: { listings?: ListingWithPublicationStatus[] };
                    };
                    listings.push(...(venueData.data?.listings ?? []));
                }
                if (experienceRes.ok) {
                    const experienceData = (await experienceRes.json()) as {
                        data?: { listings?: ListingWithPublicationStatus[] };
                    };
                    listings.push(...(experienceData.data?.listings ?? []));
                }

                // HOS-1948: the card says "published", so count only PUBLISHED
                // listings, and tell the owner how many are not visible yet.
                const { published, hidden } = summarizeListingVisibility({ listings });

                if (listingsFetchOk) {
                    setStatValue({ id: 'stat-listings', value: String(published) });
                } else {
                    markStatsUnavailable({ ids: ['stat-listings'] });
                }

                const hiddenEl = document.getElementById('stat-listings-hidden');
                if (hiddenEl && listingsFetchOk && hidden > 0) {
                    const template =
                        (hidden === 1
                            ? hiddenEl.getAttribute('data-label-one')
                            : hiddenEl.getAttribute('data-label-other')) ?? '{{count}}';
                    hiddenEl.textContent = template.replace('{{count}}', String(hidden));
                    hiddenEl.hidden = false;
                }
            } catch (error) {
                console.error('[account] Failed to load listing dashboard stats:', error);
                markStatsUnavailable({ ids: ['stat-listings'] });
            }
        }
    }

    void loadStats();
</script>
