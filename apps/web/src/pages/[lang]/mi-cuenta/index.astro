---
/**
 * @file mi-cuenta/index.astro
 * @description The general account dashboard (HOS-2473, D19 «tableros separados»).
 *
 * Shows ACCOUNT-level data only: an identity PageHeader with one «Editar
 * perfil» action, a StatGrid of favorites, reviews and plan, and one Section
 * of entry points. Host, venue and experience numbers live on their own
 * dashboards; this page links to them (AC-11: no shared widget).
 *
 * Per-user numbers are read client-side by `GeneralDashboardStats`, each card
 * with its own loading and error state, so a failed read shows «—» plus retry,
 * never «0» (HOS-2424).
 *
 * Auth protection: the middleware redirects first; the in-page guard is the
 * safety net.
 *
 * @route    /[lang]/mi-cuenta/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createT } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { readDashboardPlanNames } from '@/lib/account/dashboard-plan-names';
import { buildGeneralDashboardLinks } from '@/lib/account/general-dashboard';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { GeneralDashboardHeader } from '@/components/account/dashboard/GeneralDashboardHeader';
import { GeneralDashboardStats } from '@/components/account/dashboard/GeneralDashboardStats.client';
import { DashboardLinksSection } from '@/components/account/dashboard/DashboardLinksSection';
import { DashboardController } from '@/components/account/DashboardController.client';
import styles from '@/components/account/dashboard/Dashboard.module.css';

// Locale is injected by middleware — always a valid SupportedLocale.
const locale = Astro.locals.locale as SupportedLocale;

// Auth guard: middleware should have redirected already, but this is the safety net.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const t = createT(locale);
const title = t('account.pages.dashboard.title');
const description = t('account.pages.dashboard.description');

// Translated plan names by slug, read from the catalog (never a hand-kept list) and
// handed to the island, since the catalog reader and the translator are server-side.
const planNames = await readDashboardPlanNames({ t });

const links = buildGeneralDashboardLinks({ roles: user.roles });
---

<AccountLayout locale={locale} title={title} description={description} activeSection="mi-cuenta" template="dashboard">
    <div class={styles.page} id="account-dashboard">
        <GeneralDashboardHeader locale={locale} name={user.name} email={user.email} image={user.image} />

        <GeneralDashboardStats locale={locale} planNames={planNames} client:visible />

        <DashboardLinksSection
            locale={locale}
            title={t('account.pages.dashboard.linksTitle')}
            helpId="section:account.dashboard"
            rows={links}
        />
    </div>

    <!-- What's New + Tour: auto-trigger controllers (D12 gate) -->
    <DashboardController locale={locale} userRoles={user.roles} client:idle />
</AccountLayout>
