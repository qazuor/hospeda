---
/**
 * @file menu-del-dia.astro
 * @description Menú del día section of the venue/experience editor (HOS-1041).
 *
 * Venue only. The section is absent from the experience registry rather
 * than hidden from its nav, so `resolveListingEditorPage` sends an experience
 * request for this slug to the hub — the same mechanism that refuses
 * `punto-de-encuentro` to a restaurant, pointing the other way.
 *
 * `VenueDailySpecialsManager` owns its own endpoints — `GET`/`PUT
 * .../daily-specials` — so this page mounts it directly, with no form and no
 * save button, exactly as `carta.astro` mounts the carta manager and
 * `preguntas.astro` mounts the FAQ manager. Nothing here reaches the listing
 * PATCH or its dirty tracking.
 *
 * ## Why the specials are NOT preloaded server-side
 *
 * Same reason `carta.astro` gives: they are not part of the listing detail
 * payload, so preloading would need a second server-side request. The panel is
 * reached only by navigating to this route, so that is one fetch on the one
 * page that shows it — preloading would move the request, not remove it.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/menu-del-dia/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import SectionUnpublishedNotice from '@/components/listing/SectionUnpublishedNotice.astro';
import { VenueDailySpecialsManager } from '@/components/venue/VenueDailySpecialsManager.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';
import { readLockedSectionCounts } from '@/lib/listing/locked-section-counts';

export const prerender = false;

const resolution = await resolveListingEditorPage({
	astro: Astro,
	sectionSlug: 'menu-del-dia'
});

if (resolution.redirect) return resolution.redirect;
if (resolution.error) return resolution.error;

const { detail, locale, vertical, listingId, sectionId, registry, sectionStates } = resolution;
const { t } = createTranslations(locale);

// HOS-1854. See `carta.astro` for the same wiring: the state comes from the
// resolver's map and only a locked section pays for the count read.
const activeSection = sectionId ? sectionStates[sectionId] : undefined;
const sectionState = activeSection?.state ?? 'available';
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const lockedCounts =
	sectionState === 'locked' && sectionId
		? await readLockedSectionCounts({
				vertical,
				listingId,
				sectionStates: { [sectionId]: activeSection! },
				cookieHeader,
			})
		: {};
const lockedCount = sectionId ? lockedCounts[sectionId] : null;
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="menu-del-dia"
	title={t('listing.owner.editor.sectionNav.dailySpecials', 'Menú del día')}
>
	{typeof lockedCount === 'number' && lockedCount > 0 && (
		<SectionUnpublishedNotice
			locale={locale}
			count={lockedCount}
			sectionLabel={t('listing.owner.editor.sectionNav.dailySpecials', 'Menú del día')}
		/>
	)}

	<VenueDailySpecialsManager
		client:load
		listingId={listingId}
		locale={locale}
		sectionState={sectionState === 'locked' ? 'locked' : 'available'}
	/>
</ListingEditorSectionLayout>
