---
/**
 * @file carta.astro
 * @description Menu section of the food/experience editor (HOS-895).
 *
 * Venue only. The section is absent from the experience registry rather
 * than hidden from its nav, so `resolveListingEditorPage` sends an experience
 * request for this slug to the hub — the same mechanism that refuses
 * `punto-de-encuentro` to a restaurant, pointing the other way.
 *
 * `VenueMenuManager` owns its own endpoints — `GET`/`PUT .../menu` for the
 * carta and `POST`/`DELETE .../menu-file` for the uploaded photo/PDF — so this
 * page mounts it directly, with no form and no save button, exactly as
 * `preguntas.astro` mounts the FAQ manager. Nothing here reaches the listing
 * PATCH or its dirty tracking.
 *
 * ## Why the carta is NOT preloaded server-side, unlike the FAQs
 *
 * `preguntas.astro` reads its FAQs from the listing detail it already has, so
 * preloading them costs nothing. The carta is not part of that payload: it
 * would need a second server-side request, and the panel is now reached only
 * by navigating to this route — one fetch, on the one page that shows it,
 * instead of one on every page of the split editor. Preloading it would move
 * that request rather than remove it.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/carta/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import SectionUnpublishedNotice from '@/components/listing/SectionUnpublishedNotice.astro';
import { VenueMenuManager } from '@/components/venue/VenueMenuManager.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';
import { readLockedSectionCounts } from '@/lib/listing/locked-section-counts';
import { readListingMenuUrl } from '@/lib/listing/listing-editor-detail';

export const prerender = false;

const resolution = await resolveListingEditorPage({ astro: Astro, sectionSlug: 'carta' });

if (resolution.redirect) return resolution.redirect;
if (resolution.error) return resolution.error;

const { detail, locale, vertical, listingId, sectionId, registry, sectionStates } = resolution;
const { t } = createTranslations(locale);

// HOS-1854. The section state is read from the map the resolver already
// fetched; the page never asks the API for it again.
const activeSection = sectionId ? sectionStates[sectionId] : undefined;
const sectionState = activeSection?.state ?? 'available';
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const lockedCounts =
	sectionState === 'locked' && sectionId
		? await readLockedSectionCounts({
				vertical,
				listingId,
				sectionStates: { [sectionId]: activeSection! },
				cookieHeader,
			})
		: {};
const lockedCount = sectionId ? lockedCounts[sectionId] : null;
const menuUrl = readListingMenuUrl({ detail });
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="carta"
	title={t('listing.owner.editor.sectionNav.menu', 'Carta')}
>
	{typeof lockedCount === 'number' && lockedCount > 0 && (
		<SectionUnpublishedNotice
			locale={locale}
			count={lockedCount}
			sectionLabel={t('listing.owner.editor.sectionNav.menu', 'Carta')}
		/>
	)}

	<VenueMenuManager
		client:load
		listingId={listingId}
		locale={locale}
		sectionState={sectionState === 'locked' ? 'locked' : 'available'}
		menuUrl={menuUrl}
	/>
</ListingEditorSectionLayout>
