---
/**
 * @file fotos.astro
 * @description Photo section of the commerce editor (HOS-1080).
 *
 * `MediaSection` persists every photo operation immediately against the
 * relational `gastronomy_media` / `experience_media` endpoints (HOS-372) and
 * hydrates its own state from them, so there is no form and no save button on
 * this page — the same shape the accommodation editor's `fotos` route has. The
 * two values passed in only paint the first frame while it hydrates.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/fotos/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { MediaSection } from '@/components/commerce/editor/MediaSection.client';
import CommerceEditorSectionLayout from '@/layouts/CommerceEditorSectionLayout.astro';
import { readCommerceListingMedia } from '@/lib/commerce/commerce-editor-detail';
import { resolveCommerceEditorPage } from '@/lib/editor/resolve-commerce-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveCommerceEditorPage({ astro: Astro, sectionSlug: 'fotos' });

if (resolution.redirect) return resolution.redirect;

const { detail, locale, vertical, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);

const media = readCommerceListingMedia({ detail });
---

<CommerceEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="fotos"
	title={t('commerce.owner.editor.sectionNav.media', 'Fotos')}
>
	<MediaSection
		client:load
		locale={locale}
		vertical={vertical}
		listingId={listingId}
		initialFeaturedImage={media.featuredImage}
		initialGallery={media.gallery}
	/>
</CommerceEditorSectionLayout>
