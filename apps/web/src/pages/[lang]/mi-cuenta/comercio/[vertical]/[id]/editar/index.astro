---
/**
 * @file mi-cuenta/comercio/[vertical]/[id]/editar/index.astro
 * @description The venue/experience editor hub (HOS-1080, closing HOS-892).
 *
 * Lists every section as a row with a status line. Rendered on BOTH viewports:
 * on mobile it IS the navigation, on desktop it doubles as a status summary of
 * the listing.
 *
 * It deliberately does NOT redirect to the first section, for the reason
 * HOS-318 D-8 recorded on the accommodation side: a redirect traps the back
 * button — from a section, "back" lands on the hub, which bounces forward
 * again — and a back button that does not work is the single most frustrating
 * thing for this editor's audience.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import EditorHub from '@/components/host/editor/EditorHub.astro';
import { HiddenByBusinessLinesSummary } from '@/components/listing/HiddenByBusinessLinesSummary.client';
import ListingNotices from '@/components/listing/ListingNotices.astro';
import SupportEditNotice from '@/components/listing/SupportEditNotice.astro';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorSectionStatuses } from '@/lib/editor/listing-editor-hub-status-model';
import { LISTING_SECTION_PRESENTATION } from '@/lib/editor/listing-section-presentation';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';
import { readListingEditorHubFacts } from '@/lib/listing/listing-editor-detail';
import {
	readAbsentSectionCounts,
	readLockedSectionCounts,
} from '@/lib/listing/locked-section-counts';
import { loadListingNoticesItem } from '@/lib/listing/listing-notices-loader';
import { loadSupportEdits } from '@/lib/listing/support-edits';

export const prerender = false;

const resolution = await resolveListingEditorPage({ astro: Astro, sectionSlug: null });

if (resolution.redirect) return resolution.redirect;
if (resolution.error) return resolution.error;

const { detail, locale, vertical, listingId, registry, sectionStates } = resolution;
const { t } = createTranslations(locale);

const facts = readListingEditorHubFacts({ detail });

// Row 26 (HOS-1493) and the listing notices of HOS-1492 (fix requested,
// moderated, archived, surplus): support's content edits and the notices of the
// listing, read together. The vertical comes from the page resolution. Neither
// blocks the hub: any failure degrades to nothing.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const [supportEdits, listingNotices] = await Promise.all([
	loadSupportEdits({
		vertical,
		listingId,
		cookieHeader,
	}),
	loadListingNoticesItem({
		vertical,
		listingId,
		cookieHeader,
	}),
]);

const hasListingNotices =
	listingNotices.item !== undefined && listingNotices.item.notices.length > 0;

// HOS-1854. The hub only pays these reads for sections the plan withholds:
// `readLockedSectionCounts` filters the map itself, so an all-available listing
// makes no extra request. A failed read yields `null`, and the model renders
// the locked line without a number rather than as "0 cargados".
const lockedCounts = await readLockedSectionCounts({
	vertical,
	listingId,
	sectionStates,
	cookieHeader,
});
const lockedSections = Object.fromEntries(
	Object.entries(sectionStates)
		.filter(([, section]) => section.state === 'locked')
		.map(([sectionId]) => [sectionId, lockedCounts[sectionId] ?? null])
);

// HOS-1787 leaf 5.7 (DEC-FAC-063 / DEC-FAC-075): sections hidden by the
// current business lines. Only the ones that actually hold data get a row, and
// only the owner gets the destructive action — the API compares the actor to
// the subject, so staff is shown the counts without "Vaciar".
const absentCounts = await readAbsentSectionCounts({
	vertical,
	listingId,
	sectionStates: Object.fromEntries(
		Object.entries(sectionStates).filter(([, section]) => section.state === 'absent'),
	),
	cookieHeader,
});
const hiddenSections = Object.entries(absentCounts).flatMap(([sectionId, count]) =>
	typeof count === 'number' && count > 0
		? [
				{
					id: sectionId,
					labelKey:
						LISTING_SECTION_PRESENTATION[vertical][sectionId]?.labelKey ??
						sectionId,
					count,
				},
			]
		: [],
);
const canEmptyHiddenSections = detail.ownerId === Astro.locals.user?.id;

const statuses = resolveListingEditorSectionStatuses({
	input: {
		vertical,
		listing: facts.listing,
		photoCount: facts.photoCount,
		faqCount: facts.faqCount,
		selectedCatalogCount: facts.selectedCatalogCount,
		lockedSections,
	},
});

const verticalLabel = t(`listing.owner.list.badge.${vertical}`, vertical);
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={null}
	currentSectionSlug={null}
	title={detail.name}
	subtitle={t('listing.owner.editor.hub.subtitle', 'Elegí qué querés editar')}
	description={t('listing.owner.editor.pageDescription', 'Editar la información de tu ficha')}
>
	<div class="listing-hub__identity">
		<span class="listing-hub__badge">{verticalLabel}</span>
		<code class="listing-hub__slug">{detail.slug}</code>
	</div>

	{hasListingNotices && (
		<div class="listing-hub__notices" data-testid="editor-hub-listing-notices">
			<ListingNotices
				locale={locale}
				vertical={vertical}
				listingId={listingId}
				item={listingNotices.item}
			/>
		</div>
	)}

	<SupportEditNotice locale={locale} items={supportEdits.items} />

	<HiddenByBusinessLinesSummary
		client:load
		locale={locale}
		listingId={listingId}
		sections={hiddenSections}
		canEmpty={canEmptyHiddenSections}
	/>

	<EditorHub
		locale={locale}
		registry={registry}
		entityId={listingId}
		statuses={statuses}
	/>
</ListingEditorSectionLayout>

<style>
	.listing-hub__identity {
		display: flex;
		align-items: center;
		gap: var(--space-3, 1rem);
		flex-wrap: wrap;
		margin-bottom: var(--space-5, 1.5rem);
	}

	.listing-hub__badge {
		font-size: var(--text-caption, 0.75rem);
		padding: 0.125rem 0.5rem;
		border-radius: var(--radius-pill, 999px);
		background: var(--surface-warm, rgba(0, 0, 0, 0.06));
		color: var(--core-muted-foreground);
	}

	.listing-hub__slug {
		font-size: var(--text-caption, 0.75rem);
		color: var(--core-muted-foreground);
	}

	.listing-hub__notices {
		display: flex;
		flex-direction: column;
		gap: var(--space-3, 0.75rem);
		margin: 0 0 var(--space-5, 1.5rem);
	}
</style>
