---
/**
 * @file precio.astro
 * @description Price section of the gastronomy/experience editor (HOS-1080).
 *
 * The field set differs by vertical — gastronomy carries `priceRange` and
 * `menuUrl`, experience carries `isPriceOnRequest`/`priceFrom`/`priceUnit` —
 * and so do their clearing semantics; `PriceSection` and `buildPatchPayload`
 * own that split between them.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/precio/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { ListingEditor } from '@/components/listing/ListingEditor.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveListingEditorPage({
	astro: Astro,
	sectionSlug: 'precio',
});

if (resolution.redirect) return resolution.redirect;

const { detail, locale, vertical, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="precio"
	title={t('listing.owner.editor.sectionNav.price', 'Precio')}
>
	<ListingEditor
		client:load
		sectionId="price"
		vertical={vertical}
		listingId={listingId}
		locale={locale}
		initialData={detail}
	/>
</ListingEditorSectionLayout>
