---
/**
 * @file traducciones.astro
 * @description Translations section of the gastronomy/experience editor (HOS-1080).
 *
 * The four i18n fields travel as ONE unit through the listing PATCH — the panel
 * edits them together and `buildPatchPayload` emits all four whenever any of
 * them changed.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/traducciones/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { ListingEditor } from '@/components/listing/ListingEditor.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveListingEditorPage({
	astro: Astro,
	sectionSlug: 'traducciones',
});

if (resolution.redirect) return resolution.redirect;

const { detail, locale, vertical, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="traducciones"
	title={t('listing.owner.editor.sectionNav.translations', 'Traducciones')}
>
	<ListingEditor
		client:load
		sectionId="translations"
		vertical={vertical}
		listingId={listingId}
		locale={locale}
		initialData={detail}
	/>
</ListingEditorSectionLayout>
