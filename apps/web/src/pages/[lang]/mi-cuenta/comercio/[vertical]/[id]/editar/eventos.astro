---
/**
 * @file eventos.astro
 * @description Venue-events (agenda) section of the venue/experience editor
 * (HOS-1042).
 *
 * Venue only, same as `carta.astro`. The section is absent from the
 * experience registry rather than hidden from its nav, so
 * `resolveListingEditorPage` sends an experience request for this slug to
 * the hub — the same mechanism that refuses `punto-de-encuentro` to a
 * restaurant, pointing the other way.
 *
 * `VenueEventsManager` owns its own endpoints — `GET`/`PUT
 * .../events` — so this page mounts it directly, with no form and no save
 * button, exactly as `carta.astro` mounts `VenueMenuManager`. Nothing here
 * reaches the listing PATCH or its dirty tracking.
 *
 * ## Why the agenda is NOT preloaded server-side
 *
 * Same reasoning `carta.astro` states for the carta: the agenda is not part
 * of the listing payload the editor is built from, and preloading it would
 * make every editor load pay for a nested document most owners will not open.
 * One fetch, on the one page that shows it.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/eventos/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import SectionUnpublishedNotice from '@/components/listing/SectionUnpublishedNotice.astro';
import { VenueEventsManager } from '@/components/venue/VenueEventsManager.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { WEEKDAY_I18N_KEYS } from '@/lib/venue/venue-event-draft';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';
import { readLockedSectionCounts } from '@/lib/listing/locked-section-counts';

export const prerender = false;

const resolution = await resolveListingEditorPage({ astro: Astro, sectionSlug: 'eventos' });

if (resolution.redirect) return resolution.redirect;
if (resolution.error) return resolution.error;

const { detail, locale, vertical, listingId, sectionId, registry, sectionStates } = resolution;
const { t } = createTranslations(locale);

// HOS-1854. See `carta.astro` for the same wiring: the state comes from the
// resolver's map and only a locked section pays for the count read.
const activeSection = sectionId ? sectionStates[sectionId] : undefined;
const sectionState = activeSection?.state ?? 'available';
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const lockedCounts =
	sectionState === 'locked' && sectionId
		? await readLockedSectionCounts({
				vertical,
				listingId,
				sectionStates: { [sectionId]: activeSection! },
				cookieHeader,
			})
		: {};
const lockedCount = sectionId ? lockedCounts[sectionId] : null;

/**
 * The weekday picker's seven labels, resolved HERE and passed down.
 *
 * They live under `venue.detail.openingHours.*` — the set
 * `OpeningHoursSection` already owns — and that prefix deliberately does not
 * ship to the browser: 25 of its 32 keys are named only by `.astro` files
 * rendering server-side, so adding it to `CLIENT_I18N_KEY_PREFIXES` would push
 * 1,205 B brotli of never-named strings into the client dictionary to deliver
 * 303 B of useful ones (measured). SSR reads the full catalog, so resolving
 * them on this side costs nothing and avoids a second copy of the day names.
 *
 * Same pattern, and the same stated reason, as `AccommodationsListingMap`'s
 * `typeLabels`: the island stays i18n-agnostic for these strings.
 */
const weekdayLabels = WEEKDAY_I18N_KEYS.map((dayKey) =>
	t(`venue.detail.openingHours.${dayKey}`, dayKey)
);
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="eventos"
	title={t('listing.owner.editor.sectionNav.venueEvents', 'Eventos')}
>
	{typeof lockedCount === 'number' && lockedCount > 0 && (
		<SectionUnpublishedNotice
			locale={locale}
			count={lockedCount}
			sectionLabel={t('listing.owner.editor.sectionNav.venueEvents', 'Eventos')}
		/>
	)}

	<VenueEventsManager
		client:load
		listingId={listingId}
		locale={locale}
		weekdayLabels={weekdayLabels}
		sectionState={sectionState === 'locked' ? 'locked' : 'available'}
	/>
</ListingEditorSectionLayout>
