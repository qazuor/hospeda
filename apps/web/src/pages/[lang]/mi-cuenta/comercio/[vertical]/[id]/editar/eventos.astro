---
/**
 * @file eventos.astro
 * @description Venue-events (agenda) section of the commerce editor
 * (HOS-1042).
 *
 * Gastronomy only, same as `carta.astro`. The section is absent from the
 * experience registry rather than hidden from its nav, so
 * `resolveCommerceEditorPage` sends an experience request for this slug to
 * the hub — the same mechanism that refuses `punto-de-encuentro` to a
 * restaurant, pointing the other way.
 *
 * `CommerceVenueEventsManager` owns its own endpoints — `GET`/`PUT
 * .../events` — so this page mounts it directly, with no form and no save
 * button, exactly as `carta.astro` mounts `CommerceMenuManager`. Nothing here
 * reaches the listing PATCH or its dirty tracking.
 *
 * ## Why the agenda is NOT preloaded server-side
 *
 * Same reasoning `carta.astro` states for the carta: the agenda is not part
 * of the listing payload the editor is built from, and preloading it would
 * make every editor load pay for a nested document most owners will not open.
 * One fetch, on the one page that shows it.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/eventos/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { CommerceVenueEventsManager } from '@/components/commerce/CommerceVenueEventsManager.client';
import CommerceEditorSectionLayout from '@/layouts/CommerceEditorSectionLayout.astro';
import { resolveCommerceEditorPage } from '@/lib/editor/resolve-commerce-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveCommerceEditorPage({ astro: Astro, sectionSlug: 'eventos' });

if (resolution.redirect) return resolution.redirect;

const { detail, locale, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);
---

<CommerceEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="eventos"
	title={t('commerce.owner.editor.sectionNav.venueEvents', 'Eventos')}
>
	<CommerceVenueEventsManager
		client:load
		listingId={listingId}
		locale={locale}
	/>
</CommerceEditorSectionLayout>
