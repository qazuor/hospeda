---
/**
 * @file preguntas.astro
 * @description FAQ section of the gastronomy/experience editor (HOS-1080).
 *
 * `ListingFaqManager` owns its own endpoints (HOS-811) — nothing here reaches
 * the listing PATCH or its dirty tracking — so this page mounts it directly,
 * with no form and no save button, exactly as the accommodation editor's
 * `preguntas` route does.
 *
 * The FAQs are preloaded server-side so the manager paints real data on first
 * paint rather than flashing empty and filling in.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/preguntas/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { ListingFaqManager } from '@/components/listing/ListingFaqManager.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { readListingFaqs } from '@/lib/listing/listing-editor-detail';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveListingEditorPage({ astro: Astro, sectionSlug: 'preguntas' });

if (resolution.redirect) return resolution.redirect;

const { detail, locale, vertical, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);

const initialFaqs = readListingFaqs({ detail });
---

<ListingEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="preguntas"
	title={t('listing.owner.editor.sectionNav.faqs', 'Preguntas frecuentes')}
>
	<ListingFaqManager
		client:load
		vertical={vertical}
		listingId={listingId}
		locale={locale}
		initialFaqs={initialFaqs}
	/>
</ListingEditorSectionLayout>
