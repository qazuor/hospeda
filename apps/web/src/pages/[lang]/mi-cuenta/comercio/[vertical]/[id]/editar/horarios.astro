---
/**
 * @file horarios.astro
 * @description Opening-hours section of the commerce editor (HOS-1080).
 *
 * `openingHours` is seven days x N shifts under ONE Zod key, so its validation
 * errors arrive at nested paths; the editor rolls the first nested message up
 * to the bare key (HOS-814) which is what makes the field error and the focus
 * move work at all.
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/horarios/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */

import { CommerceListingEditor } from '@/components/commerce/CommerceListingEditor.client';
import CommerceEditorSectionLayout from '@/layouts/CommerceEditorSectionLayout.astro';
import { resolveCommerceEditorPage } from '@/lib/editor/resolve-commerce-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveCommerceEditorPage({
	astro: Astro,
	sectionSlug: 'horarios',
});

if (resolution.redirect) return resolution.redirect;

const { detail, locale, vertical, listingId, sectionId, registry } = resolution;
const { t } = createTranslations(locale);
---

<CommerceEditorSectionLayout
	locale={locale}
	registry={registry}
	listingId={listingId}
	listingName={detail.name}
	currentSectionId={sectionId}
	currentSectionSlug="horarios"
	title={t('commerce.owner.editor.sectionNav.openingHours', 'Horarios')}
>
	<CommerceListingEditor
		client:load
		sectionId="openingHours"
		vertical={vertical}
		listingId={listingId}
		locale={locale}
		initialData={detail}
	/>
</CommerceEditorSectionLayout>
