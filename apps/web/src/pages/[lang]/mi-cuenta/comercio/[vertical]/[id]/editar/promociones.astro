---
/** Owner editor section for venue promotions (HOS-2271). */
import { VenuePromotionsManager } from '@/components/venue/VenuePromotionsManager.client';
import ListingEditorSectionLayout from '@/layouts/ListingEditorSectionLayout.astro';
import { resolveListingEditorPage } from '@/lib/editor/resolve-listing-editor-page';
import { createTranslations } from '@/lib/i18n';
import { fetchAudiencePlans } from '@/lib/billing/audience-plans';
import { fetchPublicPlans } from '@/lib/billing/fetch-plans';
import { readPromotionPolicy } from '@/lib/promotions/promotion-policy';
import {
    getVenuePromotionLimitPlanOptions,
    resolveVenueUpsellPlans
} from '@/lib/venue/section-upsell-plan';

import { guardVenueOrExperienceArea } from '@/lib/account/publisher-access';

export const prerender = false;
const denied = guardVenueOrExperienceArea({ astro: Astro });
if (denied) return denied;
const resolution = await resolveListingEditorPage({ astro: Astro, sectionSlug: 'promociones' });
if (resolution.redirect) return resolution.redirect;
if (resolution.error) return resolution.error;
const { detail, locale, listingId, sectionId, registry, sectionStates } = resolution;
const { t } = createTranslations(locale);
const [plans, touristPlans] = await Promise.all([
    fetchAudiencePlans({ audience: 'venue' }),
    fetchPublicPlans({ vertical: 'tourist' })
]);
// HOS-2589: the audience texts read X and the VIP plan name from the tourist catalog.
const { freeQuota, vipPlanName } = readPromotionPolicy({ result: touristPlans });
const upsellPlans = resolveVenueUpsellPlans({ plans, t });
const promotionLimitPlans = getVenuePromotionLimitPlanOptions({ plans, t });
const sectionState = sectionId ? sectionStates[sectionId]?.state ?? 'available' : 'available';
---

<ListingEditorSectionLayout
    locale={locale}
    registry={registry}
    listingId={listingId}
    listingName={detail.name}
    currentSectionId={sectionId}
    currentSectionSlug="promociones"
    title={t('listing.owner.editor.sectionNav.venuePromotions', 'Promociones')}
>
    <VenuePromotionsManager
        client:load
        listingId={listingId}
        locale={locale}
        sectionState={sectionState === 'locked' ? 'locked' : 'available'}
        upsellPlanName={upsellPlans.promotions}
        limitPlanOptions={promotionLimitPlans}
        freeQuota={freeQuota}
        vipPlanName={vipPlanName}
    />
</ListingEditorSectionLayout>
