---
/**
 * @file mi-cuenta/comercio/[vertical]/[id]/editar.astro
 * @description Operational + identity editor for one commerce listing owned
 * by the authenticated COMMERCE_OWNER (SPEC-249 Part A). Mounts the editor
 * island, which now ALSO covers `name`/`destinationId` (HOS-166 D-1 — SPEC-239
 * decision #5 reversed: the owner loads their own identity). `slug` stays
 * shown read-only in the page header — the owner never edits it directly. The
 * server keeps it aligned with the name while the listing is still a draft,
 * then stops auto-changing it after publication (HOS-784 stage 1).
 *
 * @route     /[lang]/mi-cuenta/comercio/[vertical]/[id]/editar/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */
import type { CommerceFaq } from '@/components/commerce/CommerceFaqManager.client';
import { CommerceListingEditor } from '@/components/commerce/CommerceListingEditor.client';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { destinationsApi } from '@/lib/api/endpoints';
import { transformAmenityList } from '@/lib/api/transforms';
import { isListingPublished } from '@/lib/listing-slug-refresh';
import { hasCommerceNavAccess } from '@/lib/nav-gating';
import {
    type CommerceVertical,
    fetchOwnerListingDetail
} from '@/lib/commerce/owner-listings';
import { getApiUrl } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}
// HOS-296: gate through the shared `nav-gating` predicate over the role SET,
// so a COMMERCE_OWNER who is ALSO a HOST keeps commerce access (AC-1).
if (!hasCommerceNavAccess({ roles: user.roles })) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}

const verticalParam = Astro.params.vertical;
const id = Astro.params.id;
const isVertical = verticalParam === 'gastronomy' || verticalParam === 'experience';
if (!isVertical || !id) {
    return new Response(null, { status: 404 });
}
const vertical = verticalParam as CommerceVertical;

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const detail = await fetchOwnerListingDetail({ vertical, id, cookieHeader });

// Defensive UX gate: the protected getById does not enforce ownership, so a
// non-owner (and non-staff) is bounced back to their listing index. The write
// path (updateOwn) is the hard gate.
// HOS-296: staff check over the role SET — an admin who also holds
// COMMERCE_OWNER is still staff here.
const isStaff = user.roles.includes('ADMIN') || user.roles.includes('SUPER_ADMIN');
const ownsListing = detail !== null && detail.ownerId === user.id;
if (!detail || (!ownsListing && !isStaff)) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta/comercio' }));
}

// Amenity + feature catalogs for the multi-select (public, no auth needed).
// Degrade cleanly: a failed catalog fetch hides the group rather than 500ing.
const apiUrl = getApiUrl();
let amenities: ReturnType<typeof transformAmenityList> = [];
let features: ReturnType<typeof transformAmenityList> = [];
try {
    // SPEC-266: filter catalog to the listing's actual vertical so a brewery
    // (gastronomy) only sees gastronomy-scoped amenities/features, and an
    // experience listing sees experience-scoped ones. The `[vertical]` route
    // param is already validated above as 'gastronomy' | 'experience'.
    const [amenitiesRes, featuresRes] = await Promise.all([
        fetch(`${apiUrl}/api/v1/public/amenities?pageSize=100&applicableVertical=${vertical}`),
        fetch(`${apiUrl}/api/v1/public/features?pageSize=100&applicableVertical=${vertical}`)
    ]);
    if (amenitiesRes.ok) {
        const body = (await amenitiesRes.json()) as { data?: { items?: Record<string, unknown>[] } };
        amenities = transformAmenityList({ items: body.data?.items ?? [] });
    }
    if (featuresRes.ok) {
        const body = (await featuresRes.json()) as { data?: { items?: Record<string, unknown>[] } };
        features = transformAmenityList({ items: body.data?.items ?? [] });
    }
} catch {
    // Catalog unavailable — the editor renders without the amenities/features group.
}

// HOS-166 D-1: `name`/`destinationId` are now owner-editable (SPEC-239
// decision #5 reversed — see gastronomy.crud.schema.ts's JSDoc), so the
// destination catalog is needed here too, mirroring
// `publicar-restaurante/index.astro` and the create page.
const destinationsResult = await destinationsApi.list({ destinationType: 'CITY', pageSize: 100 });
const destinations = destinationsResult.ok
    ? destinationsResult.data.items.map((item) => ({ id: item.id, name: item.name }))
    : [];
// HOS-166 judgment-day fix: distinguish "the catalog fetch failed" from "the
// catalog genuinely has zero destinations" so the editor can surface an error
// instead of silently omitting a REQUIRED completeness field — see
// `CommerceListingEditor`'s `destinationsLoadFailed` prop doc.
const destinationsLoadFailed = !destinationsResult.ok;

// HOS-834: the address notice states ONE state, the one this listing is
// actually in. The previous single line described both at once ("follows the
// name while unpublished; once published it stops") and never said which
// applied, so on a published listing its first half described something that
// does not happen to it. Resolved through `isListingPublished` — the same
// predicate that gates the slug-refresh opt-in inside the editor (HOS-784), so
// the sentence above the form and the behaviour below it can never disagree.
const listingIsPublished = isListingPublished({
    lifecycleState: (detail as unknown as Record<string, unknown>).lifecycleState as
        | string
        | null
        | undefined
});

const title = t('commerce.owner.list.edit', 'Editar');
const verticalLabel = t(`commerce.owner.list.badge.${vertical}`, vertical);

// Extract FAQs for the CommerceFaqManager — safe cast via unknown bridge.
// The protected schema includes faqs when available; fallback to empty array.
const rawFaqs = (detail as unknown as Record<string, unknown>).faqs;
const initialFaqs: CommerceFaq[] = Array.isArray(rawFaqs)
    ? (rawFaqs as Array<Record<string, unknown>>).map((f) => ({
          id: typeof f.id === 'string' ? f.id : '',
          question: typeof f.question === 'string' ? f.question : '',
          answer: typeof f.answer === 'string' ? f.answer : '',
          category: typeof f.category === 'string' ? f.category : null,
          displayOrder: typeof f.displayOrder === 'number' ? f.displayOrder : null
      }))
    : [];
---

<AccountLayout locale={locale} title={`${title}: ${detail.name}`} activeSection="comercio">
    <div class="ce-identity">
        <div class="ce-identity__head">
            <h2 class="ce-identity__name">{detail.name}</h2>
            <span class="ce-identity__badge">{verticalLabel}</span>
        </div>
        <p class="ce-identity__slug"><code>{detail.slug}</code></p>
        <p class="ce-identity__notice">
            {listingIsPublished
                ? t(
                      'commerce.owner.editor.slugFixedNotice',
                      'La dirección pública ya está fija: cambiar el nombre no la modifica.'
                  )
                : t(
                      'commerce.owner.editor.slugFollowsNameNotice',
                      'La dirección pública va a seguir al nombre hasta que publiques la ficha.'
                  )}
        </p>
    </div>

    {/*
        HOS-371: deliberately NOT wrapped in an AccountSectionCard. The editor
        now renders one card PER section internally (same as the accommodation
        editor), so an outer card would nest cards — double border, double
        padding, and two stacked brand accent bars.
    */}
    <CommerceListingEditor
        client:load
        vertical={vertical}
        listingId={id}
        locale={locale}
        initialData={detail}
        amenities={amenities}
        features={features}
        destinations={destinations}
        destinationsLoadFailed={destinationsLoadFailed}
        hasFaqSection={true}
        initialFaqs={initialFaqs}
    />
</AccountLayout>

<style>
    .ce-identity {
        margin-bottom: var(--space-6);
        padding-bottom: var(--space-4);
        border-bottom: 1px solid var(--border);
    }

    .ce-identity__head {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }

    .ce-identity__name {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.5rem, 3vw, 2rem);
        color: var(--core-foreground);
        margin: 0;
    }

    .ce-identity__badge {
        font-size: var(--text-caption, 0.75rem);
        padding: 0.125rem 0.5rem;
        border-radius: var(--radius-pill, 999px);
        background: var(--surface-warm, rgba(0, 0, 0, 0.06));
        color: var(--core-muted-foreground);
    }

    .ce-identity__slug {
        margin: 0.25rem 0 0;
        font-size: var(--text-caption, 0.75rem);
        color: var(--core-muted-foreground);
    }

    .ce-identity__notice {
        margin: var(--space-3) 0 0;
        font-size: var(--text-body-sm, 0.9375rem);
        color: var(--core-muted-foreground);
    }
</style>
