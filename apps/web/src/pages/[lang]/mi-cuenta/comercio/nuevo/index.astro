---
/**
 * @file mi-cuenta/comercio/nuevo/index.astro
 * @description Permanent redirect to `/{lang}/publicar/` (HOS-1156 D-6).
 *
 * ## What was here
 *
 * A two-card vertical picker: gastronomía or experiencia, each linking to
 * `[vertical].astro`'s create form. The three publish pages are the picker now
 * — the header's "Publicar" menu offers all three verticals, and each one leads
 * straight to its own form rather than to a page that asks which form you meant.
 *
 * The picker's own copy (`commerce.owner.create.pickVertical.*`) is retired with
 * it; nothing else reads those keys.
 *
 * A signed-in commerce owner who presses "+ Nuevo comercio" on
 * `/mi-cuenta/comercio/` is NOT sent here — that button goes to
 * `/mi-cuenta/publica/`, the hub that lists all three verticals and knows which
 * ones the account already holds. This 301 is for old inbound links, and its
 * target is the one D-6 settled on.
 *
 * @route     /{lang}/mi-cuenta/comercio/nuevo/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PUBLISH_PAGE_PATH_BY_VERTICAL.accommodation,
        search: Astro.url.search
    }),
    301
);
---
