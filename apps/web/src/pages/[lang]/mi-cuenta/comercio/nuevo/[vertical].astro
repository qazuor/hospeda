---
/**
 * @file mi-cuenta/comercio/nuevo/[vertical].astro
 * @description Owner self-service commerce-listing create page (HOS-166
 * §7.2, §8 point 2). Fetches the destination catalog SSR (mirrors
 * `publicar-restaurante/index.astro`) and mounts `CommerceCreateForm`.
 *
 * ## D-4 pre-fill (HOS-257)
 *
 * This page fetches the caller's own lead via `fetchMyCommerceLead`
 * (`GET /api/v1/protected/commerce/leads/mine` — a protected READ endpoint;
 * this surface never imports the lead service or table directly, enforced by
 * the AC-14 static guard). The fetch is PRE-FILL ONLY, never a gate: a `null`
 * result (no lead, or the request failed) still renders the form fully
 * usable with no `prefill` (AC-10/AC-11) — exactly the behaviour this page
 * already had before HOS-257. `Astro.locals.user.name` is still NEVER used
 * for `prefill.name` — that field is the owner's PERSONAL name, not their
 * business name, and forcing it in would plant actively wrong data.
 *
 * ## Access (HOS-687)
 *
 * A session, and nothing else. This page no longer requires a commerce role —
 * submitting its form is what GRANTS one. See the guard comment below.
 *
 * @route     /[lang]/mi-cuenta/comercio/nuevo/[vertical]/
 * @rendering SSR (prerender = false — authenticated, any signed-in account)
 */
import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import AccountSectionCard from '@/components/account/AccountSectionCard.astro';
import { CommerceCreateForm } from '@/components/commerce/CommerceCreateForm.client';
import type { CommerceVertical } from '@/lib/commerce/owner-listings';
import { fetchMyCommerceLead } from '@/lib/commerce/owner-listings';
import { destinationsApi } from '@/lib/api/endpoints';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// HOS-687: a SESSION is the only thing this page requires. The shared
// commerce nav-access predicate that used to gate it here is gone on purpose:
// it demanded COMMERCE_EDIT_OWN, which only a COMMERCE_OWNER holds — so the
// one page that grants that role turned away everyone who did not already
// have it. The listing index and the editor keep their role gate; they list
// and edit listings that must already exist. This mirrors
// `publicar/nueva.astro`, which requires a session and nothing else.
//
// The return URL is carried through sign-in (`buildLoginRedirect`) so an
// anonymous visitor lands back on THIS vertical's form, not on /mi-cuenta
// (HOS-589 AC-18). Note `mi-cuenta` is in `PROTECTED_SEGMENTS`, so the
// middleware normally redirects first with the same helper — this in-page
// guard is the belt to that suspenders, and it must not lose the URL either.
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname }));
}

const verticalParam = Astro.params.vertical;
const isVertical = verticalParam === 'gastronomy' || verticalParam === 'experience';
if (!isVertical) {
    return new Response(null, { status: 404 });
}
const vertical = verticalParam as CommerceVertical;

const title =
    vertical === 'gastronomy'
        ? t('commerce.owner.create.title.gastronomy', 'Crear ficha de gastronomía')
        : t('commerce.owner.create.title.experience', 'Crear ficha de experiencia');
const subtitle = t(
    'commerce.owner.create.subtitle',
    'Completá lo básico ahora — vas a poder sumar fotos, horarios y más detalles después.'
);

// The destinations catalog and the caller's own lead are independent SSR
// fetches — run them in parallel to save a round-trip on every create-page load.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const [destinationsResult, myLead] = await Promise.all([
    destinationsApi.list({ destinationType: 'CITY', pageSize: 100 }),
    // HOS-257 D-4: pre-fill ONLY — `myLead` is `null` for the common case (no
    // provisioned lead) or on any fetch failure, and the form renders
    // identically usable either way (AC-10/AC-11). See module doc.
    //
    // H-155: scoped to THIS vertical. Unscoped, the owner's most recent lead in
    // ANY vertical was used, so the experience form pre-filled itself with a
    // gastronomy lead's business name — and that name becomes an immutable slug.
    fetchMyCommerceLead({ vertical, cookieHeader })
]);
const destinations = destinationsResult.ok
    ? destinationsResult.data.items.map((item) => ({ id: item.id, name: item.name }))
    : [];
// HOS-166 judgment-day fix: distinguish "the catalog fetch failed" from "the
// catalog genuinely has zero destinations" so the form can surface an error
// instead of silently omitting a REQUIRED completeness field — see
// `CommerceCreateForm`'s `destinationsLoadFailed` prop doc.
const destinationsLoadFailed = !destinationsResult.ok;
const prefill = myLead
    ? {
          name: myLead.name,
          ...(myLead.destinationId ? { destinationId: myLead.destinationId } : {})
      }
    : undefined;
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="comercio">
    <AccountPageHeader title={title} description={subtitle} />

    <AccountSectionCard>
        <CommerceCreateForm
            client:load
            vertical={vertical}
            locale={locale}
            destinations={destinations}
            destinationsLoadFailed={destinationsLoadFailed}
            prefill={prefill}
        />
    </AccountSectionCard>
</AccountLayout>
