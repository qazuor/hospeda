---
/**
 * @file mi-cuenta/comercio/nuevo/[vertical].astro
 * @description Permanent redirect to `/{lang}/publicar/{vertical}/`, the
 * vertical's publish page (HOS-1156 D-6).
 *
 * ## What was here
 *
 * The owner self-service commerce create form, inside `AccountLayout` and behind
 * an in-page login redirect. D-2 moved it to `MarketingLayout` so the three
 * publish pages look alike, and D-1 replaced the login redirect with a signup
 * CTA — a page reached from a PUBLIC navbar button must not bounce a cold
 * visitor to a login screen before they have read what they are signing up for.
 * The form ISLAND is unchanged; it never depended on the layout.
 *
 * ## An unknown vertical still 404s
 *
 * The old page answered 404 for anything that was not `gastronomy` or
 * `experience`, and so does this. Redirecting an unknown segment to a publish
 * page would turn a typo into a 301 and advertise a URL that never existed.
 *
 * @route     /{lang}/mi-cuenta/comercio/nuevo/{vertical}/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';

export const prerender = false;

const locale = Astro.locals.locale;

const verticalParam = Astro.params.vertical;
if (verticalParam !== 'gastronomy' && verticalParam !== 'experience') {
    return new Response(null, { status: 404 });
}

return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PUBLISH_PAGE_PATH_BY_VERTICAL[verticalParam],
        search: Astro.url.search
    }),
    301
);
---
