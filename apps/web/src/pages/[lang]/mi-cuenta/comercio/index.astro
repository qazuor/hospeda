---
/**
 * @file mi-cuenta/comercio/index.astro
 * @description Commerce owner self-service listing index (SPEC-249 Part A,
 * extended in HOS-166 PR-C with the create CTA and the per-listing state
 * machine — badge, completeness checklist, and publish+pay CTA).
 * Lists the authenticated COMMERCE_OWNER's own listings across both verticals
 * (gastronomy + experiences) and deep-links each to its operational editor.
 *
 * Auth: middleware protects /mi-cuenta/* (session required). This page adds a
 * role gate so only commerce owners (and staff) reach it.
 *
 * @route     /[lang]/mi-cuenta/comercio/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */
import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import AccountSectionCard from '@/components/account/AccountSectionCard.astro';
import { CommerceListingActions } from '@/components/commerce/CommerceListingActions.client';
import { hasCommerceNavAccess } from '@/lib/nav-gating';
import type { CommerceVertical } from '@/lib/commerce/owner-listings';
import { fetchOwnerCommerceListingsWithState } from '@/lib/commerce/owner-listings';
import { fetchCommerceUsageByVertical } from '@/lib/commerce/usage-badge';
import { buildUrl } from '@/lib/urls';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

// Role gate: only commerce owners (and staff) may manage commerce listings.
// HOS-296: gate through the shared `nav-gating` predicate over the role SET,
// so a COMMERCE_OWNER who is ALSO a HOST keeps commerce access (AC-1).
if (!hasCommerceNavAccess({ roles: user.roles })) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}

const title = t('commerce.owner.list.title', 'Mi comercio');
const subtitle = t('commerce.owner.list.subtitle', '');

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const listings = await fetchOwnerCommerceListingsWithState({ cookieHeader });

// ── HOS-689 item 1: one usage/limit badge PER VERTICAL the owner actually
// holds a listing in. Two verticals are two INDEPENDENT readings — never a
// merged number (§6.8 already refused a pooled cap for the same reason). ──
const verticalsWithListings = [...new Set(listings.map((listing) => listing.vertical))];
const usageByVertical = await fetchCommerceUsageByVertical({
    verticals: verticalsWithListings,
    cookieHeader
});

// HOS-689 item 4: a resolved (non-null) usage reading for a vertical IS
// proof the owner already holds a subscription there (see
// `fetchCommerceVerticalUsage`'s doc) — the signal that decides whether a
// listing's CTA is "Publicar y pagar" (first listing, real checkout) or a
// plain "Publicar" (later listings, silently attached, no payment — HOS-688
// §6.8 branch 2).
const verticalsWithSubscription = new Set<CommerceVertical>(
    verticalsWithListings.filter((vertical) => usageByVertical.get(vertical) !== null)
);

const createUrl = buildUrl({ locale, path: 'mi-cuenta/comercio/nuevo' });
const addonsUrl = buildUrl({ locale, path: 'mi-cuenta/addons' });

/** Usage badges to render — pre-filtered so the template stays a plain `.map()`. */
const usageBadges = verticalsWithListings.flatMap((vertical) => {
    const usage = usageByVertical.get(vertical);
    return usage && usage.maxAllowed > 0 ? [{ vertical, usage }] : [];
});
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="comercio">
    <div class="mc-header">
        <AccountPageHeader title={title} description={subtitle || undefined} />
        <a
            class="mc-create-cta"
            href={createUrl}
        >
            {t('commerce.owner.list.createCta', '+ Nuevo comercio')}
        </a>
    </div>

    {usageBadges.length > 0 && (
        <div class="mc-usage-row">
            {usageBadges.map(({ vertical, usage }) => (
                <div class={`mc-usage mc-usage--${usage.threshold}`} role="status">
                    <span class="mc-usage__label">
                        {tPlural(`commerce.owner.list.usage.${vertical}.label`, usage.maxAllowed, {
                            current: usage.currentUsage,
                            max: usage.maxAllowed
                        })}
                    </span>
                    {usage.threshold !== 'ok' && (
                        <a href={addonsUrl} class="mc-usage__upgrade">
                            {t('commerce.owner.list.usage.upgrade', 'Ampliar cupo')}
                        </a>
                    )}
                </div>
            ))}
        </div>
    )}

    <AccountSectionCard>
        {
            listings.length === 0 ? (
                <div class="mc-empty">
                    <p class="mc-empty__text">
                        {t(
                            'commerce.owner.list.empty',
                            'Todavía no tenés comercios. Creá tu primera ficha para empezar.'
                        )}
                    </p>
                    <a
                        class="mc-empty__cta"
                        href={createUrl}
                    >
                        {t('commerce.owner.list.emptyCta', 'Crear mi primer comercio')}
                    </a>
                </div>
            ) : (
                <ul class="mc-list">
                    {listings.map((listing) => (
                        <li class="mc-list__item">
                            <div class="mc-list__main">
                                <span class="mc-list__name">{listing.name}</span>
                                <span class="mc-badge">
                                    {t(`commerce.owner.list.badge.${listing.vertical}`, listing.vertical)}
                                </span>
                            </div>

                            <CommerceListingActions
                                client:visible
                                listing={listing}
                                locale={locale}
                                hasVerticalSubscription={verticalsWithSubscription.has(listing.vertical)}
                            />

                            <a
                                class="mc-list__edit"
                                href={buildUrl({
                                    locale,
                                    path: `mi-cuenta/comercio/${listing.vertical}/${listing.id}/editar`
                                })}
                            >
                                {t('commerce.owner.list.edit', 'Editar')}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </AccountSectionCard>
</AccountLayout>

<style>
    .mc-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .mc-create-cta {
        flex-shrink: 0;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-button, 0.5rem);
        background: var(--brand-accent);
        color: var(--accent-foreground);
        font-weight: 600;
        font-size: var(--text-body-sm, 0.9375rem);
        text-decoration: none;
        transition: opacity 150ms ease;
    }

    .mc-create-cta:hover {
        opacity: 0.85;
    }

    .mc-empty {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .mc-empty__text {
        margin: 0;
        color: var(--core-muted-foreground);
        font-size: var(--text-body-sm, 0.9375rem);
    }

    .mc-empty__cta {
        padding: var(--space-3) var(--space-8);
        border-radius: var(--radius-button, 0.5rem);
        background: var(--brand-accent);
        color: var(--accent-foreground);
        font-weight: 600;
        text-decoration: none;
        transition: opacity 150ms ease;
    }

    .mc-empty__cta:hover {
        opacity: 0.85;
    }

    .mc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .mc-list__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
        padding: var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius-md, 0.5rem);
        background: var(--core-card, var(--core-background));
    }

    .mc-list__main {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
        min-width: 0;
    }

    .mc-list__name {
        font-weight: 600;
        color: var(--core-foreground);
    }

    .mc-badge {
        font-size: var(--text-caption, 0.75rem);
        padding: 0.125rem 0.5rem;
        border-radius: var(--radius-pill, 999px);
        background: var(--surface-warm, rgba(0, 0, 0, 0.06));
        color: var(--core-muted-foreground);
    }

    .mc-list__edit {
        flex-shrink: 0;
        font-weight: 600;
        color: var(--brand-primary, var(--core-foreground));
        text-decoration: none;
    }

    .mc-list__edit:hover {
        text-decoration: underline;
    }

    /* ── HOS-689 item 1: per-vertical usage/limit badges ── */
    .mc-usage-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3, 0.75rem);
        margin-bottom: var(--space-6, 1.5rem);
    }

    .mc-usage {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3, 0.75rem);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-pill, 9999px);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 500;
        background-color: var(--surface-warm, oklch(0.96 0.02 60));
        color: var(--core-foreground);
        border: 1px solid var(--border);
    }

    .mc-usage--ok {
        background-color: oklch(0.95 0.04 145);
        color: oklch(0.35 0.12 145);
        border-color: oklch(0.85 0.08 145);
    }

    .mc-usage--warning {
        background-color: oklch(0.95 0.05 65);
        color: oklch(0.4 0.12 65);
        border-color: oklch(0.85 0.1 65);
    }

    .mc-usage--critical,
    .mc-usage--exceeded {
        background-color: oklch(0.95 0.04 25);
        color: oklch(0.45 0.15 25);
        border-color: oklch(0.85 0.1 25);
    }

    .mc-usage__label {
        white-space: nowrap;
    }

    .mc-usage__upgrade {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-pill, 9999px);
        background-color: var(--brand-primary);
        color: var(--primary-foreground, #ffffff);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.75rem;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 150ms ease-out;
    }

    .mc-usage__upgrade:hover {
        opacity: 0.88;
    }
</style>
