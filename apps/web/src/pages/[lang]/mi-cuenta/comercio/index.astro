---
/**
 * @file mi-cuenta/comercio/index.astro
 * @description Venue/experience owner self-service listing index (SPEC-249 Part A,
 * extended in HOS-166 PR-C with the create CTA and the per-listing state
 * machine — badge, completeness checklist, and publish+pay CTA).
 * HOS-1757 restores per-vertical published usage badges from effective limits.
 * Lists the authenticated owner's own listings of ONE vertical and deep-links
 * each to its operational editor. HOS-2559 split the page in two lists, one
 * per area of the sidebar: `?vertical=venue` («Comer y salir») and
 * `?vertical=experience` («Experiencias»), see
 * `lib/listing/owner-list-vertical.ts`.
 *
 * Auth: middleware protects /mi-cuenta/* (session required). Each list is
 * gated by its vertical's own-edit permission (`VENUE_EDIT_OWN` /
 * `EXPERIENCE_EDIT_OWN`) from the EFFECTIVE permissions, never a role. A URL
 * with no list, or with a list the person cannot open, redirects to the first
 * list they can; a person with neither goes back to `/mi-cuenta/`.
 *
 * @route     /[lang]/mi-cuenta/comercio/?vertical=venue|experience
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */
import AccountLayout from '@/layouts/AccountLayout.astro';
import {
    Alert,
    EmptyState,
    LinkButton,
    PageHeader
} from '@/components/account/ui';
// Hydrated island: imported from its module, not the barrel, so the island
// bundle carries the menu and not the whole kit.
import OwnerListingCard from '@/components/account/OwnerListingCard.astro';
import OwnerListingsByState from '@/components/account/OwnerListingsByState.astro';
import { bucketOwnerListings, type OwnerListingBucket } from '@/lib/listing/owner-listing-buckets';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { PageLoadError } from '@/components/account/PageLoadError.client';
import { ListingViewsWidget } from '@/components/listing/ListingViewsWidget.client';
import { TourController } from '@/components/account/TourController.client';
import { VenueMenuQrWidget } from '@/components/venue/VenueMenuQrWidget.client';
import { VenueListingStatsPanel } from '@/components/venue/VenueListingStatsPanel.client';
import { listingAnalyticsApi, publishApi } from '@/lib/api/endpoints-protected';
import {
    EMPTY_LISTING_NOTICES_INDEX,
    indexListingNotices,
    type ListingNoticesIndex
} from '@/lib/listing/listing-notices';
import { webLogger as logger } from '@/lib/logger';
import {
    fetchOwnerListingsWithState,
    isVenueListing,
    OwnerListingsUnavailableError,
    type OwnerListingSummaryWithState,
    VENUE_VERTICAL
} from '@/lib/listing/owner-listings';
import { resolveListingPublishAffordances } from '@/lib/listing/listing-publish-affordance';
import { resolveUsageAlertTone } from '@/lib/listing/usage-alert-tone';
import {
    filterOwnerListingsByVertical,
    OWNER_LIST_LABEL_KEYS,
    OWNER_LIST_VERTICAL_PARAM,
    ownerListPath,
    ownerListSectionKey,
    resolveOwnerListPage
} from '@/lib/listing/owner-list-vertical';
import {
    buildListingUsage,
    fetchListingEffectiveSets,
    resolveUsageUpgradePath
} from '@/lib/listing/vertical-usage';
import { UNKNOWN_PUBLISH_AFFORDANCE } from '@/lib/publish/subscribe-button';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { shouldAnchorMenuQrTour } from '@/lib/venue/menu-qr-tour-anchor';
import { fetchAudiencePlans } from '@/lib/billing/audience-plans';
import { resolveUnlockingPlanName } from '@/lib/venue/section-upsell-plan';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { AddIcon, VenueIcon } from '@repo/icons';
import { PublicationStatusEnum } from '@repo/schemas';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// HOS-2559: one list per vertical, gated by that vertical's permission (never a
// role), so a person with only one of the two verticals reaches only that list.
const decision = resolveOwnerListPage({
    requested: Astro.url.searchParams.get(OWNER_LIST_VERTICAL_PARAM),
    permissions: user.permissions
});
if (decision.kind === 'forbidden') {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}
if (decision.kind === 'redirect') {
    return Astro.redirect(buildUrl({ locale, path: ownerListPath({ vertical: decision.vertical }) }));
}
const listVertical = decision.vertical;

const title = t(OWNER_LIST_LABEL_KEYS[listVertical]);
const subtitle = t(`listing.owner.list.subtitle.${listVertical}`, '');

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
// HOS-2421: a failed read must never render the "you have no listings" empty
// state, which tells an owner their listings are gone. The helper throws when
// the list could not be read; the page then renders the kit ErrorState with a
// retry instead. HOS-2484: ONE request for the list this page shows, which
// already carries every checklist (no per-listing detail read).
let listings: readonly OwnerListingSummaryWithState[] = [];
let listingsLoadFailed = false;
try {
    listings = filterOwnerListingsByVertical({
        listings: await fetchOwnerListingsWithState({ vertical: listVertical, cookieHeader }),
        vertical: listVertical
    });
} catch (error) {
    if (!(error instanceof OwnerListingsUnavailableError)) throw error;
    listingsLoadFailed = true;
    logger.warn('[comercio] owner listings read failed');
}

/**
 * HOS-1641 (Coord-351 F4): a `PURGED` listing offers no action — no edit link,
 * no badge or download from `ListingActions`, no menu QR. It stays in the list
 * only so its HOS-1492 row-20 notice can say it existed and was deleted.
 */
const isPurged = (listing: (typeof listings)[number]): boolean =>
    listing.publicationStatus === PublicationStatusEnum.PURGED;

/**
 * HOS-1856: the menu QR widget's audience. The vertical check lives in
 * `isVenueListing` (G-FAC-05 scans this file for bare vertical comparisons).
 */
const venueListings = listings.filter(
    (listing) => isVenueListing(listing) && !isPurged(listing)
);

// HOS-1492: the notices of each listing (rows 8/9, 18, 20, 24, 30, 31), read
// once per vertical this page lists. A failed read leaves that vertical's
// listings without notices (never an invented one) and the page renders.
const listedVerticals = [...new Set(listings.map((listing) => listing.vertical))];
const [publishAffordances, noticesByVertical, usageBadges] = await Promise.all([
    resolveListingPublishAffordances({ listings, cookieHeader }),
    (async () => new Map<string, ListingNoticesIndex>(
        await Promise.all(
            listedVerticals.map(async (vertical) => {
                if (!cookieHeader) return [vertical, EMPTY_LISTING_NOTICES_INDEX] as const;
                try {
                    const index = indexListingNotices({
                        result: await publishApi.listingNotices({ vertical, cookieHeader })
                    });
                    if (!index.ok) logger.warn('[comercio] listing-notices read failed', { vertical });
                    return [vertical, index] as const;
                } catch (error) {
                    logger.warn('[comercio] listing-notices request failed', {
                        vertical,
                        error: error instanceof Error ? error.message : String(error)
                    });
                    return [vertical, EMPTY_LISTING_NOTICES_INDEX] as const;
                }
            })
        )
    ))(),
    (async () => {
        try {
            const verticalsWithListings = [...new Set(
                listings.filter((listing) => !isPurged(listing)).map((listing) => listing.vertical)
            )];
            const effectiveSets = await fetchListingEffectiveSets({ verticals: verticalsWithListings, cookieHeader });
            return verticalsWithListings.flatMap((vertical) => {
                const usage = buildListingUsage({
                    vertical,
                    effectiveSet: effectiveSets.get(vertical) ?? {
                        entitlements: {}, limits: {}, hasLiveNonTrialTitle: false, failed: true
                    },
                    listings
                });
                return usage ? [usage] : [];
            });
        } catch (error) {
            logger.warn('[comercio] listing usage read failed', {
                error: error instanceof Error ? error.message : String(error)
            });
            return [];
        }
    })()
]);

// HOS-1856: the venue welcome tour's `venue-qr` step must exist only when the
// widget will render something. The widget resolves each venue's `menu` section
// on the client, but the tour starts before `client:visible` has hydrated it, so
// the anchor is decided here, in parallel, from the same section-state map. A
// failed read withholds the anchor: the tour never points at an element whose
// existence it cannot prove.
const venueSectionStates = await Promise.all(
    venueListings.map(async (listing) => {
        try {
            const result = await listingAnalyticsApi.getListingSectionStates({
                vertical: VENUE_VERTICAL,
                listingId: listing.id,
                cookieHeader
            });
            return result.ok ? result.data : null;
        } catch (error) {
            logger.warn('[comercio] venue section states read failed', {
                listingId: listing.id,
                error: error instanceof Error ? error.message : String(error)
            });
            return null;
        }
    })
);
const anchorMenuQrTour = shouldAnchorMenuQrTour({ sectionStates: venueSectionStates });

// The catalog controls whether advanced metrics exist for venue owners yet.
// The user's entitlement stays in the client island and is checked by its API.
const venueStatsUnlockingPlanName =
    venueListings.length > 0
        ? resolveUnlockingPlanName({
              plans: await fetchAudiencePlans({ audience: 'venue' }),
              entitlementKey: 'view_advanced_stats',
              t
          })
        : null;

// HOS-1156 retired `/mi-cuenta/comercio/nuevo/`, the vertical picker this
// button used to open. Its replacement for a SIGNED-IN owner is the publish hub,
// which lists all three verticals with their own CTAs and already knows which
// ones this account has acquired — the picker's job, done by a page that exists.
//
// The retired URL's own 301 goes to `/publicar/` per D-6; that is the right
// landing for an old inbound link and the wrong one for this button, which a
// venue/experience owner presses expecting to choose a vertical.
const createUrl = buildUrl({ locale, path: 'mi-cuenta/publica' });
const listHelpId = 'section:comercio.listado' as const;
const buckets = bucketOwnerListings({ listings });
const bucketCounts = Object.fromEntries(Object.entries(buckets).map(([key, rows]) => [key, rows.length])) as Record<keyof typeof buckets, number>;
---

<AccountLayout
    locale={locale}
    title={title}
    description={subtitle}
    activeSection={ownerListSectionKey({ vertical: listVertical })}
>
    <div class="mc-page">
    <PageHeader
        locale={locale}
        title={title}
        description={subtitle || undefined}
    >
        <PageHelpLink slot="help" locale={locale} />
        {/* HOS-2611: one solid primary per screen. The empty state owns the
            «create» call to action, so the header hides it there (and on a
            load failure, like the properties list). */}
        {listings.length > 0 && !listingsLoadFailed && !usageBadges.some((usage) => usage.currentUsage >= usage.maxAllowed) && (
            <LinkButton slot="actions" href={createUrl}>
                <AddIcon size="sm" aria-hidden="true" />
                {t(`listing.owner.list.createCta.${listVertical}`)}
            </LinkButton>
        )}
    </PageHeader>

    {/* HOS-2443: reaching the cap is informational, never an error tone. */}
    {usageBadges.map((usage) => (
        <Alert
            locale={locale}
            tone={resolveUsageAlertTone({ threshold: usage.threshold })}
            title={tPlural(`listing.owner.list.usage.${usage.vertical}.label`, usage.maxAllowed, {
                current: usage.currentUsage,
                max: usage.maxAllowed
            })}
        >
            {usage.currentUsage >= usage.maxAllowed && t('listing.owner.list.usage.atLimit')}
            {usage.threshold !== 'ok' && (
                <LinkButton
                    slot="action"
                    variant="secondary"
                    size="sm"
                    href={buildUrl({ locale, path: resolveUsageUpgradePath({ vertical: usage.vertical }) })}
                >
                    {t('listing.owner.list.usage.upgrade')}
                </LinkButton>
            )}
        </Alert>
    ))}

    {/* HOS-788: welcome-tour anchor for the listings list, shared by the
        venue and experience welcome tours. HOS-2484: the list comes first. */}
    <div data-tour="listings">
        {
            listingsLoadFailed ? (
                <PageLoadError
                    client:load
                    locale={locale}
                    title={t(`listing.owner.list.loadError.title.${listVertical}`)}
                    description={t(
                        'listing.owner.list.loadError.body',
                        'Hubo un problema al leer tus fichas. Siguen ahí: probá de nuevo en un momento.'
                    )}
                    helpId={listHelpId}
                />
            ) : listings.length === 0 ? (
                <EmptyState
                    title={t(`listing.owner.list.empty.${listVertical}`)}
                    helpId={listHelpId}
                >
                    <VenueIcon slot="icon" size="lg" aria-hidden="true" />
                    <LinkButton slot="action" href={createUrl}>
                        <AddIcon size="sm" aria-hidden="true" />
                        {t(`listing.owner.list.emptyCta.${listVertical}`)}
                    </LinkButton>
                </EmptyState>
            ) : (
                <OwnerListingsByState locale={locale} counts={bucketCounts} helpId={listHelpId} listLabel={title}>
                    {(bucket: OwnerListingBucket) => buckets[bucket].map((listing) => {
                        const affordance =
                            publishAffordances.get(listing.vertical) ?? UNKNOWN_PUBLISH_AFFORDANCE;
                        return (
                            <OwnerListingCard listing={listing} locale={locale}
                                publishAffordance={affordance}
                                notices={noticesByVertical.get(listing.vertical)?.byListingId.get(listing.id)}
                            />
                        );
                    })}
                </OwnerListingsByState>
            )
        }
    </div>

    {/* HOS-788: welcome-tour anchor shared by the venue and experience
        welcome tours — both verticals get `VIEW_BASIC_STATS`. See
        `src/config/tours.ts`. HOS-2484: performance comes after the list. */}
    <div data-tour="listing-views">
        <ListingViewsWidget
            client:visible
            locale={locale}
            listings={listings.map((listing) => ({
                id: listing.id,
                vertical: listing.vertical,
                name: listing.name,
                purged: isPurged(listing)
            }))}
        />
    </div>

    {/* HOS-788: welcome-tour anchor for the venue welcome tour — the menu
        QR/scan-analytics panel is exclusive to the venue vertical. HOS-1856:
        the anchor exists only when at least one venue's `menu` section is not
        `absent`, i.e. when the widget will actually render something. The
        widget mounts exactly as before; only the anchor is conditional. */}
    <div data-tour={anchorMenuQrTour ? 'venue-qr' : undefined}>
        <VenueMenuQrWidget
            client:visible
            locale={locale}
            listings={venueListings.map((listing) => ({ id: listing.id, name: listing.name }))}
        />
    </div>

    {venueListings.length > 0 && venueStatsUnlockingPlanName !== null && (
        <VenueListingStatsPanel
            client:visible
            locale={locale}
            listings={venueListings.map((listing) => ({ id: listing.id, name: listing.name }))}
            unlockingPlanName={venueStatsUnlockingPlanName}
        />
    )}

    {/* HOS-1856: the venue/experience welcome tour targets the anchors on this
        page, so it has to run here. `TourController` skips steps whose target
        is absent from the DOM (the BOLICHE-only venue tour has no `venue-qr`
        step) and never starts a tour with no steps left. */}
    <TourController
        locale={locale}
        userRoles={user.roles}
        page="comercio"
        client:idle
    />
    </div>
</AccountLayout>

<style>
    /* The account content slot has no flow gap: one stack owns the rhythm. */
    .mc-page {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }
</style>
