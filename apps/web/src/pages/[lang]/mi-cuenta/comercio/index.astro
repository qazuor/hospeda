---
/**
 * @file mi-cuenta/comercio/index.astro
 * @description Venue/experience owner self-service listing index (SPEC-249 Part A,
 * extended in HOS-166 PR-C with the create CTA and the per-listing state
 * machine — badge, completeness checklist, and publish+pay CTA).
 * HOS-1757 restores per-vertical published usage badges from effective limits.
 * Lists the authenticated VENUE_OWNER's own listings across both verticals
 * (venue + experiences) and deep-links each to its operational editor.
 *
 * Auth: middleware protects /mi-cuenta/* (session required). This page adds a
 * role gate so only venue/experience owners (and staff) reach it.
 *
 * @route     /[lang]/mi-cuenta/comercio/
 * @rendering SSR (prerender = false — authenticated, owner-scoped data)
 */
import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import AccountSectionCard from '@/components/account/AccountSectionCard.astro';
import { ListingActions } from '@/components/listing/ListingActions.client';
import { ListingViewsWidget } from '@/components/listing/ListingViewsWidget.client';
import { VenueMenuQrWidget } from '@/components/venue/VenueMenuQrWidget.client';
import ListingNotices from '@/components/listing/ListingNotices.astro';
import { publishApi } from '@/lib/api/endpoints-protected';
import {
    EMPTY_LISTING_NOTICES_INDEX,
    indexListingNotices,
    type ListingNoticesIndex
} from '@/lib/listing/listing-notices';
import { webLogger as logger } from '@/lib/logger';
import { hasListingNavAccess } from '@/lib/nav-gating';
import { fetchOwnerListingsWithState } from '@/lib/listing/owner-listings';
import { resolveListingPublishAffordances } from '@/lib/listing/listing-publish-affordance';
import {
    buildListingUsage,
    fetchListingEffectiveSets,
    resolveUsageUpgradePath
} from '@/lib/listing/vertical-usage';
import { UNKNOWN_PUBLISH_AFFORDANCE } from '@/lib/publish/subscribe-button';
import { buildUrl } from '@/lib/urls';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { PublicationStatusEnum } from '@repo/schemas';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

// Role gate: only venue/experience owners (and staff) may manage listings.
// HOS-296: gate through the shared `nav-gating` predicate over the role SET,
// so a VENUE_OWNER who is ALSO a HOST keeps venue/experience access (AC-1).
if (!hasListingNavAccess({ roles: user.roles })) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}

const title = t('listing.owner.list.title', 'Mi comercio');
const subtitle = t('listing.owner.list.subtitle', '');

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const listings = await fetchOwnerListingsWithState({ cookieHeader });

/**
 * HOS-1641 (Coord-351 F4): a `PURGED` listing offers no action — no edit link,
 * no badge or download from `ListingActions`, no menu QR. It stays in the list
 * only so its HOS-1492 row-20 notice can say it existed and was deleted.
 */
const isPurged = (listing: (typeof listings)[number]): boolean =>
    listing.publicationStatus === PublicationStatusEnum.PURGED;

// HOS-1492: the notices of each listing (rows 8/9, 18, 20, 24, 30, 31), read
// once per vertical this page lists. A failed read leaves that vertical's
// listings without notices (never an invented one) and the page renders.
const listedVerticals = [...new Set(listings.map((listing) => listing.vertical))];
const [publishAffordances, noticesByVertical, usageBadges] = await Promise.all([
    resolveListingPublishAffordances({ listings, cookieHeader }),
    (async () => new Map<string, ListingNoticesIndex>(
        await Promise.all(
            listedVerticals.map(async (vertical) => {
                if (!cookieHeader) return [vertical, EMPTY_LISTING_NOTICES_INDEX] as const;
                try {
                    const index = indexListingNotices({
                        result: await publishApi.listingNotices({ vertical, cookieHeader })
                    });
                    if (!index.ok) logger.warn('[comercio] listing-notices read failed', { vertical });
                    return [vertical, index] as const;
                } catch (error) {
                    logger.warn('[comercio] listing-notices request failed', {
                        vertical,
                        error: error instanceof Error ? error.message : String(error)
                    });
                    return [vertical, EMPTY_LISTING_NOTICES_INDEX] as const;
                }
            })
        )
    ))(),
    (async () => {
        try {
            const verticalsWithListings = [...new Set(
                listings.filter((listing) => !isPurged(listing)).map((listing) => listing.vertical)
            )];
            const effectiveSets = await fetchListingEffectiveSets({ verticals: verticalsWithListings, cookieHeader });
            return verticalsWithListings.flatMap((vertical) => {
                const usage = buildListingUsage({
                    vertical,
                    effectiveSet: effectiveSets.get(vertical) ?? {
                        entitlements: {}, limits: {}, hasLiveNonTrialTitle: false, failed: true
                    },
                    listings
                });
                return usage ? [usage] : [];
            });
        } catch (error) {
            logger.warn('[comercio] listing usage read failed', {
                error: error instanceof Error ? error.message : String(error)
            });
            return [];
        }
    })()
]);

// HOS-1156 retired `/mi-cuenta/comercio/nuevo/`, the vertical picker this
// button used to open. Its replacement for a SIGNED-IN owner is the publish hub,
// which lists all three verticals with their own CTAs and already knows which
// ones this account has acquired — the picker's job, done by a page that exists.
//
// The retired URL's own 301 goes to `/publicar/` per D-6; that is the right
// landing for an old inbound link and the wrong one for this button, which a
// venue/experience owner presses expecting to choose a vertical.
const createUrl = buildUrl({ locale, path: 'mi-cuenta/publica' });
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="comercio">
    <div class="mc-header">
        <AccountPageHeader title={title} description={subtitle || undefined} />
        <a
            class="mc-create-cta"
            href={createUrl}
        >
            {t('listing.owner.list.createCta', '+ Nuevo comercio')}
        </a>
    </div>

    {usageBadges.length > 0 && (
        <div class="mc-usage-row">
            {usageBadges.map((usage) => (
                <div class={`mc-usage mc-usage--${usage.threshold}`} role="status">
                    <span class="mc-usage__label">
                        {tPlural(`listing.owner.list.usage.${usage.vertical}.label`, usage.maxAllowed, {
                            current: usage.currentUsage,
                            max: usage.maxAllowed
                        })}
                    </span>
                    {usage.currentUsage >= usage.maxAllowed && (
                        <span class="mc-usage__at-limit">{t('listing.owner.list.usage.atLimit')}</span>
                    )}
                    {usage.threshold !== 'ok' && (
                        <a
                            href={buildUrl({ locale, path: resolveUsageUpgradePath({ vertical: usage.vertical }) })}
                            class="mc-usage__upgrade"
                        >
                            {t('listing.owner.list.usage.upgrade')}
                        </a>
                    )}
                </div>
            ))}
        </div>
    )}

    {/* HOS-788: welcome-tour anchor shared by the venue and experience
        welcome tours — both verticals get `VIEW_BASIC_STATS`. See
        `src/config/tours.ts`. */}
    <div data-tour="listing-views">
        <ListingViewsWidget
            client:visible
            locale={locale}
            listings={listings.map((listing) => ({
                id: listing.id,
                vertical: listing.vertical,
                name: listing.name
            }))}
        />
    </div>

    {/* HOS-788: welcome-tour anchor for the venue welcome tour only —
        the menu QR/scan-analytics panel is exclusive to the venue vertical. A
        VENUE_OWNER always holds at least one venue listing (the
        role is granted alongside the listing's creation, never before), so
        this is never empty for the audience that tour targets. */}
    <div data-tour="venue-qr">
        <VenueMenuQrWidget
            client:visible
            locale={locale}
            listings={listings
                .filter((listing) => listing.vertical === 'venue' && !isPurged(listing))
                .map((listing) => ({ id: listing.id, name: listing.name }))}
        />
    </div>

    {/* HOS-788: welcome-tour anchor for the listings list, shared by the
        venue and experience welcome tours. */}
    <div data-tour="listings">
    <AccountSectionCard>
        {
            listings.length === 0 ? (
                <div class="mc-empty">
                    <p class="mc-empty__text">
                        {t(
                            'listing.owner.list.empty',
                            'Todavía no tenés comercios. Creá tu primera ficha para empezar.'
                        )}
                    </p>
                    <a
                        class="mc-empty__cta"
                        href={createUrl}
                    >
                        {t('listing.owner.list.emptyCta', 'Crear mi primer comercio')}
                    </a>
                </div>
            ) : (
                <ul class="mc-list">
                    {listings.map((listing) => (
                        <li class="mc-list__item">
                            <div class="mc-list__main">
                                <span class="mc-list__name">{listing.name}</span>
                                <span class="mc-badge">
                                    {t(`listing.owner.list.badge.${listing.vertical}`, listing.vertical)}
                                </span>
                            </div>

                            <ListingActions
                                client:visible
                                listing={listing}
                                locale={locale}
                                publishAffordance={publishAffordances.get(listing.vertical) ?? UNKNOWN_PUBLISH_AFFORDANCE}
                            />

                            <ListingNotices
                                locale={locale}
                                vertical={listing.vertical}
                                listingId={listing.id}
                                item={noticesByVertical.get(listing.vertical)?.byListingId.get(listing.id)}
                            />

                            {!isPurged(listing) && (
                                <a
                                    class="mc-list__edit"
                                    href={buildUrl({
                                        locale,
                                        path: `mi-cuenta/comercio/${listing.vertical}/${listing.id}/editar`
                                    })}
                                >
                                    {t('listing.owner.list.edit', 'Editar')}
                                </a>
                            )}
                        </li>
                    ))}
                </ul>
            )
        }
    </AccountSectionCard>
    </div>
</AccountLayout>

<style>
    .mc-usage-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3, 0.75rem);
    }

    .mc-usage {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-3, 0.75rem);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-pill, 9999px);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 500;
        background-color: var(--surface-warm, oklch(0.96 0.02 60));
        color: var(--core-foreground);
        border: 1px solid var(--border);
    }

    .mc-usage--ok {
        background-color: oklch(0.95 0.04 145);
        color: oklch(0.35 0.12 145);
        border-color: oklch(0.85 0.08 145);
    }

    .mc-usage--warning {
        background-color: oklch(0.95 0.05 65);
        color: oklch(0.40 0.12 65);
        border-color: oklch(0.85 0.10 65);
    }

    .mc-usage--critical,
    .mc-usage--exceeded {
        background-color: oklch(0.95 0.04 25);
        color: oklch(0.45 0.15 25);
        border-color: oklch(0.85 0.10 25);
    }

    .mc-usage__label {
        white-space: nowrap;
    }

    .mc-usage__upgrade {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-pill, 9999px);
        background-color: var(--brand-primary);
        color: var(--primary-foreground, #ffffff);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.75rem;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 150ms ease-out;
    }

    .mc-usage__upgrade:hover {
        opacity: 0.88;
    }

    .mc-usage__at-limit {
        flex-basis: 100%;
    }

    .mc-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .mc-create-cta {
        flex-shrink: 0;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-button, 0.5rem);
        background: var(--brand-accent);
        color: var(--accent-foreground);
        font-weight: 600;
        font-size: var(--text-body-sm, 0.9375rem);
        text-decoration: none;
        transition: opacity 150ms ease;
    }

    .mc-create-cta:hover {
        opacity: 0.85;
    }

    .mc-empty {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .mc-empty__text {
        margin: 0;
        color: var(--core-muted-foreground);
        font-size: var(--text-body-sm, 0.9375rem);
    }

    .mc-empty__cta {
        padding: var(--space-3) var(--space-8);
        border-radius: var(--radius-button, 0.5rem);
        background: var(--brand-accent);
        color: var(--accent-foreground);
        font-weight: 600;
        text-decoration: none;
        transition: opacity 150ms ease;
    }

    .mc-empty__cta:hover {
        opacity: 0.85;
    }

    .mc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .mc-list__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
        padding: var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius-md, 0.5rem);
        background: var(--core-card, var(--core-background));
    }

    .mc-list__main {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
        min-width: 0;
    }

    .mc-list__name {
        font-weight: 600;
        color: var(--core-foreground);
    }

    .mc-badge {
        font-size: var(--text-caption, 0.75rem);
        padding: 0.125rem 0.5rem;
        border-radius: var(--radius-pill, 999px);
        background: var(--surface-warm, rgba(0, 0, 0, 0.06));
        color: var(--core-muted-foreground);
    }

    .mc-list__edit {
        flex-shrink: 0;
        font-weight: 600;
        color: var(--brand-primary, var(--core-foreground));
        text-decoration: none;
    }

    .mc-list__edit:hover {
        text-decoration: underline;
    }
</style>
