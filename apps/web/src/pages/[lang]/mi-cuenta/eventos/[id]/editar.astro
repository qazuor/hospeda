---
/**
 * @file mi-cuenta/eventos/[id]/editar.astro
 * @description Editor page for one of the author's own events (HOS-374
 * Phase 2 2C-3). Twin of `mi-cuenta/publicaciones/[id]/editar.astro` — see that
 * file for the shared rationale on the three gates and on why capabilities come
 * from the permission set rather than roles.
 *
 * What differs here is the read-only context: `organizer` and `location` are
 * shown but not editable. Both ARE mapped by the server's update, but there is
 * no public catalog endpoint to populate a picker (`eventLocationsApi` exposes
 * only `getBySlug`; organizers expose nothing), so shipping a field that cannot
 * list its options would be worse than showing the current value.
 *
 * HOS-2505: the page is the account-kit editor template: kit `PageHeader`
 * with account breadcrumbs and the page «?», the read-only context in an `Alert`,
 * then the editor island (kit Sections + StickySaveBar). Without access it is
 * a `LockedState` (`reason.kind='permission'`), never a redirect (D9).
 *
 * @route     /[lang]/mi-cuenta/eventos/[id]/editar/
 * @rendering SSR (prerender = false — authenticated, author-scoped data)
 */

import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { Alert, LockedState, PageHeader } from '@/components/account/ui';
import { EventEditor } from '@/components/event/editor/EventEditor.client';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { eventEditApi } from '@/lib/api/endpoints-protected';
import { transformEventEditDetail } from '@/lib/api/transforms';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildAccountBreadcrumbs } from '@/lib/account/account-breadcrumbs';
import { getAccountSectionLabel } from '@/lib/account-nav-model';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { hasEventsNavAccess } from '@/lib/nav-gating';
import { resolveAuthoredEditorItem } from '@/lib/editor/resolve-authored-editor-item';
import { buildUrl } from '@/lib/urls';

import { guardPublisherArea } from '@/lib/account/publisher-access';

export const prerender = false;
const denied = guardPublisherArea({ astro: Astro, area: 'eventEdit' });
if (denied) return denied;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const canManageEvents = hasEventsNavAccess({ permissions: user.permissions });

let event: ReturnType<typeof transformEventEditDetail> | null = null;

if (canManageEvents) {
    // HOS-2556: a missing id, an unknown id and another author's id all answer the
    // same in-layout 404 (see resolveAuthoredEditorItem).
    const loaded = await resolveAuthoredEditorItem({
        astro: Astro,
        back: 'events',
        fetchById: eventEditApi.getById,
        logTag: '[mi-cuenta/eventos/editar]'
    });
    if (loaded.notFound) {
        return loaded.notFound;
    }

    event = transformEventEditDetail({ item: loaded.item });
}

// ---------------------------------------------------------------------------
// Capabilities — permission set, never roles (HOS-374 OQ-1).
// ---------------------------------------------------------------------------

const permissions = user.permissions;
const canUpdateAny = permissions.includes('event.update');
const canPublish =
    permissions.includes('event.publish.own') || permissions.includes('event.publish.toggle');
const canDelete = permissions.includes('event.delete.own') || permissions.includes('event.delete');

/*
 * The §7.6.3 write-side state lock, mirroring `checkCanUpdateEvent` +
 * `isAuthorEditLockedByModeration`: an author holding only `event.update.own`
 * loses edit rights once the platform APPROVES the content. Holding
 * `event.publish.own` lifts it, and a broad `event.update` holder is authorized
 * before the predicate is ever consulted.
 */
const isEditLocked = event
    ? event.moderationState === 'APPROVED' && !canPublish && !canUpdateAny
    : false;

const title = t('account.myContent.events.editor.pageTitle', 'Editar evento');
const organizerLabel = t('account.myContent.events.editor.field.organizer', 'Organiza');
const locationLabel = t('account.myContent.events.editor.field.location', 'Lugar');
---

{event ? (
    <AccountLayout locale={locale} title={`${title}: ${event.name}`} activeSection="eventos">
        <PageHeader
            title={title}
            description={event.name}
            locale={locale}
            breadcrumbs={buildAccountBreadcrumbs({
                t,
                parents: [{ label: getAccountSectionLabel({ t, section: 'eventos' }), path: 'mi-cuenta/eventos' }],
                current: event.name
            })}
        >
            <PageHelpLink slot="help" locale={locale} />
        </PageHeader>

        <Alert
            tone="info"
            locale={locale}
            title={t(
                'account.myContent.events.editor.readOnlyNotice',
                'La URL, el organizador y el lugar se definen al crear el evento y no se editan desde acá.'
            )}
        >
            {[
                `/${event.slug}`,
                event.organizerName ? `${organizerLabel}: ${event.organizerName}` : null,
                event.locationName ? `${locationLabel}: ${event.locationName}` : null
            ]
                .filter(Boolean)
                .join(' · ')}
        </Alert>

        <EventEditor
            client:load
            locale={locale}
            initialData={event}
            canPublish={canPublish}
            canDelete={canDelete}
            isEditLocked={isEditLocked}
        />
    </AccountLayout>
) : (
    <AccountLayout locale={locale} title={title} activeSection="eventos">
        <PageHeader title={title} locale={locale} breadcrumbs={buildAccountBreadcrumbs({
            t,
            parents: [{ label: getAccountSectionLabel({ t, section: 'eventos' }), path: 'mi-cuenta/eventos' }],
            current: title
        })}>
            <PageHelpLink slot="help" locale={locale} />
        </PageHeader>

        <LockedState
            locale={locale}
            reason={{
                kind: 'permission',
                feature: t('account.myContent.events.noAccess.title', 'Esta sección es para editores'),
                description: t(
                    'account.myContent.events.noAccess.description',
                    'Tu cuenta todavía no tiene permiso para gestionar eventos. Si querés publicar eventos en Hospeda, completá la solicitud para sumarte como editor.'
                ),
                helpHref: buildUrl({ locale, path: 'colaborar/editores' })
            }}
        />
    </AccountLayout>
)}
