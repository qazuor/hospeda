---
/**
 * @file mi-cuenta/eventos/nuevo.astro
 * @description Editor self-service event create page (HOS-374 §5.2.2). Mounts
 * `EventCreateForm`, which collects the minimum required fields and redirects
 * to the real editor (`[id]/editar.astro`) on success.
 *
 * Two gates, matching this route's siblings (`index.astro`, `[id]/editar.astro`):
 *  1. Session — middleware AND this page, matching the `/mi-cuenta` convention.
 *  2. Role — `hasEventsNavAccess` (EVENT_CREATE), the same gate the listing
 *     already uses. Users without it see the "no access" state with the
 *     application link instead of the form.
 *
 * Fetches the public event-organizer catalog SSR (`eventOrganizersApi.list`,
 * mirroring `destinationsApi.list` in `comercio/nuevo/[vertical].astro`) and
 * passes it to `EventCreateForm`, which also needs it to let an editor create
 * an organizer inline when the catalog is unusable — see that component's
 * module doc for the full rationale (`organizerId` is a required UUID with no
 * other way to satisfy it from `/mi-cuenta`).
 *
 * HOS-2505: kit `PageHeader` (account breadcrumbs + page «?») and the form inside a
 * kit `Section`; without the role, a `LockedState` (`kind: 'permission'`).
 *
 * @route     /[lang]/mi-cuenta/eventos/nuevo/
 * @rendering SSR (prerender = false — authenticated, editor-only)
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { LockedState, PageHeader } from '@/components/account/ui';
import { EventCreateForm } from '@/components/event/editor/EventCreateForm.client';
import { eventOrganizersApi } from '@/lib/api/endpoints';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildAccountBreadcrumbs } from '@/lib/account/account-breadcrumbs';
import { getAccountSectionLabel } from '@/lib/account-nav-model';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { hasEventsNavAccess } from '@/lib/nav-gating';
import { webLogger as logger } from '@/lib/logger';
import { buildUrl } from '@/lib/urls';

import { guardPublisherArea } from '@/lib/account/publisher-access';

export const prerender = false;
const denied = guardPublisherArea({ astro: Astro, area: 'eventCreate' });
if (denied) return denied;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const canCreateEvents = hasEventsNavAccess({ permissions: user.permissions });

// The organizer catalog: at most 100 entries today, no pagination UI — the
// same simplifying assumption `destinationsApi.list({ pageSize: 100 })` makes
// in the venue/experience create page.
const organizersResult = canCreateEvents
    ? await eventOrganizersApi.list({ pageSize: 100 })
    : null;
const organizers = organizersResult?.ok
    ? organizersResult.data.items.map((item) => ({ id: item.id, name: item.name }))
    : [];
const organizersLoadFailed = organizersResult !== null && !organizersResult.ok;
if (organizersResult !== null && !organizersResult.ok) {
    logger.error(
        '[mi-cuenta/eventos/nuevo] Failed to fetch event organizer catalog',
        organizersResult.error.message
    );
}

const title = t('account.myContent.events.create.pageTitle', 'Nuevo evento');
const subtitle = t(
    'account.myContent.events.create.subtitle',
    'Completá lo básico ahora — vas a poder sumar fotos y más detalles después en el editor.'
);
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="eventos">
    <PageHeader
        title={title}
        description={subtitle}
        locale={locale}
        breadcrumbs={buildAccountBreadcrumbs({
            t,
            parents: [{ label: getAccountSectionLabel({ t, section: 'eventos' }), path: 'mi-cuenta/eventos' }],
            current: title
        })}
    >
        <PageHelpLink slot="help" locale={locale} />
    </PageHeader>

    {canCreateEvents ? (
            <EventCreateForm
                client:load
                locale={locale}
                organizers={organizers}
                organizersLoadFailed={organizersLoadFailed}
            />
    ) : (
        <LockedState
            locale={locale}
            reason={{
                kind: 'permission',
                feature: t(
                    'account.myContent.events.create.noAccess.title',
                    'Crear eventos es una función de los editores'
                ),
                description: t(
                    'account.myContent.events.create.noAccess.description',
                    'Tu cuenta todavía no tiene permiso para crear eventos. Si querés publicar eventos en Hospeda, completá la solicitud para sumarte como editor.'
                ),
                helpHref: buildUrl({ locale, path: 'colaborar/editores' })
            }}
        />
    )}
</AccountLayout>
