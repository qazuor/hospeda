---
/**
 * @file mi-cuenta/eventos/index.astro
 * @description Editor own-content listing on the account kit (HOS-2505): every
 * event authored by the user, in every moderation and lifecycle state, through
 * the shared `MyContentList` template (`OwnContentListView`). Structural twin
 * of `mi-cuenta/publicaciones`; the real differences are data-driven (events
 * carry `name`, not `title`, and gate on `EVENT_CREATE`).
 *
 * Auth: middleware AND this page check for a session.
 *
 * Gate: only users whose role grants `EVENT_CREATE` (see `hasEventsNavAccess`
 * in `@/lib/nav-gating`) manage events. Anyone else sees a `LockedState`
 * (`reason.kind = 'permission'`) with the editor application link, never a
 * redirect, and the list is not even requested.
 *
 * Data: `eventEditApi.listOwn` (`lib/api/`) forwards the session cookie to
 * `GET /api/v1/protected/events`; authorship comes from the session, never
 * from a query filter. Paginated with `?page=N` (HOS-2440): no silent cap.
 *
 * @route    /[lang]/mi-cuenta/eventos/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import {
    ACCOUNT_LIST_PAGE_SIZE,
    buildAccountPageHref,
    parsePageParam,
    resolveAccountPageState
} from '@/lib/account-pagination';
import { hasEventsNavAccess } from '@/lib/nav-gating';
import { webLogger as logger } from '@/lib/logger';
import { eventEditApi } from '@/lib/api/endpoints-protected';
import { transformEventEditCardList } from '@/lib/api/transforms';
import type { EventEditListItem } from '@/lib/api/types';
import AccountLayout from '@/layouts/AccountLayout.astro';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import {
    OwnContentListView,
    type OwnContentListStatus
} from '@/components/account/my-content/OwnContentListView';
import { ContentListReloadError } from '@/components/account/my-content/ContentListReloadError.client';

import { canAccessPublisherArea, guardPublisherArea } from '@/lib/account/publisher-access';

export const prerender = false;
const denied = guardPublisherArea({ astro: Astro, area: 'events' });
if (denied) return denied;

const locale = Astro.locals.locale as SupportedLocale;

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// Gate: only editor-tier roles see their own-content dashboard.
const canManageEvents = hasEventsNavAccess({ permissions: user.permissions });

let events: readonly EventEditListItem[] = [];
let fetchError = false;

// HOS-2440: paginated (`?page=N`) instead of silently cut at 50.
const requestedPage = parsePageParam({ value: Astro.url.searchParams.get('page') });
let totalItems: number | null = null;

const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;

const result = canManageEvents
    ? await eventEditApi.listOwn({
          cookieHeader,
          page: requestedPage,
          pageSize: ACCOUNT_LIST_PAGE_SIZE,
          sortBy: 'createdAt',
          sortOrder: 'desc'
      })
    : null;

if (result) {
    if (result.ok) {
        events = transformEventEditCardList({ items: result.data.items });
        totalItems = result.data.pagination?.total ?? null;
    } else {
        fetchError = true;
        logger.error('[mi-cuenta/eventos] Failed to fetch own events', result.error.message);
    }
}

const { t } = createTranslations(locale);
const title = t('account.myContent.events.list.title');
const subtitle = t('account.myContent.events.list.subtitle');

const pageState = resolveAccountPageState({ requestedPage, total: totalItems });
if (!fetchError && pageState.isPastEnd) {
    // A stale `?page=` past the end must not read as "you have none".
    return Astro.redirect(
        buildAccountPageHref({ locale, path: 'mi-cuenta/eventos', page: pageState.totalPages })
    );
}

const status: OwnContentListStatus = !canManageEvents
    ? 'locked'
    : fetchError
      ? 'error'
      : events.length === 0
        ? 'empty'
        : 'ready';

const items = events.map((event) => ({
    id: event.id,
    title: event.name,
    moderationState: event.moderationState,
    visibility: event.visibility,
    lifecycleState: event.lifecycleState
}));
---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="eventos">
    <OwnContentListView
        canCreate={canAccessPublisherArea({ area: 'eventCreate', permissions: user.permissions })}
        canEdit={canAccessPublisherArea({ area: 'eventEdit', permissions: user.permissions })}
        locale={locale}
        kind="events"
        status={status}
        items={items}
        page={pageState.page}
        pageCount={pageState.totalPages}
    >
        <PageHelpLink slot="help" locale={locale} />
        {status === 'error' && <ContentListReloadError slot="errorRegion" client:visible locale={locale} />}
    </OwnContentListView>
</AccountLayout>
