---
/**
 * @file index.astro
 * @description The accommodation editor hub (HOS-318 T-011).
 *
 * Lists every section as a row with a status line. Rendered on BOTH viewports:
 * on mobile it is the navigation, on desktop it doubles as a status summary of
 * the property.
 *
 * It deliberately does NOT redirect to the first section. A redirect here traps
 * the back button — from a section, "back" lands on the hub, which bounces
 * forward again — and a back button that does not work is the single most
 * frustrating thing for this editor's audience (HOS-318 D-8).
 */

import EditorHub from '@/components/host/editor/EditorHub.astro';
import ListingNotices from '@/components/listing/ListingNotices.astro';
import SupportEditNotice from '@/components/listing/SupportEditNotice.astro';
import EditorSectionLayout from '@/layouts/EditorSectionLayout.astro';
import {
	ACCOMMODATION_EDITOR_REGISTRY,
	buildAccommodationEditorVisibility,
} from '@/lib/editor/accommodation-editor-sections';
import { resolveEditorSectionStatuses } from '@/lib/editor/editor-hub-status-model';
import { resolveEditorPage } from '@/lib/editor/resolve-editor-page';
import { createTranslations } from '@/lib/i18n';
import { loadListingNoticesItem } from '@/lib/listing/listing-notices-loader';
import { loadSupportEdits } from '@/lib/listing/support-edits';

export const prerender = false;

const resolution = await resolveEditorPage({
	astro: Astro,
	sectionSlug: null,
	need: ['media', 'faqs', 'translations'],
});

if (resolution.redirect) return resolution.redirect;

const { data, locale, accommodationId } = resolution;
const { t } = createTranslations(locale);
const accommodation = data.accommodation;

// Row 26 (HOS-1493) and the listing notices of HOS-1492 (fix requested,
// moderated, archived, surplus): support's content edits and the notices of the
// listing, read together. Neither blocks the hub: any failure degrades to
// nothing.
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const [supportEdits, listingNotices] = await Promise.all([
	loadSupportEdits({
		vertical: 'accommodation',
		listingId: accommodationId,
		cookieHeader,
	}),
	loadListingNoticesItem({
		vertical: 'accommodation',
		listingId: accommodationId,
		cookieHeader,
	}),
]);

const hasListingNotices =
	listingNotices.item !== undefined && listingNotices.item.notices.length > 0;

const statuses = resolveEditorSectionStatuses({
	input: {
		hasDescription: Boolean(accommodation.description),
		maxGuests: accommodation.maxGuests ?? null,
		basePrice: accommodation.basePrice ?? null,
		hasCoordinates: accommodation.latitude !== null && accommodation.longitude !== null,
		amenityCount: accommodation.amenityIds.length,
		featureCount: accommodation.featureIds.length,
		photoCount: data.gallery.length + (data.featuredImage ? 1 : 0),
		faqCount: data.faqs.length,
		hasContact: Boolean(
			accommodation.phone || accommodation.whatsapp || accommodation.email || accommodation.website,
		),
		// What the publish gate will actually check, fed from the same shared
		// requirement list the server rejects from — so the hub can no longer
		// warn about what does not block while staying silent about what does
		// (H-101).
		publishReadiness: {
			description: accommodation.description,
			capacity: accommodation.maxGuests,
			minNights: accommodation.minNights,
			bedrooms: accommodation.bedrooms,
			bathrooms: accommodation.bathrooms,
			hasMainImage: Boolean(data.featuredImage),
		},
	},
});
---

<EditorSectionLayout
	locale={locale}
	accommodationId={accommodationId}
	accommodationName={accommodation.name}
	currentSectionId={null}
	currentSectionSlug={null}
	hasTranslations={data.translations !== null}
	title={accommodation.name}
	subtitle={t('host.properties.editor.hub.subtitle', 'Elegí qué querés editar')}
	description={t('host.properties.editor.pageDescription')}
>
	{hasListingNotices && (
		<div class="editor-hub__notices" data-testid="editor-hub-listing-notices">
			<ListingNotices
				locale={locale}
				vertical="accommodation"
				listingId={accommodationId}
				item={listingNotices.item}
			/>
		</div>
	)}

	<SupportEditNotice locale={locale} items={supportEdits.items} />

	<EditorHub
		locale={locale}
		registry={ACCOMMODATION_EDITOR_REGISTRY}
		entityId={accommodationId}
		visibility={buildAccommodationEditorVisibility({ hasTranslations: data.translations !== null })}
		statuses={statuses}
	/>
</EditorSectionLayout>

<style>
	.editor-hub__notices {
		display: flex;
		flex-direction: column;
		gap: var(--space-3, 0.75rem);
		margin: 0 0 var(--space-5, 1.5rem);
	}
</style>
