---
/**
 * @file fotos.astro
 * @description Photo AND video section of the accommodation editor
 * (HOS-318 T-012, videos added by G7 smoke H-121).
 *
 * `PhotoSection` already persists every change against its own endpoints, so no
 * form logic moved here for photos — this page only loads the media and mounts
 * it. `VideoSection` is a second, independent widget on the same page: videos
 * travel through the general accommodation PATCH (`media.videos`), a different
 * persistence model than the granular photo endpoints, so it owns its own
 * save action rather than sharing one with PhotoSection.
 */

import { PhotoSection } from '@/components/host/editor/PhotoSection.client';
import { VideoSection } from '@/components/host/editor/VideoSection.client';
import EditorSectionLayout from '@/layouts/EditorSectionLayout.astro';
import { resolveEditorPage } from '@/lib/editor/resolve-editor-page';
import { createTranslations } from '@/lib/i18n';

export const prerender = false;

const resolution = await resolveEditorPage({
	astro: Astro,
	sectionSlug: 'fotos',
	need: ['media', 'translations'],
});

if (resolution.redirect) return resolution.redirect;

const { data, locale, accommodationId, sectionId } = resolution;
const { t } = createTranslations(locale);
---

<EditorSectionLayout
	locale={locale}
	accommodationId={accommodationId}
	accommodationName={data.accommodation.name}
	currentSectionId={sectionId}
	currentSectionSlug="fotos"
	hasTranslations={data.translations !== null}
	title={t('host.properties.editor.section.photos', 'Fotos')}
>
	<PhotoSection
		locale={locale}
		accommodationId={accommodationId}
		initialFeaturedImage={data.featuredImage}
		initialGallery={data.gallery}
		client:load
	/>
	<VideoSection
		locale={locale}
		accommodationId={accommodationId}
		initialVideos={data.accommodation.videos}
		client:load
	/>
</EditorSectionLayout>
