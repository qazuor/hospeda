---
/**
 * @file mi-cuenta/propiedades/index.astro
 * @description Host property listing page — shows all accommodations owned by the
 * authenticated user, with empty state fallback and optional lifecycle filter.
 *
 * Auth protection: both middleware AND this page check for a valid user session.
 * Middleware redirects before the page renders; the in-page guard is a safety net.
 *
 * Data: fetched server-side by forwarding the session cookie to the protected API
 * endpoint `GET /api/v1/protected/accommodations` (owner-scoped, see T-014).
 * On fetch error the page renders the kit ErrorState with a retry — never the
 * empty state, which would tell the host their properties are gone (HOS-2483).
 * The list is paginated (`?page=N`, HOS-2440): no silent cap.
 *
 * @route    /[lang]/mi-cuenta/propiedades/
 * @rendering SSR (prerender = false — requires authenticated user)
 */

import { PublicationStatusEnum } from '@repo/schemas';
import type { Accommodation } from '@repo/schemas';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';
import {
    type PublishAffordance,
    resolvePublishAffordance,
    UNKNOWN_PUBLISH_AFFORDANCE
} from '@/lib/publish/subscribe-button';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { hasAccommodationsNavAccess } from '@/lib/nav-gating';
import { getApiUrl } from '@/lib/env';
import { webLogger as logger } from '@/lib/logger';
import { buildUsageBadge, fetchHostUsageBadge } from '@/lib/host/usage-badge';
import {
    ACCOUNT_LIST_PAGE_SIZE,
    buildAccountPageHref,
    fetchListTotal,
    parsePageParam,
    resolveAccountPageState
} from '@/lib/account-pagination';
import { resolveNeedsPlanBannerView } from '@/lib/host/needs-plan-banner';
import { publishApi } from '@/lib/api/endpoints-protected';
import {
    EMPTY_LISTING_NOTICES_INDEX,
    indexListingNotices,
    type ListingNoticesIndex
} from '@/lib/listing/listing-notices';
import AccountLayout from '@/layouts/AccountLayout.astro';
import {
    Alert,
    EmptyState,
    LinkButton,
    ListingCardGrid,
    PageHeader,
    Pagination
} from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import { PageLoadError } from '@/components/account/PageLoadError.client';
import PropertyCard from '@/components/host/PropertyCard.astro';
import { BuildingIcon } from '@repo/icons';
import { resolveUsageAlertTone } from '@/lib/listing/usage-alert-tone';
import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';

export const prerender = false;

// ---------------------------------------------------------------------------
// Locale — injected by middleware, always a valid SupportedLocale.
// ---------------------------------------------------------------------------

const locale = Astro.locals.locale as SupportedLocale;

// ---------------------------------------------------------------------------
// Auth guard: middleware protects /mi-cuenta/* automatically, but this is the
// safety net for any SSR edge case where middleware did not run.
// ---------------------------------------------------------------------------

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

// Role gate: only host-level roles may manage properties. A plain tourist
// reaching this URL directly is redirected back to the account home.
// HOS-296: gate through the shared `nav-gating` predicate over the role SET,
// so this page and the sidebar that links to it can never disagree, and a
// user who holds HOST alongside other hats still passes.
if (!hasAccommodationsNavAccess({ roles: user.roles })) {
    return Astro.redirect(buildUrl({ locale, path: 'mi-cuenta' }));
}

// ---------------------------------------------------------------------------
// Server-side fetch: list owner's accommodations.
// The protected endpoint filters by actor.id server-side (T-014 / Option A).
// Session cookie is forwarded to authenticate the request.
// ---------------------------------------------------------------------------

let properties: readonly Accommodation[] = [];
let fetchError = false;

// HOS-2440: the list is paginated (`?page=N`) instead of silently cut at 50.
const requestedPage = parsePageParam({ value: Astro.url.searchParams.get('page') });
let totalProperties: number | null = null;
// Owner-wide counts (not this page's): the usage badge and the "needs a plan"
// banner describe the whole portfolio, so they cannot be read off one page.
let publishedTotal: number | null = null;
let draftTotal: number | null = null;

// ── Usage/limit data for plan-awareness badge ──
let usageData: ReturnType<typeof buildUsageBadge> = null;

// ── HOS-217: does the owner have a REAL owner/complex plan? ──
// Fail-open (`true`) on any fetch error, so a transient API failure never
// falsely nags a paying host.
//
// HOS-1183: this value gates the "anfitrión en preparación" banner and NOTHING
// else. It used to also decide whether each card offered Publish, and the
// comment here asserted the opposite — "only gates a proactive nag banner,
// never actual publish capability" — which stopped being true the moment H-99
// wired it into the button. One value answering two questions is what let a
// plan-shaped boolean decide publishability; the publish affordance now reads
// the server's own verdict below.
let hasOwnerPlan = false;
let effectiveSetReadOk = false;

// ── HOS-1668: what would the server do if this owner published? ──
// Resolved ONCE for the whole grid: coverage and trial eligibility are
// properties of the owner, so they cannot differ between two cards. Read from
// `subscribe-destination`, the same decision PB1 and `listing-access` consult
// when they reject a publish (HOS-1183's `publish-eligibility` answered 500 and
// this page failed OPEN, showing Publish anyway).
//
// Fails CLOSED: until a read succeeds the affordance is `unknown`, and the card
// shows a "could not check" status instead of Publish or the plans link.
let publishAffordance: PublishAffordance = UNKNOWN_PUBLISH_AFFORDANCE;

// ── HOS-1492: each listing's notices (rows 8/9, 18, 20, 24, 30, 31) and the
// unpublish confirmation lines (rows 2 and 25). Read in the same Promise.all.
// A failed read leaves every card without notices — never an invented one —
// and the page keeps rendering.
let listingNotices: ListingNoticesIndex = EMPTY_LISTING_NOTICES_INDEX;

try {
    const apiUrl = getApiUrl();
    const cookieHeader = Astro.request.headers.get('cookie');

    if (cookieHeader) {
        const headers = {
            cookie: cookieHeader,
            Accept: 'application/json'
        };

        // Parallel fetch: accommodations + effective set +
        // the publish destination. The third joins the existing Promise.all rather
        // than awaiting after it — this is one extra billing read per page
        // load, and serialising it would add its latency to every render.
        const countUrl = (status: PublicationStatusEnum) =>
            `${apiUrl}/api/v1/protected/accommodations?pageSize=1&publicationStatus=${status}`;
        const [
            accomResponse,
            usageBadgeResult,
            destinationResult,
            noticesResult,
            publishedTotalResult,
            draftTotalResult
        ] = await Promise.all([
            fetch(
                `${apiUrl}/api/v1/protected/accommodations?page=${requestedPage}&pageSize=${ACCOUNT_LIST_PAGE_SIZE}&sortBy=createdAt&sortOrder=desc`,
                { headers }
            ),
            fetchHostUsageBadge({ cookieHeader }),
            publishApi.subscribeDestination({ vertical: 'accommodation', cookieHeader }),
            publishApi.listingNotices({ vertical: 'accommodation', cookieHeader }),
            // Non-fatal: a failed count must not mark the whole list as failed.
            fetchListTotal({ url: countUrl(PublicationStatusEnum.PUBLISHED), headers }),
            fetchListTotal({ url: countUrl(PublicationStatusEnum.DRAFT), headers })
        ]);

        if (accomResponse.ok) {
            const body = (await accomResponse.json()) as {
                data?: {
                    items?: readonly Accommodation[];
                    pagination?: { total?: number };
                };
            };
            properties = body.data?.items ?? [];
            totalProperties = body.data?.pagination?.total ?? null;
        } else {
            fetchError = true;
            logger.error('[propiedades] API responded with status', accomResponse.status);
        }

        publishedTotal = publishedTotalResult;
        draftTotal = draftTotalResult;

        // Owner-wide published count; falls back to this page's count only when
        // the count read failed (the pre-pagination behaviour).
        const publishedCount =
            publishedTotal ??
            properties.filter(
                (property) => property.publicationStatus === PublicationStatusEnum.PUBLISHED
            ).length;
        usageData = buildUsageBadge({ effectiveSet: usageBadgeResult.effectiveSet, currentUsage: publishedCount });
        hasOwnerPlan = usageBadgeResult.hasOwnerPlan;
        effectiveSetReadOk = usageBadgeResult.entitlementsReadOk;

        if (!usageBadgeResult.entitlementsReadOk) logger.warn('[propiedades] effective-set read failed');

        publishAffordance = resolvePublishAffordance({ result: destinationResult });
        listingNotices = indexListingNotices({ result: noticesResult });
        if (!listingNotices.ok) {
            logger.warn('[propiedades] listing-notices read failed');
        }
        if (!destinationResult.ok) {
            // The affordance is already `unknown`; logged so a systematic
            // failure is visible rather than silently hiding every Publish.
            logger.warn('[propiedades] subscribe-destination read failed', {
                error: destinationResult.error
            });
        }
    }
} catch (err) {
    fetchError = true;
    logger.error('[propiedades] Failed to fetch properties', err instanceof Error ? err.message : String(err));
}

// ---------------------------------------------------------------------------
// i18n
// ---------------------------------------------------------------------------

const { t, tPlural } = createTranslations(locale);

const title = t('host.properties.list.title', 'Mis alojamientos');
const subtitle = t('host.properties.list.subtitle', 'Gestioná tus publicaciones');
const emptyMessage = t('host.properties.empty.title', 'Aún no publicaste ninguna propiedad');
const emptyCta = t('host.properties.empty.cta', 'Publicar ahora');

// HOS-1156: `/publicar/nueva/` was absorbed into `/publicar/`, which now
// carries the create form itself. Repointed here rather than left riding the
// 301 — a link to a redirect is a link whose destination somebody else can move,
// which is exactly how this issue was created.
const publishNewUrl = buildUrl({
    locale,
    path: PUBLISH_PAGE_PATH_BY_VERTICAL.accommodation
});
// Owner plans page (NOT mi-cuenta/suscripcion): BETA-195 routes this page's
// CTA to plan-change when the actor already has an active subscription
// (e.g. a tourist plan), so it correctly handles the cross-category
// tourist→owner upgrade this banner exists to prompt. Also matches the link
// `PublishButton.client.tsx` renders on the reactive `subscription_required`
// error, keeping the whole "publish" journey pointing at one place.
const ownerPlansUrl = buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE.owner });

const pageState = resolveAccountPageState({ requestedPage, total: totalProperties });
if (!fetchError && pageState.isPastEnd) {
    // A stale `?page=` past the end must not read as "you have no properties".
    return Astro.redirect(
        buildAccountPageHref({ locale, path: 'mi-cuenta/propiedades', page: pageState.totalPages })
    );
}

const isEmpty = properties.length === 0;

// HOS-217: proactive "anfitrión en preparación" banner — an owner with at
// least one DRAFT property but no real owner/complex subscription would
// otherwise only discover they can't publish by clicking "Publicar" on the
// card and hitting the `subscription_required` error. Surfacing it here
// (list level) instead of only reactively (card level) matches the
// requested onboarding journey. Decision extracted to a pure, unit-tested
// helper (see `@/lib/host/needs-plan-banner`).
const hasDraftProperty =
    draftTotal !== null
        ? draftTotal > 0
        : properties.some((property) => property.publicationStatus === PublicationStatusEnum.DRAFT);
const needsPlanBanner = resolveNeedsPlanBannerView({
    isEmpty,
    fetchError,
    effectiveSetReadOk,
    hasDraftProperty,
    hasOwnerPlan,
    publishAffordance
});

const needsPlanTitle = t('host.properties.list.needsPlanBanner.title', 'Sos anfitrión en preparación');
// HOS-2425: when publishing starts the free trial, the banner says so (with
// the server's own day count) instead of claiming a plan is required.
const needsPlanDescription =
    needsPlanBanner.kind === 'trialAvailable'
        ? tPlural('host.properties.list.needsPlanBanner.trialDescription', needsPlanBanner.trialDays, {
              trialDays: needsPlanBanner.trialDays
          })
        : t(
              'host.properties.list.needsPlanBanner.description',
              'Tus propiedades quedan guardadas como borrador y todavía no son visibles en el sitio. Para publicarlas necesitás un plan de anfitrión activo.'
          );
const needsPlanCta = t('host.properties.list.needsPlanBanner.cta', 'Elegir plan de anfitrión');

---

<AccountLayout locale={locale} title={title} description={subtitle} activeSection="propiedades">
    <div class="props-page">
    <!-- The header CTA is hidden in the empty and error states: the empty
         state already owns the primary call to action. -->
    <PageHeader locale={locale} title={title} description={subtitle}>
        <PageHelpLink slot="help" locale={locale} />
        {!isEmpty && !fetchError && (
            <LinkButton slot="actions" href={publishNewUrl}>
                {t('host.properties.list.publishAnother', 'Publicar otra')}
            </LinkButton>
        )}
    </PageHeader>

    {/* ── HOS-217 / HOS-2425: proactive "pick a host plan" notice. Info tone:
         nothing is wrong, the host has a next step. ── */}
    {needsPlanBanner.kind !== 'hidden' && (
        <Alert locale={locale} tone="info" title={needsPlanTitle}>
            {needsPlanDescription}
            {needsPlanBanner.kind === 'needsPlan' && (
                <LinkButton slot="action" href={ownerPlansUrl} size="sm">
                    {needsPlanCta}
                </LinkButton>
            )}
        </Alert>
    )}

    {/* ── Plan/limit awareness (HOS-2443: the cap is informational) ── */}
    {usageData && usageData.maxAllowed > 0 && (
        <Alert
            locale={locale}
            tone={resolveUsageAlertTone({ threshold: usageData.threshold })}
            title={tPlural('host.properties.usage.label', usageData.maxAllowed, {
                current: usageData.currentUsage,
                max: usageData.maxAllowed
            })}
        >
            {usageData.threshold !== 'ok' && (
                <LinkButton
                    slot="action"
                    variant="secondary"
                    size="sm"
                    href={buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE.owner })}
                >
                    {t('host.properties.usage.upgrade', 'Mejorar plan')}
                </LinkButton>
            )}
        </Alert>
    )}

    {fetchError ? (
        <PageLoadError
            client:load
            locale={locale}
            title={t('host.properties.empty.fetchError')}
            description={t('host.properties.error.body')}
            helpId="section:propiedades.listado"
        />
    ) : !isEmpty ? (
        <>
        <ListingCardGrid label={title} helpId="section:propiedades.listado">
            {properties.map((property) => (
                <PropertyCard
                    property={property}
                    locale={locale}
                    publishAffordance={publishAffordance}
                    notices={listingNotices.byListingId.get(property.id)}
                    trialRunning={listingNotices.trialRunning}
                />
            ))}
        </ListingCardGrid>
        {pageState.totalPages > 1 && (
            <Pagination
                locale={locale}
                page={pageState.page}
                pageCount={pageState.totalPages}
                hrefFor={(page: number) => buildAccountPageHref({ locale, path: 'mi-cuenta/propiedades', page })}
            />
        )}
        </>
    ) : (
        <EmptyState
            title={emptyMessage}
            helpId="section:propiedades.listado"
        >
            <BuildingIcon slot="icon" size="lg" aria-hidden="true" />
            <LinkButton slot="action" href={publishNewUrl}>
                {emptyCta}
            </LinkButton>
        </EmptyState>
    )}
    </div>
</AccountLayout>

<style>
    /* The account content slot has no flow gap: one stack owns the rhythm. */
    .props-page {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }
</style>
