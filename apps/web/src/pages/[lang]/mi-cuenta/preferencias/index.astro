---
/**
 * @file mi-cuenta/preferencias/index.astro
 * @description Account preferences page.
 * @route /{lang}/mi-cuenta/preferencias/
 * @rendering SSR
 */

import { getApiUrl } from '@/lib/env';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { PageHeader } from '@/components/account/ui';
import { PreferenceToggles } from '@/components/account/PreferenceToggles.client';
import { RestartTour } from '@/components/account/RestartTour.client';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { EntitlementKeyEnum } from '@repo/schemas';
import { fetchPublicPlans, planNamesWithEntitlement } from '@/lib/billing/fetch-plans';
import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const { t } = createTranslations(locale);
const title = t('account.pages.preferences.title', 'Preferencias');
const apiUrl = getApiUrl();
// HOS-2479: the locked search-history row names the catalog plans that include it
// (never a literal). The catalog reader is server-only, so the names are read
// here and handed to the island; the page itself stays session-blind.
const historyGatePlanNames = planNamesWithEntitlement({
	result: await fetchPublicPlans({ vertical: 'tourist' }),
	entitlement: EntitlementKeyEnum.CAN_VIEW_SEARCH_HISTORY
});
const plansHref = buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE.tourist });
---

<AccountLayout locale={locale} title={title} activeSection="preferencias">
	<PageHeader title={title} locale={locale} />

	<PreferenceToggles
		client:load
		userId={user.id}
		locale={locale}
		apiUrl={apiUrl}
		historyGatePlanNames={historyGatePlanNames}
		plansHref={plansHref}
	/>

	<div class="preferencias-tour-gap">
		<RestartTour client:idle locale={locale} userRoles={user.roles} />
	</div>
</AccountLayout>

<style>
	/* The kit Sections inside PreferenceToggles have no outer margin, so the tour
	   section needs an explicit gap before it. */
	.preferencias-tour-gap {
		margin-top: var(--space-6);
	}
</style>
