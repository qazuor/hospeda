---
/**
 * @file mi-cuenta/suscripcion/index.astro
 * @description Account subscription page ("Mi Suscripción").
 *
 * The old-billing dashboard this page used to mount — the subscription read
 * per product domain, the domain switcher, the plan-change catalogue, the
 * checkout-retry banner and the return-param scrubber — was removed with the
 * old billing client (HOS-1637, AC:B13a:21 / AC:B13a:22). Every one of those
 * reads targeted a billing route the API no longer registers.
 *
 * The page keeps its URL, its layout and its account-nav entry, and renders
 * only its header until the leaf that rewrites "Mi Suscripción" against the
 * new billing (`B13a.4`) fills it in. It makes no billing call.
 *
 * @route /{lang}/mi-cuenta/suscripcion/
 * @rendering SSR
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

const { t } = createTranslations(locale);
const title = t('account.pages.subscription.title', 'Suscripción');
---

<AccountLayout locale={locale} title={title} activeSection="suscripcion">
	<AccountPageHeader title={title} />
</AccountLayout>
