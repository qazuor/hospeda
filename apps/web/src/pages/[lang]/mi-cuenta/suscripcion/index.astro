---
/**
 * @file mi-cuenta/suscripcion/index.astro
 * @description Account subscription page ("Mi Suscripción").
 *
 * The old-billing dashboard this page used to mount — the subscription read
 * per product domain, the domain switcher, the plan-change catalogue, the
 * checkout-retry banner and the return-param scrubber — was removed with the
 * old billing client (HOS-1637, AC:B13a:21 / AC:B13a:22). Every one of those
 * reads targeted a billing route the API no longer registers.
 *
 * The page reads the authenticated owner's subscriptions during SSR and shows
 * the grace notice and self-service cancellation block above trial summary.
 *
 * Under the header, `TrialSummary` (HOS-1492, row 4) shows the accumulated
 * free-trial days per vertical and their origin. It reads the publish
 * trial-summary route (not billing), one call per vertical in parallel; a
 * vertical whose read fails is left out, never invented. The block is
 * self-contained so B13a.4 can move it whole.
 *
 * HOS-2485: on the account kit — `PageHeader` with the «Plan / Complementos»
 * `NavTabs` (which replace the bare add-ons link), each subscription a
 * `PlanSummary`, the trial promo block a `Section`. Presentation only: the
 * reads, the return flow and every Fase 1 notice are unchanged.
 *
 * @route /{lang}/mi-cuenta/suscripcion/
 * @rendering SSR
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import { hasBillingPresence } from '@/lib/account-billing-presence';
import { PageHeader, Section } from '@/components/account/ui';
import PageHelpLink from '@/components/account/help/PageHelpLink.astro';
import SubscriptionTabs from '@/components/account/SubscriptionTabs.astro';
import TrialSummary from '@/components/account/TrialSummary.astro';
import MySubscriptions from '@/components/account/MySubscriptions.astro';
import ReceiptsList from '@/components/account/ReceiptsList.astro';
import { ReceiptViewer } from '@/components/account/receipts/ReceiptViewer.client';
import { ExpiredDeclinedSignupNotice } from '@/components/account/ExpiredDeclinedSignupNotice';
import { PromoCodeRedeem } from '@/components/account/PromoCodeRedeem.client';
import StripMercadoPagoReturnParams from '@/components/billing/StripMercadoPagoReturnParams.astro';
import { SubscriptionReturn } from '@/components/billing/SubscriptionReturn.client';
import { AddonPurchaseGate } from '@/components/billing/addon-purchase/AddonPurchaseGate.client';
import { TrialStatusEnum, type OwnReceipt } from '@repo/schemas';
import { billingSubscriptionApi, publishApi, type PublishVerticalSlug } from '@/lib/api/endpoints-protected';
import { parseOwnSubscriptions } from '@/lib/billing/self-cancel';
import { parseReturnSubscriptionId, selectDeclinedNoticesToShow } from '@/lib/billing/subscription-return';
import { getPlanName } from '@/lib/billing-i18n';
import { eligibleSubscriptionTargets, plansPathForVertical } from '@/lib/billing/addon-purchase';
import { resolveMySubscriptionVerticalLabelKey } from '@/lib/billing/my-subscription-summary';
import { buildUrl } from '@/lib/urls';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildLoginRedirect } from '@/lib/middleware-helpers';
import { isOwnerAudience, resolveEmptySubscriptionPlansPath } from '@/lib/account-roles';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildLoginRedirect({ locale, currentUrl: Astro.url.pathname + Astro.url.search }));
}

const { t } = createTranslations(locale);
const title = t('account.pages.subscription.title', 'Suscripción');

// Row 4 (HOS-1492): one trial-summary read per vertical the route admits.
const TRIAL_SUMMARY_VERTICALS: readonly PublishVerticalSlug[] = [
	'accommodation',
	'venue',
	'experience'
];
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const trialSummaryReads = await Promise.all(
	TRIAL_SUMMARY_VERTICALS.map(async (vertical) => {
		try {
			const result = await publishApi.trialSummary({ vertical, cookieHeader });
			return result.ok ? [{ vertical, summary: result.data }] : [];
		} catch {
			return [];
		}
	})
);
const trialSummaries = trialSummaryReads.flat();
let ownSubscriptions = null;
try {
	ownSubscriptions = parseOwnSubscriptions({ result: await billingSubscriptionApi.listMine({ cookieHeader }) });
} catch {
	 ownSubscriptions = null;
}

// HOS-2566: the owner's payment receipts; a failed read is shown as such, never as «none».
let ownReceipts: readonly OwnReceipt[] | null = null;
try {
	const receiptsRead = await billingSubscriptionApi.listReceipts({ cookieHeader });
	ownReceipts = receiptsRead.ok ? receiptsRead.data.receipts : null;
} catch {
	ownReceipts = null;
}

// HOS-2566: `?recibo=<receiptId>` is where every «Ver recibo» button leads. The page reads
// nothing about the receipt: the island fetches the PDF with the owner's session, so a
// receipt of somebody else answers «not found» exactly like one that does not exist.
// The same shape the API's `z.string().uuid()` accepts, so a malformed id is ignored here.
const RECEIPT_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const requestedReceipt = Astro.url.searchParams.get('recibo');
const receiptId = requestedReceipt && RECEIPT_ID.test(requestedReceipt) ? requestedReceipt : null;

const billingPresence = await hasBillingPresence({ userId: user.id, cookieHeader });

const addonVerticals = [...new Set(eligibleSubscriptionTargets({
    subscriptions: ownSubscriptions?.subscriptions ?? [],
    compatibleVerticals: ownSubscriptions?.subscriptions.map((row) => row.vertical) ?? []
}).map((row) => row.vertical))];

// HOS-1979: the payer returns from Mercado Pago with `?subscription=<our id>`.
// Read that attempt's real status here, server-side; the island polls from there.
const returnSubscriptionId = parseReturnSubscriptionId({ search: Astro.url.search });
let returnStatus: string | null = null;
let returnBillingOptionId: string | null = null;
let returnDeclaredPayerEmail: string | null = null;
if (returnSubscriptionId) {
	try {
		const read = await billingSubscriptionApi.read({ subscriptionId: returnSubscriptionId, cookieHeader });
		if (read.ok) {
			returnStatus = read.data.status;
			returnBillingOptionId = read.data.billingOptionId;
			returnDeclaredPayerEmail = read.data.declaredPayerEmail;
		}
	} catch {
		returnStatus = null;
	}
}
---

<AccountLayout locale={locale} title={title} activeSection="suscripcion">
	<StripMercadoPagoReturnParams slot="head-early" />
	<PageHeader locale={locale} title={title}>
		<PageHelpLink slot="help" locale={locale} />
		<SubscriptionTabs slot="tabs" locale={locale} current="plan" showAddons={billingPresence} />
	</PageHeader>
	{returnSubscriptionId && <SubscriptionReturn
		client:load
		locale={locale}
		subscriptionId={returnSubscriptionId}
		initialStatus={returnStatus}
		billingOptionId={returnBillingOptionId}
		accountEmail={user.email}
		declaredPayerEmail={returnDeclaredPayerEmail}
	/>}
	{selectDeclinedNoticesToShow({ declinedSignups: ownSubscriptions?.declinedSignups ?? [], returnSubscriptionId }).map((notice) => (
		<SubscriptionReturn
			client:load
			locale={locale}
			subscriptionId={notice.subscriptionId}
			initialStatus="CHARGE_DECLINED"
			billingOptionId={notice.billingOptionId}
			accountEmail={user.email}
			declaredPayerEmail={notice.declaredPayerEmail}
			attemptPlanName={getPlanName({ plan: { slug: notice.plan.slug, name: notice.plan.name, description: '' }, t })}
		/>
	))}
	{(ownSubscriptions?.expiredDeclinedSignups ?? []).map((notice) => (
		<ExpiredDeclinedSignupNotice
			locale={locale}
			vertical={notice.vertical}
			title={t('account.subscription.mine.expiredDeclined.title')}
			body={t('account.subscription.mine.expiredDeclined.body', undefined, {
				plan: getPlanName({ plan: { slug: notice.plan.slug, name: notice.plan.name, description: '' }, t }),
				vertical: t(resolveMySubscriptionVerticalLabelKey({ vertical: notice.vertical }))
			})}
			ctaLabel={t('account.subscription.mine.expiredDeclined.cta')}
			href={buildUrl({ locale, path: plansPathForVertical({ vertical: notice.vertical }) })}
		/>
	))}
	<div data-subscription-sections class="sub-page__sections">
	{receiptId && (
		<section aria-labelledby="receipt-viewer-title" data-testid="receipt-section">
			<h2 id="receipt-viewer-title">{t('account.subscription.receipts.page.title')}</h2>
			<ReceiptViewer client:load locale={locale} receiptId={receiptId} backHref={buildUrl({ locale, path: 'mi-cuenta/suscripcion' })} />
		</section>
	)}
	<MySubscriptions locale={locale} result={ownSubscriptions} plansPath={resolveEmptySubscriptionPlansPath({ roles: user.roles })} />
	<ReceiptsList locale={locale} receipts={ownReceipts} />
    {addonVerticals.map((vertical) => (
        <Section id={`addons-${vertical}`} helpId="section:complementos.recurrentes" title={t('billing.addonPurchase.verticalTitle', undefined, { vertical: t(resolveMySubscriptionVerticalLabelKey({ vertical })) })}>
            <AddonPurchaseGate client:visible locale={locale} returnOrderRequestId={null} accountEmail={user.email} onlyVertical={vertical} plansPath={plansPathForVertical({ vertical })} />
        </Section>
    ))}
	<TrialSummary locale={locale} entries={trialSummaries} liveSubscriptionVerticals={ownSubscriptions?.subscriptions.map((row) => row.vertical) ?? []} audience={isOwnerAudience({ roles: user.roles }) ? 'owner' : 'tourist'} />
	{trialSummaries.some(({ summary }) => summary.status === TrialStatusEnum.TRIAL_ACTIVE) && <div data-testid="trial-promo-redeem">
		<Section title={t('account.subscription.promoRedeem.trialSectionTitle')} helpId="section:suscripcion.promo">
		{trialSummaries.filter(({ summary }) => summary.status === TrialStatusEnum.TRIAL_ACTIVE).map(({ vertical }) =>
			<PromoCodeRedeem client:visible vertical={vertical} locale={locale} offer="TRIAL" />
		)}
		</Section>
	</div>}
	</div>
</AccountLayout>

<style>
	/* The account content slot has no flow gap: one stack owns the rhythm. */
	.sub-page__sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}
</style>
