---
/**
 * @file mi-cuenta/suscripcion/index.astro
 * @description Account subscription page — renders the SubscriptionDashboard island.
 * @route /{lang}/mi-cuenta/suscripcion/
 * @rendering SSR
 */

import AccountLayout from '@/layouts/AccountLayout.astro';
import AccountPageHeader from '@/components/account/AccountPageHeader.astro';
import { SubscriptionDashboard } from '@/components/account/SubscriptionDashboard.client';
import { hasAccommodationsNavAccess } from '@/lib/nav-gating';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl, buildUrlWithParams } from '@/lib/urls';
import { fetchPublicPlans, filterPlansByCategory } from '@/lib/billing/fetch-plans';
import { userApi } from '@/lib/api/endpoints-protected';
import {
	resolveActiveSubscriptionDomain,
	SUBSCRIPTION_DASHBOARD_DOMAINS,
	type SubscriptionDashboardDomain
} from '@/lib/billing/subscription-domain';

const locale = Astro.locals.locale as SupportedLocale;
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(buildUrl({ locale, path: 'auth/signin' }));
}

const { t } = createTranslations(locale);

/**
 * HOS-259 / HOS-689: `?domain=<domain>` scopes the dashboard to one of the
 * owner's (up to three) independent subscriptions — accommodation,
 * gastronomy, experience (HOS-688 retired the old binary
 * `'accommodation' | 'commerce'` union: commerce billing is per-VERTICAL
 * now, so `'commerce'` is no longer a real subscription scope). Used by the
 * commerce SUSPENDED recover CTA (`CommerceListingActions.client.tsx`,
 * `?domain=<listing.vertical>`) for an owner who holds several subscriptions
 * under one billing customer.
 *
 * Server-side pre-check: which domains does the caller actually hold a
 * subscription in? Drives two things — the default domain when no/invalid
 * `?domain=` is given (HOS-689 AC-21: a commerce-only owner must land on
 * THEIR subscription, not an accommodation "no subscription" empty state),
 * and the domain switcher rendered below when the owner holds more than one.
 */
const cookieHeader = Astro.request.headers.get('cookie') ?? undefined;
const domainSubscriptionResults = await Promise.all(
	SUBSCRIPTION_DASHBOARD_DOMAINS.map((domain) =>
		userApi.getSubscription({ productDomain: domain, cookieHeader })
	)
);
const heldDomains: SubscriptionDashboardDomain[] = SUBSCRIPTION_DASHBOARD_DOMAINS.filter(
	(_domain, index) => {
		const result = domainSubscriptionResults[index];
		return result?.ok && result.data.subscription !== null;
	}
);

const rawDomain = Astro.url.searchParams.get('domain');
const productDomain = resolveActiveSubscriptionDomain({ rawDomain, heldDomains });

const TITLE_KEY_BY_DOMAIN: Record<SubscriptionDashboardDomain, { key: string; fallback: string }> = {
	accommodation: { key: 'account.pages.subscription.title', fallback: 'Suscripción' },
	gastronomy: {
		key: 'account.pages.subscription.titleGastronomy',
		fallback: 'Suscripción de gastronomía'
	},
	experience: {
		key: 'account.pages.subscription.titleExperience',
		fallback: 'Suscripción de experiencias'
	}
};
const title = t(TITLE_KEY_BY_DOMAIN[productDomain].key, TITLE_KEY_BY_DOMAIN[productDomain].fallback);

const DOMAIN_SWITCHER_LABEL_KEY: Record<SubscriptionDashboardDomain, { key: string; fallback: string }> = {
	accommodation: { key: 'account.pages.subscription.domainSwitcher.accommodation', fallback: 'Alojamiento' },
	gastronomy: { key: 'account.pages.subscription.domainSwitcher.gastronomy', fallback: 'Gastronomía' },
	experience: { key: 'account.pages.subscription.domainSwitcher.experience', fallback: 'Experiencias' }
};

/** Link to this page scoped to one domain — accommodation omits `?domain=` (its historical default). */
function buildDomainUrl(domain: SubscriptionDashboardDomain): string {
	return domain === 'accommodation'
		? buildUrl({ locale, path: 'mi-cuenta/suscripcion' })
		: buildUrlWithParams({ locale, path: 'mi-cuenta/suscripcion', params: { domain } });
}

/**
 * Minimal user shape forwarded to the island (no sensitive fields).
 *
 * HOS-296: the previous `(user as { role?: string }).role ?? 'USER'` cast was
 * exactly the silent-failure pattern spec §7.2 warns about — it type-checks
 * against a hand-written local shape, so dropping the scalar would have
 * degraded every subscriber to `'USER'` with no build error. `roles` comes
 * from `Astro.locals.user`, which is typed, so a rename breaks the build.
 */
const islandUser = {
	id: user.id,
	roles: user.roles,
};

/**
 * Fetch plans server-side so the PlanChangeFlow island has the full plan
 * catalog without an extra client-side request. Degrades gracefully on error
 * (island falls back to the plain pricing-page link).
 *
 * The plan category depends on the user's audience (BETA-173): a host sees
 * owner plans (Basic/Professional/Premium), a tourist sees tourist plans
 * (Plus/VIP) — matching the same host-tier split used for the "Ver
 * planes" CTA (BETA-165).
 */
const planCategory = hasAccommodationsNavAccess({ roles: islandUser.roles }) ? 'owner' : 'tourist';
const plansResult = await fetchPublicPlans();
const availablePlans = plansResult.ok ? filterPlansByCategory(plansResult.plans, planCategory) : [];
---

<AccountLayout locale={locale} title={title} activeSection="suscripcion">
	<AccountPageHeader title={title} />

	{heldDomains.length > 1 && (
		<nav
			class="sub-page__switcher"
			aria-label={t('account.pages.subscription.domainSwitcher.label', 'Elegí qué suscripción ver')}
		>
			{heldDomains.map((domain) => (
				<a
					href={buildDomainUrl(domain)}
					class:list={[
						'sub-page__switcher-link',
						domain === productDomain && 'sub-page__switcher-link--active'
					]}
					aria-current={domain === productDomain ? 'page' : undefined}
				>
					{t(DOMAIN_SWITCHER_LABEL_KEY[domain].key, DOMAIN_SWITCHER_LABEL_KEY[domain].fallback)}
				</a>
			))}
		</nav>
	)}

	<SubscriptionDashboard
		locale={locale}
		user={islandUser}
		plans={availablePlans}
		productDomain={productDomain}
		client:load
	/>
</AccountLayout>

<style>
	.sub-page__switcher {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2, 0.5rem);
		margin-bottom: var(--space-6, 1.5rem);
	}

	.sub-page__switcher-link {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-pill, 9999px);
		background-color: var(--surface-warm, oklch(0.96 0.02 60));
		color: var(--core-muted-foreground);
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		transition: opacity 150ms ease-out;
	}

	.sub-page__switcher-link:hover {
		opacity: 0.85;
	}

	.sub-page__switcher-link--active {
		background-color: var(--brand-primary);
		color: var(--primary-foreground, #ffffff);
		border-color: var(--brand-primary);
	}
</style>
