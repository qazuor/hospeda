---
/**
 * @file destinos/[slug]/eventos/index.astro
 * @description Events within a destination, filtered via event_locations.destination_id.
 * @route /{lang}/destinos/{slug}/eventos/
 * @rendering SSR + ISR 24h
 */
import ListingLayout from '@/layouts/ListingLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import ListingPageHeader from '@/components/shared/layout/ListingPageHeader.astro';
import EventCardHorizontal from '@/components/shared/cards/EventCardHorizontal.astro';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import ErrorBanner from '@/components/shared/feedback/ErrorBanner.astro';
import Pagination from '@/components/shared/feedback/Pagination.astro';
import { destinationsApi, eventsApi } from '@/lib/api/endpoints';
import { toEventCardProps } from '@/lib/api/transforms';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

import { buildEntityCacheTags, CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { hasOnlyPaginationParams } from '@/lib/cache/listing-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const destResult = await destinationsApi.getBySlug({ slug });
if (!destResult.ok) return new Response(null, { status: 404 });
const dest = destResult.data as Record<string, unknown>;
const destId = String(dest.id || '');
const destName = String(dest.name || slug);

// --- Edge cacheability (HOS-369 W2-3) ---
// After the two 404 guards, so an error response is never marked shareable.
// Same two-tag reasoning as the sibling accommodations listing: an event write
// in this destination changes it (`list-event`), and so does a destination
// rename (`dest-<slug>`, interpolated into the heading and title).
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	// `/…/page/N/` rewrites into this route with `?page=N`, so an empty-query
	// check would stop caching every paginated page.
	cacheable: hasOnlyPaginationParams({ searchParams: Astro.url.searchParams }),
	tags: [
		CACHE_TAG_COLLECTIONS.event,
		...buildEntityCacheTags({ entity: 'destination', slug, id: destId })
	]
});

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const pageSize = 9;

const result = await eventsApi.list({ destinationId: destId, page, pageSize });
const hasError = !result.ok;
const items = result.ok ? result.data.items : [];
const total = result.ok ? result.data.pagination.total : 0;
const totalPages = result.ok ? result.data.pagination.totalPages : 0;
const cards = items.map((item) => toEventCardProps({ item: item as unknown as Record<string, unknown>, locale }));

// HOS-369 WB0-5: favourite state is per-user, so it is no longer resolved
// here — the hearts resolve it themselves after hydration, once per page
// load for the whole grid (`store/favorites-store`).
const resolvedCards = cards;

const baseUrl = buildUrl({ locale, path: `destinos/${slug}/eventos` });

// Heading scoped to the destination — "Eventos en {Ciudad}" (localized). The
// city moves into the H1 (and <title>); the decorative tagline reverts to the
// generic listing tagline so the city is not shown twice.
const heading = t('events.typeInLocation', '{{type}} en {{location}}', {
	type: t('events.title', 'Eventos'),
	location: destName
});

// --- Breadcrumb JSON-LD ---
// Mirrors the visible trail below PLUS the current page: the visible component
// drops the leaf (it is already the H1), but BreadcrumbList must stay complete.
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const breadcrumbItems = [
	{ name: t('nav.home', 'Inicio'), url: `${siteOrigin}${buildUrl({ locale, path: '' })}` },
	{ name: t('destinations.title', 'Destinos'), url: `${siteOrigin}${buildUrl({ locale, path: 'destinos' })}` },
	{ name: destName, url: `${siteOrigin}${buildUrl({ locale, path: `destinos/${slug}` })}` },
	{ name: t('events.title', 'Eventos'), url: `${siteOrigin}${Astro.url.pathname}` }
];
---

<ListingLayout locale={locale} title={heading} showFilters={false} totalCount={total}>
	<BreadcrumbJsonLd slot="head-extra" items={breadcrumbItems} />
	<Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: t('destinations.title', 'Destinos'), path: 'destinos' }, { label: destName, path: `destinos/${slug}` }, { label: t('events.title', 'Eventos') }]} />
	<ListingPageHeader slot="page-header" locale={locale} tagline={t('events.tagline', 'No te pierdas nada')} title={heading} />
	{hasError && !result.ok && <ErrorBanner locale={locale} error={result.error} entityName="eventos" />}
	{!hasError && resolvedCards.length === 0 && <EmptyState locale={locale} variant="empty" actionUrl={buildUrl({ locale, path: 'eventos' })} actionLabel={t('events.viewAll', 'Ver todos los eventos')} />}
	{!hasError && resolvedCards.length > 0 && (
		<div class="events-grid">
			{resolvedCards.map((card, i) => (
				<div data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
					<EventCardHorizontal data={card} locale={locale} />
				</div>
			))}
		</div>
	)}
	{totalPages > 1 && <Pagination slot="pagination" currentPage={page} totalPages={totalPages} baseUrl={baseUrl.slice(0, -1)} locale={locale} />}
</ListingLayout>

<style>
	.events-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
		gap: var(--space-card-gap);
	}
</style>
