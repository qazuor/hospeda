---
/**
 * @file planes/gastronomia/index.astro
 * @description Sales page for the gastronomy vertical — level 2 of the three
 * that HOS-941 D-7 defines: "why is this worth it", answered without leaving
 * the page, and one click to "what does it cost".
 *
 * @route     /[lang]/planes/gastronomia/
 * @rendering SSR (no prerender); edge-cacheable via the `pricing` cache class,
 *   tagged `CACHE_TAG_PRICING`. The middleware is fail-closed and rejects a
 *   public `Cache-Control` without a declared class and tag (HOS-941 R-5).
 *
 * ## What moved, and what stayed behind
 *
 * Supersedes `/publicar-restaurante/`, which 301s here since HOS-1032. That
 * could not happen earlier: the old page still carried the price block inline,
 * and the price only moved DOWN to `/planes/gastronomia/precios/` when H7 built
 * it, so retiring the URL first would have left the vertical with no price at
 * all. Both halves landed together.
 * The split is not tidiness: a visitor who has already decided to publish
 * should not scroll a brochure to reach the grid, and "publicar mi restaurante"
 * and "cuánto cuesta publicar mi restaurante" are two search intents that a
 * single URL can only serve one of well.
 *
 * ## Why `gastronomia` and not `restaurantes`
 *
 * D-9. HOS-986 is open precisely because "Publicá tu restaurante" reads as
 * excluding food trucks, rotiserías and parrillas — all of which this vertical
 * sells to. Repeating that word in a URL bakes the exclusion into the most
 * expensive thing to change later. No collision with the public `/gastronomia/`
 * listing section: this one is nested under `/planes/`.
 */

import { CACHE_TAG_PRICING } from '@repo/cache-tags';
import { MapIcon, SettingsIcon, ShieldIcon } from '@repo/icons';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import BenefitsSection from '@/components/marketing/BenefitsSection.astro';
import StepsSection from '@/components/marketing/StepsSection.astro';
import FaqSection from '@/components/marketing/FaqSection.astro';
import GradientButton from '@/components/shared/ui/GradientButton.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'pricing',
    tags: [CACHE_TAG_PRICING]
});

/**
 * The price FAQ answer carries no trial length: the old plan catalogue the
 * length used to be read from no longer exists, and promising a number we
 * cannot read from the source of truth is worse than staying quiet (HOS-525).
 */
const priceFaqAnswer = t('gastronomy.landing.faq.a1NoTrial');

const benefits = [
    {
        Icon: MapIcon,
        title: t('gastronomy.landing.benefits.item1.title'),
        desc: t('gastronomy.landing.benefits.item1.desc')
    },
    {
        Icon: SettingsIcon,
        title: t('gastronomy.landing.benefits.item2.title'),
        desc: t('gastronomy.landing.benefits.item2.desc')
    },
    {
        Icon: ShieldIcon,
        title: t('gastronomy.landing.benefits.item3.title'),
        desc: t('gastronomy.landing.benefits.item3.desc')
    }
] as const;

const steps = [
    {
        num: '01',
        title: t('gastronomy.landing.howItWorks.step1.title'),
        desc: t('gastronomy.landing.howItWorks.step1.desc')
    },
    {
        num: '02',
        title: t('gastronomy.landing.howItWorks.step2.title'),
        desc: t('gastronomy.landing.howItWorks.step2.desc')
    },
    {
        num: '03',
        title: t('gastronomy.landing.howItWorks.step3.title'),
        desc: t('gastronomy.landing.howItWorks.step3.desc')
    }
] as const;

/**
 * Answers resolved here, not left as keys for the template.
 *
 * `a1` is the price answer and its shape depends on the catalogue, which a
 * key-per-question array cannot express. Resolving all three the same way keeps
 * the rendered page and the `FAQPage` structured data reading from one value
 * each, so the JSON-LD can never advertise a trial the visible answer omits.
 */
const faqs = [
    { q: t('gastronomy.landing.faq.q1'), a: priceFaqAnswer },
    { q: t('gastronomy.landing.faq.q2'), a: t('gastronomy.landing.faq.a2') },
    { q: t('gastronomy.landing.faq.q3'), a: t('gastronomy.landing.faq.a3') }
] as const;

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
};

const title = t('gastronomy.landing.lead.title');
const subtitle = t('gastronomy.landing.lead.subtitle');
/**
 * The CTA points at this vertical's own pricing page.
 *
 * It used to point at `/publicar-restaurante/`, which carried the price block
 * inline — the interim H6 documented, because sending both CTAs at a
 * `/precios/` page that did not exist yet would have made every conversion path
 * on this page a 404. HOS-1032 built it and retired the old URL in the same
 * change, which is why that interim is over.
 */
const pricingHref = buildUrl({ locale, path: PRICING_PAGE_PATH_BY_AUDIENCE.gastronomy });
---

<MarketingLayout
    locale={locale}
    title={title}
    description={subtitle}
>
    <JsonLd slot="head-extra" data={faqJsonLd} />

    <Breadcrumbs locale={locale} items={[{ label: title }]} />

    <MarketingHero
        tagline={t('gastronomy.landing.benefits.tagline')}
        titleAccent={title}
        subtitle={subtitle}
    >
        <GradientButton
            slot="cta"
            href={pricingHref}
            label={t('pricing.nav.seePlans')}
            variant="primary"
            icon="true"
        />
    </MarketingHero>

    <BenefitsSection
        tagline={t('gastronomy.landing.benefits.tagline')}
        title={t('gastronomy.landing.benefits.title')}
        items={benefits}
        columns={3}
    />

    <StepsSection
        tagline={t('gastronomy.landing.howItWorks.tagline')}
        title={t('gastronomy.landing.howItWorks.title')}
        items={steps}
        columns={3}
        warm
    />

    <FaqSection
        tagline={t('gastronomy.landing.faq.tagline')}
        title={t('gastronomy.landing.faq.title')}
        items={faqs}
    />

    <section class="sales-cta section section--warm">
        <div class="sales-cta__container section__container">
            <h2 class="sales-cta__title">{t('gastronomy.landing.price.title')}</h2>
            <GradientButton
                href={pricingHref}
                label={t('pricing.nav.seePlans')}
                variant="primary"
                icon="true"
            />
        </div>
    </section>
</MarketingLayout>

<style>
    .sales-cta__container {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
        text-align: center;
    }

    .sales-cta__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.5rem, 3vw, 2rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-6);
    }
</style>
