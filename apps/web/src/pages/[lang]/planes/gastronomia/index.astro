---
/**
 * @file planes/gastronomia/index.astro
 * @description Sales page for the gastronomy vertical — level 2 of the three
 * that HOS-941 D-7 defines: "why is this worth it", answered without leaving
 * the page, and one click to "what does it cost".
 *
 * @route     /[lang]/planes/gastronomia/
 * @rendering SSR (no prerender); edge-cacheable via the `pricing` cache class,
 *   tagged `CACHE_TAG_PRICING`. The middleware is fail-closed and rejects a
 *   public `Cache-Control` without a declared class and tag (HOS-941 R-5).
 *
 * ## What moved, and what stayed behind
 *
 * Supersedes `/publicar-restaurante/`, which 301s here once H7 lands — not
 * before, because that page still carries the price block inline and the price
 * only moves DOWN to `/planes/gastronomia/precios/` when H7 builds it.
 * Retiring the old URL first would leave the vertical with no price at all.
 * The split is not tidiness: a visitor who has already decided to publish
 * should not scroll a brochure to reach the grid, and "publicar mi restaurante"
 * and "cuánto cuesta publicar mi restaurante" are two search intents that a
 * single URL can only serve one of well.
 *
 * ## Why `gastronomia` and not `restaurantes`
 *
 * D-9. HOS-986 is open precisely because "Publicá tu restaurante" reads as
 * excluding food trucks, rotiserías and parrillas — all of which this vertical
 * sells to. Repeating that word in a URL bakes the exclusion into the most
 * expensive thing to change later. No collision with the public `/gastronomia/`
 * listing section: this one is nested under `/planes/`.
 */

import { CACHE_TAG_PRICING } from '@repo/cache-tags';
import { MapIcon, SettingsIcon, ShieldIcon } from '@repo/icons';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import BenefitsSection from '@/components/marketing/BenefitsSection.astro';
import StepsSection from '@/components/marketing/StepsSection.astro';
import FaqSection from '@/components/marketing/FaqSection.astro';
import GradientButton from '@/components/shared/ui/GradientButton.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { fetchPublicPlans } from '@/lib/billing/fetch-plans';
import { resolveCommerceLandingOffer } from '@/lib/billing/commerce-landing-plan';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'pricing',
    tags: [CACHE_TAG_PRICING]
});

/**
 * The trial length, read from the plan catalogue and never from a string.
 *
 * HOS-941 R-2, and the reason is on the record: `commerce.json` used to spell
 * "30 días de prueba gratis" by hand in three locales, which matched the
 * catalogue by coincidence and would have kept promising 30 the day an operator
 * edited the plan. That is exactly HOS-525, where marketing promised hosts 30
 * days and checkout granted 14.
 *
 * `null` renders NOTHING. Never "0 días", never a number borrowed from the
 * other vertical: a failed fetch and a plan with no trial must be
 * indistinguishable to a visitor, because promising a trial we cannot honour is
 * worse than staying quiet.
 */
const plansResult = await fetchPublicPlans({ domain: 'gastronomy' });
const { trialDays } = resolveCommerceLandingOffer({ plansResult });

const priceFaqAnswer =
    trialDays === null
        ? t('commerce.landing.gastronomy.faq.a1NoTrial')
        : tPlural('commerce.landing.gastronomy.faq.a1', trialDays);

const benefits = [
    {
        Icon: MapIcon,
        title: t('commerce.landing.gastronomy.benefits.item1.title'),
        desc: t('commerce.landing.gastronomy.benefits.item1.desc')
    },
    {
        Icon: SettingsIcon,
        title: t('commerce.landing.gastronomy.benefits.item2.title'),
        desc: t('commerce.landing.gastronomy.benefits.item2.desc')
    },
    {
        Icon: ShieldIcon,
        title: t('commerce.landing.gastronomy.benefits.item3.title'),
        desc: t('commerce.landing.gastronomy.benefits.item3.desc')
    }
] as const;

const steps = [
    {
        num: '01',
        title: t('commerce.landing.gastronomy.howItWorks.step1.title'),
        desc: t('commerce.landing.gastronomy.howItWorks.step1.desc')
    },
    {
        num: '02',
        title: t('commerce.landing.gastronomy.howItWorks.step2.title'),
        desc: t('commerce.landing.gastronomy.howItWorks.step2.desc')
    },
    {
        num: '03',
        title: t('commerce.landing.gastronomy.howItWorks.step3.title'),
        desc: t('commerce.landing.gastronomy.howItWorks.step3.desc')
    }
] as const;

/**
 * Answers resolved here, not left as keys for the template.
 *
 * `a1` is the price answer and its shape depends on the catalogue, which a
 * key-per-question array cannot express. Resolving all three the same way keeps
 * the rendered page and the `FAQPage` structured data reading from one value
 * each, so the JSON-LD can never advertise a trial the visible answer omits.
 */
const faqs = [
    { q: t('commerce.landing.gastronomy.faq.q1'), a: priceFaqAnswer },
    { q: t('commerce.landing.gastronomy.faq.q2'), a: t('commerce.landing.gastronomy.faq.a2') },
    { q: t('commerce.landing.gastronomy.faq.q3'), a: t('commerce.landing.gastronomy.faq.a3') }
] as const;

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
};

const title = t('commerce.lead.title');
const subtitle = t('commerce.lead.subtitle');
/**
 * The CTA points at the page that HAS the price today, not at the one that
 * will have it.
 *
 * `/planes/gastronomia/precios/` is H7's, and it does not exist yet — sending
 * both CTAs there would make every conversion path on this page a 404 for as
 * long as H7 takes. The price block still lives inside `/publicar-restaurante/`
 * (HOS-690), which is exactly why that URL cannot 301 here yet either: the
 * retirement and the `/precios/` page are one move, and they belong to H7.
 *
 * The host page does the same thing for the same reason, pointing at the live
 * `/suscriptores/planes/anfitriones/` grid. Both lines change to
 * `planes/<audiencia>/precios` the day H7 builds it.
 */
const pricingHref = buildUrl({ locale, path: 'publicar-restaurante' });
---

<MarketingLayout
    locale={locale}
    title={title}
    description={subtitle}
>
    <JsonLd slot="head-extra" data={faqJsonLd} />

    <Breadcrumbs locale={locale} items={[{ label: title }]} />

    <MarketingHero
        tagline={t('commerce.landing.gastronomy.benefits.tagline')}
        titleAccent={title}
        subtitle={subtitle}
    >
        <GradientButton
            slot="cta"
            href={pricingHref}
            label={t('pricing.nav.seePlans')}
            variant="primary"
            icon="true"
        />
    </MarketingHero>

    <BenefitsSection
        tagline={t('commerce.landing.gastronomy.benefits.tagline')}
        title={t('commerce.landing.gastronomy.benefits.title')}
        items={benefits}
        columns={3}
    />

    <StepsSection
        tagline={t('commerce.landing.gastronomy.howItWorks.tagline')}
        title={t('commerce.landing.gastronomy.howItWorks.title')}
        items={steps}
        columns={3}
        warm
    />

    <FaqSection
        tagline={t('commerce.landing.gastronomy.faq.tagline')}
        title={t('commerce.landing.gastronomy.faq.title')}
        items={faqs}
    />

    <section class="sales-cta section section--warm">
        <div class="sales-cta__container section__container">
            <h2 class="sales-cta__title">{t('commerce.landing.gastronomy.price.title')}</h2>
            <GradientButton
                href={pricingHref}
                label={t('pricing.nav.seePlans')}
                variant="primary"
                icon="true"
            />
        </div>
    </section>
</MarketingLayout>

<style>
    .sales-cta__container {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
        text-align: center;
    }

    .sales-cta__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.5rem, 3vw, 2rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-6);
    }
</style>
