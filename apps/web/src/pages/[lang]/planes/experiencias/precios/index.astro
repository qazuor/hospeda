---
/**
 * @file planes/experiencias/precios/index.astro
 * @description Pricing page for the experience vertical — level 3 of the three
 * HOS-941 D-7 defines. Twin of `/planes/gastronomia/precios/`; see that file's
 * docblock for the shared rationale (where the content came from, why no
 * redirect points here, and why the CTA is a link rather than a checkout).
 *
 * @route     /[lang]/planes/experiencias/precios/
 * @rendering SSR (prerender=false); edge-cacheable via the `pricing` cache
 *   class, tagged `CACHE_TAG_PRICING` (HOS-941 R-5).
 *
 * The one thing that is NOT shared with its twin: `gastronomy` and `experience`
 * are separate product domains, and `'commerce'` is a RETIRED `ProductDomainEnum`
 * value that survives only on legacy rows (HOS-941 R-3). The two pages fetch
 * different catalogues and render different comparison rows; nothing here may
 * group them under one "Comercio".
 */

import { CACHE_TAG_PRICING } from '@repo/cache-tags';
import { BarChartIcon, CompassIcon, SunIcon } from '@repo/icons';
import AudiencePricingSections from '@/components/billing/AudiencePricingSections.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import PriceSpecificationJsonLd from '@/components/seo/PriceSpecificationJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { getPlanDescription, getPlanName } from '@/lib/billing-i18n';
import { fetchAudiencePlans } from '@/lib/billing/audience-plans';
import {
    buildBillingFaqJsonLd,
    buildPricingBreadcrumbs,
    resolvePricingPageContent
} from '@/lib/billing/pricing-page-content';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { buildCommerceStartUrl } from '@/lib/commerce/start-url';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { getIntlLocale } from '@/lib/pricing-plans';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    cacheable: true,
    cacheClass: 'pricing',
    tags: [CACHE_TAG_PRICING]
});

const plans = await fetchAudiencePlans({ audience: 'experience' });
const { copyRoot, faqs, hasComparison } = resolvePricingPageContent({
    audience: 'experience',
    plans,
    translators: { t, tPlural }
});

const intlLocale = getIntlLocale(locale);
const pagePath = buildUrl({ locale, path: 'planes/experiencias/precios' });
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;

/**
 * The Offer entries, built from the SAME resolvers the cards render
 * (`getPlanName` / `getPlanDescription`) and not from the raw config values.
 *
 * `plan.name` / `plan.description` off the API are the billing package's
 * internal strings — for the commerce verticals, English engineering prose
 * carrying issue IDs. Publishing those as structured data would put them in the
 * field a search result quotes, while the visible card said something else.
 */
const jsonLdPlans = plans.map((plan) => ({
    name: getPlanName({ plan, t }),
    description: getPlanDescription({ plan, t }),
    priceCurrency: 'ARS',
    price: plan.monthlyPriceArs / 100,
    url: `${siteOrigin}${pagePath}`
}));

const ctaHref = buildCommerceStartUrl({ locale, vertical: 'experience' });

const title = t(`${copyRoot}.pageTitle`);
const description = t(`${copyRoot}.pageDescription`);

/**
 * One trail, rendered twice — visibly and as `BreadcrumbList` structured data.
 * Derived from a single source so the crumb a reader sees and the one a search
 * result quotes cannot describe different paths.
 */
const breadcrumbs = buildPricingBreadcrumbs({
    homeLabel: t('nav.home', 'Inicio'),
    homeUrl: `${siteOrigin}${buildUrl({ locale, path: '' })}`,
    salesLabel: t('commerce.lead.experience.title'),
    salesPath: 'planes/experiencias',
    salesUrl: `${siteOrigin}${buildUrl({ locale, path: 'planes/experiencias' })}`,
    pageLabel: title,
    pageUrl: `${siteOrigin}${pagePath}`
});

const headingFull = t(`${copyRoot}.heading`);
const headingWords = headingFull.trim().split(/\s+/);
const headingAccent = headingWords.pop() ?? headingFull;
const headingMain = headingWords.join(' ');
---

<MarketingLayout locale={locale} title={title} description={description}>
    {plans.length > 0 && <PriceSpecificationJsonLd slot="head-extra" plans={jsonLdPlans} />}
    <JsonLd slot="head-extra" data={buildBillingFaqJsonLd({ faqs })} />
    <BreadcrumbJsonLd slot="head-extra" items={breadcrumbs.jsonLd} />

    <Breadcrumbs locale={locale} items={breadcrumbs.visible} />

    <MarketingHero
        tagline={t(`${copyRoot}.tagline`)}
        titleMain={headingMain}
        titleAccent={headingAccent}
        subtitle={t(`${copyRoot}.subtitle`)}
    >
        <Fragment slot="icon-1"><CompassIcon size="md" weight="duotone" /></Fragment>
        <Fragment slot="icon-2"><SunIcon size="md" weight="duotone" /></Fragment>
        <Fragment slot="icon-3"><BarChartIcon size="md" weight="duotone" /></Fragment>
    </MarketingHero>

    <AudiencePricingSections
        locale={locale}
        audience="experience"
        plans={plans}
        intlLocale={intlLocale}
        copyRoot={copyRoot}
        faqs={faqs}
        hasComparison={hasComparison}
        ctaMode="link"
        ctaHref={ctaHref}
    />
</MarketingLayout>
