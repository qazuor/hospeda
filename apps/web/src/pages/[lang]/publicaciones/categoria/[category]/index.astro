---
/**
 * @file publicaciones/categoria/[category]/index.astro
 * @description Posts filtered by category.
 * @route /{lang}/publicaciones/categoria/{category}/
 * @rendering SSR + Cloudflare edge cache — TTL from the `catalog` cache class
 *   (see `lib/cache/cache-classes.ts`), purged by cache tag. Eligibility is
 *   decided per request by the `applyCacheHeaders` call below, not by this
 *   comment.
 */

import ListingLayout from '@/layouts/ListingLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import ListingPageHeader from '@/components/shared/layout/ListingPageHeader.astro';
import ArticleCard from '@/components/shared/cards/ArticleCard.astro';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import ErrorBanner from '@/components/shared/feedback/ErrorBanner.astro';
import Pagination from '@/components/shared/feedback/Pagination.astro';
import { postsApi } from '@/lib/api/endpoints';
import { toArticleCardProps } from '@/lib/api/transforms';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { resolvePostCategorySlug, slugForPostCategory } from '@/lib/facet-slugs';
import { buildUrl } from '@/lib/urls';

import { CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { hasOnlyPaginationParams } from '@/lib/cache/listing-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { category: catSlug } = Astro.params;

// Resolved against the canonical Spanish slug map (H-110). The helper is
// case-insensitive. The legacy English slug (e.g. `gastronomy`) never reaches
// this page as a 200 — the middleware 301-redirects it to the Spanish slug
// before routing gets here.
const catEnum = resolvePostCategorySlug({ slug: catSlug });
if (!catEnum) return new Response(null, { status: 404 });

// `blog.categories.<key>` i18n keys are authored as the English-lowercased
// enum value (e.g. `gastronomy`, `nightlife`) — a pre-existing, separate
// naming convention from the URL slug map above. Deriving it from the enum
// keeps display copy correct regardless of which Spanish slug the URL uses.
const catI18nKey = catEnum.toLowerCase();

// --- Edge cacheability (HOS-369 W2-3) ---
// After the 404 guard, so an unknown category is never marked shareable. The
// category is a closed enum fixed by the URL path, not a query facet, so there
// is no filtered variant here beyond pagination.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	// `/…/page/N/` rewrites into this route with `?page=N`.
	cacheable: hasOnlyPaginationParams({ searchParams: Astro.url.searchParams }),
	cacheClass: 'catalog',
	tags: [CACHE_TAG_COLLECTIONS.post]
});

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const result = await postsApi.list({ page, pageSize: 9, category: catEnum });
const hasError = !result.ok;
const items = result.ok ? result.data.items : [];
const total = result.ok ? result.data.pagination.total : 0;
const totalPages = result.ok ? result.data.pagination.totalPages : 0;
const cards = items.map((item) => toArticleCardProps({ item: item as unknown as Record<string, unknown>, locale }));
const catLabel = t(`blog.categories.${catI18nKey}`, catI18nKey);
// Re-derived from the enum (not the raw `catSlug` param) so a differently
//-cased inbound slug (the resolver is case-insensitive) still self-canonicalizes
// to the exact lowercase Spanish slug, instead of echoing back whatever casing
// the visitor typed.
const canonicalSlug = slugForPostCategory({ category: catEnum });
const baseUrl = buildUrl({ locale, path: `publicaciones/categoria/${canonicalSlug}` });
---

<ListingLayout locale={locale} title={`${catLabel} - ${t('blog.title', 'Publicaciones')}`} description={`Publicaciones de ${catLabel}`} showFilters={false} noindex={true} totalCount={total}>
	<Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: t('blog.title', 'Publicaciones'), path: 'publicaciones' }, { label: catLabel }]} />
	<ListingPageHeader slot="page-header" locale={locale} tagline={t('blog.byCategory.tagline', 'Categoría')} title={catLabel} />

	{hasError && !result.ok && <ErrorBanner locale={locale} error={result.error} entityName="publicaciones" />}
	{!hasError && cards.length === 0 && <EmptyState locale={locale} variant="no-results" actionUrl={buildUrl({ locale, path: 'publicaciones' })} />}
	{!hasError && cards.length > 0 && (
		<div class="grid">
			{cards.map((card, i) => (<div data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100"><ArticleCard data={card} locale={locale} /></div>))}
		</div>
	)}
	{totalPages > 1 && <Pagination slot="pagination" currentPage={page} totalPages={totalPages} baseUrl={baseUrl.slice(0, -1)} locale={locale} />}
</ListingLayout>

<style>
	.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-card-gap); }
	@media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
