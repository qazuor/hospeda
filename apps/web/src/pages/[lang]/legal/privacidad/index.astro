---
/**
 * @file legal/privacidad/index.astro
 * @description Privacy policy page. Every section reads `privacy.sections.*`
 * from `@repo/i18n`; the layout numbers them and builds the ToC.
 * @route /{lang}/legal/privacidad/
 * @rendering SSR + Cloudflare cache (HOS-74 — see [lang]/index.astro)
 */

import LegalLayout from '@/layouts/LegalLayout.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// --- Edge cacheability (HOS-369 W2-2) ---
// No session, no API call — the content is i18n + code, so it only changes on
// deploy. Tagged `site-config`: the only tag with a live purger. The TTL comes
// from the `static` cache class (see `lib/cache/cache-classes.ts`); what
// bounds the post-deploy staleness window is HOS-427's deploy purge, which
// evicts the environment catch-all tag this response carries. Note that purge
// fires 45s after the container serves its FIRST REQUEST, not after the deploy,
// and nothing bounds when that first request arrives — see HOS-428.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	cacheable: true,
	cacheClass: 'static',
	tags: [CACHE_TAG_SITE_CONFIG]
});

// Anchor ids are public (external links point at `#datos-google`, `#derechos`, ...):
// never rename one. The layout numbers the sections, so inserting one is safe.
// `items` names the `privacy.sections.<key>.items.*` keys rendered as bullets.
const sections: readonly { readonly id: string; readonly key: string; readonly items?: readonly string[] }[] = [
	{ id: 'responsable', key: 'controller' },
	{ id: 'recopilacion', key: 'dataCollected', items: ['account', 'socialLogin', 'content', 'messages', 'feedback', 'ai', 'activity', 'billing', 'technical'] },
	{ id: 'uso', key: 'dataUse' },
	{ id: 'compartir', key: 'dataSharing', items: ['providers', 'public', 'processors', 'serverErrors', 'legal'] },
	{ id: 'ia-hospeda', key: 'hospedaAi' },
	{ id: 'medicion', key: 'usageMeasurement' },
	{ id: 'cookies', key: 'cookies' },
	{ id: 'grabaciones', key: 'sessionRecording' },
	{ id: 'email-y-campanas', key: 'emailAttribution' },
	{ id: 'datos-google', key: 'googleData' },
	{ id: 'asistentes-ia', key: 'aiAssistants' },
	{ id: 'conservacion', key: 'dataRetention', items: ['aiChat', 'mcpAudit', 'recordings', 'views', 'logs', 'inquiries', 'listings', 'billing'] },
	{ id: 'transferencias', key: 'internationalTransfers' },
	{ id: 'derechos', key: 'yourRights' },
	{ id: 'seguridad', key: 'dataSecurity' },
	{ id: 'contacto', key: 'contact' }
];

const links: Readonly<Record<string, readonly { readonly href: string; readonly label: string }[]>> = {
	cookies: [{ href: buildUrl({ locale, path: '/legal/cookies/' }), label: t('privacy.links.cookiePolicy') }],
	derechos: [{ href: buildUrl({ locale, path: '/contacto/' }), label: t('privacy.links.contact') }]
};

const articles = sections.map(({ id, key, items }) => ({
	id,
	heading: t(`privacy.sections.${key}.title`),
	body: t(`privacy.sections.${key}.body`),
	bullets: items?.map((item) => t(`privacy.sections.${key}.items.${item}`)),
	links: links[id]
}));
---

<LegalLayout
	locale={locale}
	title={t('privacy.title')}
	description={t('privacy.description')}
	lastUpdated="2026-11-28"
	articles={articles}
/>
