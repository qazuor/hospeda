---
/**
 * @file legal/privacidad/index.astro
 * @description Privacy policy page with 7 numbered sections and ToC.
 * @route /{lang}/legal/privacidad/
 * @rendering SSR + Cloudflare cache (HOS-74 — see [lang]/index.astro)
 */

import LegalLayout from '@/layouts/LegalLayout.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';

import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// --- Edge cacheability (HOS-369 W2-2) ---
// No session, no API call — the content is i18n + code, so it only changes on
// deploy. Tagged `site-config`: the only tag with a live purger. The TTL comes
// from the `static` cache class (see `lib/cache/cache-classes.ts`); what
// bounds the post-deploy staleness window is HOS-427's deploy purge, which
// evicts the environment catch-all tag this response carries. Note that purge
// fires 45s after the container serves its FIRST REQUEST, not after the deploy,
// and nothing bounds when that first request arrives — see HOS-428.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	cacheable: true,
	cacheClass: 'static',
	tags: [CACHE_TAG_SITE_CONFIG]
});

const sections = [
	{ id: 'recopilacion', titleKey: 'privacy.section1.title', titleFb: 'Recopilación de datos', contentKey: 'privacy.section1.content', contentFb: 'Recopilamos información personal que nos proporcionás voluntariamente al registrarte, completar formularios o interactuar con nuestros servicios. Esto incluye nombre, correo electrónico, teléfono y datos de pago.' },
	{ id: 'uso', titleKey: 'privacy.section2.title', titleFb: 'Uso de la información', contentKey: 'privacy.section2.content', contentFb: 'Utilizamos tu información para procesar reservas, mejorar nuestros servicios, enviar comunicaciones relevantes y garantizar la seguridad de la plataforma.' },
	{ id: 'compartir', titleKey: 'privacy.section3.title', titleFb: 'Compartir información', contentKey: 'privacy.section3.content', contentFb: 'No vendemos ni alquilamos tu información personal. Solo la compartimos con proveedores de servicios necesarios para operar la plataforma y cuando la ley lo requiera.' },
	{ id: 'cookies', titleKey: 'privacy.section4.title', titleFb: 'Cookies y tecnologías', contentKey: 'privacy.section4.content', contentFb: 'Utilizamos cookies y tecnologías similares para mejorar tu experiencia, analizar el uso del sitio y personalizar contenido. Podés gestionar las preferencias de cookies desde tu navegador.' },
	{ id: 'grabaciones', titleKey: 'privacy.sections.sessionRecording.title', titleFb: 'Grabaciones de sesión y mapas de calor', contentKey: 'privacy.sections.sessionRecording.body', contentFb: 'Si aceptás las cookies de analítica, Hospeda puede grabar sesiones de navegación y mapas de calor de clics y desplazamiento con Umami, una herramienta de analítica que alojamos nosotros mismos. Las grabaciones son seudónimas: si iniciaste sesión, pueden quedar asociadas al identificador de tu cuenta. La grabación solo ocurre si aceptaste las cookies de analítica y únicamente mientras esta función esté activada. Todo el texto y todos los campos de formularios se enmascaran, por lo que lo que escribís no queda registrado. Se graba una muestra de las sesiones, no todas. Las grabaciones se conservan por un período limitado de hasta 60 días y después se eliminan automáticamente.' },
	{ id: 'email-y-campanas', titleKey: 'privacy.sections.emailAttribution.title', titleFb: 'Emails, enlaces de campaña y códigos QR', contentKey: 'privacy.sections.emailAttribution.body', contentFb: 'Para saber si nuestros emails se abren, Brevo, nuestro proveedor de envío de emails, registra cuándo se abre cada mensaje y nos informa de esa apertura. Nosotros solo contamos las aperturas por tipo de email o campaña, en forma agregada, con Umami, una herramienta de analítica que alojamos nosotros mismos; ese conteo no incluye tu dirección de email. Brevo también mide los clics de los emails del newsletter. Los enlaces de nuestros emails, los enlaces que se comparten desde el sitio, los códigos QR impresos y los enlaces de nuestras presentaciones llevan parámetros de campaña (UTM) que nos dicen por qué canal llegó una visita; también los analizamos con Umami. Las funciones de privacidad de las aplicaciones de correo hacen que el conteo de aperturas sea aproximado. No hay una opción individual para excluirte de este conteo: si bloqueás la carga de imágenes en tu aplicación de correo, la apertura no se registra.' },
	{ id: 'seguridad', titleKey: 'privacy.section5.title', titleFb: 'Seguridad', contentKey: 'privacy.section5.content', contentFb: 'Implementamos medidas de seguridad técnicas y organizativas para proteger tu información contra accesos no autorizados, pérdida o alteración.' },
	{ id: 'derechos', titleKey: 'privacy.section6.title', titleFb: 'Tus derechos', contentKey: 'privacy.section6.content', contentFb: 'Tenés derecho a acceder, rectificar, eliminar o limitar el uso de tus datos personales. Para ejercer estos derechos, contactanos a través de nuestro formulario de contacto.' },
	{ id: 'datos-google', titleKey: 'privacy.section7.title', titleFb: 'Datos de tu cuenta de Google', contentKey: 'privacy.section7.content', contentFb: 'Si conectás tu cuenta de Google para sincronizar la disponibilidad de tu alojamiento, Hospeda accede únicamente a los eventos de tu Google Calendar necesarios para bloquear y desbloquear fechas entre tu calendario y la plataforma. El uso que Hospeda hace de la información recibida de las APIs de Google se ajusta a la Política de Datos de Usuario de los Servicios de las API de Google (Google API Services User Data Policy), incluidos sus requisitos de Uso Limitado (Limited Use). No vendemos ni transferimos estos datos a terceros, no los usamos con fines publicitarios ni para entrenar modelos de inteligencia artificial, y solo los utilizamos para brindar la función de sincronización de calendario que solicitaste. Podés desconectar tu cuenta de Google en cualquier momento desde tu panel; al hacerlo, eliminamos los tokens de acceso y los datos de calendario asociados.' },
	{ id: 'contacto', titleKey: 'privacy.section8.title', titleFb: 'Contacto', contentKey: 'privacy.section8.content', contentFb: 'Para consultas sobre esta política de privacidad, podés escribirnos a info@hospeda.com.ar o a través de nuestro formulario de contacto.' },
] as const;

const articles = sections.map((section) => ({
	id: section.id,
	heading: t(section.titleKey, section.titleFb),
	body: t(section.contentKey, section.contentFb)
}));
---

<LegalLayout
	locale={locale}
	title={t('privacy.title', 'Política de privacidad')}
	description={t('privacy.description', 'Política de privacidad de Hospeda. Cómo recopilamos y usamos tu información.')}
	lastUpdated="2026-11-23"
	articles={articles}
/>
