---
/** Public terms and links to related legal pages. */
import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import LegalLayout from '@/layouts/LegalLayout.astro';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

const locale = Astro.locals.locale;
const { t } = createTranslations(locale);
applyCacheHeaders({ locals: Astro.locals, headers: Astro.response.headers, cacheable: true,
    cacheClass: 'static', tags: [CACHE_TAG_SITE_CONFIG] });

// Anchor ids are public (external links point at `#reservas`, `#contacto`, ...):
// never rename one. The layout numbers the articles, so inserting one is safe.
const ids = ['aceptacion', 'uso-servicio', 'registro', 'publicacion', 'reservas', 'prueba',
    'cancelaciones', 'propiedad-intelectual', 'limitacion', 'modificaciones', 'contacto'] as const;
const withdrawalLink = { href: buildUrl({ locale, path: '/legal/arrepentimiento/' }), label: t('terms.withdrawal.title') };
const articles = ids.map((id) => ({
    id,
    heading: t(`terms.articles.${id}.title`),
    body: t(`terms.articles.${id}.body`),
    links: id === 'reservas' ? [{
        href: buildUrl({ locale, path: '/legal/privacidad/' }), label: t('privacy.title')
    }] : id === 'cancelaciones' || id === 'contacto' ? [withdrawalLink] : undefined
}));
---
<LegalLayout locale={locale} title={t('terms.title')} description={t('terms.description')} lastUpdated="2026-11-28" articles={articles} />
