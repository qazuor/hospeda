---
/** Public cookie policy and controls for the site-wide consent preferences. */
import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import LegalLayout from '@/layouts/LegalLayout.astro';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { CONSENT_COOKIE_NAME } from '@/lib/cookie-consent';
import { createTranslations } from '@/lib/i18n';

const locale = Astro.locals.locale;
const { t } = createTranslations(locale);
applyCacheHeaders({ locals: Astro.locals, headers: Astro.response.headers, cacheable: true,
    cacheClass: 'static', tags: [CACHE_TAG_SITE_CONFIG] });

const sections = {
    'que-son': 'whatAreCookies', 'cuales-usamos': 'cookiesWeUse', grabaciones: 'sessionRecording',
    listado: 'cookieList', gestionar: 'manageCookies', terceros: 'thirdPartyCookies',
    cambios: 'policyChanges', contacto: 'contact'
} as const;
const cookies = [
    { name: '*.session_token', key: 'session' },
    { name: '*.session_data', key: 'sessionCache' },
    { name: '*.dont_remember', key: 'dontRemember' },
    { name: '*.state', key: 'signInState' },
    { name: '*.session_token.oauth_logout_confirmation', key: 'oauthLogout' },
    { name: CONSENT_COOKIE_NAME, key: 'consent' },
    { name: 'hospeda_ann_dismissed', key: 'announcements' },
    { name: 'hospeda_vid', key: 'visitor' },
    { name: 'gcal_oauth_state', key: 'calendarState' }
] as const;
const articles = Object.entries(sections).map(([id, key]) => ({
    id,
    heading: t(`cookies.sections.${key}.title`),
    body: t(`cookies.sections.${key}.body`),
    bullets: key === 'sessionRecording' ? [t('cookies.recording.association'), t('cookies.recording.masking'), t('cookies.recording.retention'), t('cookies.recording.sentry')] : undefined,
    table: key === 'cookieList' ? {
        columns: [t('cookies.inventory.name'), t('cookies.inventory.purpose'), t('cookies.inventory.duration')],
        rows: cookies.map(({ name, key }) => [name, t(`cookies.inventory.${key}.purpose`), t(`cookies.inventory.${key}.duration`)])
    } : undefined,
    managePreferences: key === 'manageCookies' ? t('cookies.managePreferences') : undefined
}));
---
<LegalLayout locale={locale} title={t('cookies.title')} description={t('cookies.description')} lastUpdated="2026-11-28" articles={articles} />
