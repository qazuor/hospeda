---
/**
 * @file sumate/proveedor/index.astro
 * @description Public "Sumate como proveedor" alliance-lead landing (HOS-277).
 *
 * A prospective service provider (maintenance, cleaning, supplies, etc. for
 * hosts) submits their interest via the alliance-lead form
 * (`kind: 'service_provider'`), which posts to
 * `POST /api/v1/public/alliance/leads`. An admin reviews the lead by hand and,
 * if approved, manually adds the provider to the HostTrade directory — there
 * is NO automatic entity provisioning on submission (HOS-277 NG-1, §5
 * "service_provider = HostTrade").
 *
 * @route     /[lang]/sumate/proveedor/
 * @rendering SSR (on-demand, no prerender)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import { AllianceLead } from '@/components/alliance/AllianceLead.client';
import { destinationsApi } from '@/lib/api/endpoints';
import { CheckCircleIcon } from '@repo/icons';

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const title = t('alliance-leads.serviceProvider.title', 'Sumate como proveedor de servicios');
const subtitle = t(
    'alliance-leads.serviceProvider.subtitle',
    'Si ofrecés un servicio para alojamientos u hosts, postulate a nuestro directorio de proveedores.'
);

const benefits = [
    t('alliance-leads.serviceProvider.benefits.item1', ''),
    t('alliance-leads.serviceProvider.benefits.item2', ''),
    t('alliance-leads.serviceProvider.benefits.item3', ''),
    t('alliance-leads.serviceProvider.benefits.item4', '')
].filter((item) => item.length > 0);

// Coverage-area options for the form's `destinationId` select (HOS-278
// §6.4). This page is plain SSR — not edge-cached — so fetching it here
// (rather than client-side from the island) costs nothing extra in cache
// risk. A failed fetch degrades to an empty list: the form must still
// render, never 500 the whole landing page over a filter's options.
const destinationsResult = await destinationsApi.list({
    destinationType: 'CITY',
    pageSize: 100,
    sortBy: 'name',
    sortOrder: 'asc'
});
const destinations = destinationsResult.ok
    ? destinationsResult.data.items.map((d) => ({ id: d.id, name: d.name }))
    : [];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(buildUrl({ locale, path: '' }), Astro.site).href;

// The STRUCTURED trail is not the visible one. The visible component shows a
// parent level for context, but `BreadcrumbList` describes a URL hierarchy a
// crawler can walk — and there is no `/sumate/` index page, so
// "Sumate" is context for a human and a 404 for a bot. It is deliberately
// absent here rather than given a fabricated URL.
const breadcrumbItems = [
    { name: t('nav.home', 'Inicio'), url: homeUrl },
    { name: title, url: canonicalUrl }
];
---

<BaseLayout locale={locale} title={title} description={subtitle}>
    <SEOHead
        slot="head"
        title={title}
        description={subtitle}
        locale={locale}
        canonical={canonicalUrl}
        noindex={false}
    />
    <BreadcrumbJsonLd slot="head" items={breadcrumbItems} />

    <div class="sumate__breadcrumbs">
        <Breadcrumbs
            locale={locale}
            items={[
                { label: t('alliance-leads.breadcrumb.joinUs', 'Sumate') },
                { label: title }
            ]}
        />
    </div>

    <section class="sumate__hero section">
        <div class="sumate__container section__container">
            <div class="sumate__header" data-reveal="up">
                <h1 class="sumate__title">{title}</h1>
                <p class="sumate__subtitle">{subtitle}</p>
            </div>

            {benefits.length > 0 && (
                <ul class="sumate__benefits" data-reveal="up">
                    {benefits.map((item) => (
                        <li class="sumate__benefit">
                            <span class="sumate__benefit-icon" aria-hidden="true">
                                <CheckCircleIcon size="sm" weight="fill" />
                            </span>
                            <span>{item}</span>
                        </li>
                    ))}
                </ul>
            )}
        </div>
    </section>

    <section class="sumate__form section section--warm">
        <div class="sumate__form-container section__container">
            <AllianceLead client:load locale={locale} kind="service_provider" destinations={destinations} />
        </div>
    </section>
</BaseLayout>

<style>
    .sumate__hero {
        padding-block: clamp(3rem, 6vw, 4.5rem);
        background-color: var(--core-background);
    }
    .sumate__breadcrumbs {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
    .sumate__container {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
    .sumate__header {
        text-align: center;
        max-width: 700px;
        margin-inline: auto;
    }
    .sumate__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.875rem, 5vw, 3rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-4, 1rem);
        line-height: 1.15;
    }
    .sumate__subtitle {
        font-family: var(--font-sans);
        font-size: var(--text-body-lg, 1.0625rem);
        color: var(--core-muted-foreground);
        margin: 0;
        line-height: 1.6;
    }
    .sumate__benefits {
        list-style: none;
        margin: var(--space-8, 2rem) auto 0;
        padding: 0;
        max-width: 560px;
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 0.75rem);
    }
    .sumate__benefit {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2, 0.5rem);
        font-family: var(--font-sans);
        font-size: var(--text-body);
        color: var(--core-muted-foreground);
        line-height: 1.6;
        text-align: left;
    }
    .sumate__benefit-icon {
        display: inline-flex;
        color: var(--brand-tertiary);
        flex-shrink: 0;
        margin-top: 0.2em;
    }
    .sumate__form {
        padding-block: clamp(3rem, 6vw, 4.5rem);
    }
    .sumate__form-container {
        max-width: 720px;
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
</style>
