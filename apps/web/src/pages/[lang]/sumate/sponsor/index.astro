---
/**
 * @file sumate/sponsor/index.astro
 * @description Public "Sponsoreá Hospeda" alliance-lead landing (HOS-277).
 *
 * A prospective brand sponsor submits their interest via the alliance-lead
 * form (`kind: 'sponsor'`), which posts to
 * `POST /api/v1/public/alliance/leads`. An admin reviews the lead by hand and
 * decides whether to move forward — there is NO automatic role/entity
 * provisioning on submission (HOS-277 NG-1). Structure cloned from the
 * `/publicar-restaurante` commerce-lead molde: hero + benefits + form.
 *
 * @route     /[lang]/sumate/sponsor/
 * @rendering SSR (on-demand, no prerender)
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import { AllianceLead } from '@/components/alliance/AllianceLead.client';
import { CheckCircleIcon } from '@repo/icons';

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

const title = t('alliance-leads.sponsor.title', 'Sponsoreá Hospeda');
const subtitle = t(
    'alliance-leads.sponsor.subtitle',
    'Asociá tu marca a la plataforma líder de turismo del Litoral y llegá a miles de viajeros.'
);

const benefits = [
    t('alliance-leads.sponsor.benefits.item1', ''),
    t('alliance-leads.sponsor.benefits.item2', ''),
    t('alliance-leads.sponsor.benefits.item3', ''),
    t('alliance-leads.sponsor.benefits.item4', '')
].filter((item) => item.length > 0);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// The page stays public — an anonymous visitor is the primary case. When there
// IS a session, hand the visitor down so the island can pre-fill the contact
// fields; islands cannot read `Astro.locals` themselves. Only populated because
// `sumate` is listed in `SESSION_OPTIONAL_SEGMENTS` (see `@/lib/routes`). Only
// the two fields the form seeds: island props are serialized into the rendered
// HTML, so the user id has no business being here.
const currentUser = Astro.locals.user
    ? {
          name: Astro.locals.user.name ?? null,
          email: Astro.locals.user.email ?? null
      }
    : null;
---

<BaseLayout locale={locale} title={title} description={subtitle}>
    <SEOHead
        slot="head"
        title={title}
        description={subtitle}
        locale={locale}
        canonical={canonicalUrl}
        noindex={false}
    />

    {/* `Breadcrumbs` drops the last item (it is this page's own <h1>) and
        renders nothing when only "Inicio" would remain — so the parent level
        has to be passed for the trail to exist at all. It carries no `path`:
        there is no /sumate/ index page, so this level is context, not a link.
        The wrapper supplies the container the component does not bring. */}
    <div class="sumate__breadcrumbs">
        <Breadcrumbs
            locale={locale}
            items={[{ label: t('alliance-leads.breadcrumb.joinUs', 'Sumate') }, { label: title }]}
        />
    </div>

    <section class="sumate__hero section">
        <div class="sumate__container section__container">
            <div class="sumate__header" data-reveal="up">
                <h1 class="sumate__title">{title}</h1>
                <p class="sumate__subtitle">{subtitle}</p>
            </div>

            {benefits.length > 0 && (
                <ul class="sumate__benefits" data-reveal="up">
                    {benefits.map((item) => (
                        <li class="sumate__benefit">
                            <span class="sumate__benefit-icon" aria-hidden="true">
                                <CheckCircleIcon size="sm" weight="fill" />
                            </span>
                            <span>{item}</span>
                        </li>
                    ))}
                </ul>
            )}
        </div>
    </section>

    <section class="sumate__form section section--warm">
        <div class="sumate__form-container section__container">
            <AllianceLead client:load locale={locale} kind="sponsor" currentUser={currentUser} />
        </div>
    </section>
</BaseLayout>

<style>
    .sumate__breadcrumbs {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
        padding-block: var(--space-4, 1rem) 0;
    }
    .sumate__hero {
        /* Tighter than the default --space-section: this is a lead form
           landing, and 120px top+bottom pushed the form itself below the fold
           on a 1366x800 screen — the visitor saw a wall of copy and no form.
           Scales 48px..72px with viewport. */
        padding-block: var(--space-6, 1.5rem) clamp(3rem, 6vw, 4.5rem);
        background-color: var(--core-background);
    }
    .sumate__container {
        max-width: var(--container-max, 1350px);
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
    .sumate__header {
        text-align: center;
        max-width: 700px;
        margin-inline: auto;
    }
    .sumate__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.875rem, 5vw, 3rem);
        color: var(--core-foreground);
        margin: 0 0 var(--space-4, 1rem);
        line-height: 1.15;
    }
    .sumate__subtitle {
        font-family: var(--font-sans);
        font-size: var(--text-body-lg, 1.0625rem);
        color: var(--core-muted-foreground);
        margin: 0;
        line-height: 1.6;
    }
    .sumate__benefits {
        list-style: none;
        margin: var(--space-8, 2rem) auto 0;
        padding: 0;
        max-width: 560px;
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 0.75rem);
    }
    .sumate__benefit {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2, 0.5rem);
        font-family: var(--font-sans);
        font-size: var(--text-body);
        color: var(--core-muted-foreground);
        line-height: 1.6;
        text-align: left;
    }
    .sumate__benefit-icon {
        display: inline-flex;
        color: var(--brand-tertiary);
        flex-shrink: 0;
        margin-top: 0.2em;
    }
    .sumate__form {
        padding-block: clamp(3rem, 6vw, 4.5rem);
    }
    .sumate__form-container {
        max-width: 720px;
        margin-inline: auto;
        padding-inline: var(--space-5, 1.25rem);
    }
</style>
