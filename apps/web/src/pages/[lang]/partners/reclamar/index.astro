---
/**
 * @file partners/reclamar/index.astro
 * @description Noindex entry point for claiming a Partner from an emailed link.
 * @route /{lang}/partners/reclamar/
 * @rendering SSR, session-blind; the client island consumes the URL fragment.
 */

import { PartnerClaim } from '@/components/partner/PartnerClaim.client';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import ErrorLayout from '@/layouts/ErrorLayout.astro';

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const title = t('partners.claim.seo.title');
const description = t('partners.claim.seo.description');
---

<ErrorLayout locale={locale} title={title} description={description}>
    <div class="partner-claim-page">
        <PartnerClaim client:load locale={locale} />
    </div>
</ErrorLayout>

<style>
    /* ErrorLayout aligns its content to the top; the claim card or recovery block
       needs the whole area under the header, so it sits in the middle of it
       instead of hugging the top with a blank screen below (HOS-2667). */
    .partner-claim-page {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: var(--space-6) var(--space-4);
    }
</style>
