---
/**
 * @file publicar-restaurante/index.astro
 * @description Permanent redirect to `/{lang}/publicar/gastronomia/`, the
 * gastronomy publish page (HOS-1156 D-6).
 *
 * ## This target OVERRIDES HOS-941 D-8
 *
 * HOS-1032 pointed this URL at `/planes/gastronomia/`, and its reasoning was
 * sound at the time: "its successor by content is the SALES page", because this
 * URL's body was an argument with a price block, and no publish page existed for
 * this vertical to send anyone to.
 *
 * One does now, and it is a superset of what the sales page offers an arriving
 * visitor: the same argument, plus the form, plus a link back to the sales page
 * for anyone who wants the numbers first. The URL's own name said *publicar*;
 * it finally leads there.
 *
 * ## Why the query string is forwarded
 *
 * A URL that MOVED keeps the parameters addressed to it — see
 * `lib/pricing-redirect.ts` for the live case that made this non-optional.
 *
 * @route     /{lang}/publicar-restaurante/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';

export const prerender = false;

const locale = Astro.locals.locale;

return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PUBLISH_PAGE_PATH_BY_VERTICAL.gastronomy,
        search: Astro.url.search
    }),
    301
);
---
