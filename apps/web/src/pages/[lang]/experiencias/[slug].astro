---
/**
 * @file experiencias/[slug].astro
 * @description Experience detail page (SPEC-240 T-029).
 * Fetches a single experience listing by slug, fetches reviews + FAQs in
 * parallel, and composes the detail block components.
 *
 * 404 is returned when:
 * - The API returns !result.ok (listing not found or server error).
 * - The listing's visibility is 'PRIVATE' or 'RESTRICTED' (not public).
 *
 * @route /{lang}/experiencias/{slug}/
 * @rendering SSR (on-demand)
 */

import DetailLayout from '@/layouts/DetailLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import { ImageGallery } from '@/components/ImageGallery.client';
import TouristAttractionJsonLd from '@/components/seo/TouristAttractionJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import ExperienceHero from '@/components/experience/ExperienceHero.astro';
import ExperienceInfo from '@/components/experience/ExperienceInfo.astro';
import ExperienceMeetingPoint from '@/components/experience/ExperienceMeetingPoint.astro';
import ExperiencePreparation from '@/components/experience/ExperiencePreparation.astro';
import ExperienceCancellationPolicy from '@/components/experience/ExperienceCancellationPolicy.astro';
import ExperiencePrivateGroups from '@/components/experience/ExperiencePrivateGroups.astro';
import ExperienceContactBlock from '@/components/experience/ExperienceContactBlock.astro';
import ExperienceFaqs from '@/components/experience/ExperienceFaqs.astro';
import { ExperienceReviews } from '@/components/experience/ExperienceReviews.client';
import { EntityViewTracker } from '@/components/analytics/EntityViewTracker.client';
import { experiencesApi, userBookmarksPublicApi } from '@/lib/api/endpoints';
import { toExperienceDetailPageProps } from '@/lib/api/transforms';
import { hasPublicContactChannel } from '@/lib/experience-contact';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { getApiUrl } from '@/lib/env';
import { AiChatWidget } from '@/components/accommodation/AiChatWidget';
import type { ExperienceReviewPublicItem } from '@/lib/api/endpoints';
import type { DetailFaq } from '@/data/types';

import { buildEntityCacheTags, CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { slug } = Astro.params;

if (!slug) return new Response(null, { status: 404 });

// --- Fetch main record ---
const result = await experiencesApi.getBySlug({ slug });

if (!result.ok) {
    // Propagate 410 Gone for soft-deleted entities so crawlers/LLM fetchers
    // deindex the URL fast (HOS-117 T-022); any other failure stays 404.
    return new Response(null, { status: result.error.status === 410 ? 410 : 404 });
}

const raw = result.data as unknown as Record<string, unknown>;

// --- Visibility gate ---
// Public pages only show listings with visibility === 'PUBLIC'.
// 'PRIVATE' and 'RESTRICTED' listings return 404 to anonymous visitors.
const visibility = raw.visibility as string | undefined;
if (visibility && visibility !== 'PUBLIC') {
    return new Response(null, { status: 404 });
}

const experience = toExperienceDetailPageProps({ item: raw, locale });

// --- Edge cacheability (HOS-369 W2-4) ---
// After BOTH guards above — the 404/410 for missing or soft-deleted rows, and
// the visibility gate. That ordering is what makes this safe: a non-PUBLIC
// listing 404s before reaching here, so a private listing can never be shared
// from the edge. It mirrors the service side, which only schedules a purge for
// a listing that is ACTIVE and PUBLIC.
//
// Addressed by its OWN two tags and deliberately NOT by `list-experience`: a
// detail page is not a listing, and the collection tag would make every
// experience write evict every other one's page.
const experienceCacheTags = buildEntityCacheTags({
    entity: 'experience',
    slug,
    id: String(raw.id || '')
});
const [primaryExperienceTag, ...extraExperienceTags] = experienceCacheTags;

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    // No usable entity tag means nothing could purge this page, and an
    // unpurgeable cached page is worse than an uncached one.
    cacheable: primaryExperienceTag !== undefined,
    cacheClass: 'detail',
    tags:
        primaryExperienceTag !== undefined
            ? [primaryExperienceTag, ...extraExperienceTags]
            : [CACHE_TAG_COLLECTIONS.experience]
});

// --- Parallel secondary fetches ---
const [reviewsSettled, faqsSettled] = await Promise.allSettled([
    experiencesApi.getReviews({ id: experience.id, page: 1, pageSize: 5 }),
    experiencesApi.getFaqs({ id: experience.id })
]);

const reviewsResult =
    reviewsSettled.status === 'fulfilled' ? reviewsSettled.value : null;
const faqsResult =
    faqsSettled.status === 'fulfilled' ? faqsSettled.value : null;

const reviews: readonly ExperienceReviewPublicItem[] =
    reviewsResult?.ok ? reviewsResult.data.items : [];
const totalReviews: number =
    reviewsResult?.ok ? reviewsResult.data.pagination.total : experience.reviewsCount;

// FAQs: prefer inline entity FAQs, fall back to standalone endpoint
const faqs: readonly DetailFaq[] =
    experience.faqs.length > 0
        ? experience.faqs
        : faqsResult?.ok && Array.isArray(faqsResult.data)
          ? (faqsResult.data as Array<Record<string, unknown>>).map((faq) => ({
                id: String(faq.id || ''),
                question: String(faq.question || ''),
                answer: String(faq.answer || ''),
                category: faq.category ? String(faq.category) : null
            }))
          : [];

// --- Gallery images ---
const galleryImages = (() => {
    const mediaObj = raw.media as
        | { gallery?: Array<{ url?: string; caption?: string }> }
        | undefined;
    const gallery = mediaObj?.gallery ?? [];
    if (gallery.length > 0) {
        return gallery
            .filter((g) => g.url)
            .map((g) => ({
                url: String(g.url),
                alt: g.caption ?? experience.name,
                caption: g.caption
            }));
    }
    if (
        experience.featuredImage.url &&
        !experience.featuredImage.url.includes('placeholder')
    ) {
        return [
            {
                url: experience.featuredImage.url,
                alt: experience.featuredImage.caption ?? experience.name
            }
        ];
    }
    return [];
})();


// --- SSR bookmark status for hero ---
let bookmarkCount: number | undefined;

try {
    const countResult = await userBookmarksPublicApi.count({
        entityType: 'EXPERIENCE',
        entityId: experience.id
    });
    if (countResult.ok) {
        bookmarkCount = countResult.data.count;
    }
} catch {
    // graceful degradation
}


const canonicalPath = buildUrl({ locale, path: `experiencias/${experience.slug}/` });

// --- SEO ---
// SEOHead (via DetailLayout) already appends " | Hospeda", so the fallback is the
// bare name — appending it here too produced a duplicated "… | Hospeda | Hospeda".
const seoTitle = experience.seo?.title?.trim() || experience.name;
const seoDescription =
    experience.seo?.description?.trim() ||
    experience.summary ||
    t('experience.listing.subtitle', 'Experiencias y servicios en el Litoral Entrerriano');

/**
 * HOS-1056: whether `ExperienceContactBlock` will render anything at all.
 *
 * Computed HERE, from the same predicate the block itself uses, because the
 * private-groups CTA is an anchor into that block: if the block self-hides for
 * lack of a publishable channel, the CTA has to degrade to plain text instead of
 * linking to an element that is not on the page. Two independent checks would be
 * free to drift, and a dead anchor reports nothing — no console error, nothing
 * visibly wrong, just a click that does nothing.
 */
const hasContactBlock = hasPublicContactChannel({ contactInfo: experience.contactInfo });

// --- Breadcrumb JSON-LD (HOS-117 T-007) ---
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const breadcrumbItems = [
    { name: t('nav.home', 'Inicio'), url: `${siteOrigin}/${locale}/` },
    {
        name: t('experience.listing.title', 'Experiencias'),
        url: `${siteOrigin}/${locale}/experiencias/`
    },
    { name: experience.name, url: `${siteOrigin}${Astro.url.pathname}` }
];
---

<DetailLayout
    locale={locale}
    title={seoTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    showBreadcrumbs={true}
    showSidebar={false}
    ogImage={experience.featuredImage.url}
    ogType={t(`experience.type.${experience.type}`, experience.type)}
    ogSubtitle={experience.destinationName}
    ogRating={experience.averageRating > 0 ? experience.averageRating.toFixed(1) : undefined}
>
    <TouristAttractionJsonLd
        slot="head-extra"
        name={experience.name}
        description={seoDescription}
        url={canonicalPath}
        image={experience.featuredImage.url}
    />
    <BreadcrumbJsonLd slot="head-extra" items={breadcrumbItems} />
    <Breadcrumbs
        slot="breadcrumbs"
        locale={locale}
        items={[
            {
                label: t('experience.listing.title', 'Experiencias'),
                path: 'experiencias/'
            },
            { label: experience.name }
        ]}
    />

    <!-- Hero (rendered inside the wave band, like destinos/alojamientos) -->
    <Fragment slot="page-header">
        <ExperienceHero
            experience={experience}
            locale={locale}
            bookmarkCount={bookmarkCount}
        />
    </Fragment>

    <div class="exp-detail">
        <!-- Gallery -->
        {galleryImages.length > 0 && (
            <div class="exp-detail__gallery">
                <ImageGallery
                    client:load
                    images={galleryImages}
                    locale={locale}
                    variant="detail"
                />
            </div>
        )}

        <!-- Description, opening hours, social networks -->
        <ExperienceInfo experience={experience} locale={locale} />

        <!-- Where the experience starts (HOS-1048). Above the contact block on
             purpose: someone reading this page wants to know where to be before
             they want the provider's phone number. Renders nothing when the
             owner declared no meeting point. The meeting point TEXT carries no
             entitlement check — it is ficha data from the basic tier. The map
             that draws the coordinates and the how-to-get-there instructions
             are the paid half (HOS-1049), rendered by the same component and
             gated on `meetingPointDirectionsEnabled`, which the API resolves
             live from the provider's current plan. -->
        <ExperienceMeetingPoint
            meetingPoint={experience.meetingPoint}
            meetingPointLat={experience.meetingPointLat}
            meetingPointLong={experience.meetingPointLong}
            meetingPointDirections={experience.meetingPointDirections}
            meetingPointDirectionsEnabled={experience.meetingPointDirectionsEnabled}
            locale={locale}
        />

        <!-- What to bring and what is required (HOS-1046). Right after the
             meeting point, because the reading order of somebody planning a
             morning is: where do I go, what do I take, can I even go. Both
             halves self-hide on an empty list. -->
        <ExperiencePreparation
            whatToBring={experience.whatToBring}
            requirements={experience.requirements}
            locale={locale}
        />

        <!-- What happens if the outing does not run (HOS-1047). Free text,
             rendered as TEXT and never as HTML — it is owner-authored and
             published with no review in between. Self-hides when absent. -->
        <ExperienceCancellationPolicy
            cancellationPolicy={experience.cancellationPolicy}
            locale={locale}
        />

        <!-- The private-groups invitation (HOS-1056). `hasContactBlock` is what
             keeps its CTA from becoming a dead anchor when the contact block
             below self-hides — see the constant's docstring. -->
        <ExperiencePrivateGroups
            acceptsPrivateGroups={experience.acceptsPrivateGroups}
            hasContactBlock={hasContactBlock}
            locale={locale}
        />

        <!-- Phone / email / website the provider filled in (HOS-815). The
             listing form blocks publication without a phone or an email, but
             the public tier used to omit `contactInfo` entirely, so the only
             contact affordance was the site-wide WhatsApp button pointing at
             HOSPEDA's number — not the provider's. The published subset is
             narrowed by `ExperiencePublicContactInfoSchema`. -->
        <ExperienceContactBlock
            contactInfo={experience.contactInfo}
            locale={locale}
        />

        <!-- Reviews (interactive island) -->
        <ExperienceReviews
            client:visible
            experienceId={experience.id}
            initialReviews={reviews}
            totalReviews={totalReviews}
            averageRating={experience.averageRating}
            locale={locale}
        />

        <!-- FAQs (static SSR accordion) -->
        {faqs.length > 0 && (
            <ExperienceFaqs faqs={faqs} locale={locale} />
        )}

        <!-- Analytics tracker (headless, HOS-734) — feeds the owner-facing
             basic view stats in mi-cuenta/comercio. -->
        <EntityViewTracker
            client:idle
            entityType="EXPERIENCE"
            slug={slug}
            entityId={experience.id}
            locale={locale}
        />
    </div>
    <!-- AI chat widget (HOS-400) — signed-in visitors only, resolved in the
         browser. Mounted unconditionally, exactly as the accommodation page
         does: the widget renders nothing until it resolves a session, and both
         the FAB and the panel are position:fixed, so appearing after hydration
         shifts nothing. Whether the OWNER's plan grants the chat is decided
         server-side; an owner without it answers 403 with the vertical's own
         copy rather than a message about an accommodation. -->
    <AiChatWidget
        client:idle
        entityType="experience"
        entityId={experience.id}
        locale={locale}
        apiUrl={getApiUrl()}
    />
</DetailLayout>

<style>
    .exp-detail {
        max-width: var(--container-max, 1350px);
        margin: 0 auto;
        padding: var(--space-6, 24px) var(--space-4, 16px);
        display: flex;
        flex-direction: column;
        gap: var(--space-8, 32px);
    }

    .exp-detail__gallery {
        border-radius: var(--radius-card, 24px);
        overflow: hidden;
    }
</style>
