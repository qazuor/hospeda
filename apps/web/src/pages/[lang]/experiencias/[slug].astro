---
/**
 * @file experiencias/[slug].astro
 * @description Experience detail page (SPEC-240 T-029).
 * Fetches a single experience listing by slug, fetches reviews + FAQs in
 * parallel, and composes the detail block components.
 *
 * 404 is returned when:
 * - The API returns !result.ok (listing not found or server error).
 * - The listing is not PUBLISHED: the public read answers it like an unknown
 *   slug (HOS-1641), so this is the same `!result.ok` case.
 *
 * @route /{lang}/experiencias/{slug}/
 * @rendering SSR (on-demand)
 */

import DetailLayout from '@/layouts/DetailLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import { ImageGallery } from '@/components/ImageGallery.client';
import GalleryTapBridge from '@/components/gallery/GalleryTapBridge.astro';
import TouristAttractionJsonLd from '@/components/seo/TouristAttractionJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import ListingHeader from '@/components/listing/header/ListingHeader.astro';
import { buildExperienceHeader } from '@/lib/listing-header/build-listing-header';
import { buildExperienceContactBlock } from '@/lib/listing-contact/listing-contact-block';
import { buildExperienceLocation } from '@/lib/listing-location/build-location-section';
import FAQPageJsonLd from '@/components/seo/FAQPageJsonLd.astro';
import { buildFaqJsonLdSections } from '@/lib/seo/faq-jsonld-sections';
import ExperienceInfo from '@/components/experience/ExperienceInfo.astro';
import LocationSection from '@/components/listing/location/LocationSection.astro';
import ExperiencePreparation from '@/components/experience/ExperiencePreparation.astro';
import ExperienceSummary from '@/components/experience/ExperienceSummary.astro';
import ExperienceCancellationPolicy from '@/components/experience/ExperienceCancellationPolicy.astro';
import ExperiencePrivateGroups from '@/components/experience/ExperiencePrivateGroups.astro';
import ListingContactBlock from '@/components/listing/contact/ListingContactBlock.astro';
import ExperienceFaqs from '@/components/experience/ExperienceFaqs.astro';
import { ExperienceReviews } from '@/components/experience/ExperienceReviews.client';
import { EntityViewTracker } from '@/components/analytics/EntityViewTracker.client';
import { InternalEntryTracker } from '@/components/analytics/InternalEntryTracker.client';
import { experiencesApi, userBookmarksPublicApi } from '@/lib/api/endpoints';
import { toExperienceDetailPageProps } from '@/lib/api/transforms';
import { hasPublicContactChannel } from '@/lib/experience-contact';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { getApiUrl } from '@/lib/env';
import { AiChatWidget } from '@/components/accommodation/AiChatWidget';
import { ListingContactBar } from '@/components/listing/contact/ListingContactBar.client';
import { ListingChannelsPanel } from '@/components/listing/contact/ListingChannelsPanel.client';
import {
    buildExperienceChannels,
    buildExperienceContactPrice
} from '@/lib/listing-contact/listing-channels';
import { EXPERIENCE_CONTACT_ANCHOR_ID } from '@/lib/experience-contact';
import { resolveListingBarPhoneHref } from '@/lib/listing-contact/listing-action-bar';
import type { ExperienceReviewPublicItem } from '@/lib/api/endpoints';
import type { DetailFaq } from '@/data/types';

import { buildEntityCacheTags, CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders, markResponseDegradedFromApi } from '@/lib/cache/response-cache';
export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { slug } = Astro.params;

if (!slug) return new Response(null, { status: 404 });

// --- Fetch main record ---
const result = await experiencesApi.getBySlug({ slug });

if (!result.ok) {
    // Propagate 410 Gone for soft-deleted entities so crawlers/LLM fetchers
    // deindex the URL fast (HOS-117 T-022); any other failure stays 404.
    return new Response(null, { status: result.error.status === 410 ? 410 : 404 });
}

const raw = result.data as unknown as Record<string, unknown>;

// --- Publication gate (HOS-1641) ---
// There is no second gate here on purpose: the public read answers ONLY a
// `PUBLISHED` listing (AC:V5:5), and every other publication state answers the
// same 404 as an unknown slug, which `!result.ok` above already returns. The
// public payload carries no publication field to re-check.

const experience = toExperienceDetailPageProps({ item: raw, locale });

// --- Edge cacheability (HOS-369 W2-4) ---
// After the guard above — the 404/410 for missing, soft-deleted or
// non-PUBLISHED rows (HOS-1641: the public read answers only PUBLISHED). That
// ordering is what makes this safe: a non-published listing 404s before
// reaching here, so it can never be shared from the edge. It mirrors the
// service side, which only schedules a purge for a PUBLISHED listing.
//
// Addressed by its OWN two tags and deliberately NOT by `list-experience`: a
// detail page is not a listing, and the collection tag would make every
// experience write evict every other one's page.
const experienceCacheTags = buildEntityCacheTags({
    entity: 'experience',
    slug,
    id: String(raw.id || '')
});
const [primaryExperienceTag, ...extraExperienceTags] = experienceCacheTags;

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    // No usable entity tag means nothing could purge this page, and an
    // unpurgeable cached page is worse than an uncached one.
    cacheable: primaryExperienceTag !== undefined,
    cacheClass: 'detail',
    tags:
        primaryExperienceTag !== undefined
            ? [primaryExperienceTag, ...extraExperienceTags]
            : [CACHE_TAG_COLLECTIONS.experience]
});

// HOS-2009: a 2xx answer flagged `no-store` is the API's degraded state (the
// owner's effective set failed to resolve, paid sections withheld). Veto the
// edge cache so the failure is not frozen in as "this owner did not pay".
markResponseDegradedFromApi({ locals: Astro.locals, results: [result] });

// --- Parallel secondary fetches ---
const [reviewsSettled, faqsSettled] = await Promise.allSettled([
    experiencesApi.getReviews({ id: experience.id, page: 1, pageSize: 5 }),
    experiencesApi.getFaqs({ id: experience.id })
]);

const reviewsResult =
    reviewsSettled.status === 'fulfilled' ? reviewsSettled.value : null;
const faqsResult =
    faqsSettled.status === 'fulfilled' ? faqsSettled.value : null;

const reviews: readonly ExperienceReviewPublicItem[] =
    reviewsResult?.ok ? reviewsResult.data.items : [];
const totalReviews: number =
    reviewsResult?.ok ? reviewsResult.data.pagination.total : experience.reviewsCount;

// FAQs: prefer inline entity FAQs, fall back to standalone endpoint
const faqs: readonly DetailFaq[] =
    experience.faqs.length > 0
        ? experience.faqs
        : faqsResult?.ok && Array.isArray(faqsResult.data)
          ? (faqsResult.data as Array<Record<string, unknown>>).map((faq) => ({
                id: String(faq.id || ''),
                question: String(faq.question || ''),
                answer: String(faq.answer || ''),
                category: faq.category ? String(faq.category) : null
            }))
          : [];

// --- FAQPage JSON-LD when FAQs exist (HOS-2579 §6.6, same helper as accommodation) ---
const { sections: faqSections, inLanguage: faqInLanguage } = buildFaqJsonLdSections({
    faqs,
    locale
});

// --- Gallery images ---
const galleryImages = (() => {
    const mediaObj = raw.media as
        | { gallery?: Array<{ url?: string; caption?: string; description?: string }> }
        | undefined;
    const gallery = mediaObj?.gallery ?? [];
    if (gallery.length > 0) {
        return gallery
            .filter((g) => g.url)
            .map((g) => ({
                url: String(g.url),
                alt: g.caption ?? experience.name,
                caption: g.caption,
                description: g.description
            }));
    }
    if (
        experience.featuredImage.url &&
        !experience.featuredImage.url.includes('placeholder')
    ) {
        return [
            {
                url: experience.featuredImage.url,
                alt: experience.featuredImage.caption ?? experience.name,
                caption: experience.featuredImage.caption
            }
        ];
    }
    return [];
})();


// --- SSR bookmark status for hero ---
let bookmarkCount: number | undefined;

try {
    const countResult = await userBookmarksPublicApi.count({
        entityType: 'EXPERIENCE',
        entityId: experience.id
    });
    if (countResult.ok) {
        bookmarkCount = countResult.data.count;
    }
} catch {
    // graceful degradation
}


const canonicalPath = buildUrl({ locale, path: `experiencias/${experience.slug}/` });

// --- SEO ---
// SEOHead (via DetailLayout) already appends " | Hospeda", so the fallback is the
// bare name — appending it here too produced a duplicated "… | Hospeda | Hospeda".
const seoTitle = experience.seo?.title?.trim() || experience.name;
const seoDescription =
    experience.seo?.description?.trim() ||
    experience.summary ||
    t('experience.listing.subtitle', 'Experiencias y servicios en el Litoral Entrerriano');

/**
 * HOS-1056: whether the experience `ListingContactBlock` will render anything at all.
 *
 * Computed HERE, from the same predicate the block itself uses, because the
 * private-groups CTA is an anchor into that block: if the block self-hides for
 * lack of a publishable channel, the CTA has to degrade to plain text instead of
 * linking to an element that is not on the page. Two independent checks would be
 * free to drift, and a dead anchor reports nothing — no console error, nothing
 * visibly wrong, just a click that does nothing.
 */
const hasContactBlock = hasPublicContactChannel({ contactInfo: experience.contactInfo });

// --- Mobile contact bar + panel (HOS-2532) ---
// Channels only: no form and no WhatsApp (HOS-363). The bar and the panel exist
// exactly when the experience `ListingContactBlock` does, so the bar's no-JS fallback anchor
// always has a target and no bar promises a channel that is not there.
const contactChannels = hasContactBlock
    ? buildExperienceChannels({ contactInfo: experience.contactInfo })
    : [];
const contactPrice = buildExperienceContactPrice({
    priceFrom: experience.priceFrom,
    priceUnit: experience.priceUnit,
    isPriceOnRequest: experience.isPriceOnRequest
});
const panelId = 'listing-contact-panel';
const barPhoneHref = resolveListingBarPhoneHref({
    phones: [experience.contactInfo?.mobilePhone, experience.contactInfo?.workPhone]
}).href;

// --- Breadcrumb JSON-LD (HOS-117 T-007) ---
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const breadcrumbItems = [
    { name: t('nav.home', 'Inicio'), url: `${siteOrigin}/${locale}/` },
    {
        name: t('experience.listing.title', 'Experiencias'),
        url: `${siteOrigin}/${locale}/experiencias/`
    },
    { name: experience.name, url: `${siteOrigin}${Astro.url.pathname}` }
];

// --- Header (HOS-2579): the shared frame, built from the detail data ---
/**
 * HOS-2579 §6.4: the shared contact block, now also carrying the social
 * profiles that used to render as emoji pills inside `ExperienceInfo`. It
 * exists whenever `hasContactBlock` is true (and also for a socials-only
 * listing), so the private-groups anchor never points at a missing element.
 */
/**
 * HOS-2579 §6.5: the meeting point (free) and, only with
 * `meetingPointDirectionsEnabled`, the exact map and the directions (HOS-1049).
 * `null` when the owner declared no meeting point.
 */
const locationSection = buildExperienceLocation({ experience, locale });

const contactBlock = buildExperienceContactBlock({
    listingId: experience.id,
    contactInfo: experience.contactInfo,
    socialNetworks: experience.socialNetworks,
    locale
});

const headerProps = buildExperienceHeader({
    experience,
    locale,
    shareUrl: `${siteOrigin}${Astro.url.pathname}`,
    bookmarkCount,
    hasMobileGalleryControls: galleryImages.length > 0
});
---

<DetailLayout
    locale={locale}
    title={seoTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    showBreadcrumbs={true}
    showSidebar={false}
    ogImage={experience.featuredImage.url}
    ogType={t(`experience.type.${experience.type}`, experience.type)}
    ogSubtitle={experience.destinationName}
    ogRating={experience.averageRating > 0 ? experience.averageRating.toFixed(1) : undefined}
    analyticsTag={experience.id}
>
    <TouristAttractionJsonLd
        slot="head-extra"
        name={experience.name}
        description={seoDescription}
        url={canonicalPath}
        image={experience.featuredImage.url}
        latitude={experience.meetingPointLat}
        longitude={experience.meetingPointLong}
        ratingValue={experience.averageRating}
        reviewCount={experience.reviewsCount}
        priceFrom={experience.priceFrom}
        isPriceOnRequest={experience.isPriceOnRequest}
        destinationName={experience.destinationName}
    />
    <BreadcrumbJsonLd slot="head-extra" items={breadcrumbItems} />
    {faqSections.length > 0 && (
        <FAQPageJsonLd slot="head-extra" sections={faqSections} inLanguage={faqInLanguage} />
    )}
    <div slot="breadcrumbs" class="exp-detail-breadcrumbs">
        <Breadcrumbs
            locale={locale}
            items={[
                {
                    label: t('experience.listing.title', 'Experiencias'),
                    path: 'experiencias/'
                },
                { label: experience.name }
            ]}
        />
    </div>

    <!-- Hero (rendered inside the wave band, like destinos/alojamientos) -->
    <Fragment slot="page-header">
        <ListingHeader {...headerProps} />
    </Fragment>

    <div class="exp-detail">
        <!-- Gallery -->
        {galleryImages.length > 0 && (
            <div class="exp-detail__gallery">
                <ImageGallery
                    client:load
                    images={galleryImages}
                    locale={locale}
                    variant="detail"
                    mobile={{
                        share: { url: `${siteOrigin}${Astro.url.pathname}`, title: experience.name, campaign: 'experience' },
                        favorite: {
                            entityId: experience.id,
                            entityType: 'EXPERIENCE',
                            variant: 'standalone'
                        }
                    }}
                />
                <GalleryTapBridge />
            </div>
        )}

        <!-- Slot 2 «summary» (HOS-2579): price and duration (moved out of the
             header) and «Consultar». -->
        <ExperienceSummary
            listingId={experience.id}
            locale={locale}
            priceFrom={experience.priceFrom}
            priceUnit={experience.priceUnit}
            isPriceOnRequest={experience.isPriceOnRequest}
            durationMinutes={experience.durationMinutes}
            hasContactChannel={contactChannels.length > 0}
            panelId={panelId}
            fallbackHref={`#${EXPERIENCE_CONTACT_ANCHOR_ID}`}
        />

        <!-- Description, opening hours, social networks -->
        <ExperienceInfo experience={experience} locale={locale} />

        <!-- Where the experience starts (HOS-1048). Above the contact block on
             purpose: someone reading this page wants to know where to be before
             they want the provider's phone number. Renders nothing when the
             owner declared no meeting point. The meeting point TEXT carries no
             entitlement check — it is ficha data from the basic tier. The map
             that draws the coordinates and the how-to-get-there instructions
             are the paid half (HOS-1049), gated by `buildExperienceLocation` on
             `meetingPointDirectionsEnabled`, which the API resolves live from
             the provider's current plan. -->
        {locationSection && <LocationSection {...locationSection} />}

        <!-- What to bring and what is required (HOS-1046). Right after the
             meeting point, because the reading order of somebody planning a
             morning is: where do I go, what do I take, can I even go. Both
             halves self-hide on an empty list. -->
        <ExperiencePreparation
            whatToBring={experience.whatToBring}
            requirements={experience.requirements}
            locale={locale}
        />

        <!-- What happens if the outing does not run (HOS-1047). Free text,
             rendered as TEXT and never as HTML — it is owner-authored and
             published with no review in between. Self-hides when absent. -->
        <ExperienceCancellationPolicy
            cancellation={experience.policies.cancellation}
            locale={locale}
        />

        <!-- The private-groups invitation (HOS-1056). `hasContactBlock` is what
             keeps its CTA from becoming a dead anchor when the contact block
             below self-hides — see the constant's docstring. -->
        <ExperiencePrivateGroups
            privateGroups={experience.policies.privateGroups}
            hasContactBlock={hasContactBlock}
            locale={locale}
        />

        <!-- Phone / email / website the provider filled in (HOS-815). The
             listing form blocks publication without a phone or an email, but
             the public tier used to omit `contactInfo` entirely, so the only
             contact affordance was the site-wide WhatsApp button pointing at
             HOSPEDA's number — not the provider's. The published subset is
             narrowed by `ExperiencePublicContactInfoSchema`. -->
        {contactBlock && <ListingContactBlock {...contactBlock} />}

        <!-- Reviews (interactive island) -->
        <ExperienceReviews
            client:visible
            experienceId={experience.id}
            initialReviews={reviews}
            totalReviews={totalReviews}
            averageRating={experience.averageRating}
            locale={locale}
        />

        <!-- FAQs (static SSR accordion) -->
        {faqs.length > 0 && (
            <ExperienceFaqs faqs={faqs} locale={locale} />
        )}

        <!-- Analytics tracker (headless, HOS-734) — feeds the owner-facing
             basic view stats in mi-cuenta/comercio. -->
        <!-- Internal-entry analytics event (HOS-2119 T-076): same-origin referrer only. -->
        <InternalEntryTracker
            client:idle
            entityType="EXPERIENCE"
            entityId={experience.id}
            locale={locale}
        />
        <EntityViewTracker
            client:idle
            entityType="EXPERIENCE"
            slug={slug}
            entityId={experience.id}
            locale={locale}
        />
    </div>
    <!-- AI chat widget (HOS-400) — signed-in visitors only, resolved in the
         browser. Mounted unconditionally, exactly as the accommodation page
         does: the widget renders nothing until it resolves a session, and both
         the FAB and the panel are position:fixed, so appearing after hydration
         shifts nothing. Whether the OWNER's plan grants the chat is decided
         server-side; an owner without it answers 403 and the widget shows the
         vertical's own `unavailable` copy (HOS-1264: resolved through
         `resolveChatError` with the entity type, not the accommodation key). -->
    <AiChatWidget
        client:idle
        entityType="experience"
        entityId={experience.id}
        locale={locale}
        apiUrl={getApiUrl()}
    />
    {/* HOS-2579 §6.10: the bar renders on every experience page (Favorito and
         Compartir always exist), so the mobile dock stays pinned. «Consultar»
         and the panel exist only with a public channel. */}
    <ListingContactBar
        client:idle
        vertical="experience"
        listingId={experience.id}
        listingName={experience.name}
        locale={locale}
        price={contactPrice}
        primary={contactChannels.length > 0 ? { kind: 'inquire' } : null}
        hasWhatsapp={false}
        phoneHref={barPhoneHref}
        shareUrl={`${siteOrigin}${Astro.url.pathname}`}
        panelId={panelId}
        fallbackHref={`#${EXPERIENCE_CONTACT_ANCHOR_ID}`}
    />
    {contactChannels.length > 0 && (
        <ListingChannelsPanel
            client:idle
            panelId={panelId}
            listingId={experience.id}
            vertical="experience"
            locale={locale}
            channels={contactChannels}
            price={contactPrice}
        />
    )}
</DetailLayout>

<script>
    import { initContactLinkTracking } from '@/lib/listing-contact/track-contact-links';
    initContactLinkTracking({ document });
</script>

<style>
    @media (max-width: 767px) {
        :global(.wave-header__breadcrumbs:has(.exp-detail-breadcrumbs)) {
            display: none;
        }

        /* The hidden breadcrumbs carried the band's top padding, so without this
           the badges sit flush under the navbar. Expanded state only: the compact
           state sets its own padding-top. */
        :global(.wave-header:not(.wave-header--compact) .wave-header__bar:has(.exp-detail-breadcrumbs) .wave-header__content) {
            padding-top: var(--space-6, 1.5rem);
        }

        /* The full-bleed mobile gallery meets the blue header directly: drop the
           page-background strip DetailLayout leaves above the body. */
        :global(.wave-header .detail-page:has(.exp-detail)) {
            padding-top: 0;
        }
    }

    .exp-detail {
        max-width: var(--container-max, 1350px);
        margin: 0 auto;
        padding: var(--space-6, 24px) var(--space-4, 16px);
        display: flex;
        flex-direction: column;
        gap: var(--space-8, 32px);
    }

    .exp-detail__gallery {
        border-radius: var(--radius-card, 24px);
        overflow: hidden;
    }

    /* The mobile gallery track runs edge to edge (HOS-2532): the layout container
       already pads the page, so the body drops its own inset and the wrapper stops
       clipping the track's negative margin. */
    @media (max-width: 767px) {
        .exp-detail {
            padding-inline: 0;
            padding-block-start: 0;
        }

        .exp-detail__gallery {
            border-radius: 0;
            overflow: visible;
        }
    }
</style>
