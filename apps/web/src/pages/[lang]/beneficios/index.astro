---
/**
 * @file beneficios/index.astro
 * @description Benefits page showing tourist and owner benefits.
 * @route /{lang}/beneficios/
 * @rendering SSR + Cloudflare cache (HOS-74 — see [lang]/index.astro)
 */

import MarketingLayout from '@/layouts/MarketingLayout.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import GradientButton from '@/components/shared/ui/GradientButton.astro';
import AboutPageJsonLd from '@/components/seo/AboutPageJsonLd.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import {
	BuildingsIcon,
	ChatIcon,
	CompassIcon,
	GlobeIcon,
	EyeIcon,
	FavoriteIcon,
	ForkKnifeIcon,
	HomeIcon,
	MapIcon,
	MegaphoneIcon,
	PhoneIcon,
	PriceIcon,
	ReceiptIcon,
	SettingsIcon,
	ShieldIcon,
	SparkleIcon,
	StarIcon,
	StatisticsIcon,
	UsersThreeIcon,
} from '@repo/icons';

import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// --- Edge cacheability (HOS-369 W2-2) ---
// No session, no API call — the content is i18n + code, so it only changes on
// deploy. Tagged `site-config`: the only tag with a live purger. The TTL comes
// from the `static` cache class (see `lib/cache/cache-classes.ts`); what
// bounds the post-deploy staleness window is HOS-427's deploy purge, which
// evicts the environment catch-all tag this response carries. Note that purge
// fires 45s after the container serves its FIRST REQUEST, not after the deploy,
// and nothing bounds when that first request arrives — see HOS-428.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	cacheable: true,
	cacheClass: 'static',
	tags: [CACHE_TAG_SITE_CONFIG]
});

const touristBenefits = [
	{ Icon: BuildingsIcon, titleKey: 'benefits.tourist.1.title', descKey: 'benefits.tourist.1.desc' },
	{ Icon: PriceIcon, titleKey: 'benefits.tourist.2.title', descKey: 'benefits.tourist.2.desc' },
	{ Icon: StarIcon, titleKey: 'benefits.tourist.3.title', descKey: 'benefits.tourist.3.desc' },
	{ Icon: MapIcon, titleKey: 'benefits.tourist.4.title', descKey: 'benefits.tourist.4.desc' },
	{ Icon: ChatIcon, titleKey: 'benefits.tourist.5.title', descKey: 'benefits.tourist.5.desc' },
] as const;

const ownerBenefits = [
	{ Icon: EyeIcon, titleKey: 'benefits.owner.1.title', descKey: 'benefits.owner.1.desc' },
	{ Icon: SettingsIcon, titleKey: 'benefits.owner.2.title', descKey: 'benefits.owner.2.desc' },
	{ Icon: ReceiptIcon, titleKey: 'benefits.owner.3.title', descKey: 'benefits.owner.3.desc' },
	{ Icon: StatisticsIcon, titleKey: 'benefits.owner.4.title', descKey: 'benefits.owner.4.desc' },
	{ Icon: PhoneIcon, titleKey: 'benefits.owner.5.title', descKey: 'benefits.owner.5.desc' },
] as const;

/*
 * Experience and gastronomy benefits deliberately point at the
 * `commerce.landing.*` keys that already back `/publicar-experiencia/` and
 * `/publicar-restaurante/` instead of getting a copy of their own. The claim a
 * vertical makes about itself has one home; a price or policy change edits one
 * string and both the landing and this page follow. Only the section chrome
 * (tagline, CTA label) is local, under `benefits.{experience,gastronomy}.*`.
 *
 * Three items each, against five for tourist/owner — the grid is `auto-fit`,
 * so a shorter row lays out on its own without a placeholder.
 */
const experienceBenefits = [
	{
		Icon: MapIcon,
		titleKey: 'commerce.landing.experience.benefits.item1.title',
		descKey: 'commerce.landing.experience.benefits.item1.desc'
	},
	{
		Icon: SettingsIcon,
		titleKey: 'commerce.landing.experience.benefits.item2.title',
		descKey: 'commerce.landing.experience.benefits.item2.desc'
	},
	{
		Icon: ShieldIcon,
		titleKey: 'commerce.landing.experience.benefits.item3.title',
		descKey: 'commerce.landing.experience.benefits.item3.desc'
	}
] as const;

const gastronomyBenefits = [
	{
		Icon: MapIcon,
		titleKey: 'commerce.landing.gastronomy.benefits.item1.title',
		descKey: 'commerce.landing.gastronomy.benefits.item1.desc'
	},
	{
		Icon: SettingsIcon,
		titleKey: 'commerce.landing.gastronomy.benefits.item2.title',
		descKey: 'commerce.landing.gastronomy.benefits.item2.desc'
	},
	{
		Icon: ShieldIcon,
		titleKey: 'commerce.landing.gastronomy.benefits.item3.title',
		descKey: 'commerce.landing.gastronomy.benefits.item3.desc'
	}
] as const;

/*
 * Partner is the one vertical whose landing does not publish its benefits in
 * this page's title+description shape: `/sumate/partner/` renders four flat
 * sentences under a single shared icon. Those sentences are reused verbatim as
 * the card descriptions; the short titles are local to this page
 * (`benefits.partner.N.title`) because no equivalent existed to harvest, and
 * each condenses its own sentence rather than adding a claim of its own.
 */
const partnerBenefits = [
	{ Icon: GlobeIcon, titleKey: 'benefits.partner.1.title', descKey: 'alliance-leads.partner.benefits.item1' },
	{ Icon: MegaphoneIcon, titleKey: 'benefits.partner.2.title', descKey: 'alliance-leads.partner.benefits.item2' },
	{ Icon: ReceiptIcon, titleKey: 'benefits.partner.3.title', descKey: 'alliance-leads.partner.benefits.item3' },
	{ Icon: ChatIcon, titleKey: 'benefits.partner.4.title', descKey: 'alliance-leads.partner.benefits.item4' }
] as const;

// Split titles to underline the last word with a handwritten accent.
const splitLastWord = (full: string): { main: string; accent: string } => {
	const words = full.trim().split(/\s+/);
	const accent = words.pop() ?? full;
	return { main: words.join(' '), accent };
};

const touristHeading = splitLastWord(t('benefits.tourist.title'));
const ownerHeading = splitLastWord(t('benefits.owner.title'));
const experienceHeading = splitLastWord(t('commerce.landing.experience.benefits.title'));
const gastronomyHeading = splitLastWord(t('commerce.landing.gastronomy.benefits.title'));
const partnerHeading = splitLastWord(t('benefits.partner.title'));

const benefitsTitle = t('benefits.title', 'Beneficios');
const benefitsDescription = t(
	'benefits.description',
	'Descubrí los beneficios de usar Hospeda como viajero o propietario.'
);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://hospeda.com.ar').href;
const inLanguageMap: Record<SupportedLocale, string> = {
	es: 'es-AR',
	en: 'en-US',
	pt: 'pt-BR'
};
---

<MarketingLayout
	locale={locale}
	title={benefitsTitle}
	description={benefitsDescription}
>
	<AboutPageJsonLd
		slot="head-extra"
		title={benefitsTitle}
		description={benefitsDescription}
		url={canonicalUrl}
		inLanguage={inLanguageMap[locale]}
	/>

	<MarketingHero
		tagline={t('benefits.hero.tagline')}
		titleMain={t('benefits.hero.titleMain')}
		titleAccent={t('benefits.hero.titleAccent')}
		subtitle={t('benefits.hero.subtitle')}
	>
		<Fragment slot="icon-1"><FavoriteIcon size="md" weight="duotone" /></Fragment>
		<Fragment slot="icon-2"><HomeIcon size="md" weight="duotone" /></Fragment>
		<Fragment slot="icon-3"><SparkleIcon size="md" weight="duotone" /></Fragment>
	</MarketingHero>

	<!-- Tourist Benefits -->
	<section class="benefits-section benefits-section--tourist section">
		<div class="benefits-section__decoratives" aria-hidden="true">
			<span class="benefits-section__watermark benefits-section__watermark--tourist">
				<FavoriteIcon size={200} weight="duotone" />
			</span>
			<svg
				class="benefits-section__wave benefits-section__wave--tourist"
				viewBox="0 0 800 60"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M 0 40 Q 100 10, 200 35 T 400 30 T 600 35 T 800 28"
					stroke="currentColor"
					stroke-width="2"
					stroke-dasharray="3 7"
					stroke-linecap="round"
					fill="none"
				/>
			</svg>
			<span class="benefits-section__dot benefits-section__dot--t1"></span>
			<span class="benefits-section__dot benefits-section__dot--t2"></span>
			<span class="benefits-section__dot benefits-section__dot--t3"></span>
			<span class="benefits-section__dot benefits-section__dot--t4"></span>
		</div>
		<div class="benefits-section__container">
			<p class="benefits-section__tagline" data-reveal="up">{t('benefits.tourist.tagline')}</p>
			<h2 class="benefits-section__title" data-reveal="up">
				{touristHeading.main && <>{touristHeading.main}{' '}</>}
				<span class="benefits-section__title-accent benefits-section__title-accent--tourist">
					{touristHeading.accent}
					<svg
						class="benefits-section__title-underline"
						viewBox="0 0 200 18"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M 4 12 Q 50 2, 100 10 T 196 8"
							stroke="currentColor"
							stroke-width="4"
							stroke-linecap="round"
							fill="none"
						/>
					</svg>
				</span>
			</h2>
			<div class="benefits-section__grid">
				{touristBenefits.map((b, i) => {
					const Icon = b.Icon;
					return (
						<div class="benefits-card" data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
							<span class="benefits-card__icon benefits-card__icon--tourist" aria-hidden="true">
								<Icon size="lg" weight="duotone" />
							</span>
							<h3 class="benefits-card__title">{t(b.titleKey)}</h3>
							<p class="benefits-card__desc">{t(b.descKey)}</p>
						</div>
					);
				})}
			</div>
			<div class="benefits-section__cta" data-reveal="up">
				<GradientButton
					href={buildUrl({ locale, path: 'alojamientos' })}
					label={t('benefits.tourist.cta')}
					variant="primary"
				/>
			</div>
		</div>
	</section>

	<!-- Owner Benefits -->
	<section class="benefits-section benefits-section--owner section section--warm">
		<div class="benefits-section__decoratives" aria-hidden="true">
			<span class="benefits-section__watermark benefits-section__watermark--owner">
				<HomeIcon size={200} weight="duotone" />
			</span>
			<svg
				class="benefits-section__wave benefits-section__wave--owner"
				viewBox="0 0 800 60"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M 0 28 Q 100 50, 200 30 T 400 32 T 600 28 T 800 35"
					stroke="currentColor"
					stroke-width="2"
					stroke-dasharray="3 7"
					stroke-linecap="round"
					fill="none"
				/>
			</svg>
			<span class="benefits-section__dot benefits-section__dot--o1"></span>
			<span class="benefits-section__dot benefits-section__dot--o2"></span>
			<span class="benefits-section__dot benefits-section__dot--o3"></span>
			<span class="benefits-section__dot benefits-section__dot--o4"></span>
		</div>
		<div class="benefits-section__container">
			<p class="benefits-section__tagline" data-reveal="up">{t('benefits.owner.tagline')}</p>
			<h2 class="benefits-section__title" data-reveal="up">
				{ownerHeading.main && <>{ownerHeading.main}{' '}</>}
				<span class="benefits-section__title-accent benefits-section__title-accent--owner">
					{ownerHeading.accent}
					<svg
						class="benefits-section__title-underline"
						viewBox="0 0 200 18"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M 4 12 Q 50 2, 100 10 T 196 8"
							stroke="currentColor"
							stroke-width="4"
							stroke-linecap="round"
							fill="none"
						/>
					</svg>
				</span>
			</h2>
			<div class="benefits-section__grid">
				{ownerBenefits.map((b, i) => {
					const Icon = b.Icon;
					return (
						<div class="benefits-card" data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
							<span class="benefits-card__icon benefits-card__icon--owner" aria-hidden="true">
								<Icon size="lg" weight="duotone" />
							</span>
							<h3 class="benefits-card__title">{t(b.titleKey)}</h3>
							<p class="benefits-card__desc">{t(b.descKey)}</p>
						</div>
					);
				})}
			</div>
			<div class="benefits-section__cta" data-reveal="up">
				<GradientButton
					href={buildUrl({ locale, path: 'suscriptores/propietarios' })}
					label={t('benefits.owner.cta')}
					variant="accent"
				/>
			</div>
		</div>
	</section>

	<!-- Experience Benefits -->
	<section class="benefits-section benefits-section--experience section">
		<div class="benefits-section__decoratives" aria-hidden="true">
			<span class="benefits-section__watermark benefits-section__watermark--experience">
				<CompassIcon size={200} weight="duotone" />
			</span>
			<svg
				class="benefits-section__wave benefits-section__wave--experience"
				viewBox="0 0 800 60"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M 0 32 Q 100 12, 200 34 T 400 26 T 600 36 T 800 24"
					stroke="currentColor"
					stroke-width="2"
					stroke-dasharray="3 7"
					stroke-linecap="round"
					fill="none"
				/>
			</svg>
			<span class="benefits-section__dot benefits-section__dot--e1"></span>
			<span class="benefits-section__dot benefits-section__dot--e2"></span>
			<span class="benefits-section__dot benefits-section__dot--e3"></span>
			<span class="benefits-section__dot benefits-section__dot--e4"></span>
		</div>
		<div class="benefits-section__container">
			<p class="benefits-section__tagline" data-reveal="up">{t('benefits.experience.tagline')}</p>
			<h2 class="benefits-section__title" data-reveal="up">
				{experienceHeading.main && <>{experienceHeading.main}{' '}</>}
				<span class="benefits-section__title-accent benefits-section__title-accent--experience">
					{experienceHeading.accent}
					<svg
						class="benefits-section__title-underline"
						viewBox="0 0 200 18"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M 4 12 Q 50 2, 100 10 T 196 8"
							stroke="currentColor"
							stroke-width="4"
							stroke-linecap="round"
							fill="none"
						/>
					</svg>
				</span>
			</h2>
			<div class="benefits-section__grid">
				{experienceBenefits.map((b, i) => {
					const Icon = b.Icon;
					return (
						<div class="benefits-card" data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
							<span class="benefits-card__icon benefits-card__icon--experience" aria-hidden="true">
								<Icon size="lg" weight="duotone" />
							</span>
							<h3 class="benefits-card__title">{t(b.titleKey)}</h3>
							<p class="benefits-card__desc">{t(b.descKey)}</p>
						</div>
					);
				})}
			</div>
			<div class="benefits-section__cta" data-reveal="up">
				<GradientButton
					href={buildUrl({ locale, path: 'publicar-experiencia' })}
					label={t('benefits.experience.cta')}
					variant="primary"
				/>
			</div>
		</div>
	</section>

	<!-- Gastronomy Benefits -->
	<section class="benefits-section benefits-section--gastronomy section section--warm">
		<div class="benefits-section__decoratives" aria-hidden="true">
			<span class="benefits-section__watermark benefits-section__watermark--gastronomy">
				<ForkKnifeIcon size={200} weight="duotone" />
			</span>
			<svg
				class="benefits-section__wave benefits-section__wave--gastronomy"
				viewBox="0 0 800 60"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M 0 24 Q 100 44, 200 22 T 400 34 T 600 20 T 800 30"
					stroke="currentColor"
					stroke-width="2"
					stroke-dasharray="3 7"
					stroke-linecap="round"
					fill="none"
				/>
			</svg>
			<span class="benefits-section__dot benefits-section__dot--g1"></span>
			<span class="benefits-section__dot benefits-section__dot--g2"></span>
			<span class="benefits-section__dot benefits-section__dot--g3"></span>
			<span class="benefits-section__dot benefits-section__dot--g4"></span>
		</div>
		<div class="benefits-section__container">
			<p class="benefits-section__tagline" data-reveal="up">{t('benefits.gastronomy.tagline')}</p>
			<h2 class="benefits-section__title" data-reveal="up">
				{gastronomyHeading.main && <>{gastronomyHeading.main}{' '}</>}
				<span class="benefits-section__title-accent benefits-section__title-accent--gastronomy">
					{gastronomyHeading.accent}
					<svg
						class="benefits-section__title-underline"
						viewBox="0 0 200 18"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M 4 12 Q 50 2, 100 10 T 196 8"
							stroke="currentColor"
							stroke-width="4"
							stroke-linecap="round"
							fill="none"
						/>
					</svg>
				</span>
			</h2>
			<div class="benefits-section__grid">
				{gastronomyBenefits.map((b, i) => {
					const Icon = b.Icon;
					return (
						<div class="benefits-card" data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
							<span class="benefits-card__icon benefits-card__icon--gastronomy" aria-hidden="true">
								<Icon size="lg" weight="duotone" />
							</span>
							<h3 class="benefits-card__title">{t(b.titleKey)}</h3>
							<p class="benefits-card__desc">{t(b.descKey)}</p>
						</div>
					);
				})}
			</div>
			<div class="benefits-section__cta" data-reveal="up">
				<GradientButton
					href={buildUrl({ locale, path: 'publicar-restaurante' })}
					label={t('benefits.gastronomy.cta')}
					variant="accent"
				/>
			</div>
		</div>
	</section>

	<!-- Partner (aliados) Benefits -->
	<section class="benefits-section benefits-section--partner section">
		<div class="benefits-section__decoratives" aria-hidden="true">
			<span class="benefits-section__watermark benefits-section__watermark--partner">
				<UsersThreeIcon size={200} weight="duotone" />
			</span>
			<svg
				class="benefits-section__wave benefits-section__wave--partner"
				viewBox="0 0 800 60"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M 0 30 Q 100 46, 200 28 T 400 38 T 600 24 T 800 32"
					stroke="currentColor"
					stroke-width="2"
					stroke-dasharray="3 7"
					stroke-linecap="round"
					fill="none"
				/>
			</svg>
			<span class="benefits-section__dot benefits-section__dot--p1"></span>
			<span class="benefits-section__dot benefits-section__dot--p2"></span>
			<span class="benefits-section__dot benefits-section__dot--p3"></span>
			<span class="benefits-section__dot benefits-section__dot--p4"></span>
		</div>
		<div class="benefits-section__container">
			<p class="benefits-section__tagline" data-reveal="up">{t('benefits.partner.tagline')}</p>
			<h2 class="benefits-section__title" data-reveal="up">
				{partnerHeading.main && <>{partnerHeading.main}{' '}</>}
				<span class="benefits-section__title-accent benefits-section__title-accent--partner">
					{partnerHeading.accent}
					<svg
						class="benefits-section__title-underline"
						viewBox="0 0 200 18"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M 4 12 Q 50 2, 100 10 T 196 8"
							stroke="currentColor"
							stroke-width="4"
							stroke-linecap="round"
							fill="none"
						/>
					</svg>
				</span>
			</h2>
			<div class="benefits-section__grid">
				{partnerBenefits.map((b, i) => {
					const Icon = b.Icon;
					return (
						<div class="benefits-card" data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
							<span class="benefits-card__icon benefits-card__icon--partner" aria-hidden="true">
								<Icon size="lg" weight="duotone" />
							</span>
							<h3 class="benefits-card__title">{t(b.titleKey)}</h3>
							<p class="benefits-card__desc">{t(b.descKey)}</p>
						</div>
					);
				})}
			</div>
			<div class="benefits-section__cta" data-reveal="up">
				<GradientButton
					href={buildUrl({ locale, path: 'sumate/partner' })}
					label={t('benefits.partner.cta')}
					variant="primary"
				/>
			</div>
		</div>
	</section>
</MarketingLayout>

<style>
	.benefits-section__container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--space-container-x);
		text-align: center;
	}

	.benefits-section__tagline {
		font-family: var(--font-decorative);
		font-weight: 700;
		font-size: clamp(1.1rem, 2.5vw, 1.4rem);
		color: var(--brand-accent);
		margin: 0 0 var(--space-2);
	}

	.benefits-section__title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		color: var(--core-foreground);
		margin: 0 0 var(--space-8);
	}

	.benefits-section__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--space-card-gap);
		text-align: left;
	}

	.benefits-card {
		background-color: var(--core-card);
		border-radius: var(--radius-card);
		padding: var(--space-6);
		box-shadow: var(--shadow-card);
	}

	/* Icon chip: rounded square with tinted background + duotone icon in the
	 * matching brand color. Mirrors the visual rhythm used in the publicar
	 * landing's benefit cards. */
	.benefits-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		margin-bottom: var(--space-4);
		border-radius: var(--radius-button, 12px);
	}

	.benefits-card__icon--tourist {
		background-color: var(--brand-primary-a12);
		color: var(--brand-primary);
