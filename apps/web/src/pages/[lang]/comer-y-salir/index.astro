---
/**
 * @file gastronomia/index.astro
 * @description venue listing page (SPEC-239 T-053).
 * SSR-fetches venueApi.list with filters from the query string and renders
 * a grid of VenueCard components with FilterSidebar, Pagination, EmptyState,
 * and ErrorBanner following the same pattern as alojamientos/index.astro.
 *
 * @route /{lang}/comer-y-salir/
 * @rendering SSR (on-demand)
 */

import ListingLayout from '@/layouts/ListingLayout.astro';
import ItemListJsonLd from '@/components/seo/ItemListJsonLd.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import ListingPageHeader from '@/components/shared/layout/ListingPageHeader.astro';
import VenueCard from '@/components/venue/VenueCard.astro';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import ErrorBanner from '@/components/shared/feedback/ErrorBanner.astro';
import Pagination from '@/components/shared/feedback/Pagination.astro';
import { FilterSidebar } from '@/components/shared/filters/FilterSidebar.client';
import type { FilterGroup } from '@/components/shared/filters/FilterSidebar.client';
import FilterChips from '@/components/shared/ui/FilterChips.astro';
import {
    buildVenueListingSummary,
    DEFAULT_VENUE_TYPES,
    DEFAULT_PRICE_RANGES
} from '@/lib/listing-summary';
import { venueApi, destinationsApi, featuresApi, SSR_PUBLIC_CACHE_TTL_MS } from '@/lib/api/endpoints';
import { toVenueCardProps } from '@/lib/api/transforms';
import { getVenueTypeIcon } from '@/lib/venue-type-icons';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { hasActiveVenueListingFilters } from '@/lib/listing-empty-state-filters';
import { buildUrl } from '@/lib/urls';
import { buildToggleParamHref } from '@/lib/filters/toggle-query-param';

import { CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { hasOnlyPaginationParams } from '@/lib/cache/listing-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);

// --- Edge cacheability (HOS-369 W2-4) ---
// Newly cacheable: until W2-4 built the purge chain, venue pages had no cache tag
// vocabulary, no `entity-tag-mapper` case, and its service never called the
// revalidation service — so caching this page would have shipped a response
// nothing could evict.
//
// Tagged with the collection: this IS a listing, so every venue write
// must evict it.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	// This listing accepts `q`, `type`, `destinationId`, `isFeatured`,
	// `minRating`, `sortBy`, `priceRange` and `features` (the apto filter,
	// HOS-1054) — all read in the frontmatter, all changing the SSR HTML.
	// Anything beyond pagination makes the render an arbitrary slice and stays
	// private.
	cacheable: hasOnlyPaginationParams({ searchParams: Astro.url.searchParams }),
	cacheClass: 'catalog',
	tags: [CACHE_TAG_COLLECTIONS.venue]
});

const url = Astro.url;

// --- Pagination ---
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const pageSize = 20;

// --- Filter params ---
const q = url.searchParams.get('q') ?? undefined;
const destinationId = url.searchParams.get('destinationId') ?? undefined;
const type = url.searchParams.get('type') ?? undefined;
const priceRange = url.searchParams.get('priceRange') ?? undefined;
const isFeatured = url.searchParams.get('isFeatured') === 'true' ? true : undefined;
const minRating = url.searchParams.get('minRating')
    ? Number(url.searchParams.get('minRating'))
    : undefined;

/**
 * The "apto" filter (HOS-1054): a comma-separated list of feature UUIDs the
 * listing must ALL carry.
 *
 * Aptos are not columns. «Sin TACC», «vegano», «vegetariano», «sin lactosa» and
 * «sin frutos secos» are rows of the shared `features` catalog scoped to the
 * `venue` vertical, so filtering by apto is filtering by feature — and the
 * day a sixth apto appears it is one more catalog row, not a migration.
 *
 * Forwarded to the API as the raw comma-separated string, exactly as
 * `alojamientos/index.astro` does: the HTTP schema splits and validates each
 * UUID, and an invalid one is a 400 rather than a silently-ignored filter.
 */
const featuresParam = url.searchParams.get('features') ?? undefined;

/**
 * Maps the URL's user-friendly sort key (matching the `sortOptions` below) to
 * the backend `(sortBy, sortOrder)` pair. BETA-119: previously the actual API
 * call ignored `sortBy` entirely (always sorted `isFeatured desc`), while the
 * sidebar still offered a sort selector — this reads and applies the real
 * selection, same as the accommodations/events/posts listings.
 */
const SORT_OPTION_MAP: Record<string, { sortBy: string; sortOrder: 'asc' | 'desc' }> = {
    featured:   { sortBy: 'isFeatured',    sortOrder: 'desc' },
    ratingDesc: { sortBy: 'averageRating', sortOrder: 'desc' },
    newest:     { sortBy: 'createdAt',     sortOrder: 'desc' },
    nameAsc:    { sortBy: 'name',          sortOrder: 'asc'  }
};
/** Default sort key — used when the URL has no `sortBy`. Matches the previous hardcoded behavior. */
const DEFAULT_SORT_KEY = 'featured';

const sortKey = url.searchParams.get('sortBy') ?? DEFAULT_SORT_KEY;
const sortResolved = SORT_OPTION_MAP[sortKey] ?? SORT_OPTION_MAP[DEFAULT_SORT_KEY];

// --- Fetch destinations (CITY), the venue feature catalog, and the listings ---
// The catalog read is scoped with `applicableVertical: 'venue'` so the
// sidebar only ever offers aptos and other venue characteristics — the
// shared `features` table also holds ~80 accommodation and experience rows that
// would be meaningless on a restaurant. Its TTL is the fixed-catalog one: the
// catalog is identical on every render, unlike the listing query itself.
const [destinationsResult, featuresResult, result] = await Promise.all([
    destinationsApi.list({ destinationType: 'CITY', pageSize: 100 }),
    featuresApi.list({
        pageSize: 100,
        applicableVertical: 'venue',
        sortBy: 'displayWeight',
        sortOrder: 'desc',
        cacheTtlMs: SSR_PUBLIC_CACHE_TTL_MS
    }),
    venueApi.list({
        page,
        pageSize,
        q,
        destinationId,
        type,
        priceRange,
        isFeatured,
        minRating,
        features: featuresParam,
        sortBy: sortResolved.sortBy,
        sortOrder: sortResolved.sortOrder
    })
]);

const destinations = destinationsResult.ok ? destinationsResult.data.items : [];
const featureCatalog = featuresResult.ok ? featuresResult.data.items : [];

const hasError = !result.ok;
const items = result.ok ? result.data.items : [];
const total = result.ok ? result.data.pagination.total : 0;
const totalPages = result.ok ? result.data.pagination.totalPages : 0;

// --- Transform to card props ---

const baseCards = items.map((item) =>
    toVenueCardProps({ item: item as unknown as Record<string, unknown>, locale })
);

// --- SSR bulk-check favorites for authenticated users ---

// HOS-369 WB0-5: favourite state is per-user, so it is no longer resolved
// here — the hearts resolve it themselves after hydration, once per page load
// for the whole grid (`store/favorites-store`).
const cards = baseCards;

const hasActiveFilters = hasActiveVenueListingFilters({
	q,
	destinationId,
	type,
	priceRange,
	isFeatured,
	minRating,
	features: featuresParam,
});

// --- Venue types for filter (from the confirmed enum) ---
const VENUE_TYPES = [
    'RESTAURANT',
    'BAR',
    'CAFE',
    'PARRILLA',
    'CERVECERIA',
    'HELADERIA',
    'PANADERIA',
    'ROTISERIA',
    'FOOD_TRUCK'
] as const;

const PRICE_RANGES = ['BUDGET', 'MID', 'HIGH', 'PREMIUM'] as const;

// --- Filter groups ---
const filterGroups: FilterGroup[] = [
    {
        id: 'q',
        label: t('venue.listing.search'),
        type: 'search',
        placeholder: t('venue.listing.searchPlaceholder')
    },
    {
        id: 'destinationId',
        label: t('venue.listing.destination'),
        type: 'select-search',
        options: destinations.map((d) => ({
            value: d.id,
            label: d.name,
            featured: Boolean(d.isFeatured)
        })),
        maxVisible: 8
    },
    {
        id: 'type',
        label: t('venue.listing.type'),
        type: 'checkbox',
        options: VENUE_TYPES.map((value) => ({
            value,
            label: t(`venue.types.${value}`, value)
        }))
    },
    {
        id: 'priceRange',
        label: t('venue.listing.priceRange'),
        type: 'checkbox',
        options: PRICE_RANGES.map((value) => ({
            value,
            label: t(`venue.card.priceRange.${value}`, value)
        }))
    },
    {
        id: 'isFeatured',
        label: t('venue.listing.featured'),
        type: 'toggle'
    },
    // The aptos group (HOS-1054). Rendered only when the catalog read
    // succeeded and returned rows: an empty `icon-chips` group is a header over
    // nothing, which reads as a broken filter rather than as an absent one.
    //
    // Labels come from `@repo/i18n` keyed by SLUG, never from the row — the
    // catalog has no `name` column (SPEC-266) and the slug IS the i18n key.
    ...(featureCatalog.length > 0
        ? ([
              {
                  id: 'features',
                  label: t('venue.listing.features'),
                  type: 'icon-chips',
                  options: featureCatalog.map((f) => ({
                      value: f.id,
                      label: t(
                          `accommodations.featureNames.${f.slug ?? ''}`,
                          f.slug ?? undefined
                      ),
                      icon: f.icon ?? undefined
                  })),
                  maxVisible: 10
              }
          ] satisfies FilterGroup[])
        : []),
    {
        id: 'minRating',
        label: t('venue.listing.minRating'),
        type: 'stars'
    }
];

const sortOptions = [
    { value: 'featured', label: t('venue.listing.sort.featured') },
    {
        value: 'ratingDesc',
        label: t('venue.listing.sort.ratingDesc')
    },
    { value: 'newest', label: t('venue.listing.sort.newest') },
    { value: 'nameAsc', label: t('venue.listing.sort.nameAsc') }
];

// --- Build initial params for sidebar (avoids hydration flash) ---
const initialParams: Record<string, string> = {};
if (q) initialParams.q = q;
if (destinationId) initialParams.destinationId = destinationId;
if (type) initialParams.type = type;
if (priceRange) initialParams.priceRange = priceRange;
if (isFeatured) initialParams.isFeatured = 'true';
if (minRating !== undefined) initialParams.minRating = String(minRating);
if (featuresParam) initialParams.features = featuresParam;
initialParams.sortBy = sortKey;

/**
 * Build a human-readable summary like "Mostrando 9 de 18 locales..." to replace the generic "N resultados encontrados" line
 * (BETA-119). Mirrors the accommodations/events/posts pattern via the shared
 * `listing-summary` module. The builder ships es/en/pt
 * phrase dictionaries, so the page locale is passed through unchanged.
 */
const destinationCatalog = destinations.map((d) => ({
    key: d.id,
    label: { es: d.name, en: d.name, pt: d.name } as const
}));
const filterSummary = buildVenueListingSummary({
    locale,
    filters: {
        text: q,
        type,
        destinationId,
        priceRange,
        isFeatured,
        minRating
    },
    counts: { shown: cards.length, total },
    sort: { sortKey },
    catalogs: {
        destinations: destinationCatalog,
        types: DEFAULT_VENUE_TYPES,
        priceRanges: DEFAULT_PRICE_RANGES
    }
});

const baseUrl = buildUrl({ locale, path: 'comer-y-salir' });
const canonicalPath = page > 1 ? `${baseUrl}page/${page}/` : baseUrl;

/**
 * Quick-filter type chips (HOS-97): filter the listing in place via
 * `?type=ENUM` (preserving every other active filter/sort and resetting to
 * page 1) instead of navigating to a separate route. The chip matching the
 * active type is highlighted; clicking it clears the filter (toggle) — same
 * single-select model as the eventos category chips.
 */
const typeChips = VENUE_TYPES.map((value) => {
    const isActive = type === value;
    return {
        label: t(`venue.types.${value}`, value),
        href: buildToggleParamHref({
            baseUrl,
            searchParams: url.searchParams,
            key: 'type',
            value,
            isActive
        }),
        active: isActive,
        icon: getVenueTypeIcon({ type: value })
    };
});

const itemListEntries = cards.map((card) => ({
    url: new URL(buildUrl({ locale, path: `comer-y-salir/${card.slug}` }), Astro.site ?? Astro.url.origin)
        .href,
    name: card.name,
}));
---

<ListingLayout
    locale={locale}
    title={t('venue.listing.title', 'Gastronomía')}
    description={t(
        'venue.listing.subtitle',
        'Descubrí los mejores restaurantes, bares y sabores de la región'
    )}
    canonicalPath={canonicalPath}
    showFilters={true}
    filterPosition="left"
    ogTagline={t('venue.listing.subtitle', 'Descubrí los mejores sabores')}
    totalCount={total}
    filterSummary={filterSummary}
>
    <ItemListJsonLd
        slot="head-extra"
        name={t('venue.listing.title', 'Gastronomía')}
        items={itemListEntries}
        numberOfItems={total}
        startPosition={(page - 1) * pageSize + 1}
    />

    <Breadcrumbs
        slot="breadcrumbs"
        locale={locale}
        items={[{ label: t('venue.listing.title', 'Gastronomía') }]}
    />

    <ListingPageHeader
        slot="page-header"
        locale={locale}
        tagline={t('venue.listing.subtitle', 'Descubrí los mejores sabores')}
        title={t('venue.listing.title', 'Gastronomía')}
    />

    <FilterSidebar
        slot="filters"
        client:load
        locale={locale}
        filters={filterGroups}
        sortOptions={sortOptions}
        initialParams={initialParams}
    />

    <FilterChips
        chips={typeChips}
        ariaLabel={t('venue.typeChips.ariaLabel', 'Filtrar por tipo de establecimiento')}
        showScrollButtons
        prevLabel={t('common.prev', 'Anterior')}
        nextLabel={t('common.next', 'Siguiente')}
    />

    {hasError && !result.ok && (
        <ErrorBanner
            locale={locale}
            error={result.error}
            entityName="gastronomía"
        />
    )}

    {!hasError && cards.length === 0 && hasActiveFilters && (
        <EmptyState
            locale={locale}
            variant="no-results"
            actionUrl={baseUrl}
            message={t(
                'venue.listing.emptyState',
                'No se encontraron locales con los filtros seleccionados.'
            )}
        />
    )}

	{!hasError && cards.length === 0 && !hasActiveFilters && (
		<EmptyState
			locale={locale}
			variant="empty"
			message={t(
				'venue.listing.emptyCatalog',
				'Todavía no hay locales publicados.'
			)}
		/>
	)}

    {!hasError && cards.length > 0 && (
        <div class="venue-grid">
            {cards.map((card, i) => (
                <div data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100">
                    <VenueCard
                        data={card}
                        locale={locale}
                        eager={i < 3}
                    />
                </div>
            ))}
        </div>
    )}

    {totalPages > 1 && (
        <Pagination
            slot="pagination"
            currentPage={page}
            totalPages={totalPages}
            baseUrl={baseUrl.slice(0, -1)}
            locale={locale}
            searchParams={(() => {
                const sp = new URLSearchParams(url.searchParams);
                sp.delete('page');
                return sp;
            })()}
        />
    )}
</ListingLayout>

<style>
    .venue-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: var(--space-card-gap);
    }

    @media (max-width: 480px) {
        .venue-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
