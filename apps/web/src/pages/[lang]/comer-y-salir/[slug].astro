---
/**
 * @file comer-y-salir/[slug].astro
 * @description Venue detail page (SPEC-239 T-054).
 * Fetches a single venue listing by slug, fetches reviews + FAQs in
 * parallel, and composes the detail block components.
 *
 * 404 is returned when:
 * - The API returns !result.ok (listing not found or server error).
 * - The listing is not PUBLISHED: the public read answers it like an unknown
 *   slug (HOS-1641), so this is the same `!result.ok` case.
 *
 * @route /{lang}/comer-y-salir/{slug}/
 * @rendering SSR (on-demand)
 */

import DetailLayout from '@/layouts/DetailLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import { ImageGallery } from '@/components/ImageGallery.client';
import ListingVideoSection from '@/components/listing/ListingVideoSection.astro';
import VenueJsonLd from '@/components/seo/VenueJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import VenueDetailHeader from '@/components/venue/VenueDetailHeader.astro';
import VenueDescription from '@/components/venue/VenueDescription.astro';
import VenueDailySpecials from '@/components/venue/VenueDailySpecials.astro';
import VenueMenu from '@/components/venue/VenueMenu.astro';
import VenueEvents from '@/components/venue/VenueEvents.astro';
import VenuePromotions from '@/components/venue/VenuePromotions.astro';
import VenueNightInfo from '@/components/venue/VenueNightInfo.astro';
import ListingHouseRules from '@/components/listing/ListingHouseRules.astro';
import OpeningHoursSection from '@/components/venue/OpeningHoursSection.astro';
import VenueContactBlock from '@/components/venue/VenueContactBlock.astro';
import VenueWhatsAppContact from '@/components/venue/VenueWhatsAppContact.astro';
import VenueAddress from '@/components/venue/VenueAddress.astro';
import { buildVenueJsonLdPlace } from '@/lib/venue/venue-address';
import { hasVenuePublicContact } from '@/lib/venue-contact';
// Reused, not duplicated (HOS-1072): venue reads the SAME `amenities` /
// `features` catalog as accommodations, so it shares the i18n namespace
// (`accommodations.amenityNames.<slug>`) these two grids already resolve. A
// venue/experience copy would fork that contract for no gain.
import AmenitiesGrid from '@/components/accommodation/AmenitiesGrid.astro';
import FeaturesGrid from '@/components/accommodation/FeaturesGrid.astro';
import VenueEventsCta from '@/components/venue/VenueEventsCta.astro';
import VenueReviewsPreview from '@/components/venue/VenueReviewsPreview.astro';
import { VenueReviewForm } from '@/components/venue/VenueReviewForm.client';
import FaqAccordion from '@/components/accommodation/FaqAccordion.astro';
import { EntityViewTracker } from '@/components/analytics/EntityViewTracker.client';
import { VenueInteractionTracker } from '@/components/analytics/VenueInteractionTracker.client';
import { InternalEntryTracker } from '@/components/analytics/InternalEntryTracker.client';
import { venueApi, userBookmarksPublicApi } from '@/lib/api/endpoints';
import { toVenueDetailPageProps } from '@/lib/api/transforms';
import { getApiUrl } from '@/lib/env';
import { AiChatWidget } from '@/components/accommodation/AiChatWidget';
import { ListingContactBar } from '@/components/listing/contact/ListingContactBar.client';
import { ListingChannelsPanel } from '@/components/listing/contact/ListingChannelsPanel.client';
import { buildVenueChannels, resolveVenueContactMode } from '@/lib/listing-contact/listing-channels';
import { VENUE_CONTACT_ANCHOR_ID } from '@/lib/venue-contact';
import { buildLoginRedirect } from '@/lib/auth-redirect';
import { createTranslations } from '@/lib/i18n';
import { buildListingPolicyStructuredData } from '@/lib/seo/listing-policies-jsonld';
import { setListingPolicy } from '@/lib/listing/listing-policies';
import type { SupportedLocale } from '@/lib/i18n';
import { resolveSafeExternalUrl } from '@/lib/safe-external-url';
import { buildRestaurantHasMenu } from '@/lib/venue/menu-jsonld';
import { resolveDimensionAverages } from '@/lib/venue/review-dimensions-view';
import {
    orderVenueDetailSections,
    type VenueDetailBodySectionId
} from '@/lib/venue/venue-detail-sections';
import { buildUrl } from '@/lib/urls';
import { renderPlain } from '@/lib/render-plain';
import type { VenueReviewPublicItem } from '@/lib/api/endpoints';
import type { DetailFaq, VenueOpeningHoursEntry } from '@/data/types';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

import { buildEntityCacheTags, CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import {
    applyCacheHeaders,
    markResponseDegraded,
    markResponseDegradedFromApi
} from '@/lib/cache/response-cache';
export const prerender = false;

const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { slug } = Astro.params;

if (!slug) return new Response(null, { status: 404 });

// --- Fetch main record ---
const result = await venueApi.getBySlug({ slug });

if (!result.ok) {
    // Propagate 410 Gone for soft-deleted entities so crawlers/LLM fetchers
    // deindex the URL fast (HOS-117 T-022); any other failure stays 404.
    return new Response(null, { status: result.error.status === 410 ? 410 : 404 });
}

const raw = result.data as unknown as Record<string, unknown>;

// --- Publication gate (HOS-1641) ---
// There is no second gate here on purpose: the public read answers ONLY a
// `PUBLISHED` listing (AC:V5:5), and every other publication state answers the
// same 404 as an unknown slug, which `!result.ok` above already returns. The
// public payload carries no publication field to re-check.

const venue = toVenueDetailPageProps({ item: raw, locale });
const dimensionRatings = resolveDimensionAverages({ vertical: 'venue', rating: venue.rating });

// --- Edge cacheability (HOS-369 W2-4) ---
// After the guard above — the 404/410 for missing, soft-deleted or
// non-PUBLISHED rows (HOS-1641: the public read answers only PUBLISHED). That
// ordering is what makes this safe: a non-published listing 404s before
// reaching here, so it can never be shared from the edge. It mirrors the
// service side, which only schedules a purge for a PUBLISHED listing.
//
// Addressed by its OWN two tags and deliberately NOT by `list-venue`: a
// detail page is not a listing, and the collection tag would make every
// venue write evict every other one's page.
const venueCacheTags = buildEntityCacheTags({
    entity: 'venue',
    slug,
    id: String(raw.id || '')
});
const [primaryVenueTag, ...extraVenueTags] = venueCacheTags;

applyCacheHeaders({
    locals: Astro.locals,
    headers: Astro.response.headers,
    // No usable entity tag means nothing could purge this page, and an
    // unpurgeable cached page is worse than an uncached one.
    cacheable: primaryVenueTag !== undefined,
    cacheClass: 'detail',
    tags:
        primaryVenueTag !== undefined
            ? [primaryVenueTag, ...extraVenueTags]
            : [CACHE_TAG_COLLECTIONS.venue]
});

// HOS-2009: a 2xx answer flagged `no-store` is the API's degraded state (the
// owner's effective set failed to resolve, paid sections withheld). Veto the
// edge cache so the failure is not frozen in as "this owner did not pay".
markResponseDegradedFromApi({ locals: Astro.locals, results: [result] });

// --- Parallel secondary fetches ---
const [reviewsSettled, faqsSettled, promotionsSettled] = await Promise.allSettled([
    venueApi.getReviews({ id: venue.id, page: 1, pageSize: 5 }),
    venueApi.getFaqs({ id: venue.id }),
    venueApi.listPromotions({ venueId: venue.id })
]);

const reviewsResult =
    reviewsSettled.status === 'fulfilled' ? reviewsSettled.value : null;
const faqsResult =
    faqsSettled.status === 'fulfilled' ? faqsSettled.value : null;
const promotionsResult = promotionsSettled.status === 'fulfilled' ? promotionsSettled.value : null;
const promotions = promotionsResult?.ok ? promotionsResult.data.items : [];
if (promotionsResult?.ok) {
    markResponseDegradedFromApi({ locals: Astro.locals, results: [promotionsResult] });
} else {
    markResponseDegraded({ locals: Astro.locals });
}

const reviews: readonly VenueReviewPublicItem[] =
    reviewsResult?.ok ? reviewsResult.data.items : [];
const totalReviews: number =
    reviewsResult?.ok ? reviewsResult.data.pagination.total : venue.reviewsCount;

// FAQs: prefer inline entity FAQs, fall back to standalone endpoint
const faqs: readonly DetailFaq[] =
    venue.faqs.length > 0
        ? venue.faqs
        : faqsResult?.ok && Array.isArray(faqsResult.data)
          ? (faqsResult.data as Array<Record<string, unknown>>).map((faq) => ({
                id: String(faq.id || ''),
                question: String(faq.question || ''),
                answer: String(faq.answer || ''),
                category: faq.category ? String(faq.category) : null
            }))
          : [];

// --- Gallery images ---
const galleryImages = (() => {
    const mediaObj = raw.media as
        | { gallery?: Array<{ url?: string; caption?: string; description?: string }> }
        | undefined;
    const gallery = mediaObj?.gallery ?? [];
    if (gallery.length > 0) {
        return gallery
            .filter((g) => g.url)
            .map((g) => ({
                url: String(g.url),
                alt: g.caption ?? venue.name,
                caption: g.caption,
                description: g.description
            }));
    }
    if (venue.featuredImage.url && !venue.featuredImage.url.includes('placeholder')) {
        return [
            {
                url: venue.featuredImage.url,
                alt: venue.featuredImage.caption ?? venue.name,
                caption: venue.featuredImage.caption
            }
        ];
    }
    return [];
})();


// --- SSR bookmark status for header ---
let bookmarkCount: number | undefined;

try {
    const countResult = await userBookmarksPublicApi.count({
        entityType: 'VENUE',
        entityId: venue.id
    });
    if (countResult.ok) {
        bookmarkCount = countResult.data.count;
    }
} catch {
    // graceful degradation
}


const descriptionText = renderPlain({ raw: venue.description });

// --- "Accepts events" CTA (HOS-1055) ---
// Driven by the house rule `policies.eventsAllowed` (HOS-2060). It used to
// reuse a catalog amenity, retired when the house rules moved into
// `policies`; only an explicit `true` turns the CTA on.
//
// The CTA has no external `href` of its own — it is an in-page anchor to
// `VenueContactBlock` (see `VenueEventsCta.astro`'s header for why:
// venue has no single public contact channel to pick, especially since
// HOS-1076 found `socialNetworks.whatsapp` never carried real data and
// removed it — HOS-1088 tracks the open question of a real phone/WhatsApp
// channel for venue). That sidesteps picking a channel AND the outbound
// href-sanitization guard (HOS-592/F-02): there is nothing external to
// sanitize.
//
// `hasVenueContact` is the SAME predicate `VenueContactBlock` uses to decide
// whether it renders anything at all (`hasVenuePublicContact`, shared through
// `@/lib/venue-contact` since HOS-2042 added the business channels). Without it, the CTA
// could point at an anchor with nothing behind it, which is worse than no CTA
// (same principle as HOS-363/HOS-924: never promise a channel that isn't
// there).
const acceptsEvents = venue.policies?.eventsAllowed === true;
const hasVenueContact = hasVenuePublicContact({
    contactInfo: venue.contactInfo,
    socialNetworks: venue.socialNetworks,
    menuUrl: venue.menuUrl
});
const showEventsCta = acceptsEvents && hasVenueContact;
// The events rule is left out of the house-rules list ONLY when the dedicated
// CTA renders in its place — otherwise both would say "accepts events" two
// centimeters apart.
const houseRulePolicies = showEventsCta
    ? setListingPolicy({ policies: venue.policies ?? {}, key: 'eventsAllowed', value: undefined })
    : venue.policies;

// --- Mobile contact bar (HOS-2532) ---
// No price and no form. The panel carries WhatsApp only through the HOS-2256 gate
// (`whatsapp` state of the payload), never a number read off contactInfo or socials (HOS-1076). A published
// menu link wins («Ver carta»); otherwise «Contactar» opens the social links; with
// neither, there is no bar. The in-page block is a superset of both, so the bar's
// no-JS fallback anchor always has a target.
// HOS-2256 state (not a socialNetworks/contactInfo field; see the venue guards).
const { whatsapp: venueWhatsApp } = venue;
const contactChannels = buildVenueChannels({ socialNetworks: venue.socialNetworks });
const contactMode = resolveVenueContactMode({
    menuUrl: venue.menuUrl,
    channels: contactChannels,
    // Same gate as the page's own WhatsApp button (HOS-2256).
    hasWhatsapp: Boolean(venueWhatsApp)
});
const contactPanelId = 'listing-contact-panel';

const canonicalPath = buildUrl({ locale, path: `comer-y-salir/${venue.slug}/` });
const jsonLdHasMenu = buildRestaurantHasMenu({
    venue,
    locale,
    siteOrigin: Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin
});

// Sign-in URL (with return path) for the anonymous review CTA.
const reviewSignInHref = buildLoginRedirect({ locale, currentUrl: canonicalPath });

// Price range mapping for JSON-LD
const priceRangeMap: Record<string, string> = {
    BUDGET: '$',
    MID: '$$',
    HIGH: '$$$',
    PREMIUM: '$$$$'
};
const jsonLdPriceRange = venue.priceRange ? priceRangeMap[venue.priceRange] ?? undefined : undefined;

// --- Body sections (HOS-1787 leaf 6.1) ---
// The body renders the catalog's own order and only the sections it paints:
// the block registry below is a lookup, never a comparison against a section
// id. `price` lives in the header, `media` is the fixed gallery above, and
// `translations` never renders publicly — see `venue-detail-sections.ts`.
// Conditions are applied while building each list, so the template just paints.
interface VenueDetailBlock {
    readonly Component: AstroComponentFactory;
    readonly props: Record<string, unknown>;
}

const hasOpeningHours =
    venue.openingHours !== null && Object.keys(venue.openingHours).length > 0;
const hasContactBlock = hasVenueContact;

const venueDetailSectionBlocks: Readonly<
    Record<VenueDetailBodySectionId, readonly VenueDetailBlock[]>
> = {
    basicInfo: [
        {
            Component: VenueDescription,
            props: {
                summary: venue.summary,
                descriptionText,
                richDescription: venue.richDescription
            }
        }
    ],
    location: venue.location
        ? [
              {
                  Component: VenueAddress,
                  props: { location: venue.location, cityName: venue.destinationName, locale }
              }
          ]
        : [],
    openingHours: hasOpeningHours
        ? [
              {
                  Component: OpeningHoursSection,
                  props: {
                      openingHours: venue.openingHours as Record<
                          string,
                          VenueOpeningHoursEntry
                      >,
                      locale
                  }
              }
          ]
        : [],
    amenities: [
        {
            Component: FeaturesGrid,
            props: { features: venue.features, lang: locale }
        },
        { Component: AmenitiesGrid, props: { amenities: venue.amenities, lang: locale } },
        // HOS-2060: `policies` belongs to the amenities section in the catalog.
        { Component: ListingHouseRules, props: { policies: houseRulePolicies, locale } },
        ...(showEventsCta ? [{ Component: VenueEventsCta, props: { locale } }] : [])
    ],
    contact: [
        ...(hasContactBlock
            ? [
                  {
                      Component: VenueContactBlock,
                      props: {
                          contactInfo: venue.contactInfo,
                          listingId: venue.id,
                          menuUrl: venue.menuUrl,
                          socialNetworks: venue.socialNetworks,
                          locale
                      }
                  }
              ]
            : []),
        // HOS-2256: the WhatsApp button. The component decides by itself whether
        // there is anything to show (the owner's choice rides the public payload;
        // the page reads no session), like the other self-hiding blocks.
        {
            Component: VenueWhatsAppContact,
            props: { venue, signInHref: reviewSignInHref, locale }
        }
    ],
    menu: [
        {
            Component: VenueMenu,
            props: {
                menuSections: venue.menuSections,
                fileUrl: venue.menuFileUrl,
                fileKind: venue.menuFileKind,
                locale
            }
        }
    ],
    dailySpecials: [
        {
            Component: VenueDailySpecials,
            props: { dailySpecials: venue.dailySpecials, locale }
        }
    ],
    venueEvents: [
        { Component: VenueEvents, props: { venueEvents: venue.venueEvents, locale } }
    ],
    promotions: promotions.length > 0 ? [{ Component: VenuePromotions, props: { items: promotions, locale } }] : [],
    faqs: faqs.length > 0 ? [{ Component: FaqAccordion, props: { faqs, lang: locale } }] : [],
    nightInfo: [
        { Component: VenueNightInfo, props: { nightInfo: venue.nightInfo, locale } }
    ]
};

// HOS-2060: `paymentAccepted` is a `LocalBusiness` property, so a venue may
// carry it; `petsAllowed` is not (schema.org scopes it to lodging), so it is
// deliberately left out of the venue object.
const jsonLdPolicyData = buildListingPolicyStructuredData({ policies: venue.policies ?? {}, t });

const jsonLdPlace = buildVenueJsonLdPlace({
    location: venue.location,
    locality: venue.destinationName
});

// --- SEO ---
// SEOHead (via DetailLayout) already appends " | Hospeda", so the fallback is the
// bare name — appending it here too produced a duplicated "… | Hospeda | Hospeda".
const seoTitle = venue.seo?.title?.trim() || venue.name;
const seoDescription =
    venue.seo?.description?.trim() || venue.summary || t('venue.listing.subtitle');

// --- Breadcrumb JSON-LD (HOS-117 T-007) ---
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const breadcrumbItems = [
    { name: t('nav.home', 'Inicio'), url: `${siteOrigin}/${locale}/` },
    {
        name: t('venue.listing.title'),
        url: `${siteOrigin}/${locale}/comer-y-salir/`
    },
    { name: venue.name, url: `${siteOrigin}${Astro.url.pathname}` }
];
---

<DetailLayout
    locale={locale}
    title={seoTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    showBreadcrumbs={true}
    showSidebar={false}
    ogImage={venue.featuredImage.url}
    ogType={t(`venue.types.${venue.type}`, venue.type)}
    ogSubtitle={venue.destinationName}
    ogRating={venue.averageRating > 0 ? venue.averageRating.toFixed(1) : undefined}
    analyticsTag={venue.id}
>
    <VenueJsonLd
        slot="head-extra"
        name={venue.name}
        description={seoDescription}
        url={canonicalPath}
        type={venue.type}
        hasMenu={jsonLdHasMenu}
        image={venue.featuredImage.url}
        priceRange={jsonLdPriceRange}
        paymentAccepted={jsonLdPolicyData.paymentAccepted}
        address={jsonLdPlace.address}
        geo={jsonLdPlace.geo}
        aggregateRating={venue.averageRating > 0 ? {
            ratingValue: venue.averageRating,
            reviewCount: venue.reviewsCount,
        } : undefined}
    />
    <BreadcrumbJsonLd slot="head-extra" items={breadcrumbItems} />
    <div slot="breadcrumbs" class="venue-detail-breadcrumbs">
        <Breadcrumbs
            locale={locale}
            items={[
                {
                    label: t('venue.listing.title'),
                    path: 'comer-y-salir/'
                },
                { label: venue.name }
            ]}
        />
    </div>

    <!-- Header (rendered inside the wave band, like destinos/alojamientos) -->
    <Fragment slot="page-header">
        <VenueDetailHeader
            venue={venue}
            locale={locale}
            bookmarkCount={bookmarkCount}
            hasMobileGalleryControls={galleryImages.length > 0}
        />
    </Fragment>

    <div class="venue-detail">
        <!-- Gallery: the listing's cover, fixed above the catalog-ordered body. -->
        {galleryImages.length > 0 && (
            <div class="venue-detail__gallery">
                <ImageGallery
                    client:load
                    images={galleryImages}
                    locale={locale}
                    variant="detail"
                    mobile={{
                        backHref: buildUrl({ locale, path: 'comer-y-salir' }),
                        share: { url: `${siteOrigin}${Astro.url.pathname}`, title: venue.name, campaign: 'venue' },
                        favorite: {
                            entityId: venue.id,
                            entityType: 'VENUE',
                            variant: 'standalone'
                        }
                    }}
                />
            </div>
        )}

        <!-- Videos (HOS-2258): linked videos, lazy facade, right under the
             gallery. They arrive already gated by the owner's plan
             (`can_embed_video`) and moderation-filtered; the block hides
             itself when none is left. -->
        {venue.videos && venue.videos.length > 0 && (
            <div class="venue-detail__videos">
                <ListingVideoSection videos={venue.videos} locale={locale} scope="venue" />
            </div>
        )}

        <!-- Body: every catalog section in catalog order (sub-spec 6 § «Ficha»).
             Each id resolves its blocks by lookup in the frontmatter registry;
             a section the public projector emptied simply contributes no
             visible output because its components self-hide. -->
        {orderVenueDetailSections().map((sectionId) =>
            venueDetailSectionBlocks[sectionId].map(({ Component, props }) => (
                <Component {...props} />
            ))
        )}

        <!-- Reviews preview + form are not catalog sections: they follow the
             last section. -->
        <VenueReviewsPreview
            reviewsCount={venue.reviewsCount}
            reviews={reviews}
            totalReviews={totalReviews}
            locale={locale}
            dimensionRatings={dimensionRatings}
        />

        <!-- Leave a review (authenticated visitors submit; anonymous see a sign-in CTA) -->
        <section class="venue-detail__review-form">
            <VenueReviewForm
                client:visible
                venueId={venue.id}
                venueName={venue.name}
                sectionStates={venue.reviewSectionStates}
                locale={locale}
                apiUrl={getApiUrl()}
                signInHref={reviewSignInHref}
            />
        </section>

        <!-- Analytics tracker (headless, HOS-734) — feeds the owner-facing
             basic view stats in mi-cuenta/comercio. -->
        <!-- Internal-entry analytics event (HOS-2119 T-076): same-origin referrer only. -->
        <InternalEntryTracker
            client:idle
            entityType="VENUE"
            entityId={venue.id}
            locale={locale}
        />
        <EntityViewTracker
            client:idle
            entityType="VENUE"
            slug={slug}
            entityId={venue.id}
            locale={locale}
        />
        <!-- Taps on phone, map, web, Instagram, ticket and WhatsApp (HOS-2256).
             The `.astro` components only carry `data-interaction-kind`; this
             island does the listening, so the page stays session-blind. -->
        <VenueInteractionTracker
            client:idle
            entityId={venue.id}
        />
    </div>
    <!-- AI chat widget (HOS-400) — signed-in visitors only, resolved in the
         browser. Mounted unconditionally, exactly as the accommodation page
         does: the widget renders nothing until it resolves a session, and both
         the FAB and the panel are position:fixed, so appearing after hydration
         shifts nothing. Whether the OWNER's plan grants the chat is decided
         server-side; an owner without it answers 403 and the widget shows the
         vertical's own `unavailable` copy (HOS-1264: resolved through
         `resolveChatError` with the entity type, not the accommodation key). -->
    <AiChatWidget
        client:idle
        entityType="venue"
        entityId={venue.id}
        locale={locale}
        apiUrl={getApiUrl()}
    />
    {contactMode.kind !== 'none' && (
        <ListingContactBar
            client:idle
            vertical="venue"
            listingId={venue.id}
            locale={locale}
            price={null}
            hasWhatsapp={false}
            primaryLabelKey={
                contactMode.kind === 'menu'
                    ? 'accommodations.detail.listingContact.bar.viewMenu'
                    : 'accommodations.detail.listingContact.bar.contact'
            }
            panelId={contactPanelId}
            fallbackHref={`#${VENUE_CONTACT_ANCHOR_ID}`}
            primaryLink={contactMode.kind === 'menu' ? { href: contactMode.href, channel: 'menu' } : undefined}
        />
    )}
    {contactMode.kind === 'panel' && (
        <ListingChannelsPanel
            client:idle
            panelId={contactPanelId}
            listingId={venue.id}
            vertical="venue"
            locale={locale}
            channels={contactChannels}
            whatsapp={venueWhatsApp ?? null}
            venueName={venue.name}
            signInHref={reviewSignInHref}
        />
    )}
</DetailLayout>

<script>
    import { initContactLinkTracking } from '@/lib/listing-contact/track-contact-links';
    initContactLinkTracking({ document });
</script>

<style>
    @media (max-width: 767px) {
        :global(.wave-header__breadcrumbs:has(.venue-detail-breadcrumbs)) {
            display: none;
        }

        /* The hidden breadcrumbs carried the band's top padding, so without this
           the badges sit flush under the navbar. Expanded state only: the compact
           state sets its own padding-top. */
        :global(.wave-header:not(.wave-header--compact) .wave-header__bar:has(.venue-detail-breadcrumbs) .wave-header__content) {
            padding-top: var(--space-6, 1.5rem);
        }

        /* The full-bleed mobile gallery meets the blue header directly: drop the
           page-background strip DetailLayout leaves above the body. */
        :global(.wave-header .detail-page:has(.venue-detail)) {
            padding-top: 0;
        }
    }

    .venue-detail {
        max-width: var(--container-max, 1350px);
        margin: 0 auto;
        padding: var(--space-6, 24px) var(--space-4, 16px);
        display: flex;
        flex-direction: column;
        gap: var(--space-8, 32px);
    }

    .venue-detail__gallery {
        border-radius: var(--radius-card, 24px);
        overflow: hidden;
    }

    /* The mobile gallery track runs edge to edge (HOS-2532): the layout container
       already pads the page, so the body drops its own inset and the wrapper stops
       clipping the track's negative margin. */
