---
/**
 * @file [page].astro
 * @description Pagination shim for the accommodation listing. Validates the page param, redirects
 * page 1 to the canonical URL and rewrites page N to the listing with `?page=N`.
 * The whole decision lives in `handlePaginationRoute` (HOS-1797).
 */
import { handlePaginationRoute } from '@/lib/listing/listing-pagination';

return handlePaginationRoute({
	astro: Astro,
	basePath: `/${Astro.params.lang}/alojamientos/`,
});
---
