---
/**
 * @file alojamientos/mapa.astro
 * @description Map view of accommodations listing. Full-width Leaflet map
 * with FilterSidebar and toggle to switch back to list view. Pagination is
 * replaced by a cap on displayed pins/cards, independent of filtered totals.
 * @route /{lang}/alojamientos/mapa/
 * @rendering SSR
 */

import ListingLayout from '@/layouts/ListingLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import { breadcrumbLabel } from '@/lib/navigation/breadcrumb-labels';
import ListingPageHeader from '@/components/shared/layout/ListingPageHeader.astro';
import ListingViewToggle from '@/components/shared/layout/ListingViewToggle.astro';
import CompareModeControls from '@/components/shared/compare/CompareModeControls.astro';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import ErrorBanner from '@/components/shared/feedback/ErrorBanner.astro';
import MapPlaceholder from '@/components/MapPlaceholder.astro';
import { AccommodationsListingMap } from '@/components/maps/AccommodationsListingMap.client';
import { FilterSidebar } from '@/components/shared/filters/FilterSidebar.client';
import { destinationsApi, SSR_PUBLIC_CACHE_TTL_MS } from '@/lib/api/endpoints';
import { loadAccommodationMapResults } from '@/lib/accommodation-map-results';
import { fetchAccommodationFilterCatalog } from '@/lib/filters/accommodation-filter-catalog';
import { toAccommodationCardProps } from '@/lib/api/transforms';
import { buildAvailabilityParams } from '@/lib/availability-params';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { buildListingViewHref } from '@/lib/listing-view-href';
import { CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { hasActiveAccommodationListingFilters } from '@/lib/cache/listing-cache';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { EntitlementKeyEnum } from '@repo/schemas';
import { buildAccommodationMapFilters, buildAccommodationMapLabels } from '@/lib/maps/accommodation-map-view-model';
import { getGatePlanNames } from '@/lib/billing/gate-plan-names';

const locale = Astro.locals.locale as SupportedLocale;
// HOS-2554: the compare upsell on the map cards names the catalog plans that carry
// comparison (public, not per-user, so the page stays session-blind).
const compareGatePlanNames = await getGatePlanNames({
	entitlement: EntitlementKeyEnum.CAN_COMPARE_ACCOMMODATIONS
});
const { t, tPlural } = createTranslations(locale);
const priceConsultLabel = t('home.accommodations.price.consult', 'Precio a consultar');
const consultAvailabilityLabel = t(
	'home.accommodations.price.consultAvailability',
	'Consultar disponibilidad'
);
// No visible pagination; cap the initial pins/cards independently of totals.
const MAP_DISPLAY_CAP = 100;

const url = Astro.url;

// HOS-218 — Cloudflare edge cache. The map SSR seeds the initial result set +
// filter sidebar via the same near-static catalog `Promise.all` as the list
// view, and served `cf-cache-status: DYNAMIC` in prod (no `Cache-Control`), so
// anonymous/bot traffic re-ran it on every hit. The map is `noindex` by design,
// but `noindex` is orthogonal to CDN cacheability: emit a shareable
// `Cache-Control` for an anonymous, unfiltered base map (+ bounded sort
// variants) so Cloudflare edge-caches it; personalised or filtered responses
// stay `private`. Gating on the anonymous case keeps favourite-baked HTML out
// of the shared cache. Unlike the base listing (`facetSeoDecision.noindex`) and
// the `/tipo/{slug}/` landing (type fixed by path), the map reads and forwards
// `types` to the API with no per-value guard, so it is excluded explicitly here
// — otherwise `hasActiveAccommodationListingFilters` (which treats `types` as
// non-filtering for the other two pages) would edge-cache arbitrary multi-type
// map combinations.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	cacheable:
		!url.searchParams.has('types') &&
		!hasActiveAccommodationListingFilters({ searchParams: url.searchParams }),
	cacheClass: 'catalog',
	tags: [CACHE_TAG_COLLECTIONS.accommodation]
});

// Extract filter params (same as list view, minus pagination)
const q = url.searchParams.get('q') ?? undefined;
const types = url.searchParams.get('types') ?? undefined;
const destinationIds = url.searchParams.get('destinationIds') ?? undefined;
const minPrice = url.searchParams.get('minPrice') ? Number(url.searchParams.get('minPrice')) : undefined;
const maxPrice = url.searchParams.get('maxPrice') ? Number(url.searchParams.get('maxPrice')) : undefined;
const sortBy = url.searchParams.get('sortBy') ?? undefined;
// SPEC-098 T-052 — `mostSaved` defaults to descending so the most-bookmarked
// accommodations appear first.
const explicitSortOrder = url.searchParams.get('sortOrder') as 'asc' | 'desc' | null;
const sortOrder: 'asc' | 'desc' | undefined =
    explicitSortOrder ?? (sortBy === 'mostSaved' ? 'desc' : undefined);
const isFeatured = url.searchParams.get('isFeatured') === 'true' ? true : undefined;
// `minGuests` is now derived from adults + children (see further down). The
// raw URL param is no longer surfaced as its own filter to keep the UI in
// sync with the list view.
const minBedrooms = url.searchParams.get('minBedrooms') ? Number(url.searchParams.get('minBedrooms')) : undefined;
const minBathrooms = url.searchParams.get('minBathrooms') ? Number(url.searchParams.get('minBathrooms')) : undefined;
const minRating = url.searchParams.get('minRating') ? Number(url.searchParams.get('minRating')) : undefined;
const amenitiesParam = url.searchParams.get('amenities') ?? undefined;
const featuresParam = url.searchParams.get('features') ?? undefined;
// Same default-ON semantics as the list view: absent param = checked. Only
// forward the explicit-OFF case to the API: `true` is the API's default
// (HOS-2017), so the param stays absent when the toggle is at its default-on
// state and the cache key is not split for a no-op.
const includeNoPrice =
    url.searchParams.get('includeNoPrice') === 'false' ? false : undefined;
const includeNoReviews =
    url.searchParams.get('includeNoReviews') === 'false' ? false : undefined;
// Trip-context. The dates are forwarded to the detail link AND used as a
// server-side availability filter (H-120) — both on the initial SSR fetch and
// on every viewport refetch, or panning the map would quietly reinstate the
// unfiltered result set (the BETA-166 failure mode, one filter later).
const checkIn = url.searchParams.get('checkIn') ?? undefined;
const checkOut = url.searchParams.get('checkOut') ?? undefined;
const availabilityParams = buildAvailabilityParams({ checkIn, checkOut });
const adultsParam = url.searchParams.get('adults');
const childrenParam = url.searchParams.get('children');
const adultsContext = adultsParam ? Number(adultsParam) : undefined;
const childrenContext = childrenParam ? Number(childrenParam) : undefined;
// Derived guest-capacity filter — sum of adults + children. See list view
// for the rationale.
// Default 0 = NO guest filter until the visitor picks a party size (BETA-161).
const guestCount = (adultsContext ?? 0) + (childrenContext ?? 0);
const minGuests = guestCount > 0 ? guestCount : undefined;

// Fetch destinations for filter dropdown (CITY only — accommodations are
// browsed by city, not by parent administrative regions).
const destinationsResult = await destinationsApi.list({ destinationType: 'CITY', pageSize: 100, cacheTtlMs: SSR_PUBLIC_CACHE_TTL_MS });
const destinations = destinationsResult.ok ? destinationsResult.data.items : [];

// Fetch amenities + features for filter chips (accommodation-scoped, fully paged — HOS-2057)
const { amenities, features } = await fetchAccommodationFilterCatalog();

// BETA-166 / H-120: SSR and viewport requests share the same filter payload.
const mapExtraSearchParams = {
	q,
	types,
	destinationIds,
	minPrice,
	maxPrice,
	sortBy,
	sortOrder,
	isFeatured,
	minGuests,
	minBedrooms,
	minBathrooms,
	minRating,
	amenities: amenitiesParam,
	features: featuresParam,
	includeAmenities: true,
	includeNoPrice,
	includeNoReviews,
	...availabilityParams,
};

const result = await loadAccommodationMapResults({ filters: mapExtraSearchParams, displayCap: MAP_DISPLAY_CAP });
const hasError = !result.ok;
const { items, locatedCount, unlocatedCount } = result.ok
	? result.data
	: { items: [], locatedCount: 0, unlocatedCount: 0 };

// HOS-369 WB0-5: favourites resolve client-side; keep SSR session-blind.
const locatedCards = items.map((item) => toAccommodationCardProps({ item: item as unknown as Record<string, unknown>, locale }));

const LITORAL_CENTER: [number, number] = [-31.8, -58.5];
const LITORAL_ZOOM = 8;
const firstWithCoords = locatedCards[0];
const mapCenter: [number, number] = firstWithCoords?.approximateLocation
	? [firstWithCoords.approximateLocation.lat, firstWithCoords.approximateLocation.lng]
	: LITORAL_CENTER;
const { filterGroups, sortOptions } = buildAccommodationMapFilters({
	locale, destinations, amenities, features
});

// Build initial filter params for the sidebar
const initialParams: Record<string, string> = {};
if (q) initialParams.q = q;
if (types) initialParams.types = types;
if (destinationIds) initialParams.destinationIds = destinationIds;
if (minPrice !== undefined) initialParams.minPrice = String(minPrice);
if (maxPrice !== undefined) initialParams.maxPrice = String(maxPrice);
if (sortBy) initialParams.sortBy = sortBy;
if (isFeatured) initialParams.isFeatured = 'true';
// `minGuests` is derived (adults + children), not a user-facing filter.
if (minBedrooms !== undefined) initialParams.minBedrooms = String(minBedrooms);
if (minBathrooms !== undefined) initialParams.minBathrooms = String(minBathrooms);
if (minRating !== undefined) initialParams.minRating = String(minRating);
if (amenitiesParam) initialParams.amenities = amenitiesParam;
if (featuresParam) initialParams.features = featuresParam;
// Default-checked include-null toggles: only carry the param when OFF.
if (includeNoPrice === false) initialParams.includeNoPrice = 'false';
if (includeNoReviews === false) initialParams.includeNoReviews = 'false';
if (checkIn) initialParams.checkIn = checkIn;
if (checkOut) initialParams.checkOut = checkOut;
if (adultsContext !== undefined) initialParams.adults = String(adultsContext);
if (childrenContext !== undefined) initialParams.children = String(childrenContext);

// Build the URL pointing back to the list view, preserving every active filter.
const listHref = buildListingViewHref({
	base: buildUrl({ locale, path: 'alojamientos' }),
	searchParams: url.searchParams
}).href;

const { typeLabels, detailHrefById, reviewsLabelById, photosLabelById, priceLabelById, newColors } =
	buildAccommodationMapLabels({ locale, cards: locatedCards });
---

<ListingLayout
	locale={locale}
	title={`${t('accommodations.title', 'Alojamientos')} — ${t('accommodations.viewToggle.map', 'Mapa')}`}
	description={t('accommodations.description', 'Encontrá los mejores alojamientos del Litoral Entrerriano.')}
	showFilters={true}
	filterPosition="left"
	noindex={true}
	totalCount={locatedCount}
	resultKind="accommodations"
><!--
	BETA-22: totalCount/filterSummary render as ListingLayout's
	`.listing-results-summary`, in-flow at the top of the content column
	(above the map). On mobile, a filter-driven navigation triggers
	ListingLayout's scrollIntoView-to-content behavior, which can land the
	summary just above the fold — a known, accepted tradeoff: this is a
	map-view + mobile edge case where the map itself is the primary surface,
	and the summary stays fully visible in the (default) list view. Not
	worth a position:fixed pin here.
-->
	<Breadcrumbs
		slot="breadcrumbs"
		locale={locale}
		jsonLd={false}
		items={[
			{ label: breadcrumbLabel({ t, key: 'accommodations' }), path: 'alojamientos' },
			{ label: breadcrumbLabel({ t, key: 'map' }) },
		]}
	/>

	<ListingPageHeader
		slot="page-header"
		locale={locale}
		tagline={t('accommodations.tagline', 'Encontrá tu lugar ideal')}
		title={t('accommodations.title', 'Alojamientos')}
	/>

	<CompareModeControls slot="page-header" locale={locale} />

	<FilterSidebar
		slot="filters"
		client:load
		locale={locale}
		filters={filterGroups}
		sortOptions={sortOptions}
		initialParams={initialParams}
	/>

	{/* Two sibling expressions on purpose: a `slot` attribute on a child of the
	    bare `<>` shorthand is ignored by Astro, which dumps the dock toggle into
	    the default slot (the page content) instead of the mobile dock. */}
	{!hasError && locatedCount > 0 && (
		<ListingViewToggle slot="dock-start" locale={locale} active="map" listHref={listHref} variant="dock" />
	)}

	{!hasError && locatedCount + unlocatedCount > 0 && (
		<div class="map-view-toggle">
			<ListingViewToggle locale={locale} active="map" listHref={listHref} variant="inline" />
		</div>
	)}

	{hasError && !result.ok && (
		<ErrorBanner locale={locale} error={result.error} entityName="alojamientos" />
	)}

	{unlocatedCount > 0 && <p class="map-unlocated">
		{tPlural('ui.listing.unlocated', unlocatedCount)} · <a href={listHref}>{t('ui.listing.viewList')}</a>
	</p>}

	{!hasError && locatedCount === 0 && (
		<EmptyState
			locale={locale}
			variant="no-results"
			actionUrl={buildUrl({ locale, path: 'alojamientos' })}
		/>
	)}

	{!hasError && locatedCount > 0 && (
		<div class="acc-listing-map" id="acc-listing-map">
			<AccommodationsListingMap
				client:only="react"
				initialItems={locatedCards}
				filteredLocatedCount={locatedCount}
				initialCenter={mapCenter}
				initialZoom={LITORAL_ZOOM}
				ariaLabel={t('maps.ariaLabelAccommodation')}
				extraSearchParams={mapExtraSearchParams}
				typeLabels={typeLabels}
				detailHrefById={detailHrefById}
				reviewsLabelById={reviewsLabelById}
				photosLabelById={photosLabelById}
				priceLabelById={priceLabelById}
				featuredLabel={t('home.accommodations.badge.featured', 'Destacado')}
				newLabel={t('home.accommodations.badge.new', 'Nuevo')}
				newBg={newColors.bg}
				newText={newColors.text}
				priceFromLabel={t('home.accommodations.price.from', 'Desde')}
				pricePerNightLabel={t('home.accommodations.price.perNight', '/noche')}
				priceConsultLabel={priceConsultLabel}
				noPriceCtaLabel={consultAvailabilityLabel}
				ctaLabel={`${t('common.readMore', 'Ver más')} →`}
				amenitiesLabel={t('home.accommodations.amenities.label', 'Amenidades')}
				showSidebar={true}
				locale={locale}
				gatePlanNames={compareGatePlanNames}
				sidebarI18n={{
					resultsHeading: t('maps.sidebar.resultsHeading', 'Resultados en el mapa'),
					resultsCountOne: t('maps.sidebar.resultsCount_one', '{{count}} alojamiento'),
					resultsCountOther: t('maps.sidebar.resultsCount_other', '{{count}} alojamientos'),
					emptyState: t('maps.sidebar.emptyState', 'No hay alojamientos en esta zona.'),
					openSheet: t('maps.sidebar.openSheet', 'Ver tarjetas'),
					openSheetCountOne: t('maps.sidebar.openSheetCount_one', 'Ver {{count}} resultado'),
					openSheetCountOther: t('maps.sidebar.openSheetCount_other', 'Ver {{count}} resultados'),
					openSheetCountShortOne: t('maps.sidebar.openSheetCountShort_one', '{{count}} resultado'),
					openSheetCountShortOther: t('maps.sidebar.openSheetCountShort_other', '{{count}} resultados'),
					closeSheet: t('maps.sidebar.closeSheet', 'Cerrar'),
					loading: t('maps.sidebar.loading', 'Cargando resultados…'),
				}}
				i18nStrings={{
					attribution: t('maps.attribution'),
					approximateDisclaimer: t('maps.approximateDisclaimer'),
					viewDetails: t('maps.viewDetails', 'Ver más'),
					priceConsult: priceConsultLabel,
					consultAvailability: consultAvailabilityLabel,
				}}
			>
				<MapPlaceholder
					slot="fallback"
					locale={locale}
					address={t('maps.region')}
					title={t('maps.loadingTitle')}
				/>
			</AccommodationsListingMap>
		</div>
	)}
</ListingLayout>

<style>
	.map-unlocated {
		color: var(--core-muted-foreground);
		font-size: var(--text-body-sm);
	}
	.map-unlocated a { text-decoration: underline; }
	.map-view-toggle {
		margin: var(--space-4, 16px) 0;
	}

	.acc-listing-map {
		width: 100%;
		min-height: 600px;
		margin: var(--space-4, 16px) 0 var(--space-6, 24px);
	}
	/* Mobile: turn the map into a near-fullscreen pane so the user lands on
	 * a real map view instead of a strip under the header. Height fills the
	 * viewport below the navbar and the compact wave bar; --wave-bar-compact
	 * is published by the auto-scroll script after measuring the bar in its
	 * compact state. The fallback (88px) keeps the layout sane on first
	 * paint before measurement.
	 *
	 * Width breaks out of the parent container padding via the classic
	 * full-bleed trick so the map uses 100% of the viewport width.
	 */
	@media (max-width: 768px) {
		.acc-listing-map {
			/* Default to the wave bar's expected compact height (77px without
			 * the decorative SVG — see the :global(.wave-header__wave) rule
			 * below). Keeping a static value avoids a layout flash between
			 * first paint and the moment the script publishes the measured
			 * value, which left a tile-less gray strip in the map. */
			height: calc(
				100svh - var(--navbar-height, 80px) - var(--wave-bar-compact, 77px) -
				var(--mobile-dock-height) - var(--bottom-safe-inset, 0px)
			);
			min-height: 0;
			margin: 0;
			width: 100vw;
			margin-left: calc(50% - 50vw);
			margin-right: calc(50% - 50vw);
			/* Clip the inner React island's content (disclaimer + warm bg
			 * fringes) to the box so they don't show below the map. */
			overflow: hidden;
		}

		/* Make the React island (astro-island custom element) propagate the
		 * full height down to the .root / leaflet container — without this,
		 * astro-island defaults to display:inline-like behavior and the inner
		 * `.root { height: 100% }` collapses to its content height instead of
		 * filling .acc-listing-map. */
		.acc-listing-map :global(astro-island) {
			display: block;
			width: 100%;
			height: 100%;
		}

		/* Mobile fullscreen map: drop the card chrome. */
		.acc-listing-map :global([class*="root"]) {
			border-radius: 0;
			box-shadow: none;
		}

		/* HOS-84: the decorative wave SVG is gone (Opt-B "band puro"), so the old
		 * `:global(.wave-header__wave) { display: none }` rule for this view is
		 * obsolete and has been removed. The flat band already hands off cleanly
		 * to the map. */
	}
</style>

<script>
	import { setupMobileFullscreenMap } from '@/lib/maps/accommodation-map-fullscreen.client';

	// Fire on first paint (DOMContentLoaded) and on every SPA navigation
	// (astro:page-load). The fullscreen-map setup is idempotent so re-runs
	// are safe — the data attribute and class are no-ops when already set.
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupMobileFullscreenMap, { once: true });
	} else {
		setupMobileFullscreenMap();
	}
	document.addEventListener('astro:page-load', setupMobileFullscreenMap);
</script>
