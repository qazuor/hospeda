---
/**
 * @file publicar/experiencias/index.astro
 * @description The experiences publish page (HOS-1156 T-021) — funnel and
 * create form on one URL.
 *
 * Same shape as `/publicar/gastronomia/`, other vertical: see that page's
 * docblock for what this replaces and why the form left `AccountLayout` (D-2).
 * The two pages share their mould and none of their words (§1).
 *
 * @route     /{lang}/publicar/experiencias/
 * @rendering SSR (prerender = false — reads the session to resolve the form
 *            slot; consequently absent from every cacheable-route list, AC-8).
 */

import { AlertCircleIcon, CalendarIcon, CheckCircleIcon, CompassIcon, EyeIcon, ImageIcon, ReceiptIcon, SettingsIcon } from '@repo/icons';
import { CommerceCreateForm } from '@/components/commerce/CommerceCreateForm.client';
import PublishFormSlot from '@/components/publish/PublishFormSlot.astro';
import PublishHero from '@/components/publish/PublishHero.astro';
import PublishHowItWorks from '@/components/publish/PublishHowItWorks.astro';
import PublishPlanLinks from '@/components/publish/PublishPlanLinks.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { destinationsApi } from '@/lib/api/endpoints';
import { billingApi } from '@/lib/api/endpoints-protected';
import { fetchPublicPlans } from '@/lib/billing/fetch-plans';
import { resolveCommerceLandingOffer } from '@/lib/billing/commerce-landing-plan';
import { shouldShowPublishTrialCallout } from '@/lib/host/publish-trial-callout';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { webLogger as logger } from '@/lib/logger';
import {
    PLANS_PAGE_PATH_BY_VERTICAL,
    PRICING_PAGE_PATH_BY_VERTICAL
} from '@/lib/publish/publish-page-paths';
import { resolvePublishPageSlot } from '@/lib/publish/publish-page-slot';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const VERTICAL = 'experience' as const;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const isAuthenticated = Boolean(Astro.locals.user);
const cookieHeader = Astro.request.headers.get('cookie');

const slot = await resolvePublishPageSlot({
    locale,
    vertical: VERTICAL,
    isAuthenticated,
    cookieHeader,
    pathname: Astro.url.pathname,
    wantsCreate: Astro.url.searchParams.get('create') === '1'
});

/**
 * The trial fields the hero callout/expired-banner read (HOS-1293).
 *
 * See `/publicar/gastronomia/index.astro`'s twin block for the full
 * reasoning — same shape as `/publicar/index.astro`'s own `TrialStatusData`,
 * other vertical.
 */
type TrialStatusData = {
    readonly isOnTrial: boolean;
    readonly isExpired: boolean;
    readonly daysRemaining: number | null;
    readonly startedAt: string | null;
    readonly expiresAt: string | null;
    readonly planSlug: string | null;
};

let trialStatus: TrialStatusData | null = null;

// Lifetime-scoped — see the gastronomy page's identical block for why.
let trialEligible: boolean | null = null;

if (isAuthenticated && cookieHeader) {
    try {
        const [trialResult, eligibilityResult] = await Promise.all([
            billingApi.getTrialStatus({ cookieHeader, productDomain: VERTICAL }),
            billingApi.getTrialEligibility({ cookieHeader })
        ]);
        if (trialResult.ok) {
            trialStatus = trialResult.data;
        }
        if (eligibilityResult.ok) {
            trialEligible = eligibilityResult.data.eligible;
        }
    } catch (error) {
        logger.warn('publicar/experiencias: failed to fetch trial status', { error });
        // Non-fatal: the page renders without a trial callout on this path.
    }
}

const isTrialExpired = trialStatus?.isExpired === true;

// See the gastronomy page's identical block for why this reads the catalogue
// instead of a hardcoded number, and why `null` must render nothing.
const plansResult = await fetchPublicPlans({ domain: VERTICAL });
const { trialDays } = resolveCommerceLandingOffer({ plansResult });

const showTrialCallout =
    trialDays !== null &&
    shouldShowPublishTrialCallout({ isTrialExpired, trialEligibility: trialEligible });
const expiredAtDisplay = trialStatus?.expiresAt ? trialStatus.expiresAt.substring(0, 10) : '';
const expiredPlanSlug = trialStatus?.planSlug ?? '';

// Only fetched when the form is what renders — see the gastronomy page.
const destinationsResult =
    slot.state === 'form'
        ? await destinationsApi.list({ destinationType: 'CITY', pageSize: 100 })
        : null;
const destinations = destinationsResult?.ok
    ? destinationsResult.data.items.map((item) => ({ id: item.id, name: item.name }))
    : [];
const destinationsLoadFailed = destinationsResult !== null && !destinationsResult.ok;

const steps = [
    {
        title: t('publish.experience.steps.step1.title', 'Contá qué ofrecés'),
        desc: t(
            'publish.experience.steps.step1.desc',
            'Nombre, tipo de experiencia y destino. Con eso creamos tu ficha en el momento.'
        )
    },
    {
        title: t('publish.experience.steps.step2.title', 'Completá tu ficha'),
        desc: t(
            'publish.experience.steps.step2.desc',
            'Sumá fotos, punto de encuentro, duración y horarios desde el panel, a tu ritmo.'
        )
    },
    {
        title: t('publish.experience.steps.step3.title', 'Salís publicado'),
        desc: t(
            'publish.experience.steps.step3.desc',
            'Tu experiencia aparece en el catálogo y los viajeros que ya están en la zona te encuentran.'
        )
    }
] as const;

const benefits = [
    {
        Icon: EyeIcon,
        title: t('publish.experience.benefits.item1.title', 'Te ven los que ya viajaron'),
        desc: t(
            'publish.experience.benefits.item1.desc',
            'Quienes reservan alojamiento en el litoral buscan después qué hacer, y ahí es donde aparecés.'
        )
    },
    {
        Icon: SettingsIcon,
        title: t('publish.experience.benefits.item2.title', 'La ficha es tuya'),
        desc: t(
            'publish.experience.benefits.item2.desc',
            'Cambiás fotos, horarios y precios cuando quieras, sin pedirle permiso a nadie.'
        )
    },
    {
        Icon: ReceiptIcon,
        title: t('publish.experience.benefits.item3.title', 'Sin comisión por reserva'),
        desc: t(
            'publish.experience.benefits.item3.desc',
            'Pagás tu plan y listo. Ninguna reserva ni consulta te suma un cargo aparte.'
        )
    }
] as const;
---

<MarketingLayout
    locale={locale}
    title={t('publish.experience.meta.title', 'Publicá tu experiencia')}
    description={t(
        'publish.experience.meta.description',
        'Cargá tu excursión, paseo o taller en Hospeda y llegá a los viajeros que ya están buscando qué hacer en el litoral.'
    )}
>
    <PublishHero
        tagline={t('publish.experience.hero.tagline', 'Para quienes ofrecen experiencias')}
        title={t('publish.experience.hero.title', 'Publicá tu experiencia y llenala')}
        body={t(
            'publish.experience.hero.body',
            'Empezá acá con lo básico: qué ofrecés, de qué tipo es y desde qué destino salís. Las fotos, el punto de encuentro y los horarios los cargás después, desde tu panel.'
        )}
        Icon={CompassIcon}
        floatingIcons={[ImageIcon, CalendarIcon, CheckCircleIcon]}
    >
        {isTrialExpired ? (
            <div class="publicar-hero__trial-expired" role="alert" aria-live="polite">
                <span class="publicar-hero__trial-expired-icon" aria-hidden="true">
                    <AlertCircleIcon size={20} weight="duotone" />
                </span>
                <div class="publicar-hero__trial-expired-body">
                    <p class="publicar-hero__trial-expired-title">
                        {t('billing.subscription.trial.expiredBanner.title', 'Tu prueba gratuita terminó')}
                    </p>
                    <p class="publicar-hero__trial-expired-text">
                        {t(
                            'billing.subscription.trial.expiredBanner.body',
                            'Tu prueba del plan {{planSlug}} venció el {{expiresAt}}. Suscribite para volver a publicar.',
                            { planSlug: expiredPlanSlug, expiresAt: expiredAtDisplay }
                        )}
                    </p>
                    <a href={slot.subscriptionUrl} class="publicar-hero__trial-expired-cta">
                        {t('billing.subscription.trial.expiredBanner.cta', 'Ver planes')}
                    </a>
                </div>
            </div>
        ) : showTrialCallout && trialDays !== null ? (
            <div class="publicar-hero__trial-callout" role="note">
                <span class="publicar-hero__trial-callout-icon" aria-hidden="true">✨</span>
                <p class="publicar-hero__trial-callout-text">
                    {tPlural('publish.experience.trialCallout', trialDays, { trialDays })}
                </p>
            </div>
        ) : null}
    </PublishHero>

    <PublishFormSlot locale={locale} vertical={VERTICAL} resolution={slot}>
        <CommerceCreateForm
            client:load
            vertical={VERTICAL}
            locale={locale}
            destinations={destinations}
            destinationsLoadFailed={destinationsLoadFailed}
        />
    </PublishFormSlot>

    <PublishHowItWorks
        stepsTagline={t('publish.steps.tagline', 'Es así de fácil')}
        stepsTitle={t('publish.steps.title', '¿Cómo funciona?')}
        steps={steps}
        benefitsTagline={t('publish.benefits.tagline', '¿Por qué Hospeda?')}
        benefitsTitle={t('publish.experience.benefits.title', 'Lo que te llevás')}
        benefits={benefits}
    />

    <PublishPlanLinks
        locale={locale}
        plansUrl={buildUrl({ locale, path: PLANS_PAGE_PATH_BY_VERTICAL[VERTICAL] })}
        pricingUrl={buildUrl({ locale, path: PRICING_PAGE_PATH_BY_VERTICAL[VERTICAL] })}
    />
</MarketingLayout>

<style>
    /* ── Trial callout / expired banner (HOS-1293) — see the gastronomy
       page's identical block for why this cannot be shared via
       `PublishHero.astro` (Astro scopes `<style>` per file). */
    .publicar-hero__trial-callout {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        font-family: var(--font-sans);
        line-height: 1.5;
        margin: var(--space-5) 0 0;
        padding: var(--space-4) var(--space-5);
        background-color: var(--brand-accent-a15);
        border: 1px solid var(--brand-accent-a35);
        border-left: 4px solid var(--brand-accent);
        border-radius: var(--radius-button);
        max-width: 56ch;
    }

    .publicar-hero__trial-callout-icon {
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .publicar-hero__trial-callout-text {
        margin: 0;
        font-size: var(--text-body-md);
        color: var(--brand-accent);
        font-weight: 500;
    }

    .publicar-hero__trial-expired {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        font-family: var(--font-sans);
        line-height: 1.5;
        margin: var(--space-5) 0 0;
        padding: var(--space-4) var(--space-5);
        background-color: var(--core-foreground-a05);
        border: 1px solid var(--core-foreground-a20);
        border-left: 4px solid var(--core-muted-foreground);
        border-radius: var(--radius-button);
        max-width: 56ch;
    }

    .publicar-hero__trial-expired-icon {
        flex-shrink: 0;
        color: var(--core-muted-foreground);
        opacity: 0.8;
        line-height: 1;
        padding-top: 2px;
    }

    .publicar-hero__trial-expired-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .publicar-hero__trial-expired-title {
        margin: 0;
        font-size: var(--text-body-md);
        font-weight: 600;
        color: var(--core-foreground);
    }

    .publicar-hero__trial-expired-text {
        margin: 0;
        font-size: var(--text-body-sm);
        color: var(--core-muted-foreground);
    }

    .publicar-hero__trial-expired-cta {
        display: inline-flex;
        font-size: var(--text-body-sm);
        font-weight: 600;
        color: var(--brand-primary);
        text-decoration: none;
        text-underline-offset: 2px;
        margin-top: var(--space-1);
        transition: color var(--duration-fast) ease;
    }

    .publicar-hero__trial-expired-cta:hover {
        color: var(--brand-accent);
        text-decoration: underline;
    }
</style>
