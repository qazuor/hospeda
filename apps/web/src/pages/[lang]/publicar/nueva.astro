---
/**
 * @file publicar/nueva.astro
 * @description Permanent redirect to `/{lang}/publicar/`, which absorbed this
 * page (HOS-1156 D-6).
 *
 * ## What was here
 *
 * The accommodation create form, plus BETA-197's precheck panel in front of it.
 * Both moved up one level: `/publicar/` used to be the marketing funnel and now
 * carries the funnel AND the form, which is the whole point of this spec — one
 * page per vertical instead of a funnel/form pair per vertical.
 *
 * Nothing was lost in the move. The precheck, its six decisions, the `?create=1`
 * bypass and the fail-open all live in `lib/publish/publish-page-slot.ts` now,
 * shared by all three verticals instead of being spelled out here.
 *
 * @route     /{lang}/publicar/nueva/
 * @rendering SSR (prerender=false) — emits a 301 and no body.
 */

import { buildPricingRedirectTarget } from '@/lib/pricing-redirect';
import { PUBLISH_PAGE_PATH_BY_VERTICAL } from '@/lib/publish/publish-page-paths';

export const prerender = false;

const locale = Astro.locals.locale;

// The query is forwarded like every other moved URL. `?create=1` is the one
// that matters: it is the panel's "crear uno nuevo" action, and dropping it
// would land the owner back on the panel they just answered.
return Astro.redirect(
    buildPricingRedirectTarget({
        locale,
        path: PUBLISH_PAGE_PATH_BY_VERTICAL.accommodation,
        search: Astro.url.search
    }),
    301
);
---
