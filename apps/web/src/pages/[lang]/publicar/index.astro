---
/**
 * @file publicar/index.astro
 * @description The accommodation publish page (HOS-1156 T-019) — the funnel and
 * the create form on one URL.
 *
 * ## What changed, and why each removal was deliberate
 *
 * **The existing-host redirect is gone (D-3).** This page used to fetch the
 * caller's owned-accommodation count and bounce anyone with ≥1 listing to
 * `/mi-cuenta/propiedades/`. That was right while this was a marketing landing
 * and the form lived one click away; with the form HERE it would block a host
 * from creating a second property straight off the navbar. BETA-197's precheck
 * covers the same ground better: it knows whether they have ROOM, not merely
 * whether they have listings, and it offers to resume a draft instead of
 * dropping them on a list. The fetch went with the redirect (R-3): the precheck
 * already returns `currentCount`, so keeping it would have been a third SSR
 * round trip answering a question nobody asks any more.
 *
 * **`HostLandingCta` is gone.** Its whole job was to decide whether to send you
 * to `/publicar/nueva/` or to sign-in. Both destinations are now this page.
 *
 * **The FAQ and the closing CTA banner are gone.** §6 fixes the shape at four
 * sections — hero, form, cómo funciona, links to `/planes/` — and a closing
 * "publicá tu propiedad" banner under a form that is already on screen is a CTA
 * pointing at itself. The FAQ still renders on `/planes/anfitriones/`, which
 * owns those `owners.faq.*` keys.
 *
 * Marketing prose stays shared with `/planes/anfitriones/` through the
 * `owners.*` keys — deliberate reuse, not duplication (AC-15). Only the first
 * three of its four steps render here; the fourth ("Crecé") is about life after
 * publishing, which is not what this page is asking for.
 *
 * @route     /{lang}/publicar/
 * @rendering SSR (prerender = false — reads the session to resolve the form
 *            slot and the trial callout; consequently absent from every
 *            cacheable-route list, AC-8).
 */

import {
    BuildingsIcon,
    ChatIcon,
    EyeIcon,
    ReceiptIcon,
    SettingsIcon,
    StarIcon,
    TrendingUpIcon
} from '@repo/icons';
import { CreatePropertyMiniForm } from '@/components/host/CreatePropertyMiniForm.client';
import PublishFormSlot from '@/components/publish/PublishFormSlot.astro';
import PublishHero from '@/components/publish/PublishHero.astro';
import PublishHowItWorks from '@/components/publish/PublishHowItWorks.astro';
import PublishPlanLinks from '@/components/publish/PublishPlanLinks.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { resolveGenericOwnerTrialDays } from '@/lib/billing/generic-trial-days';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { webLogger as logger } from '@/lib/logger';
import {
    PLANS_PAGE_PATH_BY_VERTICAL,
    PRICING_PAGE_PATH_BY_VERTICAL
} from '@/lib/publish/publish-page-paths';
import { publishApi } from '@/lib/api/endpoints-protected';
import { shouldShowPublishTrialCallout } from '@/lib/host/publish-trial-callout';
import { resolvePublishPageSlot } from '@/lib/publish/publish-page-slot';
import { buildUrl } from '@/lib/urls';

export const prerender = false;

const VERTICAL = 'accommodation' as const;

const locale = Astro.locals.locale as SupportedLocale;
const { t, tPlural } = createTranslations(locale);

const isAuthenticated = Boolean(Astro.locals.user);
const cookieHeader = Astro.request.headers.get('cookie');

const slot = await resolvePublishPageSlot({
    locale,
    vertical: VERTICAL,
    isAuthenticated,
    cookieHeader,
    pathname: Astro.url.pathname,
    wantsCreate: Astro.url.searchParams.get('create') === '1'
});

// The expired-trial banner this page used to render read the visitor's trial
// from the old billing (`GET /protected/billing/trial/status`), a route the API
// no longer registers. It was removed with the old billing client (HOS-1637,
// AC:B13a:21); the leaf that rewrites subscribe → publish (V8a) brings the
// trial state back on the new billing, so nothing here reports an expired
// trial.

// HOS-1183 F-6: whether publishing would actually grant this owner a trial.
// `null` = unresolved (signed out, or the read failed) — see
// `shouldShowPublishTrialCallout` for what that means.
let trialEligibility: boolean | null = null;

if (isAuthenticated && cookieHeader) {
    try {
        const eligibility = await publishApi.accommodationEligibility({ cookieHeader });
        if (eligibility.ok) {
            trialEligibility = eligibility.data.startsTrial;
        }
    } catch (error) {
        logger.warn('publicar/index: failed to fetch publish eligibility', { error });
        // Non-fatal: the default trial callout renders.
    }
}

// HOS-1183 F-6. The decision lives in a pure helper, not here — see its
// docblock for why `isExpired` alone was the wrong question.
const showTrialCallout = shouldShowPublishTrialCallout({ isTrialExpired: false, trialEligibility });

// H-98: read the trial length from the live billing plans, never from a
// constant, so the number in the callout cannot drift from what checkout grants.
// Resolved ONCE and used twice — the hero callout and the form island — because
// the two used to live on separate pages and fetched it separately.
const genericTrialDays = await resolveGenericOwnerTrialDays();

// Public env var; safe to hand to a client island.
const apiUrl = import.meta.env.PUBLIC_API_URL as string;

const steps = [
    {
        title: t('owners.steps.1.title'),
        desc: t('owners.steps.1.desc')
    },
    {
        title: t('owners.steps.2.title'),
        desc: t('owners.steps.2.desc')
    },
    {
        title: t('owners.steps.3.title'),
        desc: t('owners.steps.3.desc')
    }
] as const;

const benefits = [
    { Icon: EyeIcon, title: t('owners.benefits.1.title'), desc: t('owners.benefits.1.desc') },
    {
        Icon: SettingsIcon,
        title: t('owners.benefits.2.title'),
        desc: t('owners.benefits.2.desc')
    },
    { Icon: ReceiptIcon, title: t('owners.benefits.3.title'), desc: t('owners.benefits.3.desc') }
] as const;
---

<MarketingLayout
    locale={locale}
    title={t('host.landing.heroHeadline', 'Convertí tu propiedad en un ingreso')}
    description={t('owners.description')}
>
    <PublishHero
        tagline={t('owners.hero.tagline')}
        title={t('host.landing.heroHeadline', 'Convertí tu propiedad en un ingreso')}
        body={t(
            'host.landing.heroSubheadline',
            'Publicá en minutos y empezá a recibir huéspedes'
        )}
        Icon={BuildingsIcon}
        floatingIcons={[TrendingUpIcon, ChatIcon, StarIcon]}
    >
        {showTrialCallout ? (
            <div class="publicar-hero__trial-callout" role="note">
                <span class="publicar-hero__trial-callout-icon" aria-hidden="true">✨</span>
                <p class="publicar-hero__trial-callout-text">
                    {tPlural('host.landing.trialCallout', genericTrialDays, { trialDays: genericTrialDays })}
                </p>
            </div>
        ) : null}
    </PublishHero>

    <PublishFormSlot locale={locale} vertical={VERTICAL} resolution={slot}>
        <CreatePropertyMiniForm
            client:load
            locale={locale}
            apiUrl={apiUrl}
            trialDays={genericTrialDays}
        />
    </PublishFormSlot>

    <PublishHowItWorks
        stepsTagline={t('owners.steps.tagline')}
        stepsTitle={t('owners.steps.title')}
        steps={steps}
        benefitsTagline={t('owners.benefits.tagline')}
        benefitsTitle={t('owners.benefits.title')}
        benefits={benefits}
    />

    <PublishPlanLinks
        locale={locale}
        plansUrl={buildUrl({ locale, path: PLANS_PAGE_PATH_BY_VERTICAL[VERTICAL] })}
        pricingUrl={buildUrl({ locale, path: PRICING_PAGE_PATH_BY_VERTICAL[VERTICAL] })}
    />
</MarketingLayout>

<style>
    /* ── Trial callout (F1-UI) ─────────────────────────────────────────────
       Rendered into the hero's slot, so this block is the only style this
       page still owns; everything else lives in the shared sections. */
    .publicar-hero__trial-callout {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        font-family: var(--font-sans);
        line-height: 1.5;
        margin: var(--space-5) 0 0;
        padding: var(--space-4) var(--space-5);
        background-color: var(--brand-accent-a15);
        border: 1px solid var(--brand-accent-a35);
        border-left: 4px solid var(--brand-accent);
        border-radius: var(--radius-button);
        max-width: 56ch;
    }

    .publicar-hero__trial-callout-icon {
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .publicar-hero__trial-callout-text {
        margin: 0;
        font-size: var(--text-body-md);
        color: var(--brand-accent);
        font-weight: 500;
    }

</style>
