---
/**
 * @file eventos/en/[slug]/index.astro
 * @description Events at a specific venue/location.
 * @route /{lang}/eventos/en/{slug}/
 * @rendering SSR + Cloudflare edge cache — `public, s-maxage=300,
 *   stale-while-revalidate=600`, purged by cache tag. Eligibility is decided
 *   per request by the `applyCacheHeaders` call below, not by this comment.
 */
import ListingLayout from '@/layouts/ListingLayout.astro';
import Breadcrumbs from '@/components/shared/navigation/Breadcrumbs.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import ListingPageHeader from '@/components/shared/layout/ListingPageHeader.astro';
import EventCardHorizontal from '@/components/shared/cards/EventCardHorizontal.astro';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import ErrorBanner from '@/components/shared/feedback/ErrorBanner.astro';
import Pagination from '@/components/shared/feedback/Pagination.astro';
import { eventsApi, eventLocationsApi } from '@/lib/api/endpoints';
import { toEventCardProps } from '@/lib/api/transforms';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

import { CACHE_TAG_COLLECTIONS } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';
import { hasOnlyPaginationParams } from '@/lib/cache/listing-cache';
const locale = Astro.locals.locale as SupportedLocale;
const { t } = createTranslations(locale);
const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

// Resolve location slug to ID
const locResult = await eventLocationsApi.getBySlug({ slug });
if (!locResult.ok) return new Response(null, { status: 404 });
const locData = locResult.data as Record<string, unknown>;
const locationId = String(locData.id || '');
const locationName = String(locData.name || slug);

// --- Edge cacheability (HOS-369 W2-3) ---
// After the two 404 guards, so an error response is never marked shareable.
//
// Tagged `list-event` only. The event LOCATION this page is keyed on has no tag
// of its own — `eventLocation` is absent from the vocabulary and from
// `entity-tag-mapper.ts` — so renaming a location does not purge this page; it
// goes stale for at most the 300s TTL. Event writes, which are what actually
// changes the list below, do purge it.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	// `/…/page/N/` rewrites into this route with `?page=N`.
	cacheable: hasOnlyPaginationParams({ searchParams: Astro.url.searchParams }),
	tags: [CACHE_TAG_COLLECTIONS.event]
});

// NOTE: eventsApi has no getByLocation method. The closest available filter is
// destinationId (resolves via event_locations.destination_id server-side). When
// the location has a destinationId we scope events to that destination; without
// one we cannot scope to this location, so we render an empty result rather than
// the unfiltered platform-wide list (which would be misleading on an
// "Eventos en <location>" page). FLAG: a true "by-location" filter would require
// a new API endpoint (e.g. GET /events?locationId=...).
const locationDestinationId = locData.destinationId ? String(locData.destinationId) : undefined;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const result = locationDestinationId
	? await eventsApi.list({ destinationId: locationDestinationId, page, pageSize: 9 })
	: null;
const hasError = result !== null && !result.ok;
const items = result?.ok ? result.data.items : [];
const total = result?.ok ? result.data.pagination.total : 0;
const totalPages = result?.ok ? result.data.pagination.totalPages : 0;
const cards = items.map((item: (typeof items)[number]) => toEventCardProps({ item: item as unknown as Record<string, unknown>, locale }));
const baseUrl = buildUrl({ locale, path: `eventos/en/${slug}` });

// --- Breadcrumb JSON-LD ---
// Mirrors the visible trail below PLUS the current page: the visible component
// drops the leaf (it is already the H1), but BreadcrumbList must stay complete.
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const breadcrumbItems = [
	{ name: t('nav.home', 'Inicio'), url: `${siteOrigin}${buildUrl({ locale, path: '' })}` },
	{ name: t('events.title', 'Eventos'), url: `${siteOrigin}${buildUrl({ locale, path: 'eventos' })}` },
	{ name: locationName, url: `${siteOrigin}${Astro.url.pathname}` }
];
---

<ListingLayout locale={locale} title={`${locationName} - ${t('events.title', 'Eventos')}`} showFilters={false} totalCount={total}>
	<BreadcrumbJsonLd slot="head-extra" items={breadcrumbItems} />
	<Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: t('events.title', 'Eventos'), path: 'eventos' }, { label: locationName }]} />
	<ListingPageHeader slot="page-header" locale={locale} tagline={t('events.byLocation.tagline', 'Lugar')} title={locationName} />
	{hasError && result && !result.ok && <ErrorBanner locale={locale} error={result.error} entityName="eventos" />}
	{!hasError && cards.length === 0 && <EmptyState locale={locale} variant="no-results" actionUrl={buildUrl({ locale, path: 'eventos' })} />}
	{!hasError && cards.length > 0 && (
		<div class="grid">{cards.map((card, i) => (<div data-reveal="up" data-stagger-index={Math.min(i, 6)} data-stagger-step="100"><EventCardHorizontal data={card} locale={locale} /></div>))}</div>
	)}
	{totalPages > 1 && <Pagination slot="pagination" currentPage={page} totalPages={totalPages} baseUrl={baseUrl.slice(0, -1)} locale={locale} />}
</ListingLayout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
		gap: var(--space-card-gap);
	}
</style>
