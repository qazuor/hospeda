---
/**
 * @file presentacion/experiencias/index.astro
 * @description Commercial presentation for experience providers (HOS-978). A verbatim
 * migration of the owner-approved artifact "Presentación Experiencias"; the copy and the
 * stylesheet below are the artifact's own and must not be rewritten here —
 * the artifact is the source of truth for both.
 *
 * WHY IT IS NOT THE PUBLIC LANDING (/publicar-experiencia/). That landing sells and is
 * optimized to rank. This page is what the owner sends personally to one
 * prospect over WhatsApp, or dictates by phone, and it carries things a public
 * landing must not: negotiable pricing, comparisons against competitors, and
 * operational detail. That is why `noindex, nofollow` is a requirement here
 * rather than a precaution, and why the page is excluded from the sitemap (see
 * `lib/seo-config.ts` → SITEMAP_EXCLUDED_PATHS, which also drives the
 * robots.txt `Disallow`).
 *
 * WHY IT IS NOT TRANSLATED. The audience is local (owner decision, HOS-978).
 * The page lives under `[lang]/` anyway so the short, dictable URL works:
 * `hospeda.com.ar/presentacion/experiencias` is 301-redirected to
 * `/es/presentacion/experiencias/` by the middleware's locale step, so no middleware
 * exemption was needed. It therefore serves the same Spanish copy under
 * `/en/` and `/pt/` BY DESIGN — unlike HOS-908, where that was a defect.
 *
 * WHY `StandaloneLayout`. The page owns 100% of its chrome, exactly like the
 * `/funcionalidades/` brochure (HOS-119) it follows. No Header, no Footer, no
 * site nav — it must look like the artifact it came from.
 *
 * WHY THE STYLESHEET IS A PLAIN `<style>` BLOCK. Astro extracts it to a real
 * stylesheet. An `is:inline` block would be dropped in production: the CSP
 * omits `'unsafe-inline'` from `style-src` outside dev (see
 * `lib/middleware-helpers.ts`), so the page would render unstyled in prod
 * while looking perfect locally. Do not add `is:inline` here.
 *
 * @route /{lang}/presentacion/experiencias/
 * @rendering SSR + Cloudflare cache (matches funcionalidades/nosotros)
 */

import StandaloneLayout from '@/layouts/StandaloneLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import PresentationThemeToggle from '@/components/presentacion/PresentationThemeToggle.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { getSiteUrl } from '@/lib/env';

import { CACHE_TAG_SITE_CONFIG } from '@repo/cache-tags';
import { applyCacheHeaders } from '@/lib/cache/response-cache';

const locale = Astro.locals.locale as SupportedLocale;

// --- Edge cacheability (HOS-369 W2-2) ---
// No session and no API call: the content is hardcoded copy, so it only
// changes on deploy. Same class and tag as the `/funcionalidades/` brochure.
applyCacheHeaders({
	locals: Astro.locals,
	headers: Astro.response.headers,
	cacheable: true,
	cacheClass: 'static',
	tags: [CACHE_TAG_SITE_CONFIG]
});

const canonical = `${getSiteUrl().replace(/\/$/, '')}/${locale}/presentacion/experiencias/`;
---

<StandaloneLayout locale={locale}>
	<SEOHead
		slot="head"
		title="Presentación Experiencias"
		description="Publicá lo que hacés hacer. Kayak, cabalgatas, pesca, avistaje de aves, visitas guiadas, termas y talleres: el que reserva alojamiento en el Litoral entra a Hospeda a decidir qué va a hacer."
		canonical={canonical}
		locale={locale}
		noindex
		nofollow
	/>
	<link
		slot="head"
		rel="stylesheet"
		href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Source+Sans+3:wght@400;600&display=swap"
	/>

<PresentationThemeToggle />

<div class="wrap">

  <header class="masthead">
    <p class="eyebrow">Hospeda &middot; Experiencias</p>
    <h1>Publicá lo que hacés hacer</h1>
    <div class="rule"></div>
    <p class="masthead__lede">
      Kayak, cabalgatas, pesca, avistaje de aves, visitas guiadas, paseos en lancha, termas,
      talleres. El que reserva alojamiento en el Litoral entra a Hospeda a decidir
      <strong>qué va a hacer los días que se queda</strong>. Ahí es donde conviene que estés.
    </p>
    <div class="factsheet">
      <div class="fact">
        <span class="fact__k">Comisión</span>
        <span class="fact__v fact__v--free">Ninguna</span>
      </div>
      <div class="fact">
        <span class="fact__k">Prueba</span>
        <span class="fact__v">30 días</span>
      </div>
      <div class="fact">
        <span class="fact__k">Cómo se entra</span>
        <span class="fact__v">Solo, en el momento</span>
      </div>
    </div>
  </header>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Lo primero, sin vueltas</p>
      <h2>Acá no se vende el cupo</h2>
    </div>
    <div class="notice">
      <h3>Nadie te compra la salida desde el sitio.</h3>
      <p>
        No hay carrito, no hay pago del turista, no manejamos tu cupo ni tu agenda, y
        <strong>no nos llevamos un porcentaje</strong>. El que se interesa te llama, te escribe
        o te manda un correo, y el precio, la seña y el día los arreglás vos.
      </p>
      <p>
        Lo que hacés es <strong>publicar tu experiencia</strong> con fotos, descripción y precio
        de referencia, en el lugar donde el visitante está armando el viaje. Se paga una cuota
        fija por mes.
      </p>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Paso a paso</p>
      <h2>Cómo publicás</h2>
    </div>
    <ol class="steps">
      <li>
        <span class="num">01</span>
        <div class="step__body">
          <h3>Creás tu cuenta y cargás la experiencia</h3>
          <p>
            Sin esperar que te aprueben ni que te llamen: entrás, te registrás y la cargás vos
            mismo, en el momento.
          </p>
          <p class="step__meta">Gratis &middot; No se pide tarjeta &middot; Se hace desde el celular</p>
        </div>
      </li>
      <li>
        <span class="num">02</span>
        <div class="step__body">
          <h3>La completás con tiempo</h3>
          <p>
            Queda guardada sin que nadie la vea. Vas cargando las fotos, la descripción larga, el
            precio de referencia, tus datos de contacto y las preguntas frecuentes.
          </p>
          <p class="step__meta">Para publicar hacen falta: nombre, resumen, descripción, ciudad, tipo, foto principal, un contacto y el precio (o marcarlo "a consultar")</p>
        </div>
      </li>
      <li>
        <span class="num">03</span>
        <div class="step__body">
          <h3>Le das publicar</h3>
          <p>
            Ahí elegís el plan y cargás la tarjeta, y arrancan los <strong>30 días de prueba</strong>.
            Tu experiencia sale al aire en ese momento. Si dentro del mes decidís que no, cancelás
            y no se te cobra nada.
          </p>
          <p class="step__meta">Se paga con Mercado Pago &middot; El primer cobro es al día 31</p>
        </div>
      </li>
    </ol>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Atención con esto</p>
      <h2>Cargá un teléfono o un correo, no sólo el WhatsApp</h2>
    </div>
    <p>
      Es el error más fácil de cometer y el más caro. En la ficha de la experiencia
      <strong>se muestran el teléfono, el celular, el correo de trabajo y tu sitio web</strong>.
      El WhatsApp <strong>no</strong> se muestra ahí.
    </p>
    <p>
      El sistema te va a dejar publicar aunque hayas cargado sólo el WhatsApp — y tu ficha va a
      salir <strong>sin ningún dato de contacto a la vista</strong>. Cargá siempre un teléfono o
      un correo además, y te ahorrás la peor versión de este problema: estar publicado y que
      nadie tenga cómo llamarte.
    </p>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">El costo</p>
      <h2>Una cuota fija por mes</h2>
    </div>
    <p>
      <strong>Está en el orden de los quince mil pesos mensuales</strong>: lo que sale una o dos
      plazas de una salida. Es lo mismo si te contactan dos personas o cincuenta — no hay
      comisión ni cargo por consulta. El valor exacto está siempre publicado en el sitio.
    </p>
    <p class="subhead">Con eso tenés <strong>una experiencia publicada</strong>.</p>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Tu ficha</p>
      <h2>Qué podés mostrar</h2>
    </div>
    <ul class="plain">
      <li><span class="tick">&check;</span><span>Fotos y videos, con una foto principal destacada.</span></li>
      <li><span class="tick">&check;</span><span>Descripción con formato: qué incluye, qué llevar, cuánto dura, desde qué edad.</span></li>
      <li><span class="tick">&check;</span><span><strong>Precio de referencia</strong> — "desde tanto, por persona" — o directamente <strong>"a consultar"</strong> si preferís no publicarlo.</span></li>
      <li><span class="tick">&check;</span><span>Horarios, si trabajás con horarios fijos. No es obligatorio.</span></li>
      <li><span class="tick">&check;</span><span>Teléfono, correo, sitio web y redes.</span></li>
      <li><span class="tick">&check;</span><span><strong>Preguntas frecuentes propias</strong>: si se suspende por lluvia, si hace falta saber nadar, si van chicos, si se puede pagar en el momento.</span></li>
      <li><span class="tick">&check;</span><span>Tu ficha en español, inglés y portugués.</span></li>
    </ul>
    <p class="subhead">
      Vive en <strong>hospeda.com.ar/es/experiencias/tu-experiencia</strong>, aparece en el
      listado con buscador y filtros por ciudad y tipo, entra en el mapa del sitio y está
      preparada para que Google la muestre como atracción turística de la zona.
    </p>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Quién manda sobre qué</p>
      <h2>Lo que cambiás solo y lo que no</h2>
    </div>
    <div class="tablewrap">
      <table>
        <thead>
          <tr><th scope="col">Dato</th><th scope="col">Quién lo cambia</th></tr>
        </thead>
        <tbody>
          <tr><td>Nombre, descripción, fotos, precio, horarios, contacto y redes</td><td><strong>Vos, cuando quieras</strong></td></tr>
          <tr><td>Tus preguntas frecuentes</td><td><strong>Vos</strong></td></tr>
          <tr><td>La dirección web de tu ficha y si aparece destacada</td><td>El equipo</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Reseñas</p>
      <h2>Cómo funcionan</h2>
    </div>
    <ul class="plain">
      <li><span class="tick">&check;</span><span>Las deja cualquier persona con cuenta en Hospeda. Una por persona.</span></li>
      <li><span class="tick">&check;</span><span><strong>Ninguna se publica sola:</strong> las revisamos antes de que aparezcan.</span></li>
      <li><span class="tick tick--no">&times;</span><span><strong>Todavía no podés responder una reseña.</strong> Si aparece una que te parece injusta, escribinos y la miramos.</span></li>
    </ul>
  </section>

  <section>
    <div class="sec-head">
      <p class="eyebrow">Para ser justos</p>
      <h2>Lo que conviene que sepas antes</h2>
    </div>
    <ul class="plain">
      <li><span class="tick tick--no">!</span><span><strong>Todavía no hay estadísticas.</strong> No vas a ver cuánta gente miró tu ficha. Está en la lista, pero hoy no existe.</span></li>
      <li><span class="tick tick--no">!</span><span><strong>La tarjeta se pide para publicar</strong>, antes de los 30 días de prueba. Registrarte y armar la ficha no cuesta nada.</span></li>
      <li><span class="tick tick--no">!</span><span>Si dejás de pagar, tu ficha <strong>deja de verse pero no se borra</strong>: vuelve a estar en línea cuando reactivás, con todo lo que tenía.</span></li>
      <li><span class="tick tick--no">!</span><span>Una ficha sin foto principal o sin contacto <strong>no se puede publicar</strong>.</span></li>
    </ul>
  </section>

  <footer class="close">
    <h2>Probalo</h2>
    <p>
      Cargar la experiencia es gratis y no te compromete. Recién decidís cuando la querés
      publicar, y aun ahí tenés 30 días para arrepentirte sin que se te cobre un peso.
    </p>
    <a class="cta" href="https://hospeda.com.ar/es/publicar-experiencia">hospeda.com.ar/es/publicar-experiencia</a>
    <div class="phone">
      <span class="fact__k">¿Preferís que te acompañemos?</span>
      <strong>Llamanos o escribinos por WhatsApp al 3442 453797</strong>
      <span class="finelines">Te ayudamos a cargar la ficha la primera vez, si querés.</span>
    </div>
    <div class="finelines">
      Hospeda cobra una suscripción por tener la ficha publicada, nunca un porcentaje de lo que
      cobrás, y no interviene entre el visitante y vos: el cupo, la seña y el pago se arreglan
      directo entre ustedes. Los valores y las condiciones son los vigentes al día de hoy y pueden
      cambiar; los del momento están siempre publicados en el sitio.
    </div>
  </footer>

</div>

</StandaloneLayout>

<style>
  /* HOS-978 — celeste, verde y naranja, y nada mas (owner decision).
     Light mode is built for vividness: every accent sits at the highest chroma
     that still clears 4.5:1 against the page ground, since `--accent` is BOTH
     link/heading text and the CTA background. Dark mode moves the table header
     (`--surface-2`) and the CTA (`--accent`) out of the brown/pink family they
     inherited from the artifact.

     The three-block shape is deliberate. The switch in
     `PresentationThemeToggle.astro` writes an explicit `data-theme="light"`,
     and the `:not([data-theme="light"])` below is exactly what that
     neutralises — collapsing these blocks would let a phone in dark mode
     override the light default again. */
  :root{
    --ground:#F7FBFE;
    --surface:#FFFFFF;
    --surface-2:#E7F3FB;
    --ink:#0E1B24;
    --ink-soft:#2B3F4E;
    --muted:#4E6473;
    --line:#D5E7F2;
    --line-strong:#B2CFE2;
    --accent:#1479B0;
    --accent-soft:#C7E6FD;
    --on-accent:#FFFFFF;
    --cta-bg:#0CC1FD;
    --cta-ink:#052B3D;
    --warm:#A56217;
    --warm-soft:#FFE8D4;
    --good:#128537;
    --good-soft:#DAFDDD;
    --stop:#C54A05;
    --stop-soft:#FDD8CA;
    --shadow:0 1px 2px rgba(12,22,32,.06), 0 8px 24px -16px rgba(12,22,32,.30);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
    --ground:#0C1620;
    --surface:#132231;
    --surface-2:#182B3D;
    --ink:#E9F2F9;
    --ink-soft:#C6D8E6;
    --muted:#9DB4C6;
    --line:#22364A;
    --line-strong:#37506A;
    --accent:#19AFFE;
    --accent-soft:#08273A;
    --on-accent:#0C1620;
    --cta-bg:#19AFFE;
    --cta-ink:#0C1620;
    --warm:#FF971E;
    --warm-soft:#381C00;
    --good:#79F791;
    --good-soft:#042D0E;
    --stop:#FE773D;
    --stop-soft:#3F1604;
    --shadow:0 1px 2px rgba(0,0,0,.45), 0 8px 24px -16px rgba(0,0,0,.75);
    }
  }
  :root[data-theme="dark"]{
    --ground:#0C1620;
    --surface:#132231;
    --surface-2:#182B3D;
    --ink:#E9F2F9;
    --ink-soft:#C6D8E6;
    --muted:#9DB4C6;
    --line:#22364A;
    --line-strong:#37506A;
    --accent:#19AFFE;
    --accent-soft:#08273A;
    --on-accent:#0C1620;
    --cta-bg:#19AFFE;
    --cta-ink:#0C1620;
    --warm:#FF971E;
    --warm-soft:#381C00;
    --good:#79F791;
    --good-soft:#042D0E;
    --stop:#FE773D;
    --stop-soft:#3F1604;
    --shadow:0 1px 2px rgba(0,0,0,.45), 0 8px 24px -16px rgba(0,0,0,.75);
  }

  *{box-sizing:border-box}
  body{
    background:var(--ground);
    color:var(--ink);
    font-family:"Source Sans 3", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size:1.1875rem;
    line-height:1.72;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:44rem;margin-inline:auto;padding:0 1.5rem 5rem}
  .eyebrow{
    font-family:"IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size:.8rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;
    color:var(--muted);margin:0;
  }
  h1,h2,h3{font-family:"Archivo", system-ui, -apple-system, sans-serif;text-wrap:balance;margin:0}
  h1{font-size:clamp(2.1rem,6vw,3.1rem);font-weight:800;line-height:1.06;letter-spacing:-.02em}
  h2{font-size:clamp(1.5rem,3.6vw,1.95rem);font-weight:700;line-height:1.2;letter-spacing:-.01em}
  h3{font-size:1.15rem;font-weight:700;line-height:1.35}
  p{margin:0}
  strong{font-weight:600;color:var(--ink)}
  a{color:var(--accent);text-decoration-thickness:1px;text-underline-offset:3px}
  a:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px}

  /* --- Encabezado --- */
  .masthead{padding:3rem 0 1.5rem;display:flex;flex-direction:column;gap:1.25rem}
  .masthead__lede{font-size:1.28rem;line-height:1.6;color:var(--ink-soft);max-width:33em}
  .rule{height:3px;background:var(--ink);width:3.5rem;border-radius:2px}

  .factsheet{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));
    border:1px solid var(--line);border-radius:6px;background:var(--surface);
    overflow:hidden;box-shadow:var(--shadow);margin-top:.75rem;
  }
  .fact{padding:1rem 1.15rem;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:.25rem}
  .fact:last-child{border-right:0}
  .fact__k{
    font-family:"IBM Plex Mono", ui-monospace, monospace;font-size:.78rem;font-weight:600;
    letter-spacing:.06em;text-transform:uppercase;color:var(--muted);line-height:1.4;
  }
  .fact__v{font-family:"Archivo",system-ui,sans-serif;font-weight:700;font-size:1.2rem;line-height:1.25}
  .fact__v--free{color:var(--warm)}

  /* --- Secciones --- */
  section{padding-top:2.5rem;display:flex;flex-direction:column;gap:1rem}
  .sec-head{display:flex;flex-direction:column;gap:.5rem}
  .sec-head .eyebrow{display:flex;align-items:center;gap:.6rem}
  .sec-head .eyebrow::after{content:"";flex:1;height:1px;background:var(--line)}

  /* --- Aviso honesto --- */
  .notice{
    border:1px solid color-mix(in oklab, var(--warm) 45%, transparent);border-left:4px solid var(--warm);
    background:var(--warm-soft);border-radius:0 6px 6px 0;padding:1.2rem 1.4rem;
    display:flex;flex-direction:column;gap:.6rem;
  }
  .notice h3{color:var(--ink)}

  /* --- Listas --- */
  ul.plain{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:.8rem}
  ul.plain li{display:flex;gap:.75rem;align-items:baseline}
  .tick{
    flex:none;font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:.95rem;
    color:var(--good);line-height:1.72;
  }
  .tick--no{color:var(--stop)}

  /* --- Pasos --- */
  ol.steps{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:0}
  ol.steps li{display:grid;grid-template-columns:2.6rem 1fr;gap:1rem;padding:1.2rem 0;border-top:1px solid var(--line)}
  ol.steps li:last-child{border-bottom:1px solid var(--line)}
  .num{
    font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:.92rem;color:var(--accent);
    padding-top:.35rem;letter-spacing:.03em;
  }
  .step__body{display:flex;flex-direction:column;gap:.4rem}
  .step__meta{
    font-family:"IBM Plex Mono",monospace;font-size:.82rem;letter-spacing:.04em;
    line-height:1.5;color:var(--muted);
  }

  /* --- Circuito --- */
  .circuit{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.6rem}
  .node{
    background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:1rem 1.1rem;
    display:flex;flex-direction:column;gap:.4rem;
  }
  .node__who{
    font-family:"IBM Plex Mono",monospace;font-size:.8rem;font-weight:600;letter-spacing:.05em;
    text-transform:uppercase;color:var(--accent);
  }
  .node__what{font-size:1.05rem;line-height:1.5;color:var(--ink-soft)}
  .node--end{background:var(--good-soft);border-color:var(--good)}
  .node--end .node__who{color:var(--good)}

  /* --- Tablas --- */
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--surface)}
  table{border-collapse:collapse;width:100%;font-size:1.05rem}
  th,td{text-align:left;padding:.85rem 1rem;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.55}
  tr:last-child td{border-bottom:0}
  th{
    font-family:"IBM Plex Mono",monospace;font-size:.8rem;font-weight:600;letter-spacing:.05em;
    text-transform:uppercase;color:var(--muted);background:var(--surface-2);white-space:nowrap;
  }
  td.mono{font-family:"IBM Plex Mono",monospace;font-size:.95rem;white-space:nowrap;font-variant-numeric:tabular-nums}
  .subhead{margin-top:.4rem;color:var(--ink-soft)}

  /* --- Chips de rubros --- */
  .chips{display:flex;flex-wrap:wrap;gap:.45rem}
  .chip{
    font-size:.95rem;font-weight:600;
    border:1px solid var(--line-strong);border-radius:999px;padding:.35rem .85rem;color:var(--ink-soft);
    background:var(--surface);
  }

  /* --- Dos columnas --- */
  .split{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1rem}
  .panel{
    border:1px solid var(--line);border-radius:6px;padding:1.2rem 1.35rem;background:var(--surface);
    display:flex;flex-direction:column;gap:.85rem;
  }
  .panel--yes{border-top:3px solid var(--good)}

  /* --- Cierre --- */
  .close{
    margin-top:2.75rem;border-top:3px solid var(--ink);padding-top:1.75rem;
    display:flex;flex-direction:column;gap:1.1rem;
