---
/**
 * @file BaseLayout.astro
 * @description Full HTML shell for all pages. Handles font loading, FOUC prevention,
 * global styles, view transitions (ClientRouter), and page initialization.
 *
 * Renders: SkipToContent > Header > main#main-content > Footer > ScrollToTop
 *
 * Usage:
 * ```astro
 * <BaseLayout locale={locale} title="Page Title" description="Page description">
 *   <slot />
 * </BaseLayout>
 * ```
 */

import type { SupportedLocale } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';
import { getApiUrl, getDeployVersion, getTurnstileSiteKey, isFeedbackEnabled } from '@/lib/env';
import { BRAND_THEME_COLOR, BRAND_THEME_COLOR_DARK } from '@/lib/constants';
import { FEEDBACK_NAV_BOOTSTRAP_SNIPPET } from '@/lib/feedback/feedback-nav-bootstrap.snippet';
import { ClientRouter } from 'astro:transitions';
import Header from './Header.astro';
import Footer from './Footer.astro';
import GlobalAnnouncements from '@/components/GlobalAnnouncements.astro';
import SkipToContent from '@/components/shared/navigation/SkipToContent.astro';
import ScrollToTop from '@/components/shared/navigation/ScrollToTop.astro';
import NavigationProgress from '@/components/shared/navigation/NavigationProgress.astro';
import I18nClientData from '@/components/shared/I18nClientData.astro';
import IconSpriteClientData from '@/components/shared/IconSpriteClientData.astro';
import FontsLoader from '@/components/shared/FontsLoader.astro';
import ThemeFoucScript from '@/components/shared/ThemeFoucScript.astro';
import { CookieConsentBanner } from '@/components/legal/CookieConsentBanner.client';
import PostHogScript from '@/components/analytics/PostHogScript.astro';
import { ToastViewport } from '@/components/ui/ToastViewport.client';
import { GuestPreferenceNudge } from '@/components/shared/preferences/GuestPreferenceNudge.client';
import { AuthedPreferenceSync } from '@/components/shared/preferences/AuthedPreferenceSync.client';
import { FeedbackHeadlessHost } from '@/components/feedback/FeedbackHeadlessHost.client';
import { PaginationLoading } from '@/components/shared/feedback/PaginationLoading.client';
import CriticalStyles from '@/components/shared/CriticalStyles.astro';
// @repo/feedback's package stylesheet and the Hospeda brand-token overrides
// (`@/styles/feedback-overrides.css`) are NOT imported here (HOS-369 W3-5).
// `FeedbackHeadlessHost` hydrates with `client:idle` and cannot be interacted
// with until then, so both stylesheets are attached at runtime from its mount
// effect via `loadFeedbackStyles()` (components/feedback/load-feedback-styles.ts)
// instead of shipping render-blocking in every page's <head>. That loader also
// re-attaches both sheets, IN ORDER, on every `astro:after-swap` — a
// runtime-injected `<link>` is dropped by Astro's head-swap on navigation, and
// this island is `transition:persist`ed so it never remounts to notice. See
// the loader's file header for the full explanation, including why the
// package sheet must attach strictly before the overrides sheet.
// Static stylesheet for the inline CollectionPickerPopover React island.
// Imported here (not as a CSS Module co-located with the island) so the styles
// are bundled into the page's main stylesheet and survive ClientRouter swaps.
// A CSS Module would be dynamically injected by Vite and dropped on head-merge,
// leaving the popover unstyled (full-width block, invisibly off-screen) after
// the user navigates away and back.
import '@/components/shared/favorite/collection-picker-popover.css';

interface Props {
	readonly locale: SupportedLocale;
	readonly title?: string;
	readonly description?: string;
}

const {
	locale,
	title = 'Hospeda',
	description = 'Descubrí alojamientos en el Litoral Entrerriano',
} = Astro.props;

const cookiesPolicyUrl = buildUrl({ locale, path: 'legal/cookies' });

const feedbackEnabled = isFeedbackEnabled();
const apiUrl = getApiUrl();
// SPEC-157 REQ-4: API origin for the <head> preconnect hint (env-derived).
const apiOrigin = new URL(apiUrl).origin;
const deployVersion = getDeployVersion();
const turnstileSiteKey = getTurnstileSiteKey();

/**
 * Hint for client islands (UserMenu, GuestPreferenceNudge) about whether the
 * visitor is authenticated. Only reliable on routes where middleware parses
 * the session (protected, auth, optional-session). On SSG / public routes
 * `Astro.locals.user` is null, so `UserMenu` does its own /auth/me fetch
 * after hydration and updates this attribute as needed.
 */
const isAuthenticatedHint = Astro.locals.user ? 'true' : 'false';
---

<!doctype html>
<html lang={locale} data-user-authenticated={isAuthenticatedHint}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- HOS-369: global.css inlined as critical CSS (see CriticalStyles.astro
		     for why this must be byte-identical across all four layouts). -->
		<CriticalStyles />

		<!--
		  Named slot for scripts that MUST run before ANY other head content:
		  analytics snippets, the feedback nav bootstrap, and cross-origin
		  subresource fetches (fonts, PostHog assets) that would otherwise send a
		  `Referer` header. Rendered first in <head> so an inline script here
		  executes synchronously during parse, before all of the above. Used by the
		  checkout success page (HOS-209) to scrub `preapproval_id` from the URL
		  before it can leak. Empty on every other page.
		-->
		<slot name="head-early" />

		<!--
		  HOS-369 Wave D: the client translation dictionary, as a hashed
		  immutable asset. It MUST live in <head>: a parser-inserted
		  `<script defer>` only runs before the deferred module scripts that
		  hydrate islands if it comes first in document order. From <body> it
		  would sit after the islands rendered above it, and those would
		  hydrate against an empty dictionary.
		-->
		<I18nClientData locale={locale} />

		<!--
		  HOS-369 W3-6: the icon sprite's URL, for islands that render icons
		  after hydration. Inline and classic, so it executes during parse —
		  before any island's deferred hydration module can ask @repo/icons
		  where the sprite lives and be told "nowhere".
		-->
		<IconSpriteClientData />

		<!-- SPEC-157 REQ-18: browser UI chrome matches the brand blue. The light
		     value matches site.webmanifest theme_color; the dark variant keeps the
		     chrome on-brand under prefers-color-scheme: dark (the manifest stays
		     single-valued — only the meta tag can be media-gated). -->
		<meta name="theme-color" content={BRAND_THEME_COLOR} />
		<meta
			name="theme-color"
			content={BRAND_THEME_COLOR_DARK}
			media="(prefers-color-scheme: dark)"
		/>

		<!-- SPEC-157 REQ-4: open the image-CDN and API connections early. Most
		     LCP images are served from Cloudinary; preconnecting shaves the TLS
		     handshake off the critical path. REQ-11: the meta description lives
		     in SEOHead only (was duplicated here, two tags per page). -->
		<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
		<link rel="preconnect" href={apiOrigin} />

		<!-- Favicon -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Google Fonts: Geologica, Roboto, Caveat (non-blocking with preload + swap) -->
		<FontsLoader />

		<ThemeFoucScript />

		<!-- SPEC-157 REQ-10: the full-page opacity:0 font gate was removed.
		     Fonts load with font-display: swap (see FontsLoader), which prevents
		     FOIT without hiding the whole body — the gate only delayed FCP on
		     cold loads. -->


		<ClientRouter />

		{/*
		  Feedback nav-history bootstrap (Opción A). Captures navigation BEFORE
		  the FAB island hydrates with client:idle, persists to sessionStorage
		  so the FAB picks it up on hydration and across full-page reloads.

		  The source MUST come through `set:html` from a constant. Astro treats
		  the children of an `is:inline` script as raw text, so writing the JS
		  directly here (wrapped in a template literal to survive this expression
		  container) emitted the wrapper verbatim and the browser parsed a block
		  statement around a template literal — valid JS, zero effect. The
		  bootstrap silently never ran. See the snippet file's JSDoc.
		*/}
		{feedbackEnabled && (
			<script is:inline set:html={FEEDBACK_NAV_BOOTSTRAP_SNIPPET} />
		)}

		<!--
		  PostHog analytics snippet (SPEC-140).
		  Inline so window.posthog is stubbed before any island hydrates and
		  calls trackEvent(). Renders nothing in dev mode or when the project
		  key is unset (e.g. locally-built previews without the secret).
		-->
		<PostHogScript />

		<!-- Named slot for page-specific head content (SEOHead, JSON-LD, etc.) -->
		<slot name="head" />

		<!--
		  Fallback: when JavaScript is disabled, the IntersectionObserver that
		  reveals [data-reveal] elements never runs, so the entire page below
		  the hero would stay invisible. Force-reveal everything for no-JS users
		  and SEO crawlers that don't execute scripts.
		-->
		<noscript>
			<style>
				[data-reveal] {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>

		<!--
		  Cloudflare Web Analytics (manual snippet).
		  We use the manual setup (NOT the auto-inject) so the tag is part of our
		  own SSR HTML and its CSP story is explicit. It is an EXTERNAL script,
		  so no content hash can cover it (HOS-369 WB0-1 dropped 'strict-dynamic'
		  along with the nonce): https://static.cloudflareinsights.com is
		  allowlisted in `script-src` for exactly this tag. The beacon then POSTs
		  Core Web Vitals telemetry to https://cloudflareinsights.com — a
		  DIFFERENT host, present in `connect-src`. Both live in buildCspHeader;
		  dropping either one kills the beacon silently.

		  Only emitted in production builds: in local dev the beacon's POST to
		  cloudflareinsights.com is rejected by CORS (origin localhost), spamming
		  the console with errors on every page. Staging/prod are real builds
		  (import.meta.env.PROD === true) and still load it.
		-->
		{
			import.meta.env.PROD && (
				<script
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon='{"token": "2dbd11c61c6a461f9b75acf4a0877a83"}'
				/>
			)
		}
	</head>
	<body>
		<NavigationProgress locale={locale} />
		<SkipToContent locale={locale} />
		<Header locale={locale} />
		<GlobalAnnouncements locale={locale} />

		<main id="main-content">
			<slot />
		</main>

		<Footer locale={locale} />
		<ScrollToTop locale={locale} />
		<CookieConsentBanner
			client:idle
			transition:persist="cookie-consent-banner"
			locale={locale}
			cookiesPolicyUrl={cookiesPolicyUrl}
		/>

		<ToastViewport client:idle locale={locale} />
		<GuestPreferenceNudge client:idle />
		<AuthedPreferenceSync client:idle />
		<PaginationLoading client:idle />

		{feedbackEnabled && (
			<FeedbackHeadlessHost
				client:idle
				transition:persist="feedback-host"
				apiUrl={apiUrl}
				deployVersion={deployVersion}
				userId={Astro.locals.user?.id}
				userEmail={Astro.locals.user?.email}
				userName={Astro.locals.user?.name}
				turnstileSiteKey={turnstileSiteKey}
			/>
		)}

		<!-- Page initialization script -->
		<script>
			import { initScrollReveal } from '@/lib/scroll-reveal';
			import { initImageFallback } from '@/scripts/image-fallback';
			import { initStopPropagation } from '@/scripts/dom-helpers';
			import { clearCompareModeIfOutsideSection } from '@/store/compare-store';

			// Initialize delegated handlers once (module-level dedup)
			initImageFallback();
			initStopPropagation();

			function initParallax(): void {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				const elements = document.querySelectorAll<HTMLElement>('[data-parallax-speed]');
				if (elements.length === 0) return;

				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						const el = entry.target as HTMLElement;
						if (entry.isIntersecting) {
							el.dataset.parallaxActive = 'true';
						} else {
							delete el.dataset.parallaxActive;
						}
					}
				}, { rootMargin: '100px' });

				elements.forEach((el) => observer.observe(el));

				let ticking = false;
				window.addEventListener('scroll', () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						for (const el of elements) {
							if (el.dataset.parallaxActive !== 'true') continue;
							const speed = parseFloat(el.dataset.parallaxSpeed || '0.1');
							const rect = el.getBoundingClientRect();
							const offset = (rect.top + rect.height / 2 - window.innerHeight / 2) * speed;
							el.style.transform = `translateY(${offset}px)`;
						}
						ticking = false;
					});
				}, { passive: true });
			}

			async function initPage(): Promise<void> {
				// HOS-85 T-005: compare mode is scoped to /{locale}/alojamientos/*.
				// Runs on every page-load event (initial load AND every
				// ClientRouter-driven navigation) so the flag turns off the
				// instant the user browses outside the accommodation section,
				// regardless of which layout the destination page uses.
				clearCompareModeIfOutsideSection(window.location.pathname);
				initScrollReveal();
				initParallax();
				// Lazy-load GLightbox only when elements with [data-glightbox] exist
				// on the page. The import goes through `@/lib/load-glightbox`, which
				// pulls in the stylesheet too: importing the CSS directly from this
				// inline script put it in the page's stylesheet list, so the 11 KB
				// shipped as a render-blocking <link> on every page despite this
				// guard (HOS-369 W3-5).
				if (document.querySelector('[data-glightbox]')) {
					const { loadGlightbox } = await import('@/lib/load-glightbox');
					const GLightbox = await loadGlightbox();
					GLightbox({
						selector: '[data-glightbox]',
						touchNavigation: true,
						loop: true,
					});
				}
			}

			// Runs on initial page load AND after every client-side navigation
			document.addEventListener('astro:page-load', initPage);

			/*
			 * After paginating to /page/N/ inside a listing, the browser keeps
			 * the previous scroll position by default, which on mobile leaves
			 * the user 500-700px above the first card (header + breadcrumbs +
			 * wave header + type badges + view toggle all stacked on top).
			 * Auto-scroll to the results grid so the new page lands on cards.
			 *
			 * `astro:after-swap` runs after the DOM swap but before the browser
			 * paints, so the scroll appears instant. Page 1 (no /page/ segment)
			 * is intentionally NOT auto-scrolled because users arriving via
			 * direct link or header should see the page header first.
			 */
			document.addEventListener('astro:after-swap', () => {
				if (!location.pathname.includes('/page/')) return;
				const target = document.querySelector<HTMLElement>('.listing-content, .acc-grid');
				if (!target) return;
				const navbarHeight = parseInt(
					getComputedStyle(document.documentElement).getPropertyValue('--navbar-height') || '80',
					10
				);
				const offset = target.getBoundingClientRect().top + window.scrollY - navbarHeight - 16;
				window.scrollTo({ top: Math.max(0, offset), behavior: 'instant' });
			});
		</script>
	</body>
</html>
