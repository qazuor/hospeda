---
/**
 * @file AccountShell.astro
 * @description The new account page frame (HOS-2413 T-020, OD-1/OD-2). An Astro
 * LAYOUT composing React pieces: `BaseLayout` with the account chrome slots (compact
 * header, one-line footer, no dock, account toast region), the `AccountBar` island below 64rem and the
 * `AccountSidebar` from 64rem.
 *
 * It is LANDED OFF: `AccountLayout` only renders it for `shell="account"`, and
 * the default is still `legacy`, so no page changes until the flip PR.
 *
 * The session is read by `AccountLayout`, which hands this layout the already
 * built `navModel`; nothing here reads the request session, so every page that uses
 * it stays session-blind.
 *
 * The content column carries `container-type: inline-size` and
 * `container-name: account-content` (BaseLayout owns `<main id="main-content">`
 * that wraps this whole shell, so the skip link keeps working).
 */

import SEOHead from '@/components/seo/SEOHead.astro';
import { getSiteUrl } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import type { AccountNavModel } from '@/lib/account-nav-model';
import { AccountBar } from '@/components/account/ui/AccountBar';
import { AccountSidebar } from '@/components/account/ui/AccountSidebar';
import { ACCOUNT_NAV_ICONS } from '@/lib/account-nav-icons';
import { buildSidebarView } from '@/components/account/ui/account-sidebar-view';
import {
	type AccountShellTemplate,
	resolveShellTemplate,
} from '@/components/account/ui/account-shell-template';
import { WhatsNewCountPill } from '@/components/shared/whats-new/WhatsNewCountPill.client';
import { BenefitUsagesCountPill } from '@/components/host/host-trades/BenefitUsagesCountPill.client';
import { AccountFooter } from '@/components/account/ui/AccountFooter';
import { AccountToastRegion } from '@/components/account/ui/AccountToastRegion';
import AccountHeader from './AccountHeader.astro';
import BaseLayout from './BaseLayout.astro';
import styles from './AccountShell.module.css';

interface Props {
	readonly locale: SupportedLocale;
	readonly navModel: AccountNavModel;
	readonly title?: string;
	readonly description?: string;
	readonly template?: AccountShellTemplate;
}

const { locale, navModel, title, description, template } = Astro.props;

const { t } = createTranslations(locale);
const canonicalUrl = new URL(Astro.url.pathname, getSiteUrl()).href;
const resolvedTitle = title ?? t('account.title');
const resolvedDescription = description ?? t('account.description');
const resolvedTemplate = resolveShellTemplate({ template });

const view = buildSidebarView({ model: navModel, locale });

---

<BaseLayout locale={locale} title={resolvedTitle} description={resolvedDescription}>
	<AccountHeader slot="chrome-header" locale={locale} />
	<AccountFooter slot="chrome-footer" locale={locale} year={new Date().getFullYear()} />
	<AccountToastRegion slot="chrome-toasts" client:idle locale={locale} />
	<slot name="head-early" slot="head-early" />
	<SEOHead
		slot="head"
		title={resolvedTitle}
		description={resolvedDescription}
		locale={locale}
		canonical={canonicalUrl}
		noindex={true}
	/>

	<div class={styles.shell} data-account-shell>
		<div class={styles.bar}>
			<AccountBar client:media="(max-width: 63.99rem)" view={view} locale={locale} />
		</div>

		<aside class={styles.sidebar}>
			<AccountSidebar view={view} locale={locale} icons={ACCOUNT_NAV_ICONS}>
				<WhatsNewCountPill slot="whatsNewCount" locale={locale} client:idle />
				<BenefitUsagesCountPill slot="benefitUsagesCount" locale={locale} client:idle />
			</AccountSidebar>
		</aside>
		{/* Applies the remembered open/closed nav state BEFORE first paint (HOS-2549), so a
		    remembered-open area does not collapse and expand on every navigation. Static
		    body, so the csp-soft-nav-hashes integration hashes it at build (no nonce, CSP
		    untouched). Keep the storage key in sync with ACCOUNT_NAV_STORAGE_KEY: pinned
		    by test/layouts/account-shell.test.ts. */}
		<script is:inline data-astro-rerun>
			(function () {
				try {
					var raw = localStorage.getItem('hospeda:account-nav:v1');
					if (!raw) return;
					var stored = JSON.parse(raw);
					if (!stored || typeof stored !== 'object' || Array.isArray(stored)) return;
					var groups = document.querySelectorAll('[data-account-sidebar] details[data-nav-group]');
					for (var i = 0; i < groups.length; i++) {
						var d = groups[i];
						var v = stored[d.getAttribute('data-nav-group')];
						if (typeof v === 'boolean' && d.getAttribute('data-contains-active') !== 'true') d.open = v;
					}
				} catch (e) {}
			})();
		</script>

		<div class={styles.content} data-account-content data-template={resolvedTemplate}>
			<slot />
		</div>
	</div>
</BaseLayout>

<script>
	import { applyStoredNavState } from '@/lib/account-nav-collapse';

	/**
	 * Layers the remembered open/closed state of each nav area on top of the
	 * server-rendered `open` defaults (HOS-2124, HOS-2549). Storage access is
	 * wrapped in try/catch inside the helper.
	 */
	document.addEventListener('astro:page-load', () => {
		applyStoredNavState({ root: document, storage: () => localStorage });
	});
</script>
