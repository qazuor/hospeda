---
/**
 * @file ErrorLayout.astro
 * @description Crash-resistant layout for 404 and 500 error pages.
 * Standalone HTML shell with lightweight navigation and no heavy JS.
 * Does NOT extend BaseLayout to avoid complex component trees that could fail.
 */

import { type SupportedLocale, toRegionalLocaleTag } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { BRAND_THEME_COLOR, BRAND_THEME_COLOR_DARK } from '@/lib/constants';
import Logo from '@/components/shared/navigation/Logo.astro';
import I18nClientData from '@/components/shared/I18nClientData.astro';
import IconSpriteClientData from '@/components/shared/IconSpriteClientData.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import FontsLoader from '@/components/shared/FontsLoader.astro';
import ThemeFoucScript from '@/components/shared/ThemeFoucScript.astro';
import { ToastViewport } from '@/components/ui/ToastViewport.client';
import { ClientRouter } from 'astro:transitions';
import CriticalStyles from '@/components/shared/CriticalStyles.astro';
import { buildUrl } from '@/lib/urls';

interface Props {
	readonly locale: SupportedLocale;
	readonly title?: string;
	readonly description?: string;
	/** Adds noindex robots meta tag. Defaults to true for all error pages. */
	readonly noindex?: boolean;
	readonly showSearch?: boolean;
}

const {
	locale,
	title = 'Error',
	description = 'Ha ocurrido un error',
	noindex = true,
	showSearch = false,
} = Astro.props;

const { t } = createTranslations(locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const isAuthenticatedHint = Astro.locals.user ? 'true' : 'false';
const navItems = [
    { label: t('nav.accommodations'), href: buildUrl({ locale, path: 'alojamientos' }) },
    { label: t('nav.destinations'), href: buildUrl({ locale, path: 'destinos' }) },
    { label: t('nav.events'), href: buildUrl({ locale, path: 'eventos' }) },
];
---

<!doctype html>
<html lang={toRegionalLocaleTag({ locale })} data-locale={locale} data-user-authenticated={isAuthenticatedHint}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- HOS-369: global.css inlined as critical CSS (see CriticalStyles.astro
		     for why this must be byte-identical across all four layouts). -->
		<CriticalStyles />

		<!-- HOS-369 Wave D: client translation dictionary (hashed immutable
		     asset): a parser-blocking critical part plus a deferred rest, both in the
		     document head so they precede every island (HOS-2388, HOS-2572) — see
		     I18nClientData.astro. -->
		<I18nClientData locale={locale} />

		<!-- HOS-369 W3-6: the icon sprite's URL, for islands that render icons
		     after hydration. Inline and classic, so it executes during parse —
		     see IconSpriteClientData.astro. -->
		<IconSpriteClientData />

		<!-- SPEC-157 REQ-18: browser UI chrome matches the brand blue, with a
		     dark-mode variant gated by prefers-color-scheme. -->
		<meta name="theme-color" content={BRAND_THEME_COLOR} />
		<meta
			name="theme-color"
			content={BRAND_THEME_COLOR_DARK}
			media="(prefers-color-scheme: dark)"
		/>

		<!-- Favicon -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Google Fonts (non-blocking) -->
		<FontsLoader />

		<ThemeFoucScript />

		<ClientRouter />

		<SEOHead
			title={title}
			description={description}
			locale={locale}
			canonical={canonical}
			noindex={noindex}
		/>

		<style is:inline>
			/* ErrorLayout: body — flex column so the footer sits at the bottom
			   while the main fills the remaining viewport height. Same shape as
			   AuthLayout so status pages render identically across both. */
			body { min-height: 100vh; display: flex; flex-direction: column; background-color: var(--core-background); }

			/* ErrorLayout: header */
			.error-header { background-color: var(--core-background); padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
			.error-header__container, .error-header nav, .error-header form { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; justify-content: center; }
			.error-header__container { max-width: var(--container-max); margin: 0 auto; padding-inline: var(--space-4); }
			.error-header nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--core-foreground); }
			.error-header form input { min-height: 44px; max-width: 100%; border: 1px solid var(--border); border-radius: var(--radius-button); padding-inline: var(--space-3); }

			/* ErrorLayout: content area. Fills the space between header and
			   footer; StatusPage owns its own vertical padding so we align to
			   the top for a consistent content position across pages. */
			.error-content { flex: 1; max-width: var(--container-max, 1350px); width: 100%; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; }

			/* ErrorLayout: footer */
			.error-footer { border-top: 1px solid var(--border); padding: 1.5rem 0; margin-top: auto; }
			.error-footer__container { max-width: var(--container-max, 1350px); margin: 0 auto; padding: 0 1.5rem; text-align: center; }
			.error-footer__copyright { font-family: var(--font-sans); font-size: 0.875rem; color: var(--core-muted-foreground); margin: 0; }
		</style>
	</head>
	<body>
		<header class="error-header">
			<div class="error-header__container">
				<Logo locale={locale} size="md" />
				<nav>
					{navItems.map(({ href, label }) => <a href={href}>{label}</a>)}
				</nav>
				{showSearch && <form action={navItems[0]?.href} method="get" role="search">
					<input type="search" name="q" aria-label={t('error.404.searchAccommodations')} placeholder={t('error.404.searchAccommodations')} />
					<button type="submit" class="btn-gradient btn-gradient--outline-primary btn-gradient--md">{t('common.search')}</button>
				</form>}
			</div>
		</header>

		<!-- Error content -->
		<main id="main-content" class="error-content">
			<slot />
		</main>

		<!-- Minimal footer -->
		<footer class="error-footer">
			<div class="error-footer__container">
				<p class="error-footer__copyright">
					&copy; {new Date().getFullYear()} Hospeda. {t('footer.allRightsReserved')}.
				</p>
			</div>
		</footer>

		<ToastViewport client:idle locale={locale} />
	</body>
</html>
