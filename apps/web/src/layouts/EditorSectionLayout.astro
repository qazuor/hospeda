---
/**
 * @file EditorSectionLayout.astro
 * @description The ACCOMMODATION editor's shell (HOS-318 T-010).
 *
 * Since HOS-1080 this is a thin adapter over `EditorShellLayout.astro`, which
 * carries the geometry, the breadcrumbs and the route nav for every vertical.
 * What is left here is the accommodation-specific vocabulary — its registry, the
 * `propiedades` sidebar entry, and the single `hasTranslations` flag the eleven
 * accommodation pages already pass.
 *
 * Kept as its own file rather than folded into the shell so those eleven routes
 * did not have to grow four registry props each for a refactor that changes
 * nothing about them. `.section` is deliberately never used by the shell: it
 * carries `padding-block: var(--space-section)` (120px), the public-site rhythm,
 * which pushes every account page far down the viewport.
 */

import EditorShellLayout from '@/layouts/EditorShellLayout.astro';
import {
	ACCOMMODATION_EDITOR_REGISTRY,
	buildAccommodationEditorVisibility,
} from '@/lib/editor/accommodation-editor-sections';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
	readonly locale: SupportedLocale;
	readonly accommodationId: string;
	readonly accommodationName: string;
	/** `null` on the hub, where no section is active. */
	readonly currentSectionId: string | null;
	/** `null` on the hub. Drives the last breadcrumb. */
	readonly currentSectionSlug: string | null;
	readonly hasTranslations: boolean;
	readonly title: string;
	readonly description?: string;
	/** Optional subtitle under the page heading. */
	readonly subtitle?: string;
}

const {
	locale,
	accommodationId,
	accommodationName,
	currentSectionId,
	currentSectionSlug,
	hasTranslations,
	title,
	description,
	subtitle,
} = Astro.props;
---

<EditorShellLayout
	locale={locale}
	registry={ACCOMMODATION_EDITOR_REGISTRY}
	entityId={accommodationId}
	entityName={accommodationName}
	currentSectionId={currentSectionId}
	currentSectionSlug={currentSectionSlug}
	visibility={buildAccommodationEditorVisibility({ hasTranslations })}
	accountSection="propiedades"
	title={title}
	description={description}
	subtitle={subtitle}
>
	<slot />
</EditorShellLayout>
