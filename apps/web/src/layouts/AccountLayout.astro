---
/**
 * @file AccountLayout.astro
 * @description Two-panel layout for account pages with persistent sidebar navigation.
 * It reads the session facts the nav needs and renders `AccountShell` (which
 * wraps BaseLayout). Auth is handled by existing middleware. HOS-2508 removed
 * the pre-kit `legacy` frame that HOS-2413 kept as a rollback.
 *
 * Used by: mi-cuenta dashboard, edit profile, favorites, reviews, subscription, preferences.
 *
 * Navigation is rendered from the single-source `ACCOUNT_NAV_GROUPS` config
 * (HOS-131 G-3) via `getNavForSurface({ surface: 'sidebar' })`, gated
 * server-side by effective permissions (see `src/lib/nav-gating.ts`
 * for the evaluator shared with client navigation).
 */

import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import AccountShell from './AccountShell.astro';
import { buildAccountNavModel } from '@/lib/account-nav-model';
import type { AccountShellTemplate } from '@/components/account/ui/account-shell-template';
import { getConfiguredMcpUrl } from '@/lib/mcp-discovery';

interface Props {
	readonly locale: SupportedLocale;
	readonly title?: string;
	readonly description?: string;
	readonly activeSection?: string;
	/** Page template of the account shell (`list`, `form`, `dashboard`, `reading`, `editor`). */
	readonly template?: AccountShellTemplate;
}

const {
	locale,
	title,
	description,
	activeSection = 'mi-cuenta',
	template,
} = Astro.props;

const { t } = createTranslations(locale);

const resolvedTitle = title ?? t('account.title');
const resolvedDescription = description ?? t('account.description');

// Effective permissions decide publisher navigation on every surface.
//
// HOS-2413 T-017: the nav DATA (gating, provider placement, doors, active
// state) lives in `buildAccountNavModel`. The session reads stay here so this
// layout, and every page it wraps, remains session-blind.
const userRoles = Astro.locals.user?.roles ?? null;

/**
 * HOS-2562: the "Asistentes de IA" entry is listed only for a real client (a
 * person with a business vertical, decided by the shared `isRealClient` rule
 * from the EFFECTIVE permissions and the ownership facts) and only while the
 * MCP feature is on. Anybody else gets no entry at all: no hidden copy and no
 * reveal island (the HOS-2430 reveal is gone). The flag comes from a
 * short-lived cached lookup against the API, so it costs no round trip on
 * most requests.
 */
const mcpEnabled = (await getConfiguredMcpUrl()) !== null;
const userPermissions = Astro.locals.user?.permissions ?? [];

/**
 * The provider self-service nav entry ("Mi ficha de proveedor", H-158) is
 * gated by ROW OWNERSHIP, not a permission or role (HOS-278 AC-7). The answer
 * arrives ON THE SESSION, from the same `GET /api/v1/public/auth/me` call the
 * middleware already makes once per protected request. Read as a plain truthy
 * check, NOT "and not revoked": a revoked listing still resolves to a
 * meaningful page, and hiding the door the moment a listing is revoked would
 * strand that provider with no way back besides a typed URL.
 */
const ownsHostTradeListing = Astro.locals.user?.ownsHostTradeListing === true;
/**
 * HOS-2551: unlike the provider flag, `ownsPartner` already excludes a revoked
 * partner (owner decision): the API probe counts live rows only.
 */
const ownsPartner = Astro.locals.user?.ownsPartner === true;

const navModel = buildAccountNavModel({
	roles: userRoles,
	permissions: userPermissions,
	ownsHostTradeListing,
	ownsPartner,
	mcpEnabled,
	activeSection,
});
---

<AccountShell
	locale={locale}
	navModel={navModel}
	mcpEnabled={mcpEnabled}
	title={resolvedTitle}
	description={resolvedDescription}
	template={template}
>
	<slot name="head-early" slot="head-early" />
	<slot />
</AccountShell>
