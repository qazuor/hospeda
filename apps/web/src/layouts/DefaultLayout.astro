---
/**
 * @file DefaultLayout.astro
 * @description Standard page layout with header, content slot, and footer.
 * Wraps BaseLayout for pages that need full header/footer without sidebars
 * or special structural elements (no filter panel, no breadcrumbs).
 *
 * Used by: homepage, destinations listing, search, contact, about, feedback.
 */

import { getSiteUrl } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';
import BaseLayout from './BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';

interface Props {
	readonly locale: SupportedLocale;
	readonly title?: string;
	readonly description?: string;
	readonly canonicalPath?: string;
	readonly noindex?: boolean;
	/** Caveat tagline for the generated OG BRAND card. */
	readonly ogTagline?: string;
	/** Entity id rendered as the Umami page tag (`<meta name="umami-tag">`, partner page). */
	readonly analyticsTag?: string;
}

const {
	locale,
	title,
	description,
	canonicalPath = Astro.url.pathname,
	noindex = false,
	ogTagline,
	analyticsTag,
} = Astro.props;

const siteBase = getSiteUrl();
const canonicalUrl = new URL(canonicalPath, siteBase).href;

const resolvedTitle = title ?? 'Hospeda';
const resolvedDescription = description ?? 'Descubrí alojamientos en el Litoral Entrerriano';
---

<BaseLayout
	locale={locale}
	title={resolvedTitle}
	description={resolvedDescription}
	analyticsTag={analyticsTag}
>
	<SEOHead
		slot="head"
		title={resolvedTitle}
		description={resolvedDescription}
		locale={locale}
		canonical={canonicalUrl}
		noindex={noindex}
		ogTagline={ogTagline}
	/>
	<slot name="head-priority" slot="head-priority" />
	<slot name="head-extra" slot="head" />

	<slot />
</BaseLayout>
