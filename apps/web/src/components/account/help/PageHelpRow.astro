---
/**
 * @file PageHelpRow.astro
 * @description The «?» of a `/mi-cuenta` page that has no `AccountPageHeader`
 * (HOS-2410 `docs/web-ui.md` §6): a right-aligned row holding `HelpLink` for
 * the page's own `page:` anchor, derived from `Astro.routePattern`.
 *
 * `AccountLayout` renders it at the top of its content area, where a global
 * rule hides it whenever the page renders `AccountPageHeader` (which carries
 * its own «?»), so a page never shows two. The three account pages that use
 * `BaseLayout` directly render it themselves.
 *
 * Renders nothing when no article claims the anchor (AC-22) or outside
 * `/mi-cuenta` (AC-21).
 */

import HelpLink from '@/components/account/help/HelpLink.astro';
import { findHelpEntry, pageHelpAnchor } from '@/lib/help/help-entry';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
	readonly locale: SupportedLocale;
	/** Marks the copy `AccountLayout` renders, so CSS can hide it next to a header. */
	readonly fallback?: boolean;
}

const { locale, fallback = false } = Astro.props;
const anchor = pageHelpAnchor({ routePattern: Astro.routePattern });
const hasEntry = findHelpEntry({ anchor, locale }) !== undefined;
---

{hasEntry && (
	<div class="page-help-row" data-help-fallback={fallback ? '' : undefined}>
		<HelpLink anchor={anchor} locale={locale} />
	</div>
)}

<style>
	.page-help-row {
		display: flex;
		justify-content: flex-end;
		margin: 0 0 var(--space-2);
	}
</style>
