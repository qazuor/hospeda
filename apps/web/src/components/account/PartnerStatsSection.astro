---
/**
 * @file PartnerStatsSection.astro
 * @description Server-rendered partner metrics, separate from the mentions log.
 * Visibility and applicable metrics use the same resolver as the partner carousel.
 * A metric that does not apply is empty, never a fabricated zero.
 */
import { EyeIcon, LinkIcon } from '@repo/icons';
import { createElement } from 'react';
import { Section, StatCard, StatGrid } from '@/components/account/ui';
import { SectionLoadError } from '@/components/account/SectionLoadError';
import type { MyPartnerStats } from '@/lib/api/endpoints-protected';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import { resolvePartnerStatsView } from '@/lib/partner-stats-cards';

interface Props {
    readonly locale: SupportedLocale;
    readonly stats30: MyPartnerStats | null;
    readonly stats7: MyPartnerStats | null;
    readonly loadFailed?: boolean;
    readonly retryHref?: string;
}

const { locale, stats30, stats7, loadFailed = false, retryHref = '' } = Astro.props;
const { t } = createTranslations(locale);
const { visible, showViews, showClicks, views, clicks } = resolvePartnerStatsView({
    stats30, stats7, locale
});
const numberFormatter = new Intl.NumberFormat(locale);
const window30 = t('account.partnerStats.windows.last30');
const window7 = t('account.partnerStats.windows.last7');
---

{loadFailed && !visible && (
    <Section title={t('account.partnerStats.title')} description={t('account.partnerStats.subtitle')} helpId="section:partner.stats">
        <SectionLoadError locale={locale} retryHref={retryHref} />
    </Section>
)}

{visible && (
    <Section title={t('account.partnerStats.title')} description={t('account.partnerStats.subtitle')} helpId="section:partner.stats">
        <StatGrid>
            <StatCard
                id="partnerViews"
                label={t('account.partnerStats.views.label')}
                locale={locale}
                icon={createElement(EyeIcon, { size: 20 })}
                context={t('account.partnerStats.views.notApplicable')}
                state={showViews ? {
                    status: 'ready',
                    data: {
                        value: numberFormatter.format(views.last30),
                        nextStep: views.last7 !== null
                            ? `${window30} · ${numberFormatter.format(views.last7)} ${window7}`
                            : window30,
                        detail: t('account.partnerStats.views.help')
                    }
                } : { status: 'empty' }}
            />
            {showClicks && (
                <StatCard
                    id="partnerClicks"
                    label={t('account.partnerStats.clicks.label')}
                    locale={locale}
                    icon={createElement(LinkIcon, { size: 20 })}
                    state={{
                        status: 'ready',
                        data: {
                            value: numberFormatter.format(clicks.last30),
                            nextStep: clicks.last7 !== null
                                ? `${window30} · ${numberFormatter.format(clicks.last7)} ${window7}`
                                : window30,
                            detail: t('account.partnerStats.clicks.help')
                        }
                    }}
                />
            )}
        </StatGrid>
        <p class="scope">{t('account.partnerStats.scopeNote')}</p>
    </Section>
)}

<style>
    .scope {
        margin: var(--space-3) 0 0;
        padding-block-start: var(--space-3);
        border-block-start: 1px solid var(--border);
        font: var(--app-meta);
        color: var(--core-muted-foreground);
    }
</style>
