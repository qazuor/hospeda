---
/**
 * @file AllianceApplicationsSection.astro
 * @description The caller's own "aliados" applications and their real state
 * (HOS-278 AC-14), on the account kit (HOS-2502).
 *
 * `/mi-cuenta/aliados` was a static discovery hub: it offered the four
 * programs and, once you had applied, said exactly the same thing as before
 * you did. This section is the half that answers "and then what happened?".
 *
 * Renders NOTHING when the visitor has no applications and the read worked: the
 * hub below it is the whole page for someone who has never applied, and an empty
 * "your applications" panel would be noise on the most common case. When the
 * read FAILED it renders the section with an error and a retry link instead,
 * because hiding a failed read is how a user concludes «I never applied».
 *
 * Server-rendered on purpose: `/mi-cuenta/*` is a protected route, never
 * edge-cached, so reading the session here is correct. (Contrast with the four
 * public landing pages, where the same personalization has to happen in the
 * browser — see `AllianceLead.client.tsx`.)
 */

import { Section } from '@/components/account/ui';
import {
    AllianceApplicationsList,
    type AllianceApplicationRow
} from '@/components/account/AllianceApplicationsList';
import { SectionLoadError } from '@/components/account/SectionLoadError';
import type { MyAllianceLeadItem } from '@/lib/api/endpoints-protected';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';

interface Props {
    /** Active locale for i18n. */
    readonly locale: SupportedLocale;
    /** The visitor's own applications, newest first. */
    readonly leads: ReadonlyArray<MyAllianceLeadItem>;
    /** True when the applications read failed (shown as an error, never as empty). */
    readonly loadFailed?: boolean;
    /** Where the retry link points: the current page. */
    readonly retryHref?: string;
}

const { locale, leads, loadFailed = false, retryHref = '' } = Astro.props;
const { t } = createTranslations(locale);

const dateFormatter = new Intl.DateTimeFormat(locale, {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
});

const rows: AllianceApplicationRow[] = leads.map((lead) => ({
    id: lead.id,
    program: t(`account.alliances.programs.${lead.kind}`, lead.kind),
    submittedOn: `${t('account.alliances.applications.submittedOn')} ${dateFormatter.format(new Date(lead.createdAt))}`,
    status: lead.status,
    statusLabel: t(`account.alliances.status.${lead.status}`, lead.status)
}));
---

{
    (leads.length > 0 || loadFailed) && (
        <Section
            title={t('account.alliances.applications.title')}
            description={loadFailed ? undefined : t('account.alliances.applications.note')}
            helpId="section:alliances.applications"
        >
            {loadFailed ? (
                <SectionLoadError locale={locale} retryHref={retryHref} />
            ) : (
                <AllianceApplicationsList
                    label={t('account.alliances.applications.title')}
                    rows={rows}
                />
            )}
        </Section>
    )
}
