---
import { OwnSubscriptionsResponseSchema, type PricingSituationVertical } from '@repo/schemas';
import type { z } from 'zod';
import { SubscriptionCancel } from './SubscriptionCancel.client';
import { PromoCodeRedeem } from './PromoCodeRedeem.client';
import { PlanChangeOffer } from './PlanChangeOffer.client';
import { PauseOffer } from './PauseOffer.client';
import { ResumeOffer } from './ResumeOffer.client';
import { PausedCancel } from './PausedCancel.client';
import { PROMO_REDEEM_OFFERED } from '@/lib/billing/promo-redeem';
import type { PublishVerticalSlug } from '@/lib/api/endpoints-protected';
import { CANCELLATION_OFFERED, formatSelfCancelDate, GRACE_NOTICE, resolveScheduledRenewal } from '@/lib/billing/self-cancel';
import {
    DEFERRED_COURTESY_KEY,
    GRACE_PLAN_CHANGE_KEY
} from '@/lib/billing/my-subscription-notices';
import { resolveMySubscriptionSummary, resolveMySubscriptionVerticalLabelKey } from '@/lib/billing/my-subscription-summary';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import styles from './MySubscriptions.module.css';

type OwnSubscriptionsResult = z.infer<typeof OwnSubscriptionsResponseSchema>;
interface Props { readonly locale: SupportedLocale; readonly result: OwnSubscriptionsResult | null; }
const { locale, result } = Astro.props;
const { t, tPlural } = createTranslations(locale);
const date = (iso: string) => formatSelfCancelDate({ iso, locale }) ?? '';
const STATUS_KEY = { ACTIVE: 'account.subscription.mine.status.ACTIVE', GRACE_PERIOD: 'account.subscription.mine.status.GRACE_PERIOD', SUSPENDED: 'account.subscription.mine.status.SUSPENDED', CANCEL_SCHEDULED: 'account.subscription.mine.status.CANCEL_SCHEDULED', PAUSED: 'account.subscription.mine.status.PAUSED' } as const;
const statusKey = (row: OwnSubscriptionsResult['subscriptions'][number]) => {
    if (row.status === 'CANCEL_SCHEDULED') return resolveScheduledRenewal({ row }).statusKey;
    return STATUS_KEY[row.status];
};
const renewalKind = (row: OwnSubscriptionsResult['subscriptions'][number]) => {
    if (row.status !== 'CANCEL_SCHEDULED') return undefined;
    return resolveScheduledRenewal({ row }).kind;
};
---
<section class={styles.list} aria-label={t('account.subscription.mine.title')}>
    <h2 class={styles.title}>{t('account.subscription.mine.title')}</h2>
    {!result && <p class={styles.line}>{t('account.subscription.mine.loadError')}</p>}
    {result && result.subscriptions.length === 0 && result.deferredCourtesies.length === 0 && <p class={styles.line}>{t('account.subscription.mine.empty')}</p>}
    {result?.subscriptions.map((row) => {
        const summary = resolveMySubscriptionSummary({ row, locale, t });
        return (
            <article class={styles.item} data-testid="my-subscription" data-subscription-id={row.id} data-renewal={renewalKind(row)}>
                <h3 class={styles.title}>{summary.title}</h3>
                <p class={styles.line} data-testid="my-subscription-vertical">{t(summary.verticalLabelKey)}</p>
                <p class={styles.line}>{t(statusKey(row))}</p>
                {summary.priceLine && <p class={styles.line} data-testid="my-subscription-price">{summary.priceLine}</p>}
                {summary.nextChargeLine && <p class={styles.line} data-testid="my-subscription-next-charge">{summary.nextChargeLine}</p>}
                {row.status === 'ACTIVE' && <PauseOffer client:visible subscriptionId={row.id} locale={locale} />}
                {row.status === 'ACTIVE' && row.succession?.checkoutOpen ? <p class={styles.line} data-testid="my-subscription-plan-change-checkout">{t('account.subscription.mine.planChange.reason.succession')}</p> : row.status === 'ACTIVE' && <PlanChangeOffer client:visible subscriptionId={row.id} vertical={row.vertical as PricingSituationVertical} locale={locale} promo={row.promo !== null} courtesyMonths={result.deferredCourtesies.filter((courtesy) => courtesy.vertical === row.vertical).reduce((total, courtesy) => total + courtesy.balanceMonths, 0)} />}
                {row.status === 'SUSPENDED' && row.succession?.checkoutOpen && <p class={styles.line} data-testid="my-subscription-plan-change-coverage">{t('account.subscription.mine.planChange.reason.successionCoverage')}</p>}
                {row.status === 'PAUSED' && row.pause?.expectedEndAt && <p class={styles.line}>{t('account.subscription.mine.pause.expectedEnd', undefined, { date: date(row.pause.expectedEndAt) })}</p>}
                {row.status === 'PAUSED' && row.pause?.reason === 'CUSTOMER_REQUEST' && <ResumeOffer client:visible subscriptionId={row.id} locale={locale} />}
                {row.status === 'PAUSED' && <p class={styles.line} data-testid="my-subscription-plan-change-paused">{t('account.subscription.mine.planChange.reason.paused')}</p>}
                {row.status === 'PAUSED' && <PausedCancel client:visible subscriptionId={row.id} locale={locale} planName={summary.title} verticalLabel={t(summary.verticalLabelKey)} />}
                {row.status === 'GRACE_PERIOD' && <p class={styles.line} data-testid="my-subscription-plan-change-grace">{t(GRACE_PLAN_CHANGE_KEY[row.paymentMethod])}</p>}
                {row.status === 'CANCEL_SCHEDULED' && row.serviceEndsAt && <>
                    <p class={styles.line}>{t(resolveScheduledRenewal({ row }).lineKey, undefined, { date: date(row.serviceEndsAt) })}</p>
                    {resolveScheduledRenewal({ row }).addonsLineKey && <p class={styles.line}>{t(resolveScheduledRenewal({ row }).addonsLineKey as 'account.subscription.mine.paidAfterCancellationAddons', undefined, { date: date(row.serviceEndsAt) })}</p>}
                </>}
                {row.status === 'GRACE_PERIOD' && GRACE_NOTICE[row.paymentMethod] && row.graceEndsAt && <p class={styles.line} data-testid="my-subscription-grace">{t('account.subscription.mine.grace', undefined, { date: date(row.graceEndsAt) })}</p>}
                {CANCELLATION_OFFERED[row.status] && <SubscriptionCancel client:visible subscriptionId={row.id} locale={locale} planName={summary.title} verticalLabel={t(summary.verticalLabelKey)} />}
                {PROMO_REDEEM_OFFERED[row.status][row.paymentMethod] && <PromoCodeRedeem client:visible vertical={row.vertical as PublishVerticalSlug} locale={locale} offer="SUBSCRIPTION" />}
            </article>
        );
    })}
    {result?.deferredCourtesies.map((c) => (
        <article class={styles.item} data-testid="my-subscription-deferred-courtesy" data-courtesy-grant-id={c.courtesyGrantId}>
            <h3 class={styles.title}>{t(resolveMySubscriptionVerticalLabelKey({ vertical: c.vertical }))}</h3>
            <p class={styles.line}>{tPlural(DEFERRED_COURTESY_KEY, c.balanceMonths, { count: c.balanceMonths })}</p>
        </article>
    ))}
</section>
