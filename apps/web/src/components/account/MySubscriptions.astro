---
/**
 * @file MySubscriptions.astro
 * @description The owner's subscriptions on the subscription page, one kit
 * `PlanSummary` each (HOS-2485). Presentation only: every line, condition,
 * island and testid below is the Fase 1 behaviour (unsettled statuses
 * `PENDING_AUTHORIZATION` / `CHARGE_DECLINED` with their to-do line, grace,
 * pause, plan change, scheduled cancellation), moved into the kit piece. The
 * plan name and price line come from `resolveMySubscriptionSummary` (catalog).
 */
import { OwnSubscriptionsResponseSchema, type PricingSituationVertical } from '@repo/schemas';
import type { z } from 'zod';
import { SubscriptionCancel } from './SubscriptionCancel.client';
import { PromoCodeRedeem } from './PromoCodeRedeem.client';
import { PlanChangeOffer } from './PlanChangeOffer.client';
import { PlanChangeCheckoutPending } from './PlanChangeCheckoutPending.client';
import { PauseOffer } from './PauseOffer.client';
import { ResumeOffer } from './ResumeOffer.client';
import { PausedCancel } from './PausedCancel.client';
import { PROMO_REDEEM_OFFERED } from '@/lib/billing/promo-redeem';
import type { PublishVerticalSlug } from '@/lib/api/endpoints-protected';
import { CANCELLATION_OFFERED, formatSelfCancelDate, GRACE_NOTICE, resolveScheduledRenewal } from '@/lib/billing/self-cancel';
import {
    DEFERRED_COURTESY_KEY,
    GRACE_PLAN_CHANGE_KEY,
    totalCourtesyMonths
} from '@/lib/billing/my-subscription-notices';
import { MY_SUBSCRIPTION_TODO_KEY, findActiveSuccessor, resolveMySubscriptionSummary, resolveMySubscriptionVerticalLabelKey } from '@/lib/billing/my-subscription-summary';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import { EmptyState, LinkButton, PlanSummary, StatusPill, toneFor } from '@/components/account/ui';
import { PageLoadError } from './PageLoadError.client';
import { buildUrl } from '@/lib/urls';
import styles from './MySubscriptions.module.css';

type OwnSubscriptionsResult = z.infer<typeof OwnSubscriptionsResponseSchema>;
interface Props {
    readonly locale: SupportedLocale;
    readonly result: OwnSubscriptionsResult | null;
    /** Where the empty state's «Ver planes» goes (`resolveEmptySubscriptionPlansPath`, owner decision 2). */
    readonly plansPath: string;
}
const { locale, result, plansPath } = Astro.props;
const { t, tPlural } = createTranslations(locale);
const date = (iso: string) => formatSelfCancelDate({ iso, locale }) ?? '';
const STATUS_KEY = { ACTIVE: 'account.subscription.mine.status.ACTIVE', GRACE_PERIOD: 'account.subscription.mine.status.GRACE_PERIOD', SUSPENDED: 'account.subscription.mine.status.SUSPENDED', CANCEL_SCHEDULED: 'account.subscription.mine.status.CANCEL_SCHEDULED', PAUSED: 'account.subscription.mine.status.PAUSED', PENDING_AUTHORIZATION: 'account.subscription.mine.status.PENDING_AUTHORIZATION', CHARGE_DECLINED: 'account.subscription.mine.status.CHARGE_DECLINED' } as const;
const statusKey = (row: OwnSubscriptionsResult['subscriptions'][number]) => {
    if (row.status === 'CANCEL_SCHEDULED') return resolveScheduledRenewal({ row }).statusKey;
    return STATUS_KEY[row.status];
};
const renewalKind = (row: OwnSubscriptionsResult['subscriptions'][number]) => {
    if (row.status !== 'CANCEL_SCHEDULED') return undefined;
    return resolveScheduledRenewal({ row }).kind;
};
---
<section class={styles.list} aria-labelledby="my-subscriptions-title" data-help="section:suscripcion.plan">
    <h2 id="my-subscriptions-title" class={styles.title}>{t('account.subscription.mine.title')}</h2>
    {!result && <PageLoadError client:load locale={locale} title={t('account.subscription.mine.loadError')} helpId="section:suscripcion.plan" />}
    {result && result.subscriptions.length === 0 && result.deferredCourtesies.length === 0 && (
        <EmptyState variant="compact" title={t('account.subscription.mine.empty')}>
            <LinkButton slot="action" href={buildUrl({ locale, path: plansPath })} data-testid="my-subscription-empty-plans">
                {t('billing.common.viewPlans')}
            </LinkButton>
        </EmptyState>
    )}
    {result?.subscriptions.map((row) => {
        const summary = resolveMySubscriptionSummary({ row, locale, t });
        const activeSuccessor = findActiveSuccessor({ row, subscriptions: result.subscriptions });
        const successorSummary = activeSuccessor
            ? resolveMySubscriptionSummary({ row: activeSuccessor, locale, t })
            : null;
        return (
            <div class={styles.item} data-testid="my-subscription" data-subscription-id={row.id} data-renewal={renewalKind(row)}>
            <PlanSummary name={summary.title}>
                <span slot="scope" data-testid="my-subscription-vertical">{t(summary.verticalLabelKey)}</span>
                {!(activeSuccessor && successorSummary) && <StatusPill slot="status" tone={toneFor({ domain: 'subscription', status: row.status })}>{t(statusKey(row))}</StatusPill>}
                {!(activeSuccessor && successorSummary) && summary.priceLine && <span slot="price" data-testid="my-subscription-price">{summary.priceLine}</span>}
                {!(activeSuccessor && successorSummary) && summary.nextChargeLine && <span slot="renewal" data-testid="my-subscription-next-charge">{summary.nextChargeLine}</span>}
                {activeSuccessor && successorSummary
                    ? <p class={styles.line} data-testid="my-subscription-replaced">{t('account.subscription.mine.replacedBy', undefined, { plan: successorSummary.title })}</p>
                    : <>
                {(row.status === 'PENDING_AUTHORIZATION' || row.status === 'CHARGE_DECLINED') && <p class={styles.line} data-testid="my-subscription-todo">{t(MY_SUBSCRIPTION_TODO_KEY[row.status])}</p>}
                {row.status === 'ACTIVE' && row.scheduledChange && <p class={styles.line} data-testid="my-subscription-scheduled-change">{t('account.subscription.mine.planChange.downgrade', undefined, { date: date(row.scheduledChange.effectiveAt) })}</p>}
                {row.status === 'ACTIVE' && row.succession?.checkoutOpen && <p class={styles.line} data-testid="my-subscription-plan-change-checkout">{t('account.subscription.mine.planChange.reason.succession')}</p>}
                {row.succession?.checkoutDeadline && <p class={styles.line} data-testid="my-subscription-plan-change-deadline">{t('account.subscription.mine.planChange.checkoutDeadline', undefined, { date: date(row.succession.checkoutDeadline) })}</p>}
                {row.status === 'SUSPENDED' && row.succession?.checkoutOpen && <p class={styles.line} data-testid="my-subscription-plan-change-coverage">{t('account.subscription.mine.planChange.reason.successionCoverage')}</p>}
                {row.status === 'PAUSED' && row.pause?.expectedEndAt && <p class={styles.line}>{t('account.subscription.mine.pause.expectedEnd', undefined, { date: date(row.pause.expectedEndAt) })}</p>}
                {row.status === 'PAUSED' && <p class={styles.line} data-testid="my-subscription-plan-change-paused">{t('account.subscription.mine.planChange.reason.paused')}</p>}
                {row.status === 'GRACE_PERIOD' && <p class={styles.line} data-testid="my-subscription-plan-change-grace">{t(GRACE_PLAN_CHANGE_KEY[row.paymentMethod])}</p>}
                {row.status === 'CANCEL_SCHEDULED' && row.serviceEndsAt && <>
                    <p class={styles.line}>{t(resolveScheduledRenewal({ row }).lineKey, undefined, { date: date(row.serviceEndsAt) })}</p>
                    {resolveScheduledRenewal({ row }).addonsLineKey && <p class={styles.line}>{t(resolveScheduledRenewal({ row }).addonsLineKey as 'account.subscription.mine.paidAfterCancellationAddons', undefined, { date: date(row.serviceEndsAt) })}</p>}
                </>}
                {row.status === 'GRACE_PERIOD' && GRACE_NOTICE[row.paymentMethod] && row.graceEndsAt && <p class={styles.line} data-testid="my-subscription-grace">{t('account.subscription.mine.grace', undefined, { date: date(row.graceEndsAt) })}</p>}
                <div class={styles.actions} data-testid="my-subscription-actions">
                    {(row.status === 'ACTIVE' || (row.status === 'PAUSED' && row.pause?.reason === 'COURTESY')) && <PauseOffer client:visible subscriptionId={row.id} locale={locale} />}
                    {!row.succession?.checkoutOpen && row.status === 'ACTIVE' && <PlanChangeOffer client:visible subscriptionId={row.id} vertical={row.vertical as PricingSituationVertical} locale={locale} promo={row.promo !== null} courtesyMonths={totalCourtesyMonths({ row, deferredCourtesies: result.deferredCourtesies })} />}
                    {row.succession?.checkoutOpen && row.succession.successorId && <PlanChangeCheckoutPending client:visible successorId={row.succession.successorId} checkoutUrl={row.succession.checkoutUrl ?? null} locale={locale} />}
                    {row.status === 'PAUSED' && row.pause?.reason === 'CUSTOMER_REQUEST' && <ResumeOffer client:visible subscriptionId={row.id} locale={locale} />}
                    {row.status === 'PAUSED' && <PausedCancel client:visible subscriptionId={row.id} locale={locale} planName={summary.title} verticalLabel={t(summary.verticalLabelKey)} />}
                    {CANCELLATION_OFFERED[row.status] && <SubscriptionCancel client:visible subscriptionId={row.id} locale={locale} planName={summary.title} verticalLabel={t(summary.verticalLabelKey)} />}
                </div>
                {PROMO_REDEEM_OFFERED[row.status][row.paymentMethod] && <div class={styles.promo}><PromoCodeRedeem client:visible vertical={row.vertical as PublishVerticalSlug} locale={locale} offer="SUBSCRIPTION" /></div>}
                    </>}
            </PlanSummary>
            </div>
        );
    })}
    {result?.deferredCourtesies.map((c) => (
        <div class={styles.item} data-testid="my-subscription-deferred-courtesy" data-courtesy-grant-id={c.courtesyGrantId}>
            <PlanSummary name={t(resolveMySubscriptionVerticalLabelKey({ vertical: c.vertical }))}>
                <p class={styles.line}>{tPlural(DEFERRED_COURTESY_KEY, c.balanceMonths, { count: c.balanceMonths })}</p>
            </PlanSummary>
        </div>
    ))}
</section>
