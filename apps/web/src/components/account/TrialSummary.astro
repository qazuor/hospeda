---
/**
 * @file TrialSummary.astro
 * @description Row 4 of Mi Suscripción (HOS-1492, V8a.1b): the accumulated
 * free-trial days of the person in each vertical and where they came from
 * ("{base} from the plan, {promo} from promotions, {support} granted by
 * support"; only the origins above zero), with the start and end dates.
 *
 * Server-rendered, no island and no fetch: the page reads the trial-summary
 * route once per vertical and hands in what answered. A vertical
 * without a trial (`status: 'NONE'`), with zero days, or whose read failed is
 * simply absent, so the block renders nothing at all when there is nothing to
 * say. Self-contained on purpose: the page around it is rewritten by B13a.4,
 * and this block has to move whole.
 *
 * The panel half of row 4 is not here (D2).
 */
import type { TrialSummaryResponse } from '@repo/schemas';
import type { PublishVerticalSlug } from '@/lib/api/endpoints-protected';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';
import { formatNoticeInstant } from '@/lib/listing/listing-notices';
import styles from './TrialSummary.module.css';

/** One vertical's trial read, as the page received it. */
interface TrialSummaryEntry {
	readonly vertical: PublishVerticalSlug;
	readonly summary: TrialSummaryResponse;
}

interface Props {
	/** Page locale. */
	readonly locale: SupportedLocale;
	/** One entry per vertical whose read answered. */
	readonly entries: readonly TrialSummaryEntry[];
}

/** The vertical's name inside the block title. */
const VERTICAL_KEY: Readonly<Record<PublishVerticalSlug, string>> = {
	accommodation: 'account.subscription.trialSummary.vertical.accommodation',
	gastronomy: 'account.subscription.trialSummary.vertical.gastronomy',
	experience: 'account.subscription.trialSummary.vertical.experience'
};

/** The three origins, in the order the line states them. */
const ORIGIN_KEYS = [
	['base', 'account.subscription.trialSummary.origins.base'],
	['promo', 'account.subscription.trialSummary.origins.promo'],
	['support', 'account.subscription.trialSummary.origins.support']
] as const;

const { locale, entries } = Astro.props;
const { t, tPlural } = createTranslations(locale);

const views = entries.flatMap(({ vertical, summary }) => {
	if (!('totalDays' in summary) || summary.totalDays <= 0) return [];
	const origins = ORIGIN_KEYS.filter(([origin]) => summary.origins[origin] > 0)
		.map(([origin, key]) => tPlural(key, summary.origins[origin], { count: summary.origins[origin] }))
		.join(', ');
	const start = summary.startedAt ? formatNoticeInstant({ iso: summary.startedAt, locale }) : null;
	const end = summary.endsAt ? formatNoticeInstant({ iso: summary.endsAt, locale }) : null;
	return [
		{
			vertical,
			title: t('account.subscription.trialSummary.title', undefined, {
				vertical: t(VERTICAL_KEY[vertical])
			}),
			total: tPlural('account.subscription.trialSummary.total', summary.totalDays, {
				count: summary.totalDays
			}),
			origins,
			dates:
				start && end
					? t('account.subscription.trialSummary.dates', undefined, { start, end })
					: null
		}
	];
});
---

{
	views.length > 0 && (
		<section class={styles.summary} data-testid="trial-summary">
			{views.map((view) => (
				<article class={styles.item} data-vertical={view.vertical}>
					<h2 class={styles.title}>{view.title}</h2>
					<p class={styles.total}>
						{view.origins ? `${view.total}: ${view.origins}` : view.total}
					</p>
					{view.dates && <p class={styles.dates}>{view.dates}</p>}
				</article>
			))}
		</section>
	)
}
