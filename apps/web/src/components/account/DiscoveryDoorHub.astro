---
/**
 * @file DiscoveryDoorHub.astro
 * @description Shared hub component for the two `/mi-cuenta` discovery doors
 * (HOS-131 §6.2/§6.3): "Publicá en Hospeda" (`mi-cuenta/publica`) and
 * "Sumate como aliado" (`mi-cuenta/aliados`). Both pages render the SAME
 * component with a different `door` from `ACCOUNT_DISCOVERY_DOORS` — the
 * per-option state (acquired / unacquired / coming soon) is resolved here,
 * server-side, the same way `AccountLayout.astro`'s sidebar approximates
 * gating: via effective permissions from the authenticated session (HOS-2622,
 * D-4 — no effective-permissions round-trip on SSR).
 *
 * Per option:
 * HOS-2501: cards, pills and buttons are kit pieces (`StatusPill`, `LinkButton`,
 * the `accent` button for the acquire CTA) and the styles use design tokens only.
 * The props API is unchanged (`aliados` renders it too).
 *
 * - `acquired`   -> check badge + "Gestionar" button. Links `option.manageHref`
 *   (locale-relative), except `managesInAdminPanel` options (HOS-134), which
 *   link the absolute admin-panel URL (`adminUrl` prop) instead.
 * - `unacquired` -> mini-explanation + acquire CTA button (`option.href`).
 * - `comingSoon` -> "Próximamente" badge + "Contactanos" button (`option.href`).
 */

import type { DiscoveryDoor } from '@/config/discovery-doors';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import type { GatedNavNode } from '@/lib/nav-gating';
import { isVisibleByPermissions, resolveDoorOptionState } from '@/lib/nav-gating';
import { buildUrl } from '@/lib/urls';
import { CheckCircleIcon } from '@repo/icons';
import { LinkButton, StatusPill } from '@/components/account/ui';

interface Props {
    readonly locale: SupportedLocale;
    readonly door: DiscoveryDoor;
    /**
     * Every role the visitor holds (`Astro.locals.user.roles`), or `null`
     * for guests. HOS-296: a door option counts as acquired when ANY held
     * role grants its permission.
     */
    readonly permissions: readonly string[];
    /**
     * Admin panel base URL (`getAdminUrl()`), used for `managesInAdminPanel`
     * acquired options (HOS-134). `undefined` when the env var isn't
     * configured — the "Gestionar" link then falls back to the relative door
     * href instead of emitting a broken empty href.
     */
    readonly adminUrl?: string;
    /**
     * Option ids that are force-`'acquired'` out-of-band (HOS-278), bypassing
     * the permission mechanism entirely for those ids — see
     * `resolveDoorOptionState`'s JSDoc in `src/lib/nav-gating.ts` for why the
     * override exists. Only `mi-cuenta/aliados/index.astro` passes this today
     * (`['serviceProvider']` once `GET /host-trades/mine` returns a row);
     * every other caller omits it and behaviour is unchanged.
     */
    readonly acquiredOptionIds?: readonly string[];
}

const { locale, door, permissions, adminUrl, acquiredOptionIds } = Astro.props;
const { t } = createTranslations(locale);

const visibility = (node: GatedNavNode) => isVisibleByPermissions(node, permissions);

const optionRows = door.options.map((option) => {
    const state = resolveDoorOptionState({ option, visibility, acquiredOptionIds });
    // Resolve the "Gestionar" target only for acquired options. A
    // `managesInAdminPanel` option links the absolute admin URL; when that env
    // var isn't configured, `manageHref` stays undefined and the button is
    // hidden entirely rather than emitting a self-referential link back to the
    // current hub page (mirrors the hide-on-unavailable behavior of
    // `buildAdminPanelItem`).
    //
    // NOTE: no option in `ACCOUNT_DISCOVERY_DOORS` sets that flag today — the
    // editor role was the only one, and HOS-374 moved it to a `/mi-cuenta`
    // `manageHref` because Phase 3 closes the admin panel to editors. The
    // branch is kept (and still covered by this component's tests) for the
    // next role that is genuinely managed cross-app.
    const manageHref =
        state === 'acquired'
            ? option.managesInAdminPanel
                ? adminUrl
                : buildUrl({ locale, path: option.manageHref ?? door.href })
            : undefined;
    return { option, state, manageHref };
});
---

<div class="door-hub">
    <p class="door-hub__subtitle">{t(door.subtitleI18nKey)}</p>

    <ul class="door-hub__list">
        {optionRows.map(({ option, state, manageHref }) => {
            const OptionIcon = option.icon;

            return (
            <li class="door-hub__option">
                <div class="door-hub__option-icon" aria-hidden="true">
                    <OptionIcon size={22} weight="regular" aria-hidden="true" />
                </div>

                <div class="door-hub__option-body">
                    <h2 class="door-hub__option-title">{t(option.i18nKey)}</h2>
                    <p class="door-hub__option-description">{t(option.descriptionI18nKey)}</p>
                </div>

                <div class="door-hub__option-action">
                    {state === 'acquired' && (
                        <>
                            <StatusPill tone="success">
                                <CheckCircleIcon size={16} weight="fill" aria-hidden="true" />
                                {t('account.doors.common.acquiredLabel')}
                            </StatusPill>
                            {manageHref && (
                                <LinkButton href={manageHref} variant="secondary" size="sm">
                                    {t('account.doors.common.manageCta')}
                                </LinkButton>
                            )}
                        </>
                    )}
                    {state === 'comingSoon' && (
                        <>
                            <StatusPill tone="neutral">
                                {t('account.doors.common.comingSoonBadge')}
                            </StatusPill>
                            <LinkButton
                                href={buildUrl({ locale, path: option.href })}
                                variant="secondary"
                                size="sm"
                            >
                                {t(option.ctaI18nKey)}
                            </LinkButton>
                        </>
                    )}
                    {state === 'unacquired' && (
                        <LinkButton
                            href={buildUrl({ locale, path: option.href })}
                            variant="accent"
                            size="sm"
                        >
                            {t(option.ctaI18nKey)}
                        </LinkButton>
                    )}
                </div>
            </li>
            );
        })}
    </ul>
</div>

<style>
    .door-hub__subtitle {
        margin: 0 0 var(--space-6);
        color: var(--core-muted-foreground);
        font: var(--app-body);
        max-inline-size: 60ch;
    }

    .door-hub__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
    }

    @media (min-width: 48rem) {
        .door-hub__list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* An option card: the kit card surface, with the option icon, text and action. */
    .door-hub__option {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        background-color: var(--core-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        padding: var(--space-6);
    }

    .door-hub__option-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        inline-size: var(--space-10);
        block-size: var(--space-10);
        border-radius: var(--radius-md);
        background-color: var(--upsell-bg);
        color: var(--upsell-fg);
    }

    .door-hub__option-title {
        margin: 0 0 var(--space-1);
        color: var(--core-foreground);
        font: var(--app-card-title);
    }

    .door-hub__option-description {
        margin: 0;
        color: var(--core-muted-foreground);
        font: var(--app-ui);
    }

    .door-hub__option-action {
        margin-top: auto;
        padding-top: var(--space-3);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-3);
    }
</style>
