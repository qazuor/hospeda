---
/**
 * @file WebSiteJsonLd.astro
 * @description WebSite JSON-LD component for the homepage.
 * Generates schema.org `WebSite` structured data (name + canonical URL).
 *
 * NOTE: this component used to advertise a sitelinks searchbox pointing at the
 * global site-search page. That feature was cut from the product and its page
 * deleted, so the action was removed too — advertising a search target that
 * 404s is worse than advertising none. Do NOT reintroduce it without a live
 * search page to point at. `WebSiteJsonLd.test.ts` guards this.
 *
 * SPEC-157 / REQ-5.
 */

import JsonLd from './JsonLd.astro';

/** Props interface for WebSiteJsonLd component. */
interface Props {
	/** Site/brand name (e.g. "Hospeda"). */
	readonly name: string;
	/** Canonical absolute URL of the site root (e.g. "https://hospeda.com.ar"). */
	readonly url: string;
}

const { name, url } = Astro.props;

const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name,
	url,
};
---

<JsonLd data={structuredData} />
