---
/**
 * @file TouristAttractionJsonLd.astro
 * @description TouristAttraction JSON-LD component for experiences and attractions.
 * Generates schema.org TouristAttraction structured data.
 *
 * SPEC-268 F2/F3: new component for experience and attraction detail pages.
 * HOS-2579 §6.6: optional `geo`, `aggregateRating`, `isAccessibleForFree`,
 * `containedInPlace` and `offers` (multi-typed with `TouristTrip`, D-2). The
 * object is built by `buildTouristAttractionJsonLd`, which emits each property
 * only when its data exists.
 */

import {
	buildTouristAttractionJsonLd,
	type TouristAttractionJsonLdInput,
} from '@/lib/seo/tourist-attraction-jsonld';
import JsonLd from './JsonLd.astro';

type Props = TouristAttractionJsonLdInput;

const { data: structuredData } = buildTouristAttractionJsonLd(Astro.props);
---

<JsonLd data={structuredData} />
