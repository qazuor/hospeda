---
/**
 * @file ListingSocialLinks.astro
 * @description A listing's social profiles as outline `IconButton`s carrying
 * the network's brand logo from `@repo/icons` (HOS-2579 §6.4). Extracted from
 * the shared contact block so the row has one presentation on the three
 * verticals; before, the experience page drew its own emoji pills inside
 * `ExperienceInfo`.
 *
 * It only PRESENTS: each `href` must already have gone through
 * `resolveSafeExternalUrl`, and which networks a vertical may show is decided
 * by its builder (`@/lib/listing-contact/listing-contact-block`). There is no
 * WhatsApp entry. Every link carries the block's `trackingData` plus
 * `contact-channel: social` and, when the owner panel counts it, its
 * `interaction-kind`.
 */
import IconButton from '@/components/shared/ui/IconButton.astro';
import type { ListingContactSocialLink } from './listing-contact.types';

interface Props {
    readonly links: readonly ListingContactSocialLink[];
    /** Title above the row. Omitted, the row has no title. */
    readonly heading?: string;
    /** `data-*` read by `initContactLinkTracking` (keys without the `data-` prefix). */
    readonly trackingData: Readonly<Record<string, string>>;
}

const { links, heading, trackingData } = Astro.props;
---

{links.length > 0 && (
    <div class="listing-social">
        {heading && <h3 class="listing-social__title">{heading}</h3>}
        <div class="listing-social__list">
            {links.map(({ href, ariaLabel, Icon, interactionKind }) => (
                <IconButton
                    as="a"
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    variant="outline"
                    size="md"
                    ariaLabel={ariaLabel}
                    data={{
                        ...trackingData,
                        'contact-channel': 'social',
                        ...(interactionKind ? { 'interaction-kind': interactionKind } : {})
                    }}
                >
                    <Icon size={18} aria-hidden="true" />
                </IconButton>
            ))}
        </div>
    </div>
)}

<style>
    .listing-social {
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 12px);
    }
    .listing-social__title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0;
    }
    .listing-social__list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2, 8px);
    }
</style>
