---
/** @file Shared, session-blind price title and contact CTA for listing details. */
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import type { ListingContactPrice } from '@/lib/listing-contact/listing-contact-price';
import { getListingPriceCardDisplay } from '@/lib/listing-contact/listing-contact-price';
import type { PriceCardAction } from '@/lib/listing-contact/price-card-action';

interface Props {
    readonly listingId: string;
    readonly vertical: 'accommodation' | 'experience' | 'venue';
    readonly locale: SupportedLocale;
    readonly price?: ListingContactPrice;
    readonly rangeLabel?: string | null;
    readonly hostReply?: boolean;
    readonly action: PriceCardAction;
    readonly stacked?: boolean;
}

const { listingId, vertical, locale, price, rangeLabel, hostReply, action, stacked } = Astro.props;
const { t } = createTranslations(locale);
const display = getListingPriceCardDisplay({ price, locale, rangeLabel, hostReply, byEmail: action.kind === 'email' });
const direct = 'href' in action ? action : undefined;
---

<div class:list={['listing-price-card', { 'listing-price-card--stacked': stacked }]}>
    <div class="listing-price-card__facts">
        {rangeLabel && <p class="listing-price-card__note">{t('venue.detail.priceRangeLabel')}</p>}
        <div class="listing-price-card__price">
            <h2 class="listing-price-card__title">{display.title}</h2>
            {display.unit && <span class="listing-price-card__note">{display.unit}</span>}
        </div>
        {display.note && <p class="listing-price-card__note">{display.note}</p>}
        <slot name="facts" />
    </div>
    {direct && (
        <a
            class="listing-price-card__cta btn-gradient--accent btn-gradient--flat"
            href={direct.href}
            target={direct.kind === 'menu' ? '_blank' : undefined}
            rel={direct.kind === 'menu' ? 'noopener noreferrer' : undefined}
            data-contact-channel={direct.kind}
            data-listing-id={listingId}
            data-vertical={vertical}
            data-contact-origin="summary"
        >{t(direct.labelKey)}</a>
    )}
    <slot />
</div>

<style>
    .listing-price-card {
        display: flex;
        flex: 1 1 100%;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        min-width: 0;
    }
    .listing-price-card--stacked {
        flex-direction: column;
        align-items: stretch;
    }
    .listing-price-card__facts {
        display: grid;
        min-width: 0;
        gap: var(--space-1);
    }
    .listing-price-card__price {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-2);
    }
    .listing-price-card__title {
        color: var(--core-foreground);
        font: var(--app-title);
        margin: 0;
    }
    .listing-price-card__note {
        color: var(--core-muted-foreground);
        font: var(--app-ui);
        margin: 0;
    }
    .listing-price-card__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: calc(var(--space-10) + var(--space-1));
        padding-inline: var(--space-4);
        border-radius: var(--radius-button);
        text-decoration: none;
    }
</style>
