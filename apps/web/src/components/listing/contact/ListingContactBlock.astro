---
/**
 * @file ListingContactBlock.astro
 * @description The one contact block of the three listing detail pages
 * (HOS-2579 §6.4, HOS-2520 owner smoke items 18 and 19).
 *
 * Renders the channels (phone, email, website) as outline `GradientButton`s,
 * then the venue's «Ver menú» link when there is one, then the social profiles
 * through `ListingSocialLinks`.
 *
 * This component only PRESENTS. Its props come from the per-vertical builders
 * in `@/lib/listing-contact/listing-contact-block`, which decide which channels
 * and networks a vertical shows, run every URL through
 * `resolveSafeExternalUrl` and never produce a WhatsApp channel. Every `href`
 * received here is already safe (or a `tel:` / `mailto:` URI). Tracking
 * attributes are the builder's `trackingData` plus a per-link
 * `contact-channel`.
 */
import { EmailIcon, ExternalLinkIcon, GlobeIcon, PhoneIcon } from '@repo/icons';
import GradientButton from '@/components/shared/ui/GradientButton.astro';
import ListingSocialLinks from './ListingSocialLinks.astro';
import type {
    ListingContactChannel,
    ListingContactMenuLink,
    ListingContactShell,
    ListingContactSocialLink
} from './listing-contact.types';

interface Props {
    /** Visible title of the block. Omitted, no title and no section label. */
    readonly heading?: string;
    /** Title above the social row. Omitted, the row has no title. */
    readonly socialHeading?: string;
    readonly channels: readonly ListingContactChannel[];
    readonly socialLinks: readonly ListingContactSocialLink[];
    /** `data-*` read by `initContactLinkTracking` (keys without the `data-` prefix). */
    readonly trackingData: Readonly<Record<string, string>>;
    /** `card` (default) draws a card; `plain` has no chrome. */
    readonly shell?: ListingContactShell;
    /** Stable anchor id of the root `<section>` (in-page CTAs point at it). */
    readonly id?: string;
    /** Extra attributes for the root element (the Umami block marker). */
    readonly blockProps?: Readonly<Record<string, string>>;
    /** The venue's «Ver menú» outbound link (not counted by the owner panel). */
    readonly menuLink?: ListingContactMenuLink;
}

const {
    heading,
    socialHeading,
    channels,
    socialLinks,
    trackingData,
    shell = 'card',
    id,
    blockProps = {},
    menuLink
} = Astro.props;

const CHANNEL_ICONS = { phone: PhoneIcon, email: EmailIcon, website: GlobeIcon } as const;
---

<section
    class:list={['listing-contact', `listing-contact--${shell}`]}
    id={id}
    aria-label={heading}
    {...blockProps}
>
    <!-- An <h2>: the block opens slot 10 on the three pages (HOS-2579 §6.8). -->
    {heading && <h2 class="listing-contact__title">{heading}</h2>}

    {channels.length > 0 && (
        <div class="listing-contact__channels">
            {channels.map(({ kind, href, label, srHint, interactionKind }) => {
                const ChannelIcon = CHANNEL_ICONS[kind];
                return (
                    <GradientButton
                        href={href}
                        {...(kind === 'website'
                            ? { target: '_blank', rel: 'noopener noreferrer' }
                            : {})}
                        label={label}
                        srHint={srHint}
                        variant="outline-primary"
                        size="sm"
                        class="listing-contact__channel"
                        data={{
                            ...trackingData,
                            'contact-channel': kind,
                            ...(interactionKind ? { 'interaction-kind': interactionKind } : {})
                        }}
                    >
                        <ChannelIcon slot="leading" size={16} />
                    </GradientButton>
                );
            })}
        </div>
    )}

    {menuLink && (
        <div class="listing-contact__menu">
            <GradientButton
                href={menuLink.href}
                target="_blank"
                rel="noopener noreferrer"
                label={menuLink.label}
                variant="accent"
                size="md"
                class="venue-contact__menu-btn"
                data={{ ...trackingData, 'contact-channel': 'menu' }}
            >
                <ExternalLinkIcon slot="trailing" size={16} aria-hidden="true" />
            </GradientButton>
        </div>
    )}

    <ListingSocialLinks
        links={socialLinks}
        heading={socialHeading}
        trackingData={trackingData}
        headingLevel={heading ? 3 : 2}
    />
</section>

<style>
    .listing-contact {
        display: flex;
        flex-direction: column;
        gap: var(--space-4, 16px);
    }
    .listing-contact--card {
        padding: var(--space-5, 20px);
        background-color: var(--core-card);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
    }
    .listing-contact--plain {
        margin-bottom: var(--space-6, 24px);
    }
    .listing-contact__title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0;
    }
    .listing-contact__channels {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2, 8px);
    }
    /* A long email or URL wraps inside its pill instead of being clipped by the
       button's nowrap + overflow. */
    .listing-contact__channels :global(.listing-contact__channel) {
        max-inline-size: 100%;
        white-space: normal;
    }
    .listing-contact__channels :global(.listing-contact__channel .gradient-btn__label) {
        min-inline-size: 0;
        overflow-wrap: anywhere;
    }
</style>
