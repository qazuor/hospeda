---
/**
 * @file ListingHouseRules.astro
 * @description The public "house rules" block shared by the accommodation,
 * venue and experience detail pages (HOS-2060).
 *
 * Renders the declared policies — check-in/out, payment methods, pets, smoking,
 * events, reservations, and the accommodation's deposit and spoken languages
 * (HOS-2120) — as an icon list. The row decisions live in the pure
 * `buildHouseRuleRows`; this component only maps a row id to its icon. Renders
 * nothing when no rule is declared.
 */
import type { ListingPolicyValues } from '@/lib/listing/listing-policies';
import { buildHouseRuleRows, type HouseRuleRowId } from '@/lib/listing/listing-house-rules';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import {
  CheckInIcon,
  CheckOutIcon,
  CreditCardIcon,
  PetFriendlyIcon,
  SmokingAllowedIcon,
  ConfettiIcon,
  CalendarIcon,
  PriceIcon,
  LanguageIcon
} from '@repo/icons';

interface Props {
  readonly policies: ListingPolicyValues | undefined;
  readonly locale: SupportedLocale;
}

const { policies, locale } = Astro.props;
const { t } = createTranslations(locale);

const rows = buildHouseRuleRows({ policies: policies ?? {}, t, locale });
if (rows.length === 0) return;

const ICONS: Readonly<Record<HouseRuleRowId, typeof CheckInIcon>> = {
  checkIn: CheckInIcon,
  checkOut: CheckOutIcon,
  paymentMethods: CreditCardIcon,
  pets: PetFriendlyIcon,
  smokingAllowed: SmokingAllowedIcon,
  eventsAllowed: ConfettiIcon,
  reservations: CalendarIcon,
  deposit: PriceIcon,
  spokenLanguages: LanguageIcon
};
---

<section class="house-rules" aria-labelledby="house-rules-title">
  <h2 class="house-rules__title" id="house-rules-title">
    {t('listing.policies.houseRulesTitle', 'Normas y políticas')}
  </h2>
  <ul class="house-rules__list">
    {rows.map((row) => {
      const Icon = ICONS[row.id];
      return (
        <li class="house-rules__item" data-rule={row.id}>
          <Icon size="sm" weight="duotone" aria-hidden="true" />
          <div class="house-rules__content">
            <span class="house-rules__label">{row.label}</span>
            <span class="house-rules__value">{row.value}</span>
            {row.note && <span class="house-rules__note">{row.note}</span>}
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .house-rules__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--core-foreground);
    margin-bottom: var(--space-4, 16px);
  }
  .house-rules__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3, 12px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .house-rules__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2, 8px);
    color: var(--core-foreground);
  }
  .house-rules__content {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .house-rules__label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--core-muted-foreground);
  }
  .house-rules__value {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .house-rules__note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--core-muted-foreground);
  }
</style>
