---
/**
 * @file VenueContactBlock.astro
 * @description Social networks + menu URL block for a venue listing
 * (SPEC-239 T-054).
 *
 * HOS-2042: the public VenuePublicSchema now exposes a NARROWED `contactInfo`
 * (business channels only: mobile phone, optional landline, email, website),
 * mirroring the experience contact block. `homePhone`, personal fields and
 * `whatsapp` are never published. `whatsapp` was removed from
 * `VenueSocialNetworks` (HOS-1076) because it was never real, and it must not
 * come back here: the number is gated per viewer on a separate endpoint.
 *
 * The root `<section>` below carries a stable `id` (HOS-1055): the "accepts
 * events" CTA on the detail page is an in-page anchor to THIS block rather
 * than a link of its own, precisely because there is no single channel here
 * to pick — see `VenueEventsCta.astro`'s header.
 */

import { EmailIcon, GlobeIcon, PhoneIcon } from '@repo/icons';
import type { VenueContactInfo, VenueSocialNetworks } from '@/data/types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { resolveSafeExternalUrl } from '@/lib/safe-external-url';
import { hasVenuePublicContact, VENUE_CONTACT_ANCHOR_ID } from '@/lib/venue-contact';
import { UMAMI_BLOCK_PROPS } from '@/lib/analytics/recording-block';

interface Props {
    readonly contactInfo?: VenueContactInfo | null;
    readonly socialNetworks: VenueSocialNetworks | null;
    readonly menuUrl?: string | null;
    readonly locale: SupportedLocale;
}

const { contactInfo, socialNetworks, menuUrl, locale } = Astro.props;
const { t } = createTranslations(locale);

// Both the menu link and the social profiles are authored by the listing
// owner in `/mi-cuenta/comercio`, and `z.string().url()` accepts `javascript:`
// — so this allow-list, not the schema, is what keeps a payload out of the
// hrefs below (HOS-592 / F-02). A refused value drops its link entirely.
const menuHref = resolveSafeExternalUrl(menuUrl);

/** Only render if at least one piece of contact info is present. */
const hasSocial =
    socialNetworks &&
    Object.values(socialNetworks).some((v) => Boolean(resolveSafeExternalUrl(v)));

// The decision is shared with the page's section gate and the events CTA
// (`@/lib/venue-contact`): they must all agree on whether this block exists.
if (!hasVenuePublicContact({ contactInfo, socialNetworks, menuUrl })) {
    // Nothing to render — exit early
    return;
}

/**
 * Normalizes a stored value to a non-empty trimmed string, or `undefined`.
 * `contact_info` is an unbounded JSONB blob, so a key can hold `null`, `''` or
 * whitespace.
 */
const clean = (value: string | null | undefined): string | undefined => {
    if (typeof value !== 'string') return undefined;
    const trimmed = value.trim();
    return trimmed.length > 0 ? trimmed : undefined;
};

/** `tel:` hrefs carry digits and `+` only; the displayed text keeps its spaces. */
const toTelHref = (phone: string): string => `tel:${phone.replace(/[^\d+]/g, '')}`;

const mobilePhone = clean(contactInfo?.mobilePhone);
const landlinePhone = clean(contactInfo?.workPhone);
const workEmail = clean(contactInfo?.workEmail);
// Owner-authored URL: `z.string().url()` accepts `javascript:`, so this
// allow-list is what keeps a payload out of the href (HOS-592 / F-02).
const websiteHref = resolveSafeExternalUrl(contactInfo?.website ?? undefined);

// The mobile phone is the main one and goes first; the landline follows it.
const phones = [
    {
        value: mobilePhone,
        ariaLabel: t('venue.detail.contactPhoneAriaLabel', 'Llamar al comercio')
    },
    {
        value: landlinePhone,
        ariaLabel: t(
            'venue.detail.contactLandlineAriaLabel',
            'Llamar al teléfono fijo del comercio'
        )
    }
].filter((entry): entry is { value: string; ariaLabel: string } => entry.value !== undefined);
const hasChannels = phones.length > 0 || Boolean(workEmail) || Boolean(websiteHref);
const contactTitle = t('venue.detail.contactTitle', 'Contacto');

interface SocialLink {
    readonly key: keyof VenueSocialNetworks;
    readonly label: string;
    readonly icon: string;
}

// HOS-1076: `whatsapp` was removed from `VenueSocialNetworks` and MUST
// NOT be re-added here. It never existed in `SocialNetworkSchema` (the
// `socialNetworks` JSONB column's shape), so this render path — unlike
// accommodation's WhatsApp channel — would have published a number with no
// entitlement gate the instant anything ever wrote that key.
const SOCIAL_LINKS: readonly SocialLink[] = [
    { key: 'website', label: 'Sitio web', icon: '🌐' },
    { key: 'instagram', label: 'Instagram', icon: '📷' },
    { key: 'facebook', label: 'Facebook', icon: '📘' },
    { key: 'twitter', label: 'Twitter / X', icon: '🐦' },
    { key: 'youtube', label: 'YouTube', icon: '▶️' },
    { key: 'tiktok', label: 'TikTok', icon: '🎵' }
] as const;

const menuLabel = t('venue.detail.menu', 'Ver menú');
const socialLabel = t('venue.detail.social', 'Redes sociales');
---

<section class="venue-contact" id={VENUE_CONTACT_ANCHOR_ID} {...UMAMI_BLOCK_PROPS}>
    {hasChannels && (
        <div class="venue-contact__channels-block">
            <h3 class="venue-contact__social-title">{contactTitle}</h3>
            <div class="venue-contact__channels">
                {phones.map(({ value, ariaLabel }) => (
                    <a href={toTelHref(value)} class="venue-contact__link">
                        <PhoneIcon size={16} aria-hidden="true" />
                        <span>{value}</span>
                        <span class="sr-only">, {ariaLabel}</span>
                    </a>
                ))}
                {workEmail && (
                    <a
                        href={`mailto:${workEmail}`}
                        class="venue-contact__link"
                    >
                        <EmailIcon size={16} aria-hidden="true" />
                        <span>{workEmail}</span>
                        <span class="sr-only">, {t('venue.detail.contactEmailAriaLabel', 'Enviar email al comercio')}</span>
                    </a>
                )}
                {websiteHref && (
                    <a
                        href={websiteHref}
                        class="venue-contact__link"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <GlobeIcon size={16} aria-hidden="true" />
                        <span>{websiteHref.replace(/^https?:\/\//, '')}</span>
                        <span class="sr-only">, {t('venue.detail.contactWebsiteAriaLabel', 'Visitar el sitio web del comercio')}</span>
                    </a>
                )}
            </div>
        </div>
    )}

    {menuHref && (
        <div class="venue-contact__menu">
            <a
                href={menuHref}
                class="venue-contact__menu-btn"
                target="_blank"
                rel="noopener noreferrer"
            >
                {menuLabel} ↗
            </a>
        </div>
    )}

    {hasSocial && (
        <div class="venue-contact__social">
            <h3 class="venue-contact__social-title">{socialLabel}</h3>
            <ul class="venue-contact__social-list">
                {SOCIAL_LINKS.map(({ key, label, icon }) => {
                    const href = resolveSafeExternalUrl(socialNetworks?.[key]);
                    if (!href) return null;
                    return (
                        <li class="venue-contact__social-item">
                            <a
                                href={href}
                                class="venue-contact__social-link"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={label}
                            >
                                <span aria-hidden="true">{icon}</span>
                                <span>{label}</span>
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>
    )}
</section>

<style>
    .venue-contact {
        display: flex;
        flex-direction: column;
        gap: var(--space-5, 20px);
        margin-bottom: var(--space-6, 24px);
    }

    /* Menu CTA button */
    .venue-contact__menu-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 24px;
        border-radius: var(--radius-button, 8px);
        background-color: var(--brand-accent);
        /* SPEC-308: dark ink on the vibrant orange fill (white fails AA). */
        color: var(--accent-foreground);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: opacity 200ms ease-out;
    }

    .venue-contact__menu-btn:hover {
        opacity: 0.85;
    }

    .venue-contact__menu-btn:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    /* Business channels (HOS-2042) */
    .venue-contact__channels {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .venue-contact__link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--core-foreground);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        text-decoration: none;
    }

    .venue-contact__link:hover {
        color: var(--brand-primary);
    }

    .venue-contact__link:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    /* Social networks */
    .venue-contact__social-title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin-bottom: var(--space-3, 12px);
    }

    .venue-contact__social-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .venue-contact__social-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: var(--radius-pill, 9999px);
        border: 1px solid var(--border);
        background-color: var(--core-card);
        color: var(--core-foreground);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition:
            background-color 150ms ease-out,
            border-color 150ms ease-out;
    }

    .venue-contact__social-link:hover {
        background-color: var(--surface-warm);
        border-color: var(--brand-primary);
    }

    .venue-contact__social-link:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }
</style>
