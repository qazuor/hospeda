---
/**
 * @file VenueCard.astro
 * @description Card component for a venue listing (SPEC-239 T-053).
 * Mirrors the AccommodationCard pattern: featured image, type + priceRange badges,
 * rating stars + review count, destination name, and an optional "open now" badge
 * rendered by a client island so cached listings never freeze it.
 *
 * Hydration: the favorite button and the open-now badge are the only islands.
 */

import { FavoriteButton } from '@/components/shared/favorite/FavoriteButton.client';
import { VenueOpenNowBadge } from '@/components/venue/VenueOpenNowBadge.client';
import CardPromotionPills from '@/components/shared/cards/CardPromotionPills.astro';
import CardPriceFooter from '@/components/shared/cards/CardPriceFooter.astro';
import { selectCardPhotoBadge } from '@/components/shared/cards/utils/card-photo-badge';
import { resolveVenuePromoBadges } from '@/lib/promotions/promotion-badges';
import { Image } from 'astro:assets';
import { StarIcon, LocationIcon } from '@repo/icons';
import { isCloudinaryDeliveryUrl } from '@/lib/media';
import { buildUrl } from '@/lib/urls';
import { ENTITY_PUBLIC_PATHS } from '@/lib/seo/entity-public-urls';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import type { VenueCardData } from '@/data/types';

interface Props {
    readonly data: VenueCardData;
    readonly locale: SupportedLocale;
    /**
     * When true the card image renders with `loading="eager"` and
     * `fetchpriority="high"` — set this on cards in the first visible row
     * so the browser treats them as LCP candidates. Defaults to false.
     */
    readonly eager?: boolean;
}

const { data, locale, eager = false } = Astro.props;
const { t } = createTranslations(locale);

// Canonical venue detail path (HOS-1787 6.1): the card must link to the real
// page, never to the retired redirect. The segment lives in the shared
// entity → public-URL registry, not here.
const detailUrl = buildUrl({ locale, path: ENTITY_PUBLIC_PATHS.venue(data.slug) });

/** Type label from i18n (e.g. 'RESTAURANT' → 'Restaurante'). */
const typeLabel = t(`venue.types.${data.type}`, data.type);

/** Price range label from i18n (e.g. 'MID' → 'Moderado'). */
const priceRangeLabel = data.priceRange
    ? t('common.card.priceRange', undefined, { range: t(`venue.card.priceRange.${data.priceRange}`) })
    : null;

const fullStars = Math.floor(data.averageRating);

/** "Nuevo" badge: created less than 30 days ago. */
const photoBadge = selectCardPhotoBadge(data);

const featuredLabel = t('venue.card.featured', 'Destacado');
const promoBadges = resolveVenuePromoBadges({ badge: data.promoBadge });
const shouldProxyFeaturedImage = isCloudinaryDeliveryUrl(data.featuredImage.url);
---

<article class="venue-card">
    <div class="venue-card__link">
        <!-- IMAGE AREA -->
        <div class="venue-card__image-area">
            {data.featuredImage.url && !data.featuredImage.url.includes('placeholder') ? (
                shouldProxyFeaturedImage ? (
                    <Image
                        src={data.featuredImage.url}
                        alt={data.featuredImage.caption ?? data.name}
                        width={432}
                        height={220}
                        format="webp"
                        loading={eager ? 'eager' : 'lazy'}
                        fetchpriority={eager ? 'high' : undefined}
                        decoding="async"
                        class="venue-card__img"
                        data-fallback="/assets/images/placeholder-venue.svg"
                    />
                ) : (
                    <img
                        src={data.featuredImage.url}
                        alt={data.featuredImage.caption ?? data.name}
                        width="432"
                        height="220"
                        loading={eager ? 'eager' : 'lazy'}
                        fetchpriority={eager ? 'high' : undefined}
                        decoding="async"
                        class="venue-card__img"
                        data-fallback="/assets/images/placeholder-venue.svg"
                    />
                )
            ) : (
                <img
                    src={data.featuredImage.url || '/assets/images/placeholder-venue.svg'}
                    alt={data.featuredImage.caption ?? data.name}
                    width="432"
                    height="220"
                    loading={eager ? 'eager' : 'lazy'}
                    fetchpriority={eager ? 'high' : undefined}
                    decoding="async"
                    class="venue-card__img"
                    data-fallback="/assets/images/placeholder-venue.svg"
                />
            )}

            <!-- NEW corner badge -->
            {photoBadge === 'new' && (
                <div class="venue-card__status-corner" aria-hidden="true">
                    <span class="venue-card__status-text">
                        {t('home.accommodations.badge.new', 'Nuevo')}
                    </span>
                </div>
            )}

            <!-- Featured badge -->
            {photoBadge === 'featured' && (
                <div class="venue-card__featured-badge featured-badge">
                    <StarIcon size={12} weight="fill" aria-hidden="true" />
                    <span>{featuredLabel}</span>
                </div>
            )}


            <!-- Top-right actions: FavoriteButton island -->
            <div class="venue-card__actions">
                <FavoriteButton
                    client:visible
                    entityId={data.id}
                    entityType="VENUE"
                    count={data.bookmarkCount}
                    variant="standalone"
                    showCount={true}
                    locale={locale}
                />
            </div>

            <!-- Wave separator -->
            <div class="venue-card__wave" aria-hidden="true">
                <svg
                    viewBox="0 0 432 40"
                    preserveAspectRatio="none"
                    fill="var(--core-card, white)"
                >
                    <path d="M0 40V22C72 8 144 0 216 6C288 12 360 24 432 22V40H0Z" />
                </svg>
            </div>
        </div>

        <!-- CONTENT AREA -->
        <div class="venue-card__content">
            <!-- Type + Location row -->
            <div class="venue-card__category-row">
                <span class="venue-card__type-badge">{typeLabel}</span>
                <CardPromotionPills badges={promoBadges} windows={promoBadges.windows} locale={locale} />
                <div class="venue-card__location-bar">
                    <LocationIcon size={12} weight="fill" aria-hidden="true" />
                    <span>{data.destinationName}</span>
                </div>
            </div>

            <!-- Name -->
            <h3 class="venue-card__name">{data.name}</h3>

            <!-- Summary -->
            <p class="venue-card__description">{data.summary}</p>

            <!-- Stars + rating -->
            {data.averageRating > 0 && (
                <div class="venue-card__stars">
                    {Array.from({ length: 5 }).map((_, i) => (
                        <span
                            class={
                                i < fullStars
                                    ? 'venue-card__star--filled'
                                    : 'venue-card__star--empty'
                            }
                        >
                            <StarIcon
                                size={14}
                                weight={i < fullStars ? 'fill' : 'regular'}
                                aria-hidden="true"
                            />
                        </span>
                    ))}
                    <span class="venue-card__rating-value">
                        {data.averageRating.toFixed(1)}
                    </span>
                    {data.reviewsCount > 0 && (
                        <span class="venue-card__reviews-count">
                            ({data.reviewsCount} {t('common.reviews', 'reseñas')})
                        </span>
                    )}
                </div>
            )}

            <!-- Divider -->

            <!-- Price range + CTA row -->
            <CardPriceFooter locale={locale} href={detailUrl} listingName={data.name} price={priceRangeLabel} cta={t('common.card.viewVenue')}>
                <Fragment slot="meta">
                    {data.openingHours && <VenueOpenNowBadge client:idle variant="inline" locale={locale} openingHours={data.openingHours} />}
                </Fragment>
            </CardPriceFooter>
        </div>
    </div>
</article>

<style>
    @import "./VenueCard.css";
</style>
