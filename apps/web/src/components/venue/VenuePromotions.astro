---
/**
 * @file VenuePromotions.astro
 * @description The venue detail page's promotions block (HOS-2589 §7.6).
 *
 * The page is session-blind and cached, so this block carries no promotion data:
 * it mounts the per-reader island, which reads the visible / blurred cards of this
 * venue in the browser. A wrapper is needed because the page renders its blocks
 * through a dynamic component map, where a hydration directive cannot be written.
 */
import { PlacePromotions } from '@/components/promotions/PlacePromotions.client';
import { getApiUrl } from '@/lib/env';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly venueId: string;
    readonly locale: SupportedLocale;
}
const { venueId, locale } = Astro.props;
---

<PlacePromotions client:idle locale={locale} apiUrl={getApiUrl()} entityType="venue" entityId={venueId} />
