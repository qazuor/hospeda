---
/**
 * @file OpeningHoursSection.astro
 * @description Renders a weekly opening-hours grid for a venue listing
 * (SPEC-239 T-054). The client highlights today's row because this page is
 * cached (`cacheClass: 'detail'`); it uses the HOS-1863 venue time zone. Handles closed days, 24-hour days,
 * and missing close times.
 *
 * The day-key ordering follows the Monday-first convention standard in the
 * Spanish-speaking Argentina market (ISO week: Mon–Sun).
 *
 * All computation delegates to the pure `venue-hours` helpers so both
 * this component and the "open now" badge on the listing card share the same
 * logic (single source of truth).
 */

import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import type { VenueOpeningHoursEntry } from '@/data/types';
import { ORDERED_DAY_KEYS } from '@/lib/venue-hours';
import { OpeningHoursGrid } from '@/components/venue/OpeningHoursGrid.client';

interface Props {
    /** Opening hours map keyed by lower-cased English day names. */
    readonly openingHours: Record<string, VenueOpeningHoursEntry>;
    readonly locale: SupportedLocale;
}

const { openingHours, locale } = Astro.props;
const { t } = createTranslations(locale);

/**
 * Map API day keys to i18n keys so the labels respect the active locale.
 * We don't have `venue.detail.openingHours.days.*` keys in the JSON yet,
 * so we fall back to hard-coded Spanish labels via t() with defaults.
 * When the locale files add dedicated keys they'll be picked up automatically.
 */
const DAY_LABELS: Record<string, string> = {
    monday: t('venue.detail.openingHours.monday'),
    tuesday: t('venue.detail.openingHours.tuesday'),
    wednesday: t('venue.detail.openingHours.wednesday'),
    thursday: t('venue.detail.openingHours.thursday'),
    friday: t('venue.detail.openingHours.friday'),
    saturday: t('venue.detail.openingHours.saturday'),
    sunday: t('venue.detail.openingHours.sunday')
};

const DAY_INDEX_BY_KEY: Record<string, number> = {
    sunday: 0,
    monday: 1,
    tuesday: 2,
    wednesday: 3,
    thursday: 4,
    friday: 5,
    saturday: 6
};

const closedLabel = t('venue.detail.openingHours.closed', 'Cerrado');
const todayLabel = t('venue.detail.openingHours.today', 'Hoy');
const sectionTitle = t('venue.detail.openingHours.title', 'Horarios de atención');

/**
 * Build row data for each day in Mon→Sun order.
 */
const rows = ORDERED_DAY_KEYS.map((dayKey) => {
    const entry: VenueOpeningHoursEntry | undefined = openingHours[dayKey];
    const label = DAY_LABELS[dayKey] ?? dayKey;

    const isClosed = !entry || !entry.isOpen || entry.shifts.length === 0;
    const hoursText =
        entry && !isClosed
            ? entry.shifts.map((shift) => `${shift.open} – ${shift.close}`).join(', ')
            : closedLabel;

    return { dayKey, label, hoursText, isClosed };
});
---

<section class="opening-hours">
    <h2 class="opening-hours__title">{sectionTitle}</h2>

    <OpeningHoursGrid client:visible rows={rows} todayLabel={todayLabel} dayIndexByKey={DAY_INDEX_BY_KEY} />
</section>

<style>
    .opening-hours {
        margin-bottom: var(--space-6, 24px);
    }

    .opening-hours__title {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin-bottom: var(--space-4, 16px);
    }

</style>
