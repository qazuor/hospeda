---
/**
 * @file VenueDescription.astro
 * @description Plain description section for a venue listing (SPEC-239 T-054).
 *
 * Uses the same render pattern as the accommodation Description component:
 * - `richDescription` (markdown) is rendered via `renderContent` when present.
 * - `description` (plain text) is rendered via `renderPlain` as an escaped fallback.
 * - Text is emitted as plain child nodes (NOT via `set:html`) to avoid XSS.
 *
 * Mirrors apps/web/src/components/accommodation/Description.astro.
 *
 * Slot 3 («description», HOS-2579): the body sits inside `ClampedText` (4
 * lines on mobile, 8 on desktop, «Leer más»); the full text always stays in
 * the DOM. The summary stays outside the clamp, as on accommodation.
 */

import ClampedText from '@/components/listing/ClampedText.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { renderContent } from '@/lib/render-content';
import { stripMarkdownPlain } from '@/lib/render-plain';
import { isRedundantText } from '@/lib/is-redundant-text';

interface Props {
    /** Short summary shown above the full description with a warm accent border. */
    readonly summary: string;
    /** Plain-text description. Emitted as a text child (HTML-escaped). */
    readonly descriptionText: string;
    /**
     * Optional rich-text (markdown) description. When present it supersedes
     * `descriptionText` and is rendered to HTML via `renderContent`.
     */
    readonly richDescription?: string | null;
    /** Page locale, for the «Leer más» toggle labels. */
    readonly locale: SupportedLocale;
}

const { summary, descriptionText, richDescription, locale } = Astro.props;

// Render rich markdown to HTML only when the field is present and non-empty.
const richHtml =
    richDescription && richDescription.trim().length > 0
        ? renderContent({ raw: richDescription, siteOrigin: '' })
        : null;
const bodyText = richHtml && richDescription ? stripMarkdownPlain(richDescription) : descriptionText;
const showSummary = summary && !isRedundantText({ a: summary, b: bodyText });
const showBody = (richHtml || descriptionText) && !(showSummary && isRedundantText({ a: bodyText, b: summary }));
---

{showSummary && (
    <div class="venue-desc__summary">
        <p>{summary}</p>
    </div>
)}

{showBody && (
    <ClampedText lang={locale}>
        {richHtml ? (
            <div class="venue-desc__body venue-desc__body--rich" set:html={richHtml} />
        ) : (
            <div class="venue-desc__body">
                <p>{descriptionText}</p>
            </div>
        )}
    </ClampedText>
)}

<style>
    .venue-desc__summary {
        background-color: var(--surface-warm);
        border-left: 4px solid var(--brand-accent);
        border-radius: var(--radius-button, 8px);
        padding: var(--space-4, 16px) var(--space-5, 20px);
        margin-bottom: var(--space-5, 20px);
    }

    .venue-desc__summary p {
        font-family: var(--font-sans);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--core-foreground);
        margin: 0;
    }

    .venue-desc__body {
        font-family: var(--font-sans);
        font-size: 1rem;
        line-height: 1.7;
        color: var(--core-foreground);
    }

    .venue-desc__body p {
        margin-bottom: var(--space-3, 12px);
    }

    .venue-desc__body p:last-child {
        margin-bottom: 0;
    }

    /* Rich-text heading styles */
    .venue-desc__body--rich :global(h2),
    .venue-desc__body--rich :global(h3) {
        font-family: var(--font-heading);
        font-weight: 600;
        color: var(--core-foreground);
        margin-bottom: var(--space-2, 8px);
    }

    .venue-desc__body--rich :global(strong) {
        font-weight: 700;
    }

    .venue-desc__body--rich :global(ul),
    .venue-desc__body--rich :global(ol) {
        padding-left: var(--space-5, 20px);
    }

    .venue-desc__body--rich :global(li) {
        margin-bottom: var(--space-1, 4px);
    }
</style>
