---
/**
 * @file GastronomyMenu.astro
 * @description Renders a gastronomy listing's menu on the public detail page
 * (HOS-895 PR2).
 *
 * ## The hierarchy, and why it is "show all", not "pick one"
 *
 * A venue may set THREE independent things: a structured carta (sections and
 * dishes), an uploaded photo/PDF, and an external link (rendered separately by
 * `GastronomyContactBlock.astro`, unaffected by this component). None is
 * required and none excludes the others — PR1's own schema doc says so
 * explicitly ("All three may be set at once and none is required").
 *
 * This component does NOT hide the attachment when a structured carta exists,
 * or vice versa. The structured carta is the best experience and renders
 * FIRST when present — full sections and dishes, indexable HTML, no click
 * required — with the uploaded photo/PDF rendered below it as a secondary
 * block when ALSO present. A venue that typed ten dishes but still has a
 * scanned photo of the full seasonal specials both get shown; picking one
 * would silently drop content the owner chose to publish. The external link
 * stays the last resort by construction: it is the only shape that predates
 * HOS-895 and the only one still free on every tier (see the entitlement
 * gate note below), and `GastronomyContactBlock` already renders it as a
 * plain CTA regardless of what this component shows.
 *
 * ## The gate
 *
 * Both `menuSections` and the attachment (`fileUrl`/`fileKind`) arrive
 * PRE-FILTERED by the API (`gastronomy/public/getBySlug.ts`): withheld,
 * live, when the owner's CURRENT plan does not grant
 * `manage_gastronomy_menu` (HOS-895 PR2, owner decision 2026-09-02). This
 * component has no gate of its own to apply — an owner without the
 * entitlement simply never has non-empty props to render, the same way
 * `GastronomyContactBlock` cannot tell a "no menuUrl" venue from a redacted
 * one.
 *
 * A PDF and an image are NOT rendered the same way: `fileKind` decides
 * between an inline `<img>` and a "view PDF" link.
 *
 * ## The per-dish photo (HOS-1045)
 *
 * `item.photoUrl` arrives pre-filtered by the SAME route, under a NARROWER
 * gate: the carta needs `manage_gastronomy_menu` (gastronomy-pro), a picture on
 * a dish of it needs `menu_item_photos` (premium). So a carta with every
 * `photoUrl` null is the ordinary shape for a `-pro` venue and is not a bug —
 * this component has no gate of its own to apply and never asks why.
 *
 * The `<img>` is the LAST child of the row and is `loading="lazy"`, so a
 * forty-dish carta does not fetch forty images before the page settles. Its
 * `alt` falls back to the dish's own name rather than to `''`: an empty alt
 * says "decorative", and a photo of the dish being described is not.
 */

import type { GastronomyMenuItem, GastronomyMenuSection } from '@/data/types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { resolveI18nText } from '@/lib/resolve-i18n-text';
import { resolveSafeExternalUrl } from '@/lib/safe-external-url';
import { formatPrice } from '@/lib/format-utils';

interface Props {
    readonly menuSections?: readonly GastronomyMenuSection[];
    readonly fileUrl?: string | null;
    readonly fileKind?: 'image' | 'pdf' | null;
    readonly locale: SupportedLocale;
}

const { menuSections = [], fileUrl, fileKind, locale } = Astro.props;
const { t } = createTranslations(locale);

const hasStructuredMenu = menuSections.length > 0;

/**
 * The three-way language switcher on the carta (HOS-1043).
 *
 * Unlike `gastronomy_faqs.question_i18n` (resolved server-side to the page's
 * OWN locale, with no client-side switch — see `resolveFaqField` in
 * `transforms.ts`), the carta renders a switcher independent of the page's
 * URL locale: a Brazilian visitor reading the Spanish page may still want to
 * read the menu in Portuguese without leaving it. So every translated leg the
 * API sent travels to the browser as a `data-*` attribute, and a small inline
 * script swaps `textContent` on click — no island, no framework, matching the
 * platform's "Astro by default, minimal client JS" rule for `apps/web`.
 *
 * `hasTranslations` gates the switcher's own visibility: an owner without
 * `multilingual_gastronomy_menu` (or one who never translated) has every
 * `nameI18n`/`descriptionI18n` `null`, and a switcher with nothing to switch
 * to would be a dead control.
 */
const hasTranslations = menuSections.some(
    (section) =>
        section.nameI18n !== null ||
        section.descriptionI18n !== null ||
        section.items.some((item) => item.nameI18n !== null || item.descriptionI18n !== null)
);

/** One locale's text for a translatable field, falling back to the legacy `es` source. */
function localeText(
    i18n: GastronomyMenuSection['nameI18n'],
    legacy: string,
    lang: SupportedLocale
): string {
    return i18n ? resolveI18nText(i18n, lang) || legacy : legacy;
}

/** The three `data-name-*` attributes a name element carries for the switcher. */
function nameLangAttrs(i18n: GastronomyMenuItem['nameI18n'], legacy: string) {
    return {
        'data-name-es': i18n?.es || legacy,
        'data-name-en': i18n?.en || legacy,
        'data-name-pt': i18n?.pt || legacy
    };
}

/** The three `data-desc-*` attributes a description element carries for the switcher. */
function descLangAttrs(i18n: GastronomyMenuItem['descriptionI18n'], legacy: string) {
    return {
        'data-desc-es': i18n?.es || legacy,
        'data-desc-en': i18n?.en || legacy,
        'data-desc-pt': i18n?.pt || legacy
    };
}

const LANGUAGE_LABELS: Record<SupportedLocale, string> = { es: 'ES', en: 'EN', pt: 'PT' };
// `fileKind` is required by the schema whenever `fileUrl` is set (the API
// never reports "half an attachment" — see GastronomyMenuFileSchema's doc),
// but the safe-URL check still runs before anything is rendered.
// `resolveSafeExternalUrl` already tolerates `null`/`undefined`, so this is a
// direct binding the outbound-href-sanitization guard can prove — a ternary
// wrapping the call is invisible to its binding scanner.
const safeFileUrl = resolveSafeExternalUrl(fileUrl);
const hasFile = Boolean(safeFileUrl && fileKind);

if (!hasStructuredMenu && !hasFile) {
    // Nothing to render — GastronomyContactBlock's external link (if any) is
    // this listing's only menu content.
    return;
}

// Nested under `menuCarta`, NOT `menu` — `gastronomy.detail.menu` is already a
// leaf string ("Ver menú", the external-link CTA label in
// GastronomyContactBlock.astro), and a JSON key cannot be both a string and
// an object subtree.
const title = t('gastronomy.detail.menuCarta.title', 'Carta');
const attachmentImageTitle = t('gastronomy.detail.menuCarta.attachmentImage', 'Carta en imagen');
const attachmentPdfTitle = t('gastronomy.detail.menuCarta.attachmentPdf', 'Carta en PDF');
const viewPdfLabel = t('gastronomy.detail.menuCarta.viewPdf', 'Ver carta en PDF');
const consultLabel = t('gastronomy.detail.menuCarta.consultPrice', 'A consultar');
const unavailableLabel = t('gastronomy.detail.menuCarta.unavailable', 'No disponible');
const switchLanguageLabel = t('gastronomy.detail.menuCarta.switchLanguage', 'Ver la carta en:');
---

<section class="gastro-menu" id="gastro-menu">
    <h2 class="gastro-menu__title">{title}</h2>

    {hasStructuredMenu && hasTranslations && (
        <div
            class="gastro-menu__lang-switch"
            role="group"
            aria-label={switchLanguageLabel}
        >
            <span class="gastro-menu__lang-switch-label">{switchLanguageLabel}</span>
            {Object.entries(LANGUAGE_LABELS).map(([lang, label]) => (
                <button
                    type="button"
                    class="gastro-menu__lang-button"
                    data-menu-lang={lang}
                    aria-pressed={lang === locale ? 'true' : 'false'}
                >
                    {label}
                </button>
            ))}
        </div>
    )}

    {hasStructuredMenu && (
        <div class="gastro-menu__sections">
            {menuSections.map((section) => (
                <div class="gastro-menu__section">
                    <h3
                        class="gastro-menu__section-name"
                        {...nameLangAttrs(section.nameI18n, section.name)}
                    >
                        {localeText(section.nameI18n, section.name, locale)}
                    </h3>
                    {section.description && (
                        <p
                            class="gastro-menu__section-description"
                            {...descLangAttrs(section.descriptionI18n, section.description)}
                        >
                            {localeText(section.descriptionI18n, section.description, locale)}
                        </p>
                    )}
                    <ul class="gastro-menu__items">
                        {section.items.map((item) => (
                            <li
                                class="gastro-menu__item"
                                data-unavailable={item.isAvailable ? undefined : 'true'}
                            >
                                <div class="gastro-menu__item-main">
                                    <span
                                        class="gastro-menu__item-name"
                                        {...nameLangAttrs(item.nameI18n, item.name)}
                                    >
                                        {localeText(item.nameI18n, item.name, locale)}
                                    </span>
                                    <span class="gastro-menu__item-price">
                                        {item.priceCents == null
                                            ? consultLabel
                                            : formatPrice({ amount: item.priceCents / 100, locale })}
                                    </span>
                                </div>
                                {item.description && (
                                    <p
                                        class="gastro-menu__item-description"
                                        {...descLangAttrs(item.descriptionI18n, item.description)}
                                    >
                                        {localeText(item.descriptionI18n, item.description, locale)}
                                    </p>
                                )}
                                {!item.isAvailable && (
                                    <span class="gastro-menu__item-badge">{unavailableLabel}</span>
                                )}
                                {resolveSafeExternalUrl(item.photoUrl) && (
                                    <img
                                        src={resolveSafeExternalUrl(item.photoUrl)}
                                        alt={item.photoAlt || item.name}
                                        class="gastro-menu__item-photo"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    )}

    {hasFile && safeFileUrl && (
        <div class="gastro-menu__attachment">
            {fileKind === 'image' ? (
                <>
                    <h3 class="gastro-menu__attachment-title">{attachmentImageTitle}</h3>
                    <a href={safeFileUrl} target="_blank" rel="noopener noreferrer">
                        <img
                            src={safeFileUrl}
                            alt={attachmentImageTitle}
                            class="gastro-menu__attachment-image"
                            loading="lazy"
                        />
                    </a>
                </>
            ) : (
                <>
                    <h3 class="gastro-menu__attachment-title">{attachmentPdfTitle}</h3>
                    <a
                        href={safeFileUrl}
                        class="gastro-menu__attachment-pdf-link"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {viewPdfLabel} ↗
                    </a>
                </>
            )}
        </div>
    )}
</section>

{
    hasTranslations && (
        /**
         * The carta's language switcher (HOS-1043) — vanilla JS, no island.
         *
         * Scoped to `#gastro-menu` (the section's own id, unique per page) so
         * two instances never fight — not a concern today, but the query
         * would otherwise select from the WHOLE document. Reads the
         * `data-name-*`/`data-desc-*` attributes rendered onto each name and
         * description element (see `nameLangAttrs`/`descLangAttrs` above) and
         * swaps `textContent` on click. A description's visibility toggles
         * with it: a dish whose only content in a given language is its name
         * must not keep showing a stale paragraph from the previous one.
         */
        <script>
            /** Capitalizes a locale code ("en" → "En") to match the `data-name-En` casing camelCase turns `data-name-en` into. */
            function capitalize(lang: string): string {
                return lang.charAt(0).toUpperCase() + lang.slice(1);
            }

            const root = document.getElementById('gastro-menu');
            if (root) {
                root.addEventListener('click', (event) => {
                    const target = event.target;
                    if (!(target instanceof Element)) return;
                    const button = target.closest<HTMLElement>('[data-menu-lang]');
                    if (!button) return;

                    const lang = button.dataset.menuLang;
                    if (!lang) return;

                    const suffix = capitalize(lang);

                    for (const b of root.querySelectorAll<HTMLElement>('[data-menu-lang]')) {
                        b.setAttribute('aria-pressed', String(b === button));
                    }

                    for (const el of root.querySelectorAll<HTMLElement>('[data-name-es]')) {
                        const text = (el.dataset as Record<string, string | undefined>)[`name${suffix}`];
                        if (text) el.textContent = text;
                    }

                    for (const el of root.querySelectorAll<HTMLElement>('[data-desc-es]')) {
                        const text = (el.dataset as Record<string, string | undefined>)[`desc${suffix}`];
                        if (text) {
                            el.textContent = text;
                            el.hidden = false;
                        }
                    }
                });
            }
        </script>
    )
}

<style>
    .gastro-menu {
        display: flex;
        flex-direction: column;
        gap: var(--space-5, 20px);
        margin-bottom: var(--space-6, 24px);
    }

    .gastro-menu__title {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0;
    }

    /* HOS-1043 — the language switcher. */
    .gastro-menu__lang-switch {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-2, 8px);
    }

    .gastro-menu__lang-switch-label {
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: var(--core-muted-foreground);
    }

    .gastro-menu__lang-button {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: var(--radius-button, 8px);
        border: 1px solid var(--border);
        background: transparent;
        color: var(--core-foreground);
        cursor: pointer;
        transition: background-color 150ms ease-out;
    }

    .gastro-menu__lang-button:hover {
        background-color: var(--muted, rgba(0, 0, 0, 0.05));
    }

    .gastro-menu__lang-button[aria-pressed='true'] {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
        color: var(--primary-foreground, #fff);
    }

    .gastro-menu__lang-button:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    .gastro-menu__sections {
        display: flex;
        flex-direction: column;
        gap: var(--space-5, 20px);
    }

    .gastro-menu__section-name {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0 0 var(--space-1, 4px);
    }

    .gastro-menu__section-description {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        color: var(--core-muted-foreground);
        margin: 0 0 var(--space-3, 12px);
    }

    .gastro-menu__items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 12px);
    }

    .gastro-menu__item {
        border-bottom: 1px dashed var(--border);
        padding-bottom: var(--space-2, 8px);
    }

    .gastro-menu__item:last-child {
        border-bottom: none;
    }

    .gastro-menu__item-main {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-3, 12px);
        font-family: var(--font-sans);
    }

    .gastro-menu__item-name {
        font-weight: 600;
        color: var(--core-foreground);
    }

    .gastro-menu__item[data-unavailable='true'] .gastro-menu__item-name {
        color: var(--core-muted-foreground);
        text-decoration: line-through;
    }

    .gastro-menu__item-price {
        font-weight: 600;
        color: var(--brand-primary);
        white-space: nowrap;
    }

    .gastro-menu__item-description {
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: var(--core-muted-foreground);
        margin: 4px 0 0;
    }

    /*
     * HOS-1045. Capped rather than full-bleed: the carta is a LIST and the
     * photos are evidence for its rows, so a picture that grew to the column
     * width would turn every dish into a card and bury the prices the list
     * exists to show.
     */
    .gastro-menu__item-photo {
        display: block;
        margin-top: var(--space-2, 8px);
        max-width: 220px;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: var(--radius-card, 24px);
        border: 1px solid var(--border);
    }

    .gastro-menu__item[data-unavailable='true'] .gastro-menu__item-photo {
        opacity: 0.55;
    }

    .gastro-menu__item-badge {
        display: inline-block;
        margin-top: 4px;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--core-muted-foreground);
    }

    .gastro-menu__attachment {
        display: flex;
        flex-direction: column;
        gap: var(--space-2, 8px);
    }

    .gastro-menu__attachment-title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0;
    }

    .gastro-menu__attachment-image {
        max-width: 100%;
        border-radius: var(--radius-card, 24px);
        border: 1px solid var(--border);
    }

    .gastro-menu__attachment-pdf-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 24px;
        border-radius: var(--radius-button, 8px);
        background-color: var(--brand-accent);
        color: var(--accent-foreground);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: opacity 200ms ease-out;
        width: fit-content;
    }

    .gastro-menu__attachment-pdf-link:hover {
        opacity: 0.85;
    }

    .gastro-menu__attachment-pdf-link:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }
</style>
