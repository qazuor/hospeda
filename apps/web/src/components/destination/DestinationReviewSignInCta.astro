---
/**
 * @file DestinationReviewSignInCta.astro
 * @description Static (zero-JS) sidebar card inviting a logged-out visitor to
 * sign in and review the destination.
 *
 * Since HOS-369 WB0-7 this is not a page-level branch any more: the destination
 * page always renders it as `DestinationReviewSidebarCard`'s slot children, so
 * it is what the server emits and what the edge caches. The island replaces it
 * once a session resolves in the browser.
 *
 * Presentation lives in the shared `SignInCtaCard`; this component only owns
 * the destination-review copy.
 */
import SignInCtaCard from '@/components/shared/auth/SignInCtaCard.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly locale: SupportedLocale;
    /** The current destination path (e.g. "destinos/entre-rios/colon") used
     *  to build the returnUrl query param on the sign-in link. */
    readonly returnPath: string;
    /** `card` renders the sidebar card; `inline` renders just the sign-in link. */
    readonly variant?: 'card' | 'inline';
}

const { locale, returnPath, variant = 'card' } = Astro.props;
const { t } = createTranslations(locale);
---

<SignInCtaCard
    locale={locale}
    returnPath={returnPath}
    variant={variant}
    icon="star"
    title={t('review.destinationSidebar.title', 'Tu opinión')}
    hint={t('review.destinationSidebar.signInCtaHint', 'Necesitás una cuenta para dejar tu reseña.')}
    ctaLabel={t('review.destinationSidebar.signInCta', 'Iniciá sesión para opinar')}
/>
