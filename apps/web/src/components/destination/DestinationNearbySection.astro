---
/**
 * @file DestinationNearbySection.astro
 * @description "Other destinations in the area" section on destination detail page.
 * Siblings are derived from the parent's children in the destination hierarchy —
 * NOT by geographic km-radius. Copy says "en la zona / en la región" which is
 * an honest representation of the heuristic.
 * Renders nothing when destinations array is empty.
 * Caps visible cards at 4 in a 1/2/3/4-col responsive grid.
 */

import DestinationCard from '@/components/shared/cards/DestinationCard.astro';
import { toDestinationCardProps } from '@/lib/api/transforms';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly destinations: ReadonlyArray<unknown>;
    readonly locale: SupportedLocale;
    readonly variant?: 'nearby' | 'cities';
}

const { destinations, locale, variant = 'nearby' } = Astro.props;
const isCities = variant === 'cities';
const headingId = isCities ? 'destination-cities' : 'dest-nearby-title';
const { t } = createTranslations(locale);

if (destinations.length === 0) return;

const MAX_VISIBLE = 4;
const visibleDestinations = (destinations as Record<string, unknown>[])
    .slice(0, isCities ? undefined : MAX_VISIBLE)
    .map((item) => toDestinationCardProps({ item, locale }));
---

<section class="dest-nearby" aria-labelledby={headingId}>
    <header class="dest-nearby__header">
        <h2 class="dest-nearby__title" id={headingId}>
            {isCities ? t('destinations.detail.nearby.exploreCities') : t('destinations.detail.nearby.title')}
        </h2>
        {!isCities && <p class="dest-nearby__subtitle">
            {t('destinations.detail.nearby.subtitle')}
        </p>}
    </header>

    <div class:list={['dest-nearby__grid', { 'dest-nearby__grid--cities': isCities }]}>
        {visibleDestinations.map((card) => (
            <DestinationCard
                destination={card}
                locale={locale}
                variant="grid"
            />
        ))}
    </div>
</section>

<style>
    .dest-nearby {
        padding: 2rem 0;
    }

    .dest-nearby__header {
        margin-bottom: 1.5rem;
    }

    .dest-nearby__title {
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 1.5vw + 0.75rem, 1.75rem);
        font-weight: 700;
        color: var(--core-foreground);
        margin: 0 0 0.375rem;
    }

    .dest-nearby__subtitle {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        color: var(--core-muted-foreground);
        margin: 0;
    }

    .dest-nearby__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 480px) {
        .dest-nearby__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 768px) {
        .dest-nearby__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .dest-nearby__grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .dest-nearby__grid--cities {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
    #destination-cities {
        scroll-margin-top: calc(var(--navbar-height, 80px) + var(--wave-bar-compact, 72px));
    }
</style>
