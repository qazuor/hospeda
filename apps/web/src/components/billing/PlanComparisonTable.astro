---
/**
 * @file PlanComparisonTable.astro
 * @description Curated plan comparison table. The row/group model and the cell
 * resolver live in `plan-comparison-rows.ts` — this component only renders
 * them. Do NOT re-declare the rows here: until HOS-329 this file carried its
 * own inline copy, which drifted from the module and left the catalog-veracity
 * guard validating data the site never rendered.
 *
 * Owner audience filters out complex plans and renders a teaser note below.
 * Tourist audience shows experience + AI groups.
 *
 * Keeps table semantics while using stacked benefit rows for up to two plans
 * on mobile and horizontal scrolling for wider comparisons.
 *
 * @prop locale - Active locale.
 * @prop plans - Plans from the API (may include complex plans for owners —
 *   they are filtered out inside this component).
 * @prop audience - `'owner'` or `'tourist'`.
 * @prop intlLocale - BCP-47 locale string for Intl.NumberFormat.
 * @prop touristVipPlan - The sellable Tourist VIP plan; the `asTourist` group
 *   resolves an inheriting plan's cells against it (HOS-2398).
 */

import { CheckIcon, MinusIcon } from '@repo/icons';
import PlanComparisonHeaderActions from './PlanComparisonHeaderActions.astro';
import './comparison-scroll.css';
import { COMPARISON_ROW_ICONS } from '@/components/billing/comparison-row-icons';
import { getLineMarkText } from '@/components/billing/plan-comparison-catalog-rows';
import { resolveGroupCell } from '@/components/billing/plan-comparison-source';
import {
	comparisonScrollsOnMobile,
	getActivePlans,
	getComparisonGroups,
	getVisibleRows
} from '@/components/billing/plan-comparison-table.helpers';
import type { PricingAudience } from '@/lib/billing-i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { getComparisonGroupLabel, getPlanName } from '@/lib/billing-i18n';
import type { PublicPlanData } from '@/lib/billing/fetch-plans';
import type { TouristVipPlanCells } from '@/lib/billing/tourist-vip-benefits';

interface Props {
	readonly locale: SupportedLocale;
	readonly plans: readonly PublicPlanData[];
	/**
	 * Which audience's curated rows to render.
	 *
	 * `'partner'` is deliberately NOT accepted (HOS-1032). Every partner tier
	 * carries `entitlements: []` and `limits: []` — what separates silver from
	 * gold is the `/partners/<slug>/` page, which the entitlement engine knows
	 * nothing about — so a comparison table for aliados would be a wall of "no"
	 * that under-sells both tiers. The plan cards already list what each level
	 * gives (HOS-941 D-13), which is the job this table would be doing. The type
	 * is what stops that table from being added by analogy later.
	 */
	readonly audience: Exclude<PricingAudience, 'partner'>;
	readonly intlLocale: string;
	/** Optional CTA link for venue and experience columns only (HOS-1032). */
	readonly ctaHref?: string;
	/**
	 * The sellable Tourist VIP plan, read from the tourist catalog. An owner plan
	 * that inherits Tourist VIP gets its "as tourist" cells from THIS plan, not
	 * from its own rows (HOS-2398). `null` when the read failed or the audience
	 * has no inherited group.
	 */
	readonly touristVipPlan?: TouristVipPlanCells | null;
}

const { locale, plans, audience, intlLocale, ctaHref, touristVipPlan = null } = Astro.props;
const { t } = createTranslations(locale);

const unlimitedLabel = t('billing.comparison.unlimited', 'Ilimitado');
const notIncludedLabel = t('billing.comparison.notIncluded', 'No incluido');
const includedLabel = t('billing.comparison.included', 'Incluido');
const upcomingLabel = t('billing.comparison.upcoming', 'Próximamente');

const isAccommodationAudience = audience === 'owner' || audience === 'tourist';

// Complex plans are included by the /planes/comparar/ page but must NOT appear
// as columns here; the helper re-filters so columns are always active-only and
// sortOrder-sorted, and the teaser below covers the complex plans (HOS-1032).
const activePlans = getActivePlans({ plans, audience });
const scrollsOnMobile = comparisonScrollsOnMobile({ planCount: activePlans.length });
const groups = getComparisonGroups(audience);

---

<div class="comparison-scroll" data-comparison-scroll>
<div class="comparison-table__wrapper" data-comparison-viewport role="region" aria-label={t('pricing.comparison.link', 'Comparativa')} tabindex="0">
	<table class:list={['comparison-table', { 'comparison-table--fits-mobile': !scrollsOnMobile }]} role="table">
		<thead>
			<tr>
				<th scope="col" class="comparison-table__label-col">
					<span class="sr-only">{t('pricing.features.label', 'Incluye')}</span>
				</th>
				{activePlans.map((plan) => (
					<th scope="col" class="comparison-table__plan-col">
						<span class="comparison-table__plan-name">{getPlanName({ plan, t })}</span>
						<PlanComparisonHeaderActions plan={plan} locale={locale} intlLocale={intlLocale}
							touristPlans={audience === 'tourist' ? activePlans : undefined}
							ctaHref={isAccommodationAudience ? undefined : ctaHref} />
					</th>
				))}
			</tr>
		</thead>
		{groups.map((group) => (
			<tbody>
				<tr class="comparison-table__group-header">
					<th scope="rowgroup" colspan={activePlans.length + 1}>
						{getComparisonGroupLabel({ group: group.id, t })}
					</th>
				</tr>
				{getVisibleRows({ rows: group.rows, plans: activePlans, group, touristVipPlan }).map((row) => {
					const RowIcon = row.icon ?? COMPARISON_ROW_ICONS[row.id];
					// Per-row descriptive text (SPEC-299). Empty fallback → not rendered.
					const rowDesc = t(`billing.comparison.rowDesc.${row.id}`, '');
					return (
					<tr>
						<th scope="row" class="comparison-table__label-col">
							<span class="comparison-table__row-label">
								{RowIcon && (
									<span class="comparison-table__row-icon" aria-hidden="true">
										<RowIcon size="xs" weight="regular" color="currentColor" />
									</span>
								)}
								{t(row.labelKey)}
								{row.status === 'upcoming' && (
									<span class="comparison-table__badge--upcoming">{upcomingLabel}</span>
								)}
							</span>
							{row.lineMarks?.length ? (
								<span class="comparison-table__row-desc comparison-table__row-mark">
									{getLineMarkText({ lineMarks: row.lineMarks, t })}
								</span>
							) : null}
							{rowDesc && (
								<span class="comparison-table__row-desc">{rowDesc}</span>
							)}
							{row.noteKey && (
								<span class="comparison-table__row-note">{t(row.noteKey)}</span>
							)}
						</th>
						{activePlans.map((plan) => {
							const result = resolveGroupCell({ group, cell: row.cell, plan, touristVipPlan });
							const isNumeric = typeof result === 'number' || result === 'unlimited';
							return (
								<td class:list={['comparison-table__cell', { 'comparison-table__cell--limit': isNumeric }]}>
									{result === 'yes' ? (
										<span class="comparison-table__icon comparison-table__icon--included" role="img" aria-label={includedLabel}>
											<CheckIcon size="sm" weight="bold" color="currentColor" />
										</span>
									) : result === 'no' ? (
										<span class="comparison-table__icon comparison-table__icon--not-included" role="img" aria-label={notIncludedLabel}>
											<MinusIcon size="sm" weight="regular" color="currentColor" />
										</span>
									) : (
										<span class:list={['comparison-table__limit-value', { 'comparison-table__limit-value--unlimited': result === 'unlimited' }]}>
											{result === 'unlimited' ? unlimitedLabel : result}
										</span>
									)}
								</td>
							);
						})}
					</tr>
				);
				})}
			</tbody>
		))}
	</table>
</div>
</div>

{scrollsOnMobile && <p class="comparison-table__scroll-hint" aria-hidden="true">
	<span>{t('billing.comparison.scrollHint', 'Deslizá para ver todos los planes')}</span>
	<span class="comparison-table__scroll-hint-arrow">→</span>
</p>}

{audience === 'owner' && (
	<p class="comparison-table__complex-teaser">
		{t('billing.comparison.complexTeaser', 'Planes especiales para complejos y hoteles — próximamente')}
	</p>
)}

<style>
	.comparison-table__plan-col:has([data-current-tourist-plan]) {
		background-color: var(--surface-warm);
	}

	.comparison-table__wrapper {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--space-container-x);
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: var(--brand-primary-a30) transparent;
	}

	.comparison-table__wrapper:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
	}

	.comparison-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		min-width: 600px;
	}

	.comparison-table thead th {
		position: sticky;
		top: 0;
		z-index: 2;
		background-color: var(--core-card);
		border-bottom: 2px solid var(--brand-primary-a20);
		padding: var(--space-4) var(--space-3);
		text-align: center;
		vertical-align: bottom;
	}

	.comparison-table__label-col {
		position: sticky;
		left: 0;
		z-index: 1;
		background-color: var(--core-card);
		text-align: left;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: var(--text-body-sm);
		color: var(--core-foreground);
		padding: var(--space-3) var(--space-4);
		min-width: 200px;
		white-space: normal;
		word-break: break-word;
		border-bottom: 1px solid var(--core-foreground-a10);
	}

	.comparison-table thead .comparison-table__label-col {
		z-index: 3;
		border-bottom: 2px solid var(--brand-primary-a20);
	}

	.comparison-table__plan-col {
		min-width: 140px;
	}

	.comparison-table__plan-name {
		display: block;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: var(--text-body-lg);
		color: var(--core-foreground);
		margin-bottom: var(--space-1);
	}

	/* OQ-5: mobile-only hint that the table scrolls horizontally. Hidden on
	   desktop where the full table fits without scrolling. */
	.comparison-table__scroll-hint {
		display: none;
	}

	.comparison-table__scroll-hint-arrow {
		animation: comparison-scroll-nudge var(--duration-slow, 1.2s) ease-in-out infinite;
	}

	@keyframes comparison-scroll-nudge {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(var(--space-1)); }
	}

	@media (prefers-reduced-motion: reduce) {
		.comparison-table__scroll-hint-arrow {
			animation: none;
		}
	}

	.comparison-table__group-header th {
		background-color: var(--surface-warm);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: var(--text-body);
		/* `--brand-primary` on the warm band measured 3.08:1 in light; the text-grade
		   step is 9.38:1 there and 5.4:1 in dark (HOS-1766). */
		color: var(--brand-primary-text);
		padding: var(--space-3) var(--space-4);
		text-align: left;
		border-bottom: 2px solid var(--brand-primary-a15);
		border-top: 1px solid var(--brand-primary-a15);
		position: sticky;
		left: 0;
	}

	.comparison-table__cell {
		text-align: center;
		padding: var(--space-3);
		border-bottom: 1px solid var(--core-foreground-a10);
		vertical-align: middle;
	}

	.comparison-table__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/*
	 * HOS-1766: `--brand-tertiary` is a pale-green SURFACE tint (L 0.92), so as
	 * ink it measured 1.25:1 on the white card and vanished in dark (1.04:1).
	 * `--hospeda-forest-link` is the AA-safe green TEXT step (the same one the
	 * pricing toggle badge uses, HOS-943): >= 4.5:1 on card and on the warm row
	 * hover, in both themes. Pinned by
	 * `packages/design-tokens/src/tokens/plan-comparison-contrast.test.ts`.
	 */
	.comparison-table__icon--included {
		color: var(--hospeda-forest-link);
	}

	.comparison-table__icon--not-included {
		color: var(--core-muted-foreground);
		/* 0.5 composited to 2.31:1 (light) / 2.36:1 (dark), under the 3:1 floor for a
		   graphical object; 0.7 clears it in both themes (HOS-1766). */
		opacity: 0.7;
	}

	.comparison-table__cell--limit {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--text-body);
		color: var(--core-foreground);
	}

	.comparison-table__limit-value--unlimited {
		color: var(--hospeda-forest-link);
		font-weight: 700;
	}

	.comparison-table__row-label {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	/* OQ-6: decorative icon in the label column, one per feature row. */
	.comparison-table__row-icon {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		color: var(--core-muted-foreground);
		opacity: 0.65;
	}

	.comparison-table__badge--upcoming {
		display: inline-block;
		font-size: var(--text-caption);
		font-family: var(--font-sans);
		font-weight: 600;
		/* Foreground ink, not `--brand-accent`: orange on the blue tint measured
		   2.52:1 in light. The tint and border keep the chip reading as a badge. */
		color: var(--core-foreground);
		background-color: var(--brand-primary-a15);
		border: 1px solid var(--brand-primary-a30);
		border-radius: var(--radius-pill, 999px);
		padding: 1px var(--space-2);
		white-space: nowrap;
		line-height: 1.4;
	}

	/* Per-row descriptive text (SPEC-299): explains what the feature does,
	   shown under the row label. Distinct from `row-note` (contextual caveat)
	   by not being italic. */
	.comparison-table__row-desc {
		display: block;
		font-size: var(--text-caption);
		font-family: var(--font-sans);
		font-weight: 400;
		color: var(--core-muted-foreground);
		margin-top: var(--space-1);
		line-height: 1.4;
	}

	.comparison-table__row-note {
		display: block;
		font-size: var(--text-caption);
		font-family: var(--font-sans);
		font-weight: 400;
		color: var(--core-muted-foreground);
		margin-top: var(--space-1);
		font-style: italic;
	}

	.comparison-table__complex-teaser {
		max-width: var(--container-max);
		margin: var(--space-6) auto 0;
		padding: 0 var(--space-container-x);
		text-align: center;
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		color: var(--core-muted-foreground);
		font-style: italic;
	}

	.comparison-table tbody tr:hover {
		background-color: var(--surface-warm);
	}

	.comparison-table tbody tr:hover .comparison-table__label-col {
		background-color: var(--surface-warm);
	}

	@media (max-width: 768px) {
		/*
		 * `table-layout: fixed` takes every width from the FIRST row (the `thead`
		 * row), so the label width goes on its header cell. At 390px there are
		 * 366px visible (390 - 2 * 12px); 150px label + 120px plan = 270px.
		 */
		.comparison-table {
			table-layout: fixed;
		}
		.comparison-table thead .comparison-table__label-col {
			width: 150px;
		}
		.comparison-table__label-col {
			min-width: 0;
			padding: var(--space-3) var(--space-2);
		}
		.comparison-table__plan-col {
			min-width: 120px;
		}
		/* HOS-2599: Gratis + VIP fit 390px; no 600px floor hides the VIP column. */
		.comparison-table--fits-mobile { min-width: 0; }
		.comparison-table--fits-mobile .comparison-table__plan-col { min-width: 0; padding-inline: var(--space-2); }
		.comparison-table__wrapper:has(.comparison-table--fits-mobile) {
			overflow: visible;
		}
		.comparison-table--fits-mobile thead {
			position: sticky;
			top: var(--navbar-height, 80px);
			z-index: 3;
			background: var(--core-card);
		}
		.comparison-table--fits-mobile,
		.comparison-table--fits-mobile thead,
		.comparison-table--fits-mobile tbody {
			display: block;
		}
		.comparison-table--fits-mobile thead tr {
			display: flex;
		}
		.comparison-table--fits-mobile thead .comparison-table__label-col {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			clip-path: inset(50%);
		}
		.comparison-table--fits-mobile thead .comparison-table__plan-col {
			flex: 1;
		}
		.comparison-table--fits-mobile tbody tr {
			display: flex;
			flex-wrap: wrap;
		}
		.comparison-table--fits-mobile tbody th {
			width: 100%;
			position: static;
		}
		.comparison-table--fits-mobile tbody td {
			flex: 1;
			border-radius: var(--radius-pill);
			background: var(--core-card);
		}
		.comparison-table__scroll-hint {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-2);
			max-width: var(--container-max);
			margin: var(--space-2) auto 0;
			padding: 0 var(--space-container-x);
			font-family: var(--font-sans);
			font-size: var(--text-caption);
			color: var(--core-muted-foreground);
		}
	}
</style>

<script>
    import { initComparisonScroll } from './comparison-scroll';
    initComparisonScroll();
    document.addEventListener('astro:page-load', initComparisonScroll);
</script>
