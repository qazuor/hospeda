---
/**
 * @file PricingCardsGrid.astro
 * @description Renders a grid of subscription plan cards (name, description,
 * price, entitlements, CTA). Shared between the owner pricing page
 * (/suscriptores/planes/anfitriones/) and the tourist pricing page
 * (/suscriptores/planes/turistas/).
 *
 * The two pricing pages target completely different audiences with separate
 * URLs (intentional, for SEO and conversion-focused copy), but the visual
 * presentation of the plan cards themselves is identical. Keeping that UI in
 * one component prevents drift between the pages and makes future visual
 * tweaks land in both places at once.
 *
 * This file is MARKUP AND CSS. Everything the cards say — the cumulative delta,
 * the summary/disclosure split, the prices, the annual discount — is built by
 * `buildPricingCardViews` in `pricing-card-view.ts`, and deliberately so: past a
 * certain amount of inference in one frontmatter, `astro check` gives up on the
 * component's own props and resolves `Astro.props` to `Record<string, any>`,
 * turning every prop into `any` while reporting errors that point only at map
 * callbacks. That module's header has the full account. Keep this frontmatter
 * thin.
 */

import { PlanPurchaseButton } from '@/components/billing/PlanPurchaseButton.client';
import PricingCardItemLine from '@/components/billing/PricingCardItem.astro';
import { buildPricingCardViews } from '@/components/billing/pricing-card-view';
import type { PricingPlan } from '@/components/billing/pricing-card-view';
import EmptyState from '@/components/shared/feedback/EmptyState.astro';
import type { PricingAudience } from '@/lib/billing-i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { PRICING_PAGE_PATH_BY_AUDIENCE } from '@/lib/pricing-plans';

export type { PricingPlan };

interface Props {
	readonly locale: SupportedLocale;
	/**
	 * Tiers to render, ALREADY ordered by `sortOrder` — which is what
	 * `filterPlansByCategory` returns. The order is load-bearing here, not
	 * cosmetic: each card is diffed against the one before it.
	 */
	readonly plans: ReadonlyArray<PricingPlan>;
	readonly intlLocale: string;
	/** Audience of the page — owner cards collapse the inherited tourist tier
	    and the AI entitlements into grouped bullets to keep the list short. */
	readonly audience: PricingAudience;
	/** Section heading text (rendered sr-only as h2 for accessibility). */
	readonly sectionHeading: string;
	/** Aria label for the section. */
	readonly sectionAriaLabel?: string;
	/** Message rendered inside EmptyState when `plans` is empty. */
	readonly emptyMessage: string;
	readonly emptyActionUrl: string;
	readonly emptyActionLabel: string;
	/** CTA button text on each card. */
	readonly ctaText: string;
}

const {
	locale,
	plans,
	intlLocale,
	audience,
	sectionHeading,
	emptyMessage,
	emptyActionUrl,
	emptyActionLabel,
	ctaText,
} = Astro.props;

const { t, tPlural } = createTranslations(locale);
const hasPlans = plans.length > 0;

// Annual toggle: only render the UI when at least one plan in the grid has
// an annual price configured. If every plan is monthly-only, the toggle is
// a no-op surface that just adds clutter.
const hasAnyAnnualPrice = plans.some(
	(plan) => plan.annualPriceArs !== null && plan.annualPriceArs > 0
);

const featuresLabel = t('pricing.features.label', 'Incluye');
const limitsLabel = t('pricing.limitsLabel', 'Límites de este plan');
const recommendedForLabel = t('pricing.recommendedFor.label', 'Recomendado para');
const toggleMonthlyLabel = t('pricing.toggle.monthly', 'Mensual');
const toggleAnnualLabel = t('pricing.toggle.annual', 'Anual');
const toggleAriaLabel = t(
	'pricing.toggle.ariaLabel',
	'Elegí la frecuencia de facturación'
);
const toggleQuestionLabel = t('pricing.toggle.question', '¿Cómo querés pagar?');
const annualBadgeTemplate = t('pricing.toggle.annualBadge', 'Ahorrá hasta {percent}%');
const periodMonthLabel = t('pricing.period.month', '/mes');
const periodYearLabel = t('pricing.period.year', '/año');
const monthlyOnlyLabel = t('pricing.monthlyOnly', 'Solo plan mensual');

/** Every card's copy, prices and item split — see `pricing-card-view.ts`. */
const { cards, maxAnnualSavingPercent } = buildPricingCardViews({
	plans,
	audience,
	intlLocale,
	t
});

/**
 * The toggle badge. It has to sell the annual option BEFORE the reader has
 * chosen a tier, so it speaks about the catalogue as a whole; when no tier has
 * a valid annual price it renders nothing rather than an invented number.
 */
const annualBadgeLabel =
	maxAnnualSavingPercent !== null
		? annualBadgeTemplate.replace('{percent}', String(maxAnnualSavingPercent))
		: '';

/** One radio group per audience, so the two pricing pages never share a name. */
const selectGroupName = `pricing-select-${audience}`;
---

<div
	class="pricing-cards__container"
	data-billing="monthly"
	data-audience={audience}
>
	<h2 class="sr-only">{sectionHeading}</h2>

	{/*
		The billing-interval toggle. It used to be a bare pill pair that read as
		decoration; it now carries a question above it and the catalogue's best
		annual discount inside the "Anual" option. The badge sits INSIDE the
		radio, so the discount is part of that option's accessible name: a
		screen-reader user hears the saving together with the option it applies
		to, instead of a percentage floating beside a control it does not
		belong to.
	*/}
	{hasPlans && hasAnyAnnualPrice && (
		<div class="pricing-toggle-block">
			<p class="pricing-toggle__question">{toggleQuestionLabel}</p>
			<div class="pricing-toggle" role="radiogroup" aria-label={toggleAriaLabel}>
				<button
					type="button"
					class="pricing-toggle__option pricing-toggle__option--active"
					data-pricing-toggle="monthly"
					role="radio"
					aria-checked="true"
				>
					{toggleMonthlyLabel}
				</button>
				<button
					type="button"
					class="pricing-toggle__option"
					data-pricing-toggle="annual"
					role="radio"
					aria-checked="false"
				>
					{toggleAnnualLabel}
					{annualBadgeLabel && (
						<span class="pricing-toggle__badge">{annualBadgeLabel}</span>
					)}
				</button>
			</div>
		</div>
	)}

	{!hasPlans ? (
		<EmptyState
			locale={locale}
			variant="empty"
			message={emptyMessage}
			actionUrl={emptyActionUrl}
			actionLabel={emptyActionLabel}
		/>
	) : (
		<div class="pricing-cards__grid" data-count={Math.min(cards.length, 3)}>
			{cards.map((card, i) => (
				<div
					class="pricing-card"
					data-pricing-card
					data-reveal="up"
					data-stagger-index={Math.min(i, 6)} data-stagger-step="100"
				>
					{/*
						Card selection (owner review): clicking a card marks it, so a
						reader comparing three tiers can park on one. The state is a
						REAL radio, visually hidden — not a div carrying a pressed-state
						ARIA attribute. Three reasons, all load-bearing: the card contains
						a button and a `summary` element, so giving the card itself
						`role="button"` would be a nested-interactive violation (and these
						pages ARE in the axe sweep); that same pressed-state attribute on a
						role-less element is prohibited ARIA and would never be announced;
						and a native radio group gives keyboard operation (arrow keys), the
						"selected" announcement and the no-JS path for free. The card is simply this control's
						visual representation, which is the ordinary custom-radio
						pattern. `.sr-only` is absolutely positioned, so the input is
						NOT a grid item and does not consume one of the shared rows.
					*/}
					<input
						type="radio"
						class="sr-only pricing-card__select"
						id={card.selectId}
						name={selectGroupName}
						aria-label={card.selectAriaLabel}
						data-pricing-select
					/>
					<h3 class="pricing-card__name">{card.name}</h3>
					<p class="pricing-card__desc">{card.description}</p>
					{/*
						Every card carries a "recommended for" profile — no card wears a
						"most popular" badge (HOS-943 AC-12). A single highlighted tier
						needs conversion data Hospeda does not have, and it turns the
						other two into losers; naming the reader each tier is for lets
						them self-select instead.
					*/}
					<p class="pricing-card__audience">
						<span class="pricing-card__audience-label">{recommendedForLabel}:</span>{' '}
						<span class="pricing-card__audience-text">{card.recommendedFor}</span>
					</p>
					<div class="pricing-card__price">
						{/*
							Render both prices in the markup and let CSS toggle visibility
							based on the ancestor's data-billing attribute. Avoids shipping
							an island for the price display; the React PlanPurchaseButton
							below reads the same data attribute when forming the checkout
							payload.
						*/}
						<span class="pricing-card__amount pricing-card__amount--monthly">
							{card.monthlyFormatted}
						</span>
						{card.plan.monthlyPriceArs > 0 && (
							<span class="pricing-card__period pricing-card__period--monthly">
								{periodMonthLabel}
							</span>
						)}
						{card.hasAnnualPrice ? (
							<>
								<span class="pricing-card__amount pricing-card__amount--annual">
									{card.annualFormatted}
								</span>
								<span class="pricing-card__period pricing-card__period--annual">
									{periodYearLabel}
								</span>
								{card.savingLabel && (
									<span class="pricing-card__saving pricing-card__saving--annual">
										{card.savingLabel}
									</span>
								)}
							</>
						) : (
							<span class="pricing-card__amount pricing-card__amount--annual pricing-card__monthly-only">
								{monthlyOnlyLabel}
							</span>
						)}
						{/*
							The discount, stated while the reader is still looking at the
							MONTHLY price. `.pricing-card__saving--annual` above only
							appears once annual is already selected, which is too late to
							influence the choice. Same computed percentage, opposite
							visibility rule — CSS hides this one under the annual toggle.
							Empty (and therefore absent) for a monthly-only tier.
						*/}
						{card.annualHintLabel && (
							<p class="pricing-card__annual-hint">{card.annualHintLabel}</p>
						)}
						{card.plan.hasTrial && card.plan.trialDays > 0 && (
							<p class="pricing-card__trial">
								{tPlural('pricing.trial', card.plan.trialDays)}
							</p>
						)}
					</div>
					{/*
						The delta heading. `card.deltaHeading` was resolved in the
						frontmatter from a plan object that exists, so this can never
						render "everything in plan undefined, plus:" — on the first tier
						(or a single-tier audience) it is the neutral "this plan
						includes:" line instead (AC-17).
					*/}
					<p class="pricing-card__delta-heading">{card.deltaHeading}</p>
					{/*
						The card's list, cut in two. `visibleItems` is the summary; the
						remainder lives in a native `details` element, which is why the "ver
						todo" control works with JavaScript disabled, is keyboard
						operable, and is announced as a disclosure — all of it for free.
						Nothing is dropped: every hidden line is in the DOM, so the
						browser's find, a crawler and an LLM fetcher all still read it.

						Both halves render through the SAME item component. Inlining the
						markup twice is how the two copies drift, and a source-reading
						guard only ever matches the first one.
					*/}
					<div class="pricing-card__body">
						{card.visibleItems.length > 0 && (
							<ul class="pricing-card__items" aria-label={featuresLabel}>
								{card.visibleItems.map((item) => (
									<PricingCardItemLine item={item} />
								))}
							</ul>
						)}
						{card.hiddenItems.length > 0 && (
							<details class="pricing-card__more">
								<summary class="pricing-card__more-summary">
									{card.seeAllLabel}
								</summary>
								<ul class="pricing-card__items" aria-label={limitsLabel}>
									{card.hiddenItems.map((item) => (
										<PricingCardItemLine item={item} />
									))}
								</ul>
							</details>
						)}
					</div>
					<div class="pricing-card__btn-wrapper">
						<PlanPurchaseButton
							client:load
							planSlug={card.plan.slug}
							monthlyPrice={card.plan.monthlyPriceArs}
							annualPrice={card.plan.annualPriceArs ?? null}
							currency="ARS"
							ctaText={ctaText}
							locale={locale}
							plansPath={PRICING_PAGE_PATH_BY_AUDIENCE[audience]}
							trialDays={card.plan.hasTrial ? card.plan.trialDays : 0}
						/>
					</div>
				</div>
			))}
		</div>
	)}
</div>

<style>
	.pricing-cards__container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--space-container-x);
	}

	/* The grid is sized to the number of cards it actually has (HOS-943 AC-14,
	   absorbing HOS-891). A fixed `repeat(3, …)` left one or two cards pinned to
	   the left of a three-column track with dead space beside them — which is
	   what deactivating a tourist tier produced the day it happened. Each count
	   gets its own column template plus a matching `max-width`, so `margin: 0
	   auto` centres the whole track instead of centring a track that is wider
	   than its contents. `data-count` is clamped to 3 by the template, so a
	   fourth tier falls back to the three-column rule rather than to no rule. */
	.pricing-cards__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-card-gap);
		align-items: stretch;
		justify-content: center;
		max-width: 1140px;
		margin: 0 auto;
		padding-top: var(--space-4);
	}

	.pricing-cards__grid[data-count='2'] {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		max-width: 760px;
	}

	.pricing-cards__grid[data-count='1'] {
		grid-template-columns: minmax(0, 1fr);
		max-width: 400px;
	}

	.pricing-card {
		background-color: var(--core-card);
		border-radius: var(--radius-card);
		padding: var(--space-8);
		box-shadow: var(--shadow-card);
		border: 2px solid transparent;
		display: flex;
		flex-direction: column;
		transition:
			transform var(--duration-normal) ease,
			box-shadow var(--duration-normal) ease,
			border-color var(--duration-normal) ease;
	}

	.pricing-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card-hover);
	}

	/* ─── Shared row tracks ──────────────────────────────────────────
	   The price and the CTA have to land on the SAME line across the three
	   cards. Stacking each card independently cannot do that: a two-line plan
	   name or a longer description pushes everything below it down by one line,
	   and the prices end up staggered.

	   `subgrid` is the mechanism, not `min-height`. The grid owns the row
	   tracks; each card opts into them (`grid-row: 1 / -1`), so every row is as
	   tall as the tallest card's content for that row and every card's Nth
	   block starts at the same y. A `min-height` tuned by eye is a guess that
	   breaks on the first copy edit, in another locale, or at another font
	   size.

	   There are SEVEN in-flow children per card and the row list below must
	   match them one for one: name, description, "recomendado para", the price
	   block, the delta heading, the body (list + disclosure) and the CTA. The
	   selection radio is `position: absolute` via `.sr-only`, so it is out of
	   flow and consumes no row — if it ever stopped being absolutely
	   positioned, every card would shift by one row.

	   The body row takes `1fr` so it absorbs the slack, which is what pins the
	   CTA to the bottom.

	   FALLBACK (no `subgrid` support): the cards stay flex columns. They are
	   still equal height — grid items stretch by default — and the CTA is still
	   bottom-aligned by its own `margin-top: auto`. Only the price alignment is
	   lost, degrading to exactly today's behaviour. */
	@media (min-width: 769px) {
		@supports (grid-template-rows: subgrid) {
			.pricing-cards__grid,
			.pricing-cards__grid[data-count='1'],
			.pricing-cards__grid[data-count='2'] {
				grid-template-rows: auto auto auto auto auto 1fr auto;
			}

			.pricing-card {
				display: grid;
				grid-row: 1 / -1;
			grid-template-rows: subgrid;
				}
		}
	}

	/* ─── Selected card ──────────────────────────────────────────────
	   Driven by the hidden radio: `[data-selected]` is what the script sets,
	   and `:has(:checked)` covers the no-script path (a keyboard user reaching
	   the radio group and arrowing through it). Sober on purpose — a border and
	   the hover elevation, no scale, no colour flood. */
	.pricing-card[data-selected='true'],
	.pricing-card:has(.pricing-card__select:checked) {
		border-color: var(--brand-accent);
		box-shadow: var(--shadow-card-hover);
	}

	/* The radio is visually hidden, so its focus ring has to be drawn on the
	   card that represents it — otherwise a keyboard user arrowing through the
	   group gets no visible indication of where they are. */
	.pricing-card:has(.pricing-card__select:focus-visible) {
		outline: 2px solid var(--brand-accent);
		outline-offset: 3px;
	}

	/* There is deliberately no `.pricing-card--highlighted` rule and no
	   "Recomendado" badge (HOS-943 AC-12). Singling out one tier needs
	   conversion data Hospeda does not have, and it labels the other two as
	   second-best. `.pricing-card__audience` below is what replaced it: every
	   card names the reader it is for. */

	.pricing-card__name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: var(--text-xl);
		color: var(--core-foreground);
		margin: 0 0 var(--space-2);
	}

	.pricing-card__desc {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		color: var(--core-muted-foreground);
		margin: 0 0 var(--space-4);
	}

	/* "Recomendado para: …" — present on EVERY card. Bordered rather than
	   badged: it identifies the reader, it does not rank the tier. */
	.pricing-card__audience {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		line-height: 1.45;
		color: var(--core-foreground);
		background-color: var(--surface-warm);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: var(--space-3);
		margin: 0 0 var(--space-4);
	}

	.pricing-card__audience-label {
		font-weight: 700;
		/* `--brand-primary` is ~3.5:1 on a light card and fails WCAG AA as body
		   text; `--brand-primary-link` is the accessible step of the same hue. */
		color: var(--brand-primary-link);
	}

	.pricing-card__price {
		margin-bottom: var(--space-4);
	}

	.pricing-card__amount {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		color: var(--core-foreground);
	}

	.pricing-card__period {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		color: var(--core-muted-foreground);
		margin-left: var(--space-1);
	}

	.pricing-card__trial {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		color: var(--brand-accent-text);
		font-weight: 600;
		margin: var(--space-2) 0 0;
	}

	/* The annual discount, stated in the MONTHLY state. `display` is owned by
	   the toggle rules further down (hidden under `[data-billing='annual']`),
	   so do not set it here. */
	.pricing-card__annual-hint {
		font-family: var(--font-sans);
		font-size: var(--text-caption);
		font-weight: 600;
		/* `--brand-primary` is ~3.5:1 on a light card and fails WCAG AA as body
		   text; `--brand-primary-link` is the accessible step of the same hue. */
		color: var(--brand-primary-link);
		margin: var(--space-2) 0 0;
	}

	/* Delta heading — either "Todo lo del plan X, más:" or, on the first tier,
	   the neutral "Este plan incluye:". The block that used to sit here (the
	   inherited-tier list, plus a "value highlight" filler for the base card)
	   is gone: it re-enumerated the whole previous tier under a header that
	   says "only the differences follow", which is the opposite of AC-10. */
	.pricing-card__delta-heading {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		font-weight: 700;
		color: var(--core-foreground);
		margin: 0 0 var(--space-2);
	}

	/* The list itself. Each ITEM's styling (bullet, cap value, cap explanation)
	   lives in `PricingCardItem.astro`, which owns that markup — Astro scopes
	   styles per component, so a rule for `.pricing-card__limit` written here
	   would never match an element rendered by the child. */
	.pricing-card__items {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	/* The body is one grid child (one shared row) holding both the summary and
	   the disclosure, so the row list stays one entry per visible block. */
	.pricing-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	/* "Ver todo lo que incluye (N más)". A native <details>: it works with no
	   JavaScript, it is keyboard operable, and it is announced as a disclosure
	   with its own expanded state — none of which a scripted toggle gets for
	   free. Opening one card grows the shared body row, so the three cards stay
	   the same height rather than one of them jumping. */
	.pricing-card__more-summary {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		font-weight: 600;
		color: var(--brand-primary-link);
		cursor: pointer;
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) 0;
	}

	/* Safari still paints the default disclosure triangle through the
	   webkit-specific pseudo-element; `list-style: none` alone does not remove
	   it there. The marker below replaces it in every browser. */
	.pricing-card__more-summary::-webkit-details-marker {
		display: none;
	}

	.pricing-card__more-summary::after {
		content: '';
		width: 0.5em;
		height: 0.5em;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translate(-15%, -15%);
		transition: transform var(--duration-normal) ease;
	}

	.pricing-card__more[open] .pricing-card__more-summary::after {
		transform: rotate(-135deg) translate(-15%, -15%);
	}

	.pricing-card__more-summary:hover {
		text-decoration: underline;
	}

	.pricing-card__more-summary:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
		border-radius: var(--radius-md);
	}

	.pricing-card__more[open] .pricing-card__items {
		margin-top: var(--space-3);
	}

	.pricing-card__btn-wrapper {
		display: flex;
		justify-content: center;
		margin-top: auto;
	}

	/* Below 768px every count collapses to one centred column, which is why the
	   `[data-count]` rules above need no mobile variants — this rule wins on
	   specificity ties by source order and applies to all three. */
	@media (max-width: 768px) {
		.pricing-cards__grid,
		.pricing-cards__grid[data-count='1'],
		.pricing-cards__grid[data-count='2'] {
			grid-template-columns: minmax(0, 1fr);
			max-width: 400px;
			margin: 0 auto;
		}
	}

	/* ─── Toggle UI ──────────────────────────────────────────────────
	   The toggle used to be a bare pill pair floating above the grid and read
	   as decoration. It now sits in a block with a question above it and the
	   catalogue's best discount inside the "Anual" option, so the annual saving
	   is legible before the reader has switched anything. */
	.pricing-toggle-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-6);
	}

	.pricing-toggle__question {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		font-weight: 600;
		color: var(--core-foreground);
		margin: 0;
	}

	.pricing-toggle__badge {
		font-size: var(--text-caption);
		font-weight: 700;
		line-height: 1.2;
		padding: 0.15em 0.55em;
		border-radius: var(--radius-pill);
		background-color: color-mix(in srgb, var(--success) 16%, transparent);
		color: var(--success);
	}

	.pricing-toggle {
		display: inline-flex;
		gap: 0;
		/* Bottom spacing belongs to `.pricing-toggle-block` now — keeping it
		   here too would double the gap under the toggle. */
		margin: 0 auto;
		background-color: var(--surface-warm);
		border-radius: var(--radius-pill);
		padding: var(--space-1);
		position: relative;
		justify-self: center;
		align-self: center;
		border: 1px solid var(--border);
	}
	.pricing-cards__container .pricing-toggle {
		margin-left: auto;
		margin-right: auto;
		display: flex;
		max-width: max-content;
	}
	.pricing-toggle__option {
		font-family: var(--font-sans);
		font-size: var(--text-body-sm);
		font-weight: 600;
		color: var(--core-muted-foreground);
		background-color: transparent;
		border: none;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-pill);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		transition: background-color var(--duration-normal) ease,
			color var(--duration-normal) ease;
	}
	.pricing-toggle__option:hover {
		color: var(--core-foreground);
	}
	.pricing-toggle__option--active {
		background-color: var(--core-card);
		color: var(--brand-accent);
		box-shadow: var(--shadow-card);
	}
	.pricing-toggle__option:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
	}

	/* ─── Dual price visibility ──────────────────────────────────────
	   The grid container carries `data-billing="monthly"|"annual"`. The
	   toggle script (below) flips it on user interaction. Cards render
	   both monthly and annual price spans; CSS hides the inactive set.
	   This keeps the toggle as zero-cost SSG markup — the React island
	   below (PlanPurchaseButton) reads the same attribute on click to
	   send the right `billingInterval` to /start-paid.
	 */
	.pricing-card__amount--annual,
	.pricing-card__period--annual,
	.pricing-card__saving--annual {
		display: none;
	}
	/*
	   HOS-115: the annual entry path grants the SAME trial the monthly path
	   does (both resolve it through `resolveCheckoutFreeTrialDays` at
	   checkout, so it is interval-agnostic), so the
	   trial copy must be visible under BOTH toggles. `.pricing-card__trial`
	   is intentionally absent from this hide rule — only the monthly-specific
	   price amount/period are hidden under the annual toggle.
	 */
	[data-billing='annual'] .pricing-card__amount--monthly,
	[data-billing='annual'] .pricing-card__period--monthly,
	[data-billing='annual'] .pricing-card__annual-hint {
		display: none;
	}
	[data-billing='annual'] .pricing-card__amount--annual,
	[data-billing='annual'] .pricing-card__period--annual {
		display: inline;
	}
	[data-billing='annual'] .pricing-card__saving--annual {
		display: block;
	}
	.pricing-card__saving {
		/* `display` is owned exclusively by the --annual toggle rules above:
		   hidden in monthly, shown (block) only under [data-billing='annual'].
		   Do NOT set `display` here or it overrides the monthly-hide rule. */
		font-family: var(--font-sans);
		font-size: var(--text-caption);
		font-weight: 600;
		color: var(--success, var(--brand-accent));
		margin-top: var(--space-1);
	}
	.pricing-card__monthly-only {
		font-size: var(--text-body-sm);
		color: var(--core-muted-foreground);
		font-style: italic;
		font-weight: 400;
	}

	/* Selection and hover both move the card; neither may animate for a visitor
	   who asked for less motion. The border and the elevation still change —
	   the STATE is never removed, only its transition and its displacement. */
	@media (prefers-reduced-motion: reduce) {
		.pricing-card {
			transition: none;
		}
		.pricing-card:hover {
			transform: none;
		}
		.pricing-card__more-summary::after,
		.pricing-card__more[open] .pricing-card__more-summary::after {
			transition: none;
		}
	}
</style>

<style is:global>
	/* ─── Promo-applied card visuals ─────────────────────────────────────
	   These classes/nodes are injected at runtime by the PlanPurchaseButton
	   island (when a user applies a valid promo code) on the surrounding
	   `.pricing-card`. They live OUTSIDE Astro's scoped CSS, so the rules
	   must be global. Every change is reverted by the island on remove.
	 */
	.pricing-card__amount--struck {
		text-decoration: line-through;
		opacity: 0.55;
		font-weight: 400;
		margin-right: var(--space-2, 0.5rem);
	}
	.pricing-card__amount--promo {
		color: var(--success, var(--brand-accent));
		font-weight: 800;
	}
	.pricing-card__promo-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		margin-top: var(--space-2, 0.5rem);
		padding: 0.2em 0.65em;
		border-radius: 999px;
		background: color-mix(in srgb, var(--success, var(--brand-accent)) 14%, transparent);
		color: var(--success, var(--brand-accent));
		font-family: var(--font-sans);
		font-size: var(--text-caption);
		font-weight: 700;
		line-height: 1.3;
		animation: promo-badge-in 280ms ease-out both;
	}
	.pricing-card__promo-badge::before {
		content: '';
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: currentColor;
		flex: none;
	}
	.pricing-card__trial--promo {
		color: var(--success, var(--brand-accent));
		font-weight: 700;
	}
	/* HOS-226: badge-suppression note injected by PlanPurchaseButton when an
	   authenticated user turns out to be trial-ineligible. Muted (not the
	   accent color the "N days free" perk uses) — this is neutral billing
	   info, not a benefit being advertised. */
	.pricing-card__trial--ineligible {
		color: var(--core-muted-foreground);
		font-weight: 500;
	}
	.pricing-card__price--promo-active {
		animation: promo-price-pulse 650ms ease-out 1;
		border-radius: var(--radius-md, 0.5rem);
	}
	@keyframes promo-price-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--success, var(--brand-accent)) 55%, transparent);
		}
		70% {
			box-shadow: 0 0 0 12px color-mix(in srgb, var(--success, var(--brand-accent)) 0%, transparent);
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}
	@keyframes promo-badge-in {
		from {
			opacity: 0;
			transform: translateY(4px) scale(0.96);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pricing-card__price--promo-active,
		.pricing-card__promo-badge {
			animation: none;
		}
	}
</style>

<script>
	/**
	 * Vanilla JS toggle for monthly / annual billing interval. Lives outside
	 * any React island so the grid stays SSG-friendly (no hydration cost).
	 * Updates the closest `.pricing-cards__container` data-billing attribute;
	 * CSS handles all visual changes for the cards, and the React
	 * PlanPurchaseButton island observes the attribute via MutationObserver
	 * to keep the displayed checkout price + the /start-paid payload in
	 * sync. Pattern documented inline in PlanPurchaseButton.client.tsx.
	 */
	import { billingApi } from '@/lib/api/endpoints-protected';
	/**
	 * Reads the `?interval=` query param (HOS-115 §5 nudge delivery path 1 —
	 * the TRIAL_ENDING_REMINDER notification's upgradeUrl). Returns `null` when
	 * absent or set to anything other than the two known values, so a bad or
	 * stale link never leaves the toggle in an invalid state.
	 */
	function resolveQueryInterval(): 'monthly' | 'annual' | null {
		const params = new URLSearchParams(window.location.search);
		const value = params.get('interval');
		return value === 'monthly' || value === 'annual' ? value : null;
	}

	/**
	 * HOS-115 §5 nudge delivery path 2 (T-008, fast-follow): for a logged-in
	 * visitor who navigated directly to the owner pricing page (no
	 * `?interval=` query param — path 1 already covers that case and always
	 * wins), look up their most recent trial's `intendedInterval` and
	 * pre-select the toggle to match.
	 *
	 * Deliberately client-side, NOT server-rendered: this page sets
	 * `Cache-Control: s-maxage=...` so Cloudflare caches the SSR HTML at the
	 * edge and serves it to every subsequent visitor regardless of their own
	 * cookies. Baking one visitor's personalized `intendedInterval` into that
	 * cached markup would leak it to whoever the CDN serves the cached page
	 * to next. Fetching after the cacheable HTML has already loaded keeps the
	 * page fully cacheable and the personalization strictly per-browser.
	 *
	 * Scoped to `audience === 'owner'` only (`data-audience` on the
	 * container) — every trial-eligible plan today is an owner plan (see
	 * `DEFAULT_TRIAL_PLAN_SLUG` / `TRIAL_UPGRADE_PATH` in `trial.service.ts`),
	 * so applying this on the tourist pricing page would incorrectly nudge
	 * that toggle from an unrelated owner trial.
	 *
	 * Fire-and-forget: never blocks first paint. A no-op for anonymous
	 * visitors (the protected endpoint 401s, surfaced as `ApiResult.ok:
	 * false`, swallowed here), for users with no trial history, and for a
	 * trial that recorded no interval. `isOverridden` is re-checked right
	 * before applying so a visitor who manually flips the toggle — or
	 * navigates again — while the request is in flight is never clobbered by
	 * a late response.
	 */
	async function applyIntendedIntervalNudge(input: {
		readonly setActive: (interval: 'monthly' | 'annual') => void;
		readonly isOverridden: () => boolean;
	}): Promise<void> {
		const { setActive, isOverridden } = input;
		try {
			const result = await billingApi.getTrialStatus();
			if (isOverridden() || !result.ok) return;
			const { intendedInterval } = result.data;
			if (intendedInterval === 'monthly' || intendedInterval === 'annual') {
				setActive(intendedInterval);
			}
		} catch {
			// Never let a lookup failure affect the toggle — it simply stays
			// at whatever it already resolved to (default 'monthly').
		}
	}

	function initPricingToggle(container: HTMLElement): void {
		const options = container.querySelectorAll<HTMLButtonElement>(
			'[data-pricing-toggle]'
		);
		if (options.length === 0) return;
		let manuallyToggled = false;
		const setActive = (interval: 'monthly' | 'annual'): void => {
			container.setAttribute('data-billing', interval);
			for (const opt of options) {
				const isActive = opt.dataset.pricingToggle === interval;
				opt.classList.toggle('pricing-toggle__option--active', isActive);
				opt.setAttribute('aria-checked', String(isActive));
			}
		};
		// HOS-115 §5: pre-select the toggle from the query param on load (or
		// 'monthly' when absent/invalid). This only runs once per page
		// load/navigation (astro:page-load), so a user who manually flips the
		// toggle afterwards via the click listener below is never overridden
		// by this initial selection.
		const queryInterval = resolveQueryInterval();
		setActive(queryInterval ?? 'monthly');
		for (const opt of options) {
			opt.addEventListener('click', () => {
				manuallyToggled = true;
				const interval = opt.dataset.pricingToggle === 'annual' ? 'annual' : 'monthly';
				setActive(interval);
			});
		}
		// Nudge delivery path 2: only when path 1 (query param) did not
		// already decide, and only on the owner audience.
		if (!queryInterval && container.dataset.audience === 'owner') {
			void applyIntendedIntervalNudge({
				setActive,
				isOverridden: () => manuallyToggled
			});
		}
	}

	/**
	 * Card selection (owner review): clicking anywhere on a card marks it, so a
	 * reader comparing three tiers can park on one while they read.
	 *
	 * The state itself is NOT owned here — it lives in a visually hidden radio
	 * per card (see the markup comment). That is what makes the feature
	 * keyboard operable and announced without this script: arrowing through the
	 * radio group already selects, and CSS `:has(:checked)` already paints it.
	 * All this adds is the click target, plus a `data-selected` mirror for
	 * browsers without `:has()`.
	 *
	 * A click that lands on a real control is left alone — the CTA, the "ver
	 * todo" disclosure, and any link inside the card must keep behaving
	 * exactly as they did before selection existed.
	 */
	function initPricingSelection(container: HTMLElement): void {
		const cards = Array.from(
			container.querySelectorAll<HTMLElement>('[data-pricing-card]')
		);
		if (cards.length === 0) return;

		const syncFromInputs = (): void => {
			for (const card of cards) {
				const input = card.querySelector<HTMLInputElement>('[data-pricing-select]');
				card.dataset.selected = input?.checked ? 'true' : 'false';
			}
		};

		for (const card of cards) {
			const input = card.querySelector<HTMLInputElement>('[data-pricing-select]');
			if (!input) continue;
			// Fires for a click on the card AND for an arrow-key move within the
			// radio group, so keyboard selection updates the mirror too.
			input.addEventListener('change', syncFromInputs);
			card.addEventListener('click', (event) => {
				const target = event.target as HTMLElement | null;
				if (target?.closest('a, button, summary, input, label, [role="button"]')) {
					return;
				}
				input.checked = true;
				syncFromInputs();
			});
		}

		syncFromInputs();
	}

	function initAllPricingToggles(): void {
		document
			.querySelectorAll<HTMLElement>('.pricing-cards__container[data-billing]')
			.forEach((container) => {
				initPricingToggle(container);
				initPricingSelection(container);
			});
	}

	// Re-attach on every navigation. Astro's ClientRouter does not re-run module
	// scripts after a View Transitions swap, so a module-level call would leave
	// the toggle dead after in-app navigation (Bug B4 — clicking "Anual" did
	// nothing once the user had navigated through the pricing page). astro:page-load
	// also fires on the initial load, so first paint is covered too. Same pattern
	// as BaseLayout and the other re-initialized components.
	document.addEventListener('astro:page-load', initAllPricingToggles);
</script>
