---
/**
 * @file PlanCatalogueNav.astro
 * @description The row above the plan cards: back to the audience index, and
 * across to the full comparison table.
 *
 * Added after the owner reviewed the live pages. Both vertical pricing pages
 * (`/suscriptores/planes/anfitriones/`, `/suscriptores/planes/turistas/`) are
 * reachable directly from search and from the index, and neither offered a way
 * BACK to `/suscriptores/planes/` — the only exit was the browser button or the
 * footer. The comparison table had the same problem in reverse: its only link
 * sat at the very bottom of the page, after every card, so a reader still
 * choosing between tiers had to scroll past all of them to find the surface
 * that actually compares them.
 *
 * The comparison link therefore exists in BOTH places, deliberately duplicated
 * — `ComparisonLinkTeaser` still closes the page. This one is a compact
 * secondary link, not a second teaser block: the same call to action twice at
 * full weight reads as a mistake.
 *
 * Nothing here is new UI. The back control is the shared, history-aware
 * `HeaderBackButton` (it calls `history.back()` when the visitor arrived from
 * elsewhere on the site, and falls back to `href` otherwise), and the forward
 * link is the shared `GradientButton`.
 */

import GradientButton from '@/components/shared/ui/GradientButton.astro';
import HeaderBackButton from '@/components/shared/ui/HeaderBackButton.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { buildUrl } from '@/lib/urls';

interface Props {
	readonly locale: SupportedLocale;
	/**
	 * Comparison-table URL for this audience, already locale-resolved by the
	 * caller — the owner and tourist tables live at different paths.
	 */
	readonly comparisonHref: string;
}

const { locale, comparisonHref } = Astro.props;
const { t } = createTranslations(locale);

// The audience index. Hardcoding the path here rather than taking it as a prop
// is deliberate: there is exactly one plan index, and a caller that could point
// "back to all plans" somewhere else is a bug, not a feature.
const indexHref = buildUrl({ locale, path: 'suscriptores/planes' });
---

<nav
	class="plan-catalogue-nav"
	aria-label={t('pricing.nav.ariaLabel', 'Navegación del catálogo de planes')}
>
	<HeaderBackButton
		href={indexHref}
		locale={locale}
		label={t('pricing.nav.backToIndex', 'Volver a todos los planes')}
	/>
	<GradientButton
		href={comparisonHref}
		label={t('pricing.comparison.link', 'Ver comparativa detallada')}
		variant="outline-primary"
		size="sm"
		shape="rounded"
		icon="true"
	/>
</nav>

<style>
	.plan-catalogue-nav {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: var(--space-6) var(--space-container-x) 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	/* Stacked and full-width on narrow screens: two half-width controls side by
	   side end up with wrapped labels and tap targets that are hard to hit. */
	@media (max-width: 560px) {
		.plan-catalogue-nav {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
