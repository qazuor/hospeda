---
/**
 * @file WhatsAppContact.astro
 * @description Gated WhatsApp contact block for an accommodation detail page (HOS-19).
 *
 * Renders one of three states, decided by the page from the VIEWER's plan:
 *   1. `showUpsell` → a "subscribe to see WhatsApp" prompt (anonymous / free /
 *      any viewer without `CAN_CONTACT_WHATSAPP_DISPLAY`). No number is shown.
 *   2. `number` + `direct` (tourist-vip+ / owner-pro+) → a one-click `wa.me`
 *      deep link button.
 *   3. `number` + not `direct` (tourist-plus+ / owner-basico+) → the number as
 *      selectable text (display only; no click-to-chat link).
 *
 * The number is resolved per-viewer on the protected endpoint
 * `GET /protected/accommodations/:id/whatsapp` and is NEVER present on the
 * shared-cached public payload, so it can never leak to an unentitled viewer.
 *
 * Hydration: none — fully static Astro component (the page fetched everything
 * in SSR).
 */
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildWhatsAppLink } from '@/lib/whatsapp';

interface Props {
    /** The WhatsApp number, or null when the viewer is not entitled to it. */
    readonly number: string | null;
    /** Whether the viewer may use the one-click `wa.me` deep link (VIP+). */
    readonly direct: boolean;
    /** Render the subscribe upsell instead of a number. */
    readonly showUpsell: boolean;
    /** Accommodation name, used in the prefilled WhatsApp message. */
    readonly accommodationName: string;
    /** Locale-aware href to the plans page (upsell CTA target). */
    readonly plansHref: string;
    readonly locale: SupportedLocale;
}

const { number, direct, showUpsell, accommodationName, plansHref, locale } = Astro.props;
const { t } = createTranslations(locale);

// Nothing to render unless we have a number to show or an upsell to offer.
if (!showUpsell && !number) return;

const title = t('accommodations.detail.whatsapp.title', 'Contacto por WhatsApp');

// --- wa.me deep link (direct tier only) ---
// Built by the shared helper so the phone is sanitized the one way wa.me
// accepts (bare digits, no leading '+') — see `@/lib/whatsapp`.
let waUrl: string | null = null;
if (number && direct) {
    const message = t(
        'accommodations.detail.whatsapp.messageTemplate',
        'Hola, me interesa obtener más información sobre {{name}}'
    ).replace('{{name}}', accommodationName);
    waUrl = buildWhatsAppLink({ phone: number, message }).url;
}

const ctaLabel = t('accommodations.detail.whatsapp.cta', 'Consultar por WhatsApp');
const numberLabel = t('accommodations.detail.whatsapp.numberLabel', 'WhatsApp del anfitrión');
const upsellText = t(
    'accommodations.detail.whatsapp.upsellText',
    'Suscribite a Plus para ver el WhatsApp del anfitrión.'
);
const upsellCta = t('accommodations.detail.whatsapp.upsellCta', 'Ver planes');
---

<section class="acc-whatsapp">
    <h3 class="acc-whatsapp__title">{title}</h3>

    {showUpsell ? (
        <div class="acc-whatsapp__upsell">
            <p class="acc-whatsapp__upsell-text">{upsellText}</p>
            <a class="acc-whatsapp__upsell-cta" href={plansHref}>{upsellCta}</a>
        </div>
    ) : waUrl ? (
        <a
            href={waUrl}
            class="acc-whatsapp__btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={ctaLabel}
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
                aria-hidden="true"
            >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>{ctaLabel}</span>
        </a>
    ) : (
        <p class="acc-whatsapp__number" aria-label={numberLabel}>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="18"
                height="18"
                aria-hidden="true"
            >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>{number}</span>
        </p>
    )}
</section>

<style>
    .acc-whatsapp {
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 12px);
        padding: var(--space-5, 20px);
        background-color: var(--surface-warm);
        border-radius: var(--radius-card, 24px);
        border: 1px solid var(--border);
    }

    .acc-whatsapp__title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--core-foreground);
        margin: 0;
    }

    .acc-whatsapp__btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        border-radius: var(--radius-button, 8px);
        /* HOS-314: the WhatsApp brand green with DARK ink on top (9.12:1).
           White on this green is 1.98:1 — below WCAG AA for both normal (4.5)
           and large (3) text. The fill keeps the brand color; only the ink was
           inverted. Both values are theme-invariant on purpose — see
           packages/design-tokens/src/tokens/colors.ts. */
        background-color: var(--channel-whatsapp);
        color: var(--channel-whatsapp-foreground);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        transition: background-color 200ms ease-out;
        width: fit-content;
    }

    /* An explicit darker green, not `opacity`: fading the button dims the ink
       and the fill together, so it cannot preserve the contrast ratio. */
    .acc-whatsapp__btn:hover {
        background-color: var(--channel-whatsapp-hover);
    }

    .acc-whatsapp__btn:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }

    .acc-whatsapp__number {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 1rem;
        /* HOS-314: WhatsApp's own teal (#128c7e) reads 3.57:1 on
           --surface-warm in light and 3.82:1 in dark — it fails AA in BOTH.
           This token is the theme-aware step, since --surface-warm inverts. */
        color: var(--channel-whatsapp-text);
        user-select: text;
    }

    .acc-whatsapp__upsell {
        display: flex;
        flex-direction: column;
        gap: var(--space-3, 12px);
    }

    .acc-whatsapp__upsell-text {
        margin: 0;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        color: var(--core-muted-foreground);
    }

    .acc-whatsapp__upsell-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: var(--radius-button, 8px);
        background-color: var(--brand-primary);
        /* HOS-314: was a hard-coded `white`, which measures 2.93:1 on the dark
           brand blue — below even the 3:1 large-text floor, on the branch every
           anonymous visitor sees. The repo's primary-button ink token inverts to
           near-black in dark and reads 7.05:1 there, so the design system
           already had the fix and this rule had opted out of it.
           The trade, stated plainly: in light the token is `oklch(0.99 0 0)`,
           so this goes 3.56 -> 3.47 — both fail AA 4.5, because light
           `--brand-primary` + near-white is a REPO-WIDE pair that every primary
           CTA shares and that is out of scope here (tracked in HOS-367).
           Consuming the token costs 0.09 in a state that already fails and
           gains 4.12 in one that failed worse, and it puts this rule inside
           that systemic fix instead of permanently outside it. */
        color: var(--primary-foreground);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        width: fit-content;
        transition: background-color 200ms ease-out;
    }

    /* Same reason as the WhatsApp button: `opacity` composites ink and fill
       toward the surface together, which took this rule to 2.72:1 on hover.
       Ink on this fill: 4.26:1 light, 5.78:1 dark.

       The token is `--brand-primary-lm05`, NOT `--primary-hover`, and the
       difference is load-bearing: `--primary-hover` is emitted at `:root` as a
       bare `oklch(from …)` relative color with no sRGB fallback and no
       `@supports` gate, so below Chrome 119 / Safari 16.4 / Firefox 128 the
       whole declaration is invalid at computed-value time and the fill falls
       back to transparent — leaving this near-white ink on `--surface-warm` at
       1.13:1. That is the BETA-44 incident global.css warns about, and
       `check-css-relative-colors.cjs` cannot catch it here because the invalid
       syntax lives in the token, not in this file (the remaining consumers of
       such tokens are tracked in HOS-368). `-lm05` ships a solid `:root`
       fallback plus an `@supports` oklch override, and is what the repo's other
       primary hovers already use.

       Identical math in LIGHT, not in dark. `--primary-hover` is `calc(l - 0.05)`
       in light — byte-identical to `-lm05`, so the light ratio is unchanged at
       4.26 on any browser that supports relative colors, and the light gain is
       1.13 -> 4.26 only on the browsers that do not. In DARK it is
       `calc(l + 0.07)`, i.e. it brightens, while `-lm05` darkens in both themes:
       there the measured trade is 9.25 -> 5.78. Taking that loss is deliberate —
       a hover that reads 5.78:1 everywhere beats one that reads 9.25:1 on new
       browsers and paints nothing on old ones — and 5.78 clears AA comfortably.
       If dark wants its brightening back it needs a `-lp07` variant token with
       the same fallback pair, not `--primary-hover`. */
    .acc-whatsapp__upsell-cta:hover {
        background-color: var(--brand-primary-lm05);
    }

    .acc-whatsapp__upsell-cta:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
    }
</style>
