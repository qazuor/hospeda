---
/**
 * @file DetailHeader.astro
 * @description Accommodation detail page header with a history-aware back
 * button, name, type badge, destination, status pills, rating, favorite
 * button, and bookmark counter.
 *
 * Layout (HOS-84): a back-button row above the title and metadata, with a
 * right-aligned cluster for Compare and Favorite. Compare precedes the
 * destination link in the DOM to match the mobile rows. Below
 * 768px the compare button collapses to an icon-only circle
 * (DetailCompareButton.module.css) matching the FavoriteButton's diameter so
 * the pair fits without overflowing the header row on mobile. Pages with
 * mobile gallery controls use a smaller compare button aligned to the title.
 *
 * Compact behavior comes from the shared `.wh-compact-*` utility classes
 * (contract defined once in WaveHeader.astro): `wh-compact-row` collapses the
 * main stack to one line, `wh-compact-title` shrinks the H1, `wh-compact-hide`
 * drops the back-button row + rating, `wh-compact-demote` inlines the
 * destination, `wh-compact-badge` shrinks the status pill. Only genuinely
 * accommodation-specific overrides (such as the type badge's custom-prop
 * shrink) remain local below.
 *
 * The status badges (featured/new) are rendered as plain spans here (instead
 * of going through the `Badge` primitive) so we can size them identically to
 * the type badge — the primitive's inline padding/font-size would otherwise
 * win over any external override.
 */
import type { AccommodationDetailData } from '@/data/types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { getBadgeStatusColor } from '@/lib/colors';
import AccommodationTypeBadge from '@/components/shared/ui/AccommodationTypeBadge.astro';
import HeaderBackButton from '@/components/shared/ui/HeaderBackButton.astro';
import RatingStars from '@/components/shared/ui/RatingStars.astro';
import { FavoriteButton } from '@/components/shared/favorite/FavoriteButton.client';
import { DetailCompareButton } from '@/components/accommodation/DetailCompareButton.client';
import { CheckCircleIcon, StarIcon } from '@repo/icons';
import { EntitlementKeyEnum } from '@repo/schemas';
import { getGatePlanNames } from '@/lib/billing/gate-plan-names';

interface Props {
  readonly accommodation: AccommodationDetailData;
  readonly lang: string;
  /** UUID of the accommodation — used by FavoriteButton. */
  readonly accommodationId: string;
  /**
   * Pre-fetched public bookmark count.
   * When undefined the counter is not rendered (parent opted out of pre-fetch).
   */
  readonly bookmarkCount?: number;
  /** Whether the gallery already renders back and favorite controls on mobile. */
  readonly hasMobileGalleryControls?: boolean;
}

const {
  accommodation,
  lang,
  accommodationId,
  bookmarkCount,
  hasMobileGalleryControls = false
} = Astro.props;
const locale = lang as SupportedLocale;
const { t, tPlural } = createTranslations(locale);
// HOS-2554: the compare upsell names the catalog plans that carry comparison (public, not
// per-user, so the page stays session-blind).
const compareGatePlanNames = await getGatePlanNames({
  entitlement: EntitlementKeyEnum.CAN_COMPARE_ACCOMMODATIONS
});

const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const isNew = (Date.now() - new Date(accommodation.createdAt).getTime()) < THIRTY_DAYS_MS;

const newColors = getBadgeStatusColor({ status: 'new' });

const newStyle =
  `background-color: ${newColors.bg}; color: ${newColors.onFill}; border-color: ${newColors.border};`;
---

<header class:list={['detail-header', { 'detail-header--mobile-gallery': hasMobileGalleryControls }]}>
  <div class="detail-header__back-row wh-compact-hide">
    <HeaderBackButton href={`/${lang}/alojamientos/`} locale={locale} />
  </div>

  <div class="detail-header__body">
    <div class="detail-header__main wh-compact-row">
      <div
        class="detail-header__badges"
        tabindex="-1"
        role="group"
        aria-label={t('accommodations.detail.badges.scrollLabel')}
      >
        <AccommodationTypeBadge
          type={accommodation.type}
          locale={locale}
          size="sm"
          class="detail-header__type-badge"
        />
        {accommodation.isFeatured && (
          <span class="featured-badge">
            <StarIcon size={12} weight="fill" aria-hidden="true" />
            <span>{t('accommodations.detail.badges.featured')}</span>
          </span>
        )}
        {accommodation.isVerified && (
          <span class="featured-badge detail-header__verified-badge">
            <CheckCircleIcon size={12} weight="fill" aria-hidden="true" />
            <span>{t('accommodations.detail.badges.verified')}</span>
          </span>
        )}
        {isNew && (
          <span class="detail-header__status-pill wh-compact-badge" style={newStyle}>
            {t('accommodations.detail.badges.new')}
          </span>
        )}
      </div>

      <h1 class="detail-header__name wh-compact-title">{accommodation.name}</h1>

      <div class="detail-header__favorite">
        <DetailCompareButton
          client:load
          accommodationId={accommodationId}
          accommodationName={accommodation.name}
          accommodationThumbnailUrl={accommodation.featuredImage}
          locale={locale}
          gatePlanNames={compareGatePlanNames}
          className="detail-header__compare-btn"
        />
        <div class="detail-header__favorite-only">
          <FavoriteButton
            client:load
            entityId={accommodationId}
            entityType="ACCOMMODATION"
            variant="standalone"
            locale={locale}
            className="detail-header__favorite-btn"
          />
        </div>
      </div>

      <a href={`/${lang}/destinos/${accommodation.destination.slug}`} class="detail-header__destination wh-compact-demote">
        {accommodation.destination.name}
      </a>

      {accommodation.averageRating > 0 && (
        <div class="detail-header__rating wh-compact-hide">
          <RatingStars rating={accommodation.averageRating} />
          <span class="detail-header__reviews-count">
            ({accommodation.reviewsCount} {t('accommodations.detail.reviewsLabel')})
          </span>
          {bookmarkCount !== undefined && (
            <span
              class="detail-header__bookmark-count"
            >
              <span class="detail-header__bookmark-icon" aria-hidden="true">♥</span>
              {bookmarkCount === 0
                ? t('accommodations.detail.bookmark_count_zero', 'Sé el primero en guardarlo')
                : tPlural('accommodations.detail.bookmark_count', bookmarkCount)}
            </span>
          )}
        </div>
      )}

      {accommodation.averageRating === 0 && bookmarkCount !== undefined && (
        <div class="detail-header__rating wh-compact-hide">
          <span
            class="detail-header__bookmark-count"
          >
            <span class="detail-header__bookmark-icon" aria-hidden="true">♥</span>
            {bookmarkCount === 0
              ? t('accommodations.detail.bookmark_count_zero', 'Sé el primero en guardarlo')
              : tPlural('accommodations.detail.bookmark_count', bookmarkCount)}
          </span>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  // Desktop badges wrap instead of scrolling, so they don't need a tab stop.
  const mobile = window.matchMedia('(max-width: 767px)');
  const updateBadgeTabStops = () => {
    for (const badges of document.querySelectorAll('.detail-header__badges')) {
      badges.setAttribute('tabindex', mobile.matches ? '0' : '-1');
    }
  };

  updateBadgeTabStops();
  mobile.addEventListener('change', updateBadgeTabStops);
  document.addEventListener('astro:page-load', updateBadgeTabStops);
</script>

<style>
  /* Vertical stack: back-button row on top, then the body row. */
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 8px);
  }

  /* Back-button row — collapses out via `wh-compact-hide` in compact mode, so
     it needs its own max-height/opacity transition to animate. */
  .detail-header__back-row {
    overflow: hidden;
    max-height: 3em;
    opacity: 1;
    transition:
      max-height var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease),
      opacity 0.2s ease;
  }

  /* Keep the desktop action cluster at the top right without changing DOM order. */
  .detail-header__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "badges compare"
      "title compare"
      "destination compare";
    gap: var(--space-2, 8px) var(--space-3, 12px);
    transition: gap var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease);
  }

  .detail-header__main > .detail-header__rating {
    grid-column: 1;
    grid-row: 4;
  }

  .detail-header__favorite {
    grid-area: compare;
    align-self: start;
    flex-shrink: 0;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
  }

  .detail-header__favorite-only {
    display: contents;
  }

  .detail-header__badges {
    grid-area: badges;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
    align-items: center;
    transition: gap var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease);
  }

  .detail-header__badges:focus-visible {
    outline: 2px solid var(--brand-primary);
    outline-offset: -2px;
  }

  /* Verified badge — reuses the shared `.featured-badge` shape (padding,
   * font, radius, icon gap) from components.css but swaps to the semantic
   * "info" (trust) token so it reads apart from the accent-colored featured
   * badge, mirroring the AccommodationCard verified-badge treatment. */
  .detail-header__verified-badge {
    background-color: var(--info);
    color: var(--info-foreground);
  }

  /* Status pills: rendered inline (not via the Badge primitive) so they share
   * the exact padding / font-size / radius of the type badge. The colour
   * palette comes from `getBadgeStatusColor`, applied via inline `style`. */
  .detail-header__status-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius-pill, 9999px);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 14px;
    line-height: 1.4;
    white-space: nowrap;
    transition: padding var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease), font-size var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease);
  }

  /* Bookmark count pill (non-interactive, info only) */
  .detail-header__bookmark-count {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--core-muted-foreground);
    border-left: 1px solid var(--border);
    padding-left: var(--space-2, 8px);
    margin-left: var(--space-1, 4px);
  }

  .detail-header__bookmark-icon {
    font-size: 0.75rem;
    color: var(--destructive);
    line-height: 1;
  }

  .detail-header__name {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--core-foreground);
    margin: 0;
    line-height: 1.15;
    transition: font-size var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease);
  }
  .detail-header__destination {
    grid-area: destination;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--brand-primary-link);
    text-decoration: none;
    transition: font-size var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease);
  }
  .detail-header__destination:hover {
    text-decoration: underline;
  }
  .detail-header__rating {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    overflow: hidden;
    max-height: 3em;
    opacity: 1;
    transition:
      max-height var(--wave-header-anim-duration, 0.3s) var(--wave-header-anim-ease, ease),
      opacity 0.2s ease;
  }
  .detail-header__reviews-count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--core-muted-foreground);
  }

  /* =========================================================
   * Compact state — only genuinely accommodation-specific overrides remain
   * here; the title shrink, destination demote, rating/back
   * hide and status-pill shrink all come from the shared `.wh-compact-*`
   * utilities applied in the markup (contract in WaveHeader.astro).
   * ========================================================= */
  :global(.wave-header--compact) .detail-header__main {
    display: flex;
  }

  :global(.wave-header--compact) .detail-header__favorite {
    align-self: center;
    order: 1;
  }

  :global(.wave-header--compact) .detail-header__badges {
    gap: 4px;
  }

  /* Type badge shrinks via the custom properties exposed by
   * AccommodationTypeBadge — no `!important`, no fighting child styles. This
   * cannot use `wh-compact-badge` because the primitive sizes itself from
   * these custom props, not a direct font-size/padding. */
  :global(.wave-header--compact .detail-header__type-badge) {
    --acc-type-font-size: 0.6rem;
    --acc-type-padding: 2px 10px;
  }

  @media (min-width: 768px) {
    /* Metadata can wrap within its tracks; the action cluster never joins that flow. */
    :global(.wave-header.wave-header--compact) .detail-header__main {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, max-content)) 1fr auto;
      grid-template-areas:
        "badges title destination . compare"
        "rating rating rating . compare";
      row-gap: 0;
    }

    :global(.wave-header--compact) .detail-header__favorite {
      align-self: start;
      order: 0;
    }

    :global(.wave-header--compact) .detail-header__main > .detail-header__rating {
      grid-area: rating;
    }

    :global(.wave-header--compact) .detail-header__name,
    :global(.wave-header--compact) .detail-header__destination {
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 767px) {
    .detail-header--mobile-gallery .detail-header__back-row,
    .detail-header--mobile-gallery .detail-header__favorite-only {
      display: none;
    }

    /* Keep Compare beside the title even when WaveHeader shrinks on scroll. */
    :global(.wave-header) .detail-header--mobile-gallery .detail-header__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "badges badges"
        "title compare"
        "destination destination"
        "rating rating";
      align-items: center;
      column-gap: var(--space-3, 12px);
      row-gap: var(--space-2);
    }

    :global(.wave-header) .detail-header--mobile-gallery .detail-header__main {
      display: contents;
    }

    .detail-header__badges {
      min-width: 0;
      max-width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .detail-header__badges > * {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .detail-header__badges :global(.detail-header__type-badge) {
      --acc-type-font-size: 12px;
    }

    .detail-header__badges .featured-badge,
    .detail-header__badges .detail-header__status-pill {
      font-size: 12px;
    }

    .detail-header__name {
      overflow-wrap: anywhere;
    }

    /* Long titles wrap to 5 lines at the desktop-derived size; use the h3 step. */
    .detail-header--mobile-gallery .detail-header__name {
      font-size: var(--text-h3, 1.25rem);
    }

    .detail-header--mobile-gallery .detail-header__rating {
      grid-area: rating;
    }

    /* Compare aligns with the first title line, not the whole wrapped block. */
    :global(.wave-header) .detail-header--mobile-gallery .detail-header__favorite {
      align-self: start;
      order: 0;
    }

    /* The destination already has its own row, even in compact mode. */
    :global(.wave-header--compact) .detail-header--mobile-gallery .detail-header__destination::before {
      content: none;
    }

    .detail-header--mobile-gallery :global(.detail-header__compare-btn) {
      width: 32px;
      height: 32px;
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-header__back-row,
    .detail-header__main,
    .detail-header__status-pill,
    .detail-header__name,
    .detail-header__destination,
    .detail-header__rating {
      transition: none;
    }
    /* Type badge: AccommodationTypeBadge owns its own reduced-motion rule. */
  }
</style>
