---
/**
 * @file QuickFacts.astro
 * @description Horizontal row of icon+value pills showing accommodation quick facts.
 * Only renders pills for non-null fields. Hidden when there is nothing to show.
 * Everything comes from `extraInfo`.
 *
 * The stay length (`policies.minNights` / `policies.maxNights`) is NOT here any more
 * (owner smoke, HOS-2520): it was shown twice, a few pixels apart, here and in the
 * price block. It is a booking constraint, so it lives only next to the price and
 * «Consultar»: `MobileBookingSummary` up to 1024px, `PricingSidebar` above. Those two
 * never show at the same width, so every viewport shows it exactly once.
 */
import type { AccommodationDetailData } from '@/data/types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { GuestsIcon, BedroomsIcon, BedLinensIcon, BathroomsIcon } from '@repo/icons';

interface Props {
  readonly extraInfo: AccommodationDetailData['extraInfo'];
  readonly lang: string;
}

const { extraInfo, lang } = Astro.props;
const { t, tPlural } = createTranslations(lang as SupportedLocale);

if (!extraInfo) return;

const compactFacts = [
  extraInfo?.capacity != null && tPlural('accommodations.detail.quickFacts.guests', extraInfo.capacity),
  extraInfo?.bedrooms != null && tPlural('accommodations.detail.quickFacts.compactBedrooms', extraInfo.bedrooms),
  extraInfo?.beds != null && tPlural('accommodations.detail.quickFacts.compactBeds', extraInfo.beds),
  extraInfo?.bathrooms != null && tPlural('accommodations.detail.quickFacts.compactBathrooms', extraInfo.bathrooms)
].filter(Boolean);
---

{compactFacts.length > 0 && (
  <div
    class="quick-facts__compact"
    role="group"
    aria-label={t('accommodations.detail.quickFacts.scrollLabel')}
  >
    {/* Each fact is unbreakable and carries its trailing separator, so a long
        row wraps BETWEEN facts and the dot stays with the fact before it. */}
    {compactFacts.map((fact, index) => (
      <span class="quick-facts__compact-item">{index < compactFacts.length - 1 ? `${fact} ·` : fact}</span>
    ))}
  </div>
)}

<div class="quick-facts">
  {extraInfo?.capacity != null && (
    <div class="quick-facts__pill">
      <GuestsIcon size="sm" weight="duotone" aria-hidden="true" />
      <div class="quick-facts__text">
        <span class="quick-facts__value">{tPlural('accommodations.detail.quickFacts.guests', extraInfo.capacity)}</span>
        <span class="quick-facts__label">{t('accommodations.detail.quickFacts.capacity')}</span>
      </div>
    </div>
  )}
  {extraInfo?.bedrooms != null && (
    <div class="quick-facts__pill">
      <BedroomsIcon size="sm" weight="duotone" aria-hidden="true" />
      <div class="quick-facts__text">
        <span class="quick-facts__value">{extraInfo.bedrooms}</span>
        <span class="quick-facts__label">{t('accommodations.detail.quickFacts.bedrooms')}</span>
      </div>
    </div>
  )}
  {extraInfo?.beds != null && (
    <div class="quick-facts__pill">
      <BedLinensIcon size="sm" weight="duotone" aria-hidden="true" />
      <div class="quick-facts__text">
        <span class="quick-facts__value">{extraInfo.beds}</span>
        <span class="quick-facts__label">{t('accommodations.detail.quickFacts.beds')}</span>
      </div>
    </div>
  )}
  {extraInfo?.bathrooms != null && (
    <div class="quick-facts__pill">
      <BathroomsIcon size="sm" weight="duotone" aria-hidden="true" />
      <div class="quick-facts__text">
        <span class="quick-facts__value">{extraInfo.bathrooms}</span>
        <span class="quick-facts__label">{t('accommodations.detail.quickFacts.bathrooms')}</span>
      </div>
    </div>
  )}
</div>

<style>
  .quick-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3, 12px);
    margin-block: var(--space-4, 16px);
  }
  .quick-facts__pill {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: var(--space-2, 8px) var(--space-3, 12px);
    background-color: var(--core-card);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border, oklch(0.8 0 0));
  }
  .quick-facts__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .quick-facts__value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--core-foreground);
  }
  .quick-facts__label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--core-muted-foreground);
  }

  .quick-facts__compact {
    display: none;
  }

  @media (max-width: 767px) {
    .quick-facts {
      display: none;
    }
    /* Wraps to a second line instead of clipping: a horizontal scroller hid
       the last facts and nobody discovered the swipe. */
    .quick-facts__compact {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.3em;
      row-gap: var(--space-1);
      margin: 0;
      font-size: 0.875rem;
      color: var(--core-muted-foreground);
    }
    .quick-facts__compact-item {
      white-space: nowrap;
    }
  }
</style>
