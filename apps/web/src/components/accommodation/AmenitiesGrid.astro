---
/**
 * @file AmenitiesGrid.astro
 * @description Summarized amenities (HOS-2528): pills with icon, 6 visible on mobile
 * and 8 on desktop. «Ver las N comodidades» opens a `sheet` dialog (island
 * `ListingItemsSheet`) with the complete list; there is no inline expand any more.
 * Pills 7-8 are in the DOM but hidden below 768px by CSS, so the split between the
 * two breakpoints costs no JavaScript.
 *
 * Owner rule (HOS-2528, 2026-11-23): a breakpoint collapses only when at least 5 items
 * would be hidden (`summarizeItems`). Up to 10 items mobile shows all and has no button;
 * up to 12 items desktop shows all and has no button.
 *
 * SEO / no-JS: the sheet island renders nothing while closed, so its children never
 * reach the HTML. Every amenity past the visible pills therefore also renders here, in
 * SSR, as a visually-hidden list (`data-amenities-rest`): crawlers and screen readers
 * get the whole catalog and, read in order, it simply continues the visible pills.
 * Without JavaScript (`<noscript>`) the list becomes visible and the dead sheet button
 * is hidden.
 *
 * HOS-2058: an amenity whose relation DECLARES scope and/or availability shows
 * a badge per declared value (`resolveAmenityAttributeBadges`); an undeclared
 * one shows nothing.
 */
import type { AccommodationAmenityItem } from '@/data/types';
import { resolveAmenityAttributeBadges } from '@/lib/catalog-attribute-badges';
import { createTranslations } from '@/lib/i18n';
import { summarizeItems } from '@/lib/listing-items/summarize-items';
import type { SupportedLocale } from '@/lib/i18n';
import ListingPill from '@/components/listing/ListingPill.astro';
import { ListingItemsSheet } from '@/components/listing/ListingItemsSheet.client';
import { resolveIcon } from '@repo/icons/resolver';
import { isMissingTranslation } from '@repo/i18n/web';

interface Props {
  readonly amenities: readonly AccommodationAmenityItem[];
  readonly lang: string;
}

const { amenities, lang } = Astro.props;
const { t, tPlural } = createTranslations(lang as SupportedLocale);

if (amenities.length === 0) return;

/** Pills shown on mobile; desktop shows {@link DESKTOP_COUNT}. */
const MOBILE_COUNT = 6;
const DESKTOP_COUNT = 8;

/** Translate amenity name via i18n, falling back to humanized raw name. */
function translateAmenity(name: string): string {
  const key = `accommodations.amenityNames.${name}`;
  const translated = t(key);
  if (isMissingTranslation({ key, value: translated })) {
    return name
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
  }
  return translated;
}

const additionalCostLabel = t('accommodations.detail.amenitiesDetail.additionalCost');
const entries = amenities.map((amenity) => ({
  label: translateAmenity(amenity.name),
  Icon: amenity.icon ? resolveIcon({ iconName: amenity.icon }) : null,
  costLabel: amenity.additionalCost != null ? additionalCostLabel : null,
  badges: resolveAmenityAttributeBadges({
    scope: amenity.scope,
    availability: amenity.availability,
    extraCharge: amenity.isOptional,
    t
  })
}));

/** Owner rule: collapse a breakpoint only when at least 5 items would be hidden there. */
const { showAllMobile, showAllDesktop } = summarizeItems({
  total: entries.length,
  visibleMobile: MOBILE_COUNT,
  visibleDesktop: DESKTOP_COUNT
});
const hasOverflow = !showAllMobile;
const visibleEntries = showAllDesktop ? entries : entries.slice(0, DESKTOP_COUNT);
const restEntries = showAllDesktop ? [] : entries.slice(DESKTOP_COUNT);
const viewAllLabel = tPlural('accommodations.detail.amenitiesDetail.viewAll', entries.length);
const title = t('accommodations.detail.amenitiesDetail.title');
---

<section class="amenities-section">
  <h2 class="amenities-section__title">{title}</h2>

  <div class="amenities-list" data-amenities-list>
    {visibleEntries.map((entry, index) => (
      <div class:list={['amenities-list__item', { 'amenities-list__item--desktop-only': !showAllMobile && index >= MOBILE_COUNT }]}>
        <ListingPill {...entry} />
      </div>
    ))}
  </div>

  {restEntries.length > 0 && (
    <div class="amenities-list amenities-list--rest" data-amenities-rest>
      {restEntries.map((entry) => <ListingPill {...entry} />)}
    </div>
  )}

  {hasOverflow && (
    <div class:list={['amenities-section__more', { 'amenities-section__more--mobile-only': showAllDesktop }]}>
      <ListingItemsSheet
        client:idle
        sheetId="amenities-sheet"
        triggerLabel={viewAllLabel}
        title={title}
        closeLabel={t('accommodations.detail.amenitiesDetail.close')}
      >
        <div class="amenities-list amenities-list--full" data-amenities-full>
          {entries.map((entry) => <ListingPill {...entry} />)}
        </div>
      </ListingItemsSheet>
    </div>
  )}
</section>
<noscript>
  <style is:inline>
    [data-amenities-rest] { position: static !important; inline-size: auto !important; block-size: auto !important; clip-path: none !important; overflow: visible !important; white-space: normal !important; }
    .amenities-section__more { display: none !important; }
    .amenities-list__item--desktop-only { display: contents !important; }
  </style>
</noscript>

<style>
  .amenities-section {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 16px);
  }
  .amenities-section__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--core-foreground);
    margin: 0;
  }
  .amenities-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
  }
  .amenities-list__item {
    display: contents;
  }
  /* Pills past the sixth are desktop-only while mobile collapses. */
  .amenities-list__item--desktop-only {
    display: none;
  }
  /* Visually hidden, still in the DOM and in the accessibility tree (see @file). */
  .amenities-list--rest {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .amenities-list__item--desktop-only {
      display: contents;
    }
    /* When desktop would hide fewer than 5 items it shows them all: no button. */
    .amenities-section__more--mobile-only {
      display: none;
    }
  }
</style>
