---
/**
 * @file ExternalReputation.astro
 * @description "Lo que dicen en otras plataformas" block rendered on the
 * accommodation detail page. Sibling to ReviewPreview, placed after it.
 *
 * Accepts an {@link ExternalReputationBlock} from the public API and renders,
 * in this order:
 *
 * 1. A summary row per platform that has an aggregate score (platform label,
 *    numeric rating, five-star visual, review count, allow-listed "Ver en …"
 *    link). Google's row is always the LAST one, so it sits directly above its
 *    own review cards without the cards splitting the list of scores.
 * 2. Up to three Google review cards (ExternalReviews island) showing the
 *    guest's original text. When the cached snippets are TTL-expired, a muted
 *    note replaces the cards.
 * 3. The Google CTA, only when the review block is shown. Google gets exactly
 *    ONE link: with the review block visible it is this CTA (the Google score
 *    row drops its own "Ver en Google"); without it, the score row's link, or
 *    the "También en" pill when Google has no score.
 * 4. A "También en:" pill row for platforms that have no aggregate but do have
 *    a safe outbound link.
 *
 * Renders NOTHING when the block is empty OR when every configured platform
 * came back with no score, no safe link and no snippets — see
 * `lib/external-reputation-visibility.ts` and H-133.
 */

import { ExternalLinkIcon } from '@repo/icons';
import type { ExternalReputationBlock, ExternalReputationPlatformItem } from '@repo/schemas';
import { ExternalReviews } from './ExternalReviews.client';
import ExternalReputationSummaryRow from './ExternalReputationSummaryRow.astro';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import {
    hasAggregate,
    hasValidSnippets,
    orderSummaryItemsGoogleLast,
    resolvePlatformHref,
    selectLinkOnlyReputationItems,
    selectSummaryReputationItems,
    selectVisibleReputationItems
} from '@/lib/external-reputation-visibility';
import styles from './ExternalReputation.module.css';

interface Props {
    /**
     * External reputation block from GET /api/v1/public/accommodations/:id/external-reputation.
     * Render nothing when items is empty.
     */
    readonly reputationData: ExternalReputationBlock;
    /** Active locale for i18n. */
    readonly locale: string;
}

const { reputationData, locale } = Astro.props;
const { t, tPlural } = createTranslations(locale as SupportedLocale);

// Nothing to render when no platform is configured.
const { items: configuredItems } = reputationData;
if (configuredItems.length === 0) {
    return;
}

/**
 * Returns the i18n-translated platform name for a given platform key.
 */
function platformLabel(platform: ExternalReputationPlatformItem['platform']): string {
    const key = `external-reputation.platform.${platform.toLowerCase()}` as const;
    return t(key as Parameters<typeof t>[0], platform);
}

/**
 * Determines if a platform item should show the "snippets temporarily unavailable"
 * note. Uses the explicit `snippetsTtlExpired` flag set by buildExternalReputationBlock
 * rather than inferring from missing snippets — prevents showing the note when the
 * owner intentionally disabled reviews (showReviews=false) (FIX L5).
 */
function isGoogleTtlExpired(item: ExternalReputationPlatformItem): boolean {
    return item.snippetsTtlExpired === true;
}

// Drop platforms that came back with nothing at all. When that leaves nothing,
// say nothing rather than publish a section promising reviews it does not have
// (H-133). The predicates live in `lib/external-reputation-visibility.ts` so
// they can be unit-tested — Astro components cannot be rendered under Vitest.
const items = selectVisibleReputationItems({ items: configuredItems });
if (items.length === 0) {
    return;
}

// Google-only review block state.
const googleItemWithSnippets = items.find((item) => hasValidSnippets({ item }));
const googleItemTtlExpired = items.find(
    (item) =>
        item.platform === 'GOOGLE' && isGoogleTtlExpired(item) && hasAggregate({ item })
);
const showReviewsBlock = googleItemWithSnippets != null || googleItemTtlExpired != null;

// The Google CTA targets the Google listing's safe link, and is the one Google
// link only while the review block is shown.
const googleItem = items.find((item) => item.platform === 'GOOGLE');
const googleHref = googleItem != null ? resolvePlatformHref({ item: googleItem }) : undefined;
const showGoogleCta = showReviewsBlock && googleHref != null;
const googleReviewsCount = googleItem?.reviewsCount ?? null;
const googlePlatformName = t('external-reputation.platform.google', 'Google');

// Summary rows: one per platform with an aggregate, Google last.
const summaryItems = orderSummaryItemsGoogleLast({
    items: selectSummaryReputationItems({ items })
});
// Pill row: platforms with a safe link but no aggregate. Google is left out
// while its CTA is shown, so it never gets two links.
const linkOnlyItems = selectLinkOnlyReputationItems({ items }).filter(
    (item) => !(showGoogleCta && item.platform === 'GOOGLE')
);
---

<section class={styles.section}>
    <h2 class={styles.title}>
        {t('external-reputation.section.title', 'Lo que dicen en otras plataformas')}
    </h2>

    {/* ── Summary rows: one per platform with an aggregate, Google last ── */}
    {summaryItems.length > 0 && (
        <div class={styles.summaryList}>
            {summaryItems.map((item) => (
                <ExternalReputationSummaryRow
                    item={item}
                    locale={locale}
                    showLink={!(showGoogleCta && item.platform === 'GOOGLE')}
                />
            ))}
        </div>
    )}

    {/* ── Google reviews (original text, up to three cards) ── */}
    {showReviewsBlock && (
        <div class={styles.reviewsBlock}>
            {googleItemWithSnippets != null ? (
                <ExternalReviews
                    client:visible
                    snippets={googleItemWithSnippets.snippets!}
                    locale={locale as SupportedLocale}
                />
            ) : googleItemTtlExpired != null ? (
                <p class={styles.ttlNote}>
                    {t(
                        'external-reputation.snippets.ttlExpired',
                        'Las reseñas de texto no están disponibles temporalmente; mostrando solo el puntaje'
                    )}
                </p>
            ) : null}
        </div>
    )}

    {/* ── Google CTA (the one Google link while the reviews are shown) ── */}
    {showGoogleCta && (
        <div class={styles.reviewsFooter}>
            <a
                href={googleHref}
                target="_blank"
                rel="noopener noreferrer"
                class={styles.seeAllLink}
            >
                <span>
                    {googleReviewsCount != null
                        ? tPlural('external-reputation.reviews.seeAllOn', googleReviewsCount, {
                              platform: googlePlatformName
                          })
                        : t('external-reputation.link.viewOn', 'Ver en {{platform}}', {
                              platform: googlePlatformName
                          })}
                </span>
                <ExternalLinkIcon size="sm" aria-hidden="true" />
            </a>
        </div>
    )}

    {/* ── "También en:" pill row ── */}
    {linkOnlyItems.length > 0 && (
        <div class={styles.alsoOn}>
            <span class={styles.alsoOnLabel}>{t('external-reputation.alsoOn', 'También en:')}</span>
            {linkOnlyItems.map((item) => {
                const pillHref = resolvePlatformHref({ item });
                if (!pillHref) {
                    return null;
                }
                return (
                    <a
                        href={pillHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={styles.pill}
                    >
                        <span>{platformLabel(item.platform)}</span>
                        <ExternalLinkIcon size="xs" aria-hidden="true" />
                    </a>
                );
            })}
        </div>
    )}
</section>
