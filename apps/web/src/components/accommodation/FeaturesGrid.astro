---
/**
 * @file FeaturesGrid.astro
 * @description Features as pills with icon. Hidden when empty. HOS-2528: when at least
 * 5 features would be hidden past the first {@link SUMMARY_COUNT} (11 or more in total) only
 * the first ones show, and «Ver las N
 * características» opens a `sheet` dialog (island `ListingItemsSheet`) with the full list.
 *
 * SEO / no-JS: the sheet island renders nothing while closed, so the features past the
 * summary also render in SSR as a visually-hidden list (`data-features-rest`), made
 * visible by `<noscript>` (which also hides the dead sheet button). Grouped categories
 * only matter in the sheet; the hidden list is flat.
 *
 * HOS-2060: the synthetic "smoking allowed" item is gone — smoking is a house
 * rule now (`policies.smokingAllowed`) and renders in `ListingHouseRules`.
 *
 * HOS-2058: when any feature carries a `category`, the grid renders one
 * sub-heading + grid per category (canonical order, unclassified ones under
 * "Otras"). With no classified feature — venue and experience today — it stays
 * the flat grid it always was (`groupFeaturesForDisplay` returns null).
 */
import type { AccommodationFeatureItem } from '@/data/types';
import { groupFeaturesForDisplay } from '@/lib/catalog-attribute-badges';
import { createTranslations } from '@/lib/i18n';
import { summarizeItems } from '@/lib/listing-items/summarize-items';
import ListingPill from '@/components/listing/ListingPill.astro';
import { ListingItemsSheet } from '@/components/listing/ListingItemsSheet.client';
import type { SupportedLocale } from '@/lib/i18n';
import { resolveIcon } from '@repo/icons/resolver';
import { isMissingTranslation } from '@repo/i18n/web';

interface Props {
  readonly features: readonly AccommodationFeatureItem[];
  readonly lang: string;
}

const { features, lang } = Astro.props;
const { t, tPlural } = createTranslations(lang as SupportedLocale);

if (features.length === 0) return;

/** Features shown when the list collapses into a summary plus the full-list sheet. */
const SUMMARY_COUNT = 6;

/**
 * Translate feature label via i18n by slug, falling back to humanized slug.
 * SPEC-266: `name` was dropped from the catalog; `feature.name` now holds the slug.
 */
function translateFeature(slug: string): string {
  const key = `accommodations.featureNames.${slug}`;
  const translated = t(key);
  if (isMissingTranslation({ key, value: translated })) {
    return slug
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
  }
  return translated;
}

/** Resolve icon component from icon name. Returns null if not found. */
function getIcon(iconName: string | null) {
  if (!iconName) return null;
  return resolveIcon({ iconName });
}

const featureGroups = groupFeaturesForDisplay({ features, t });
const sections: readonly { readonly key: string; readonly label: string | null; readonly items: readonly AccommodationFeatureItem[] }[] =
  featureGroups === null
    ? [{ key: 'all', label: null, items: features }]
    : featureGroups.map((group) => ({ key: group.key, label: group.label, items: group.items }));

/** Pill props of one feature. hostReWriteName (host-customized label) wins over i18n. */
function toPill(feature: AccommodationFeatureItem) {
  return {
    label: feature.hostReWriteName ?? translateFeature(feature.name),
    Icon: getIcon(feature.icon),
    comments: feature.comments ?? null
  };
}

/** Owner rule (HOS-2528): summarise only when at least 5 features would be hidden. */
const { showAllMobile } = summarizeItems({
  total: features.length,
  visibleMobile: SUMMARY_COUNT,
  visibleDesktop: SUMMARY_COUNT
});
const hasOverflow = !showAllMobile;
const title = t('accommodations.detail.features.title');
const summaryPills = features.slice(0, SUMMARY_COUNT).map(toPill);
const restPills = features.slice(SUMMARY_COUNT).map(toPill);
---

<section class="features-section">
  <h2 class="features-section__title">{title}</h2>

  {hasOverflow ? (
    <>
      <div class="features-list" data-features-summary>
        {summaryPills.map((pill) => <ListingPill {...pill} />)}
      </div>
      <div class="features-list features-list--rest" data-features-rest>
        {restPills.map((pill) => <ListingPill {...pill} />)}
      </div>
      <div class="features-section__more">
        <ListingItemsSheet
          client:idle
          sheetId="features-sheet"
          triggerLabel={tPlural('accommodations.detail.features.viewAll', features.length)}
          title={title}
          closeLabel={t('accommodations.detail.features.close')}
        >
          {sections.map((section) => (
            <div class="features-group">
              {section.label && <h3 class="features-group__title">{section.label}</h3>}
              <div class="features-list">
                {section.items.map((feature) => <ListingPill {...toPill(feature)} />)}
              </div>
            </div>
          ))}
        </ListingItemsSheet>
      </div>
    </>
  ) : (
    sections.map((section) => (
      <div class="features-group">
        {section.label && <h3 class="features-group__title">{section.label}</h3>}
        <div class="features-list">
          {section.items.map((feature) => <ListingPill {...toPill(feature)} />)}
        </div>
      </div>
    ))
  )}
</section>
<noscript>
  <style is:inline>
    [data-features-rest] { position: static !important; inline-size: auto !important; block-size: auto !important; clip-path: none !important; overflow: visible !important; white-space: normal !important; }
    .features-section__more { display: none !important; }
  </style>
</noscript>

<style>
  .features-section { position: relative; }
  /* Visually hidden, still in the DOM and in the accessibility tree (see @file). */
  .features-list--rest {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .features-section__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--core-foreground);
    margin-bottom: var(--space-4, 16px);
  }
  .features-group + .features-group {
    margin-top: var(--space-4, 16px);
  }
  .features-group__title {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--core-foreground);
    margin: 0 0 var(--space-2, 8px);
  }
  .features-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
  }
  .features-section__more {
    display: flex;
    margin-top: var(--space-4, 16px);
  }
</style>
