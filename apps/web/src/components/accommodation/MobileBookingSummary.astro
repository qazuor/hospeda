---
/** @file Public, server-rendered price summary for the single-column layout. */
import ListingPriceCard from '@/components/listing/contact/ListingPriceCard.astro';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import type { ListingContactPrice } from '@/lib/listing-contact/listing-contact-price';
import { resolvePriceCardAction } from '@/lib/listing-contact/price-card-action';
import { MobileBookingSummaryActions } from './MobileBookingSummaryActions.client';

interface Props {
    readonly listingId: string;
    readonly panelId: string;
    readonly locale: SupportedLocale;
    readonly price: ListingContactPrice;
    readonly minNights?: number | null;
    readonly maxNights?: number | null;
    readonly hasWhatsapp: boolean;
}

const { listingId, panelId, locale, price, minNights, maxNights, hasWhatsapp } = Astro.props;
const { t, tPlural } = createTranslations(locale);
const primary = resolvePriceCardAction({ canInquire: true });
---

<section class="booking-summary" aria-label={t('accommodations.detail.listingContact.summary.title')}>
    <ListingPriceCard listingId={listingId} vertical="accommodation" locale={locale} price={price} action={primary} hostReply>
        <Fragment slot="facts">
            {(minNights != null || maxNights != null) && (
                <ul class="booking-summary__nights">
                    {minNights != null && <li>{tPlural('accommodations.detail.pricing.minNightsFact', minNights)}</li>}
                    {maxNights != null && <li>{tPlural('accommodations.detail.pricing.maxNightsFact', maxNights)}</li>}
                </ul>
            )}
        </Fragment>
        {primary.kind === 'inquire' && (
            <MobileBookingSummaryActions client:media="(max-width: 1024px)" listingId={listingId} panelId={panelId} locale={locale} hasWhatsapp={hasWhatsapp} primaryLabelKey={primary.labelKey} />
        )}
    </ListingPriceCard>
    <slot />
</section>

<style>
    .booking-summary {
        display: none;
    }

    @media (max-width: 1024px) {
        .booking-summary {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-3);
            padding: var(--space-4);
            background: var(--core-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
        }
    }

    .booking-summary__nights {
        margin: 0;
        color: var(--core-muted-foreground);
        padding: 0;
        list-style: none;
    }
</style>
