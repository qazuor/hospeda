---
/**
 * @file AccommodationContactBlock.astro
 * @description Phone/email/website + Facebook/Instagram block for the
 * accommodation public detail page (H-118).
 *
 * H-118 background: the host editor already collects ten contact fields
 * (`ContactForm.client.tsx`), but before this the public detail page only
 * ever surfaced the WhatsApp button — every other channel was captured and
 * silently never shown. This block closes that gap for the three contact
 * fields plus two social networks the owner approved for public display
 * (16/08 decision): phone, email, website, Facebook, Instagram. HOS-2042 adds
 * the optional landline right after the phone.
 *
 * Deliberately does NOT touch the existing WhatsApp flow: `WhatsAppContact`
 * (rendered separately inside `ContactCard`) stays the only path for the
 * WhatsApp number, since it is gated per-viewer by entitlement (HOS-19) —
 * this block never receives or renders that number.
 *
 * `rel="noopener noreferrer"` on every outbound link, NOT `sponsored
 * nofollow` — this is the accommodation's own declared contact info, not a
 * paid placement (unlike the `HOS-294` partner carousel, which IS a
 * commercial relationship and uses `rel="sponsored nofollow noopener"`).
 * Matches the existing precedent for the same kind of link elsewhere on this
 * page family: `VenueContactBlock.astro` and
 * `EventDetailOrganizerCard.astro` both use plain `noopener noreferrer`.
 *
 * HOS-2533 (owner smoke, HOS-2520): the channels render as outline
 * `GradientButton`s and the social profiles as `IconButton`s, the same CTA
 * family as the rest of the page, instead of bespoke text links.
 */
import { FacebookIcon, InstagramIcon } from '@repo/icons';
import type { AccommodationContactInfo, AccommodationSocialNetworks } from '@/data/types';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { resolveSafeExternalUrl } from '@/lib/safe-external-url';
import ListingContactChannels from '@/components/listing/contact/ListingContactChannels.astro';
import type {
    ListingContactChannel,
    ListingContactSocialLink
} from '@/components/listing/contact/listing-contact.types';

import type { ContactOrigin } from '@/lib/listing-contact/listing-contact-events';

interface Props {
    readonly listingId: string;
    readonly contactInfo?: AccommodationContactInfo;
    readonly socialNetworks?: AccommodationSocialNetworks;
    readonly locale: SupportedLocale;
}

const { contactInfo, socialNetworks, locale, listingId } = Astro.props;
const contactOrigin: ContactOrigin = 'contact_block';
/** `data-*` read by `initContactLinkTracking` (keys without the `data-` prefix). */
const trackingData = {
    'listing-id': listingId,
    vertical: 'accommodation',
    'contact-origin': contactOrigin
};
const { t } = createTranslations(locale);

// Every outbound URL here is authored by the host in the editor and published
// with no review in between. `z.string().url()` accepts `javascript:` and
// `data:` (verified against this repo's Zod), so the schema is NOT the control
// that keeps a payload out of these hrefs — this allow-list is. An unsafe value
// yields `undefined` and the link is dropped, never rendered raw.
const websiteHref = resolveSafeExternalUrl(contactInfo?.website);
const facebookHref = resolveSafeExternalUrl(socialNetworks?.facebook);
const instagramHref = resolveSafeExternalUrl(socialNetworks?.instagram);

const hasContact = Boolean(contactInfo && (contactInfo.phone || contactInfo.landlinePhone || contactInfo.email || websiteHref));
const hasSocial = Boolean(facebookHref || instagramHref);

// Nothing to show — render nothing rather than an empty card (H-118: 2 of 7
// production accommodations have no contact data at all).
if (!hasContact && !hasSocial) {
    return;
}

const channels: ListingContactChannel[] = [];
if (contactInfo?.phone) {
    channels.push({
        kind: 'phone',
        href: `tel:${contactInfo.phone}`,
        label: contactInfo.phone,
        srHint: `, ${t('accommodations.detail.contact.phoneAriaLabel', 'Llamar al alojamiento')}`
    });
}
if (contactInfo?.landlinePhone) {
    channels.push({
        kind: 'phone',
        href: `tel:${contactInfo.landlinePhone}`,
        label: contactInfo.landlinePhone,
        srHint: `, ${t('accommodations.detail.contact.landlineAriaLabel', 'Llamar al teléfono fijo del alojamiento')}`
    });
}
if (contactInfo?.email) {
    channels.push({
        kind: 'email',
        href: `mailto:${contactInfo.email}`,
        label: contactInfo.email,
        srHint: `, ${t('accommodations.detail.contact.emailAriaLabel', 'Enviar email al alojamiento')}`
    });
}
if (websiteHref) {
    channels.push({
        kind: 'website',
        href: websiteHref,
        label: websiteHref.replace(/^https?:\/\//, ''),
        srHint: `, ${t('accommodations.detail.contact.websiteAriaLabel', 'Visitar sitio web del alojamiento')}`
    });
}

const socialLinks: ListingContactSocialLink[] = [];
if (facebookHref) {
    socialLinks.push({
        href: facebookHref,
        ariaLabel: t('accommodations.detail.contact.facebookAriaLabel', 'Facebook del alojamiento'),
        Icon: FacebookIcon
    });
}
if (instagramHref) {
    socialLinks.push({
        href: instagramHref,
        ariaLabel: t('accommodations.detail.contact.instagramAriaLabel', 'Instagram del alojamiento'),
        Icon: InstagramIcon
    });
}
---

<ListingContactChannels
    heading={t('accommodations.detail.contact.title', 'Contacto')}
    channels={channels}
    socialLinks={socialLinks}
    trackingData={trackingData}
/>
