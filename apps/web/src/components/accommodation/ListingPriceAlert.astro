---
/** @file Shared responsive mount of the price-alert island with public catalog metadata. */
import { PriceAlertButton } from './PriceAlertButton';
import { fetchPublicPlans } from '@/lib/billing/fetch-plans';
import { resolvePlanBadge } from '@/lib/billing/plan-badge';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly accommodationId: string;
    readonly apiUrl: string;
    readonly locale: SupportedLocale;
    readonly placement: 'summary' | 'sidebar';
}
const { accommodationId, apiUrl, locale, placement } = Astro.props;
const result = await fetchPublicPlans({ vertical: 'tourist' });
const planName = resolvePlanBadge({ result, entitlement: 'price_alerts' });
---
<div class:list={['listing-price-alert', `listing-price-alert--${placement}`]}>
    <PriceAlertButton
        client:media={placement === 'summary' ? '(max-width: 1024px)' : '(min-width: 1025px)'}
        accommodationId={accommodationId}
        apiUrl={apiUrl}
        locale={locale}
        planName={planName}
    />
</div>
<style>
    .listing-price-alert--summary { display: none; flex-basis: 100%; }
    @media (max-width: 1024px) {
        .listing-price-alert--summary { display: block; }
        .listing-price-alert--sidebar { display: none; }
    }
</style>
