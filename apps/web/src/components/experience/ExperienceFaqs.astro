---
/** Experience FAQ adapter. */
import FaqAccordion from '@/components/shared/ui/FaqAccordion.astro';
import { groupDetailFaqs } from '@/lib/faq/groups';
import type { DetailFaq } from '@/data/types';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly faqs: readonly DetailFaq[];
    readonly locale: SupportedLocale;
}
const { faqs, locale } = Astro.props;
const { t } = createTranslations(locale);
---
<FaqAccordion title={t('experience.faq.heading')} groups={groupDetailFaqs({ faqs, locale }).groups} />
