---
/** Sales-section wrapper for the shared FAQ disclosure. */
import FaqAccordion from '@/components/shared/ui/FaqAccordion.astro';
import SalesSection from './SalesSection.astro';

/** A translated question and answer supplied by a sales page. */
export interface FaqItem {
    readonly q: string;
    readonly a: string;
}

interface Props {
    readonly tagline: string;
    readonly title: string;
    readonly items: readonly FaqItem[];
    readonly warm?: boolean;
}
const { tagline, title, items, warm = false } = Astro.props;
---
<SalesSection tagline={tagline} title={title} warm={warm}>
    <slot name="decoration" slot="decoration" />
    <div class="faq-list" data-reveal="up">
        <FaqAccordion groups={[{ items: items.map(({ q, a }) => ({ question: q, answer: a })) }]} />
    </div>
</SalesSection>

<style>
    .faq-list { max-width: 75ch; margin-inline: auto; text-align: left; }
</style>
