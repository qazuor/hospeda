---
/** Contact FAQ adapter. */
import FaqAccordion from '@/components/shared/ui/FaqAccordion.astro';
import { createTranslations, type SupportedLocale } from '@/lib/i18n';

interface Props {
    readonly locale: SupportedLocale;
}
const { t } = createTranslations(Astro.props.locale);
const keys = ['responseTime', 'accommodationIssue', 'ownerInquiry', 'languages'] as const;
const items = keys.map((key) => ({
    question: t(`contact.faq.items.${key}.question`),
    answer: t(`contact.faq.items.${key}.answer`)
}));
---
<div class="contact-faq" data-reveal="up">
    <FaqAccordion groups={[{ items }]} />
</div>
<style>
    .contact-faq { max-width: 75ch; margin: var(--space-6) auto 0; }
</style>
