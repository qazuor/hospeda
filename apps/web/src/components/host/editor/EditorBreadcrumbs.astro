---
/**
 * @file EditorBreadcrumbs.astro
 * @description "You are here" trail for every editor page (HOS-318 T-009).
 *
 * Rendered on the hub and on all ten section pages. For this editor's audience —
 * largely older, non-technical hosts — knowing where you are and how to get back
 * is the whole point of the route split, so this is not optional chrome.
 *
 * Zero JavaScript: plain links, resolved server-side.
 */

import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { buildEditorBreadcrumbs } from '@/lib/editor/editor-breadcrumbs-model';

interface Props {
	readonly locale: SupportedLocale;
	readonly accommodationId: string;
	readonly accommodationName: string;
	/** `null` on the hub. */
	readonly currentSectionSlug: string | null;
}

const { locale, accommodationId, accommodationName, currentSectionSlug } = Astro.props;
const { t } = createTranslations(locale);

const crumbs = buildEditorBreadcrumbs({
	locale,
	accommodationId,
	accommodationName,
	currentSectionSlug,
});
---

<nav
	class="editor-breadcrumbs"
	aria-label={t('common.breadcrumbs', 'Ruta de navegación')}
>
	<ol class="editor-breadcrumbs__list">
		{crumbs.map((crumb, index) => (
			<li class="editor-breadcrumbs__item">
				{index > 0 && (
					<span class="editor-breadcrumbs__separator" aria-hidden="true">›</span>
				)}
				{crumb.href ? (
					<a class="editor-breadcrumbs__link" href={crumb.href}>
						{crumb.label ?? t(crumb.labelKey as string)}
					</a>
				) : (
					<span class="editor-breadcrumbs__current" aria-current="page">
						{crumb.label ?? t(crumb.labelKey as string)}
					</span>
				)}
			</li>
		))}
	</ol>
</nav>

<style>
	.editor-breadcrumbs {
		margin-bottom: var(--space-4, 1.5rem);
	}

	.editor-breadcrumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-sans);
		font-size: 0.875rem;
	}

	.editor-breadcrumbs__item {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.editor-breadcrumbs__separator {
		color: var(--core-muted-foreground);
	}

	.editor-breadcrumbs__link {
		color: var(--core-muted-foreground);
		text-decoration: none;
	}

	.editor-breadcrumbs__link:hover {
		color: var(--brand-primary);
		text-decoration: underline;
	}

	.editor-breadcrumbs__link:focus-visible {
		outline: 2px solid var(--brand-primary);
		outline-offset: 2px;
		border-radius: var(--radius-button, 8px);
	}

	.editor-breadcrumbs__current {
		color: var(--core-foreground);
		font-weight: 600;
	}
</style>
