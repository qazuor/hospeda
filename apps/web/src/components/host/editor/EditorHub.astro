---
/**
 * @file EditorHub.astro
 * @description The one editor hub both editors share: the completeness meter
 * and every section as a row (HOS-318 T-007; registry-driven since HOS-1080;
 * rebuilt on the Mi cuenta kit by HOS-2499 / HOS-2493).
 *
 * Rendered at `…/editar/` on every viewport (D-8). On narrow screens it IS the
 * navigation; on desktop it doubles as the listing's status summary, which is
 * why it is a real page and not a redirect to the first section.
 *
 * - `CompletenessMeter` on top, fed by the completeness each editor already
 *   computes (`resolveAccommodationCompleteness` /
 *   `resolveListingEditorCompleteness`). Its missing items link to their
 *   sections.
 * - Flat groups (a heading and a list, no cards), width `--form-max`.
 * - Rows are 56px tap targets; a row's state is a `StatusPill` that says it in
 *   words, so colour is never the only signal.
 *
 * Zero JavaScript.
 */

import { CompletenessMeter, StatusPill } from '@/components/account/ui';
import { LockIcon } from '@repo/icons';
import { isEditorSectionLocked } from '@/lib/editor/editor-hub-status-model';
import type { ListingSectionStates } from '@/lib/editor/listing-editor-registry';
import type { StatusTone } from '@/components/account/ui/status-tone';
import type { EditorCompleteness } from '@/lib/editor/editor-completeness';
import type { EditorSectionStatus, EditorStatusTone } from '@/lib/editor/editor-hub-status-model';
import {
	buildEditorSectionUrl,
	type EditorRegistry,
	type EditorSectionVisibility,
	getVisibleEditorSections,
} from '@/lib/editor/editor-registry';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';

interface Props {
	readonly locale: SupportedLocale;
	/** The vertical's section registry. */
	readonly registry: EditorRegistry;
	readonly entityId: string;
	/** Runtime answers to the registry's visibility keys. */
	readonly visibility?: EditorSectionVisibility;
	/** Status lines keyed by section id. A missing key renders no pill. */
	readonly statuses: Readonly<Record<string, EditorSectionStatus>>;
	readonly sectionStates?: ListingSectionStates;
	/** What the listing still needs, by section. Omitted: no meter. */
	readonly completeness?: EditorCompleteness;
}

const { locale, registry, entityId, visibility = {}, statuses, completeness, sectionStates = {} } = Astro.props;
const { t, tPlural } = createTranslations(locale);

/** Hub tone → kit pill tone. */
const PILL_TONE: Readonly<Record<EditorStatusTone, StatusTone>> = {
	neutral: 'neutral',
	warning: 'warning',
	blocking: 'danger',
	locked: 'plan',
};

const visible = getVisibleEditorSections({ registry, visibility });

const groups = registry.groups
	.map((group) => ({
		group,
		headingKey: registry.groupLabelKeys[group],
		sections: visible.filter((section) => section.group === group),
	}))
	.filter((entry) => entry.sections.length > 0);

const statusText = (status: EditorSectionStatus): string =>
	status.tone === 'blocking' && status.missingRequirementLabelKeys
		? t(status.labelKey, undefined, {
				fields: status.missingRequirementLabelKeys.map((key) => t(key)).join(', '),
			})
		: typeof status.params?.count === 'number'
			? tPlural(status.labelKey, status.params.count, status.params)
			: t(status.labelKey, undefined, status.params);

// A missing section links to its page when it is visible here; one the
// registry hides (or does not know) is still named, without a link.
const missingItems = (completeness?.missing ?? []).map((sectionId) => {
	const section = registry.sections.find((entry) => entry.id === sectionId);
	const isVisible = visible.some((entry) => entry.id === sectionId);
	return {
		id: sectionId,
		label: section ? t(section.labelKey) : sectionId,
		href:
			section && isVisible
				? buildEditorSectionUrl({ locale, registry, entityId, section })
				: undefined,
	};
});
---

<div class="editor-hub" data-editor-hub>
	{
		completeness && (
			<CompletenessMeter
				done={completeness.done}
				total={completeness.total}
				missing={missingItems}
				locale={locale}
			/>
		)
	}

	{groups.map((entry) => (
		<section class="editor-hub__group" aria-labelledby={`editor-hub-${entry.group}`}>
			<h2 class="editor-hub__heading" id={`editor-hub-${entry.group}`}>{t(entry.headingKey)}</h2>
			<ul class="editor-hub__list">
				{entry.sections.map((section) => {
					const status = statuses[section.id];
					const locked = isEditorSectionLocked({ sectionId: section.id, sectionStates });
					return (
						<li class="editor-hub__item">
							<a
								class="editor-hub__row"
								href={buildEditorSectionUrl({ locale, registry, entityId, section })}
							>
								<span class="editor-hub__text">
									<span class="editor-hub__title">
										{locked && <LockIcon size="sm" aria-hidden="true" />}
										{t(section.labelKey)}
									</span>
									{locked && <StatusPill tone="plan">{status?.tone === 'locked' ? statusText(status) : t('listing.owner.editor.hub.status.lockedEmpty')}</StatusPill>}
									{status && (!locked || status.tone !== 'locked') && (
										<StatusPill tone={PILL_TONE[status.tone]} className="editor-hub__status">
											{statusText(status)}
										</StatusPill>
									)}
								</span>
								<span class="editor-hub__chevron" aria-hidden="true">›</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	))}
</div>

<style>
	.editor-hub {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		max-inline-size: var(--form-max);
	}

	.editor-hub__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.editor-hub__heading {
		margin: 0;
		font: var(--app-section);
		color: var(--core-foreground);
	}

	.editor-hub__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-block-start: 1px solid var(--border);
	}

	.editor-hub__item {
		border-block-end: 1px solid var(--border);
	}

	.editor-hub__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		/* Well above the 44px floor: an older audience, often on a phone. */
		min-block-size: 56px;
		padding: var(--space-3) var(--space-2);
		text-decoration: none;
		color: inherit;
	}

	.editor-hub__row:hover {
		background-color: var(--surface-warm);
	}

	.editor-hub__row:focus-visible {
		outline: 2px solid var(--brand-primary);
		outline-offset: -2px;
	}

	.editor-hub__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		min-inline-size: 0;
	}

	.editor-hub__title {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font: var(--app-ui);
		color: var(--core-foreground);
	}

	/* A blocking line names the missing fields: let the pill wrap. */
	:global(.editor-hub__status) {
		white-space: normal;
	}

	.editor-hub__chevron {
		flex-shrink: 0;
		color: var(--core-muted-foreground);
	}
</style>
