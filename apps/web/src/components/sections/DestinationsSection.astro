---
/**
 * @file DestinationsSection.astro
 * @description Homepage featured destinations section.
 *
 * Fetches destination data on the server and passes it to the
 * DestinationsIsland React client island, which handles both the interactive
 * SVG map and the Embla carousel in a single hydration boundary.
 * If the API is unavailable or returns no data, the section is not rendered.
 *
 * Layout: subtle warm-gradient background to differentiate from adjacent
 * white sections. The island itself provides the two-column map + carousel
 * layout on desktop, carousel-only on mobile.
 */

import { DestinationsIsland } from '@/components/sections/DestinationsIsland.client';
import type { DestinationsIslandData } from '@/components/sections/DestinationsIsland.client';
import { createTranslations } from '@/lib/i18n';
import type { SupportedLocale } from '@/lib/i18n';
import { destinationsApi, SSR_PUBLIC_CACHE_TTL_MS, toDestinationCardProps } from '@/lib/api';
import type { DestinationCardData } from '@/lib/api/transforms';
import { webLogger } from '@/lib/logger';
import { buildImageEndpointUrl, isCloudinaryDeliveryUrl } from '@/lib/media';

interface Props {
    /** Active locale used to resolve translations and build internal URLs. */
    readonly locale: SupportedLocale;
    /**
     * Whether the current user is authenticated.
     * Forwarded to FavoriteButton inside each carousel card.
     * Defaults to false (guest user).
     */
}

const { locale } = Astro.props;
const { t } = createTranslations(locale);

// Fetch from API - empty array if unavailable
let destinations: DestinationCardData[] = [];
try {
    const result = await destinationsApi.list({
        destinationType: 'CITY',
        pageSize: 50,
        // HOS-103: bounded homepage read; shares the cache key with the hero
        // search read in index.astro so the two collapse to one API hit.
        cacheTtlMs: SSR_PUBLIC_CACHE_TTL_MS
    });
    if (result.ok) {
        destinations = result.data.items.map((raw) => toDestinationCardProps({ item: raw as Record<string, unknown>, locale }));
    }
} catch (err) {
    webLogger.error('API fetch failed', { endpoint: 'destinations', error: err instanceof Error ? err.message : err });
}

// Public destination images inside the React island cannot use Astro `<Image>`
// directly, so point only the exact Cloudinary delivery URLs at the same
// `/_image` endpoint the cache rule now accelerates. Everything else keeps its
// original URL unchanged.
const optimizedDestinations = destinations.map((dest) => {
    const img = dest.featuredImage.url;
    if (!isCloudinaryDeliveryUrl(img)) {
        return dest;
    }
    return {
        ...dest,
        featuredImage: {
            url: buildImageEndpointUrl({ src: img, width: 300, format: 'webp' }),
            caption: dest.featuredImage.caption
        }
    };
});

// Narrow to the fields the island renders before handing them over (HOS-369
// W3-3). Astro serializes an island's props into the HTML for hydration, so
// spreading the full card shape shipped `gallery` alone — 77,162 B across
// these 22 destinations — plus four more fields nothing reads. Project
// explicitly rather than deleting keys: a new field on DestinationCardData
// then has to be opted IN here, instead of silently riding along.
const islandDestinations: DestinationsIslandData[] = optimizedDestinations.map((dest) => ({
    id: dest.id,
    slug: dest.slug,
    name: dest.name,
    summary: dest.summary,
    featuredImage: dest.featuredImage,
    accommodationsCount: dest.accommodationsCount,
    path: dest.path,
    averageRating: dest.averageRating,
    reviewsCount: dest.reviewsCount,
    attractions: dest.attractions
}));
---

{destinations.length > 0 && (
<section
    class="section destinations-section"
    aria-label={t('home.featuredDestinations.title', 'Destinos populares')}
>
    <div class="destinations-section__container">
        <DestinationsIsland
            client:visible
            destinations={islandDestinations}
            locale={locale}
        />
    </div>
</section>
)}

<style>
    .destinations-section {
        background: linear-gradient(
            160deg,
            var(--core-background) 0%,
            var(--surface-warm) 50%,
            var(--core-background) 100%
        );
        padding-block: var(--space-section);
        overflow: visible;
    }

    .destinations-section__container {
        position: relative;
        margin-inline: auto;
        padding-inline: var(--space-container-x);
        max-width: var(--container-max);
    }
</style>
