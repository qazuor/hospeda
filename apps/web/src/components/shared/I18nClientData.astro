---
/**
 * @file I18nClientData.astro
 * @description Links the current page to the CURRENT locale's flattened
 * translation dictionary, served as a hashed immutable asset by
 * `src/pages/i18n/[file].js.ts`. Client islands read it via `getClientLocaleDict`
 * in `@/lib/i18n` instead of importing the full `@repo/i18n` catalog, so the
 * other two locales never ship in the JS bundle (HOS-160 lever A).
 *
 * The dictionary used to be INLINED here as a `<script type="application/json">`
 * data block. It is byte-identical on every page and ~632 KB for `es` — 46.4% of
 * a listing page's HTML — so every navigation re-downloaded it. As an asset the
 * browser fetches it once per session per locale (HOS-369 Wave D).
 *
 * Two constraints shape the tag below, and neither is cosmetic:
 *
 *  - It is a CLASSIC script assigning a global, never a `fetch`.
 *    `getClientLocaleDict` is synchronous and runs while islands render;
 *    anything asynchronous would hand the first islands an empty dictionary and
 *    every key would silently fall back.
 *  - It is rendered in `<head>`, in all four HTML shells. A parser-inserted
 *    `<script defer>` runs before the deferred module scripts that hydrate
 *    islands only if it comes FIRST in document order; from `<body>` it can land
 *    after an island that appears earlier, and that island hydrates with nothing.
 */

import type { SupportedLocale } from '@/lib/i18n';
import { i18nAssetUrl } from '@/lib/i18n-asset';

interface Props {
    readonly locale: SupportedLocale;
}

const { locale } = Astro.props;
---

<script defer src={i18nAssetUrl(locale)} is:inline></script>
