---
/**
 * @file ThemeFoucScript.astro
 * @description Inline script that applies the saved theme before the first
 * paint to prevent a flash of unstyled content (FOUC) when dark mode is
 * active.
 *
 * Reads `localStorage.getItem('theme')`:
 * - `'dark'` → applies `data-theme="dark"`.
 * - `'system'` → consults `prefers-color-scheme` and applies dark when the
 *   OS reports a dark preference. Light otherwise.
 * - anything else (including a missing key) → leaves the document in light
 *   mode. Default is light: dark must be an explicit opt-in (either via the
 *   `ThemeToggle` island or by selecting `'system'` in account preferences).
 *
 * Used by BaseLayout, AuthLayout, and ErrorLayout — a single source of
 * truth for the theme bootstrap contract. The inline script carries no CSP
 * attribute: `middleware.ts` hashes its content and allows it by `sha256`
 * (HOS-369 WB0-1). Do NOT add a `nonce` attribute back — a nonce that reaches
 * the Cloudflare cache is a public token for the whole TTL, which is exactly
 * what that migration removed (guarded by
 * `scripts/check-no-inline-nonce.sh`).
 *
 * Usage:
 * ```astro
 * <ThemeFoucScript />
 * ```
 */
---

<script is:inline>
    (function () {
        function applyStoredTheme() {
            var stored = localStorage.getItem('theme');
            var dark =
                stored === 'dark' ||
                (stored === 'system' &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches);
            var root = document.documentElement;
            if (dark) {
                root.setAttribute('data-theme', 'dark');
            } else {
                root.removeAttribute('data-theme');
            }
        }

        // First paint on a full page load — prevents the FOUC.
        applyStoredTheme();

        // Re-apply after every Astro ClientRouter (View Transitions) navigation.
        // The swap replaces <html> attributes from the freshly SSR'd document
        // (which has no data-theme), and this inline script is NOT re-run on
        // navigation (Astro dedupes identical inline scripts), so without this
        // the saved theme is lost when moving between pages. The document object
        // survives swaps, so this listener is registered exactly once.
        document.addEventListener('astro:after-swap', applyStoredTheme);
    })();
</script>
