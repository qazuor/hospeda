---
/**
 * @file ImageAttribution.astro
 * @description Renders the visible credit for a photo — "Photo by [photographer]",
 * plus " on [provider]" when the photo came from a stock service.
 *
 * Two independent sources feed this (H-125):
 * - Stock imports (SPEC-274, Unsplash/Pexels) carry all four subfields, and the
 *   providers' API terms REQUIRE a visible credit linking the photographer.
 * - A host crediting the photo on their own listing types a name and, if they
 *   have one, a link. Nothing else.
 *
 * So every field except `photographer` is optional here, and the provider suffix
 * only renders for a provider the component can actually name. The previous
 * version defaulted every non-Unsplash value to "Pexels", which would have
 * published "Photo by <the host's photographer> on Pexels" — a false claim about
 * where the photo came from, next to an outbound link.
 */

import type { MediaAttribution } from '@/lib/media';
import type { SupportedLocale } from '@/lib/i18n';
import { createTranslations } from '@/lib/i18n';
import { resolveSafeExternalUrl } from '@/lib/safe-external-url';

interface Props {
    readonly attribution: MediaAttribution;
    readonly locale: SupportedLocale;
    readonly variant?: 'overlay' | 'inline';
}

const { attribution, locale, variant = 'inline' } = Astro.props;
const { t } = createTranslations(locale);

/** Only stock providers have a public name to print. `user-upload` has none. */
const PROVIDER_NAMES = { unsplash: 'Unsplash', pexels: 'Pexels' } as const;
const providerName =
    attribution.provider === 'unsplash' || attribution.provider === 'pexels'
        ? PROVIDER_NAMES[attribution.provider]
        : undefined;

/**
 * Defence in depth. `extractFeaturedImage`/`extractGalleryItems` already ran the
 * scheme check, but this component is also handed payloads that never passed
 * through them, and the write side accepts `javascript:` (`z.string().url()`).
 */
const profileUrl = resolveSafeExternalUrl(attribution.sourceUrl);

const photographer = attribution.photographer;

const linkAriaLabel = providerName
    ? t('common.attribution.ariaLabel', undefined, { photographer, provider: providerName })
    : t('common.attribution.ariaLabelNoProvider', undefined, { photographer });
---

{photographer && (
    <div class="image-attribution" data-variant={variant}>
        <span class="image-attribution__text">
            {t('common.attribution.byline')}
            {profileUrl ? (
                <a
                    href={profileUrl}
                    class="image-attribution__link"
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    aria-label={linkAriaLabel}
                >
                    {photographer}
                </a>
            ) : (
                <span class="image-attribution__name">{photographer}</span>
            )}
            {providerName &&
                t('common.attribution.onProvider', undefined, { provider: providerName })}
        </span>
    </div>
)}

<style>
    .image-attribution {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1, 4px);
        font-family: var(--font-sans);
        font-size: 0.75rem;
        color: var(--core-muted-foreground);
        transition: opacity 0.3s ease;
    }

    .image-attribution[data-variant="overlay"] {
        position: absolute;
        bottom: var(--space-2, 8px);
        left: var(--space-2, 8px);
        right: var(--space-2, 8px);
        background-color: rgba(0, 0, 0, 0.6);
        padding: var(--space-1, 4px) var(--space-2, 8px);
        border-radius: var(--radius-pill, 9999px);
        max-width: fit-content;
    }

    .image-attribution[data-variant="inline"] {
        margin-top: var(--space-2, 8px);
    }

    .image-attribution__link,
    .image-attribution__name {
        color: var(--core-foreground);
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .image-attribution__link:hover {
        color: var(--brand-accent);
        text-decoration: underline;
    }

    @media (prefers-reduced-motion: reduce) {
        .image-attribution,
        .image-attribution__link {
            transition: none;
        }
    }
</style>
