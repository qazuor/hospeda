---
/** Thin server-rendered adapter for the shared React breadcrumbs. */
import JsonLd from '@/components/seo/JsonLd.astro';
import { Breadcrumbs } from './Breadcrumbs';
import { createT, type SupportedLocale } from '@/lib/i18n';
import { buildBreadcrumbListJsonLd, type BreadcrumbInputItem } from '@/lib/navigation/breadcrumb-trail';

interface Props {
    readonly locale: SupportedLocale;
    readonly items: readonly BreadcrumbInputItem[];
    readonly class?: string;
    readonly jsonLd?: boolean;
    readonly includeHome?: boolean;
}

const { locale, items, class: className, jsonLd = true, includeHome = true } = Astro.props;
const t = createT(locale);
const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const homeLabel = t('nav.home');
const structured = jsonLd
    ? buildBreadcrumbListJsonLd({
          items,
          locale,
          homeLabel,
          includeHome,
          siteOrigin,
          currentPath: Astro.url.pathname
      })
    : null;
---

<Breadcrumbs
    items={items}
    locale={locale}
    homeLabel={homeLabel}
    ariaLabel={t('common.breadcrumbs')}
    includeHome={includeHome}
    className={className}
/>
{structured && <JsonLd data={structured} />}
