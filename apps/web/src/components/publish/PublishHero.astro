---
/**
 * @file PublishHero.astro
 * @description The short hero every publish page opens with (HOS-1156 §6
 * point 1): tagline, title, one paragraph, and an icon cluster beside it.
 *
 * Deliberately compact. These pages are FORM-FIRST — the argument is below the
 * fold, not above it — so the hero's job is to say which vertical you are on and
 * get out of the way. The padding window is the same one `/publicar/nueva/` used
 * before this page absorbed it, so the form stays visible on a laptop without
 * scrolling.
 *
 * The three pages share this mould and nothing else: every string arrives
 * already resolved, and none of them lives here.
 */

import type { IconProps } from '@repo/icons';
import type { ComponentType } from 'react';

/** Any `@repo/icons` component, as the nav/door configs already type them. */
type IconComponent = ComponentType<IconProps>;

interface Props {
    /** Handwritten eyebrow above the title. */
    readonly tagline: string;
    /** The page's `<h1>`. */
    readonly title: string;
    /** One paragraph, no more. */
    readonly body: string;
    /** The vertical's icon, rendered large in the aside. */
    readonly Icon: IconComponent;
    /** Three smaller icons that float around it. */
    readonly floatingIcons: readonly [IconComponent, IconComponent, IconComponent];
}

const { tagline, title, body, Icon, floatingIcons } = Astro.props;
const [FloatOne, FloatTwo, FloatThree] = floatingIcons;
---

<section class="publish-hero section section--warm">
    <div class="publish-hero__decoratives" aria-hidden="true">
        <img
            src="/assets/images/shapes/deco-arrow-1.svg"
            alt=""
            class="publish-hero__deco"
            loading="eager"
        />
    </div>

    <div class="publish-hero__container">
        <div class="publish-hero__text">
            <p class="publish-hero__tagline">{tagline}</p>
            <h1 class="publish-hero__title">{title}</h1>
            <p class="publish-hero__desc">{body}</p>
            <!-- Anything a single vertical needs under the paragraph, e.g. the
                 accommodation trial callout. Empty on the other two. -->
            <slot />
        </div>

        <aside class="publish-hero__visual" aria-hidden="true">
            <div class="publish-hero__blob"></div>
            <div class="publish-hero__icon-wrap">
                <Icon size={96} weight="duotone" />
            </div>
            <div class="publish-hero__floating publish-hero__floating--one">
                <FloatOne size="md" weight="duotone" />
            </div>
            <div class="publish-hero__floating publish-hero__floating--two">
                <FloatTwo size="md" weight="duotone" />
            </div>
            <div class="publish-hero__floating publish-hero__floating--three">
                <FloatThree size="md" weight="duotone" />
            </div>
        </aside>
    </div>
</section>

<style>
    .publish-hero {
        position: relative;
        overflow: hidden;
        /* Overrides `.section`'s clamp(48px, …, 120px): form-first pages need
           the form above the fold, not a full-height hero. */
        padding-block: clamp(2rem, 5.5vw, 4rem);
    }

    .publish-hero__decoratives {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .publish-hero__deco {
        position: absolute;
        top: clamp(18%, 22%, 28%);
        right: clamp(2%, 4vw, 6%);
        width: clamp(60px, 8vw, 110px);
        height: auto;
        opacity: 0.5;
        transform: rotate(15deg);
    }

    @media (max-width: 900px) {
        .publish-hero__deco { display: none; }
    }

    .publish-hero__container {
        position: relative;
        z-index: 1;
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--space-container-x);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-6);
        align-items: center;
    }

    .publish-hero__tagline {
        font-family: var(--font-decorative);
        font-weight: 700;
        font-size: var(--text-tagline);
        color: var(--brand-accent);
        margin: 0 0 var(--space-2);
    }

    .publish-hero__title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-h2);
        color: var(--core-foreground);
        margin: 0 0 var(--space-3);
        line-height: 1.15;
        text-wrap: balance;
    }

    .publish-hero__desc {
        font-family: var(--font-sans);
        font-size: var(--text-body-lg);
        color: var(--core-muted-foreground);
        line-height: 1.6;
        margin: 0;
        max-width: 60ch;
    }

    /* ── Visual aside ──────────────────────────────────────────────────── */
    .publish-hero__visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 280px;
    }

    .publish-hero__blob {
        position: absolute;
        inset: 0;
        margin: auto;
        width: clamp(220px, 24vw, 340px);
        height: clamp(220px, 24vw, 340px);
        border-radius: 50%;
        background: radial-gradient(
            circle at 30% 30%,
            var(--brand-primary-a20),
            var(--brand-accent-a08) 60%,
            transparent 75%
        );
        filter: blur(2px);
    }

    .publish-hero__icon-wrap {
        position: relative;
        z-index: 2;
        width: clamp(120px, 13vw, 170px);
        height: clamp(120px, 13vw, 170px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--core-card);
        border-radius: 50%;
        box-shadow: var(--shadow-card);
        color: var(--brand-primary);
    }

    .publish-hero__floating {
        position: absolute;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: var(--core-card);
        box-shadow: var(--shadow-card);
        animation: publish-float 6s ease-in-out infinite;
    }

    .publish-hero__floating--one {
        top: 10%;
        left: 6%;
        color: var(--brand-primary);
        animation-delay: 0s;
    }

    .publish-hero__floating--two {
        bottom: 16%;
        left: 2%;
        color: var(--brand-accent);
        animation-delay: 1.5s;
    }

    .publish-hero__floating--three {
        top: 18%;
        right: 4%;
        color: oklch(0.65 0.18 145);
        animation-delay: 3s;
    }

    @keyframes publish-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @media (prefers-reduced-motion: reduce) {
        .publish-hero__floating { animation: none; }
    }

    @media (max-width: 768px) {
        .publish-hero__container { grid-template-columns: 1fr; }
        .publish-hero__visual { order: -1; min-height: 240px; }
    }
</style>
