{
    "extends": "../../packages/typescript-config/app-base.json",
    "compilerOptions": {
        "types": ["node"],
        "jsx": "react-jsx"
    },
    // tsx applies this config's `jsx` option only to files matched by `include`.
    // The `@repo/*` path aliases resolve workspace packages to their `src`, so the
    // API's tsx entry points (dev server and scripts/) reach the React email
    // templates under packages/notifications and packages/email. Leaving them out of `include` makes
    // esbuild fall back to the classic JSX runtime, and those templates throw
    // "React is not defined" because they never import React.
    "include": [
        "src/**/*",
        "test/**/*",
        "../../packages/notifications/src/**/*",
        "../../packages/email/src/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "test/e2e/**/*",
        "test/utils/create-app.test.ts",
        "test/routes/billing-admin-notifications.test.ts"
    ],
    "_TODO_REINCLUDE_TESTS": "2026-02-05: Re-enable excluded tests after fixing type errors",
    "files": []
}
