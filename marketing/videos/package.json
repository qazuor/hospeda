{
    "name": "@repo/videos",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Hospeda tutorial videos: Playwright takes of the real app, edited and rendered with Remotion. Generated media lives outside the repo (HOSPEDA_MARKETING_ASSETS_DIR).",
    "scripts": {
        "studio": "remotion studio",
        "render:test": "tsx scripts/render.mts Test test.mp4",
        "render:a1": "tsx scripts/render.mts A1 a1.mp4",
        "render:vc5": "tsx scripts/render.mts VC5 vc5.mp4 --concurrency=4",
        "render:vc1": "tsx scripts/render.mts VC1 vc1.mp4 --concurrency=4",
        "render:vc3": "tsx scripts/render.mts VC3 vc3.mp4 --concurrency=4",
        "render:vc4": "tsx scripts/render.mts VC4 vc4.mp4 --concurrency=4",
        "render:vc2": "tsx scripts/render.mts VC2 vc2.mp4 --concurrency=4",
        "record:a1": "tsx record/record-a1.mts",
        "record:vc5": "tsx record/record-vc5.mts",
        "record:vc1": "tsx record/record-vc1.mts",
        "record:vc3": "tsx record/record-vc3.mts",
        "record:vc4": "tsx record/record-vc4.mts",
        "record:vc2": "tsx record/record-vc2.mts",
        "probe": "tsx record/probe.mts",
        "typecheck": "tsc --noEmit --project ./tsconfig.json"
    },
    "dependencies": {
        "@remotion/cli": "4.0.539",
        "@remotion/google-fonts": "4.0.539",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "remotion": "4.0.539"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.6.1",
        "@types/react": "19.2.18",
        "playwright": "^1.63.0",
        "tsx": "^4.23.13",
        "typescript": "6.0.3"
    }
}
