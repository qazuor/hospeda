{
    "$schema": "https://qz.dev/schemas/project.v1.json",
    "schemaVersion": 1,
    "projectId": "hospeda",
    "adapter": "hospeda",
    "displayName": "Hospeda",
    "issues": {
        "provider": "linear",
        "teamKey": "HOS",
        "identifierPattern": "^HOS-[0-9]+$",
        "backlogState": "Backlog",
        "defaultLabels": ["QAZUOR"],
        "commandLabel": "agent-reported",
        "defaultPriority": 4,
        "baseBranch": "develop",
        "states": {
            "backlog": "Backlog",
            "inProgress": "In Progress",
            "done": "Done",
            "canceled": "Canceled"
        }
    },
    "branches": {
        "base": "develop",
        "protected": ["main"],
        "pattern": "{type}/{slug}",
        "promotion": ["develop", "staging", "main"],
        "backMerge": [
            {
                "from": "main",
                "to": "staging"
            },
            {
                "from": "staging",
                "to": "develop"
            }
        ]
    },
    "worktree": {
        "pathPattern": "../hospeda-{slug}",
        "envSource": {
            "kind": "protected-checkout",
            "checkoutName": "hospeda-staging",
            "relativePath": "scripts/copy-env-to-worktree.sh"
        },
        "install": "pnpm install && (cd scripts/client-tools && bun install --frozen-lockfile) && (cd scripts/server-tools && bun install --frozen-lockfile)",
        "build": "pnpm exec turbo run build --filter='./packages/*'"
    },
    "verification": {
        "generatedPaths": ["apps/admin/src/routeTree.gen.ts"],
        "build": "pnpm build"
    },
    "database": {
        "strategy": "postgres-template",
        "container": "hospeda-postgres",
        "templateDatabase": "hospeda_template",
        "databaseNamePattern": "worktree_{slug}",
        "connectionEnvFile": "apps/api/.env.local",
        "connectionEnvVar": "HOSPEDA_DATABASE_URL",
        "schemaFingerprintPaths": [
            "packages/db/src/schemas",
            "packages/db/src/billing/schemas.ts",
            "packages/db/src/migrations"
        ],
        "schemaSentinelTables": ["gastronomies", "experiences"],
        "templateFingerprintPaths": [
            "packages/db/src/schemas",
            "packages/db/src/billing/schemas.ts",
            "packages/db/src/migrations",
            "packages/seed/src",
            "packages/billing/src/config"
        ]
    },
    "servers": [
        {
            "id": "api",
            "portEnv": "API_PORT",
            "defaultPort": 3001,
            "start": "pnpm --filter hospeda-api dev",
            "healthPath": "/health"
        },
        {
            "id": "admin",
            "defaultPort": 3000,
            "start": "pnpm --filter admin exec vite dev --port {port}"
        },
        {
            "id": "web",
            "defaultPort": 4321,
            "start": "env ASTRO_DEV_BACKGROUND=0 pnpm --filter hospeda-web exec astro dev --port {port}"
        }
    ],
    "commands": {
        "genericPrefix": "qz-",
        "projectPrefix": "hops-",
        "source": "scripts/client-tools",
        "dispatch": "node .qz/dispatch.mjs",
        "registry": [
            {
                "id": "hops-stats",
                "delegate": "stats",
                "description": "Estadísticas del monorepo, GitHub y Linear",
                "mutates": false
            },
            {
                "id": "hops-db-start",
                "delegate": "db-start",
                "description": "Levanta las bases compartidas de desarrollo",
                "mutates": true
            },
            {
                "id": "hops-db-stop",
                "delegate": "db-stop",
                "description": "Detiene las bases compartidas de desarrollo",
                "mutates": true
            },
            {
                "id": "hops-db-migrate",
                "delegate": "db-migrate",
                "description": "Aplica migraciones a la base del worktree",
                "mutates": true
            },
            {
                "id": "hops-db-seed",
                "delegate": "db-seed",
                "description": "Carga datos en la base del worktree",
                "mutates": true
            },
            {
                "id": "hops-db-studio",
                "delegate": "db-studio",
                "description": "Abre Drizzle Studio para la base del worktree",
                "mutates": false
            },
            {
                "id": "hops-db-fresh",
                "delegate": "db-fresh",
                "description": "Recrea la base del worktree desde el template",
                "mutates": true
            },
            {
                "id": "hops-db-update-template",
                "delegate": "db-update-template",
                "description": "Actualiza el template de base de datos de Hospeda",
                "mutates": true
            },
            {
                "id": "hops-servers-up",
                "delegate": "servers-up",
                "description": "Levanta DB y servidores del worktree",
                "mutates": true
            },
            {
                "id": "hops-servers-down",
                "delegate": "servers-down",
                "description": "Detiene los servidores del worktree",
                "mutates": true
            },
            {
                "id": "hops-test",
                "delegate": "test",
                "description": "Ejecuta tests por categoría de Hospeda",
                "mutates": false
            },
            {
                "id": "hops-env",
                "delegate": "env",
                "description": "Valida variables de entorno y drift",
                "mutates": false
            },
            {
                "id": "hops-update",
                "delegate": "update",
                "description": "Actualiza Hospeda desde staging y reconcilia el entorno",
                "mutates": true
            },
            {
                "id": "hops-whats-new",
                "delegate": "whats-new",
                "description": "Audita novedades antes de promocionar ramas",
                "mutates": true
            },
            {
                "id": "hops-dependabot-review",
                "delegate": "dependabot-review",
                "description": "Analiza PRs de Dependabot sin decidir por sí solo",
                "mutates": false
            }
        ]
    },
    "knowledge": {
        "root": ".qz/knowledge",
        "instructions": "AGENTS.md",
        "skillsDir": "skills",
        "agentsDir": "agents",
        "commandsDir": "commands"
    }
}
