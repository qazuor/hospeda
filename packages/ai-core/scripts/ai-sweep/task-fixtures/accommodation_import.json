        {
            "id": "accommodation_import-amenities-list",
            "call": "accommodation_import",
            "input": {
                "locale": "es",
                "html": "<html><body><h1>Complejo Los Álamos</h1><h2>Comodidades</h2><ul><li>Pileta climatizada</li><li>Estacionamiento</li><li>Aire acondicionado</li><li>Ropa de cama</li></ul><p>Cabañas para 2 a 6 personas.</p></body></html>"
