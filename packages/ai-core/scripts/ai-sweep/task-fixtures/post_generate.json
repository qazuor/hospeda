{
    "feature": "post_generate",
    "cases": [
        {
            "id": "post_generate-weekend-es",
            "call": "post_generate",
            "input": {
                "topic": "Qué hacer un fin de semana en Concepción del Uruguay",
                "points": [
                    "Caminar por la costanera al atardecer",
                    "Visitar el Palacio San José",
                    "Comer pescado de río en la zona del puerto"
                ],
                "tone": "informal",
                "category": "TOURISM",
                "locale": "es"
            },
            "checks": {
                "textPaths": ["title", "summary", "content"],
                "htmlField": "content",
                "mustInclude": [
                    { "label": "costanera", "pattern": "costanera" },
                    { "label": "Palacio San José", "pattern": "Palacio San Jos[eé]" },
                    { "label": "river fish", "pattern": "pescado" }
                ],
                "mustNotClaim": [
                    {
                        "label": "invented statistic",
                        "pattern": "\\d+\\s?%|\\d{1,3}(\\.\\d{3})+ (visitantes|turistas)"
                    },
                    { "label": "invented year/date", "pattern": "\\b(18|19|20)\\d{2}\\b" },
                    { "label": "invented price", "pattern": "\\$\\s?\\d" }
                ],
                "expectedLanguage": "es"
            },
            "notes": "Spanish draft, informal voseo tone, HTML content covering the three points only. No statistics, years or prices from outside knowledge."
        },
