{
    "feature": "text_improve",
    "cases": [
        {
            "id": "text_improve-description-rough",
            "call": "text_improve",
            "input": {
                "fieldType": "description",
                "locale": "es",
                "fieldValue": "cabaña linda p/ 4 personas tiene pileta y parrilla, cerca del rio a 300m, wifi. ideal para descansar"
            },
            "checks": {
                "mustInclude": [
                    { "label": "pool", "pattern": "pileta|piscina" },
                    { "label": "grill", "pattern": "parrilla" },
                    { "label": "300 m", "pattern": "300" },
                    { "label": "4 people", "pattern": "\\b4\\b|cuatro" }
                ],
                "mustNotClaim": [
                    {
                        "label": "invented amenity",
                        "pattern": "desayuno|spa|jacuzzi|aire acondicionado|gimnasio|sauna"
                    },
                    { "label": "invented price", "pattern": "\\$\\s?\\d" }
                ],
                "expectedLanguage": "es",
                "minChars": 120,
                "maxChars": 1500,
                "noPreamble": true
            },
            "notes": "Substantial, persuasive rewrite in Spanish keeping exactly: cabin for 4, pool, grill, 300 m from the river, wifi. No new amenities or prices, no preamble."
        },
        {
            "id": "text_improve-summary-short",
            "call": "text_improve",
            "input": {
                "fieldType": "summary",
