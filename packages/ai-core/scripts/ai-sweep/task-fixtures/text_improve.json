        {
            "id": "text_improve-faq-answer-factual",
            "call": "text_improve",
            "input": {
                "fieldType": "faq_answer",
                "locale": "es",
                "fieldValue": "si se aceptan mascotas chicas, consultar antes"
            },
            "checks": {
                "mustInclude": [
                    { "label": "pets", "pattern": "mascota" },
                    { "label": "small", "pattern": "peque[nñ]|chic" },
                    { "label": "ask first", "pattern": "consult|avis|escrib|antes" }
                ],
                "mustNotClaim": [
                    {
                        "label": "marketing copy",
                        "pattern": "inolvidable|para[ií]so|experiencia [uú]nica|ideal para toda la familia|no te lo pierdas"
                    },
                    { "label": "invented fee", "pattern": "\\$|cargo|tarifa" }
                ],
                "expectedLanguage": "es",
                "maxChars": 500,
                "noPreamble": true
            },
            "notes": "FAQ answer: clear and complete, NOT sales copy. Small pets accepted, ask beforehand. No fee invented."
        },
        {
            "id": "text_improve-strip-metadata-prefix",
            "call": "text_improve",
            "input": {
                "fieldType": "description",
                "locale": "es",
                "fieldValue": "Publicado el 12/03/2024 · Casa entera: casa de campo. Casa amplia con jardín grande, tres dormitorios y galería con parrilla, a 5 km del pueblo."
            },
            "checks": {
                "mustInclude": [
                    { "label": "3 bedrooms", "pattern": "\\b3\\b|tres" },
                    { "label": "5 km", "pattern": "\\b5\\b|cinco" },
                    { "label": "grill", "pattern": "parrilla" }
                ],
                "mustNotClaim": [
                    {
                        "label": "metadata prefix kept",
                        "pattern": "publicado|12/03/2024|casa entera:"
                    },
                    {
                        "label": "invented amenity",
                        "pattern": "pileta|piscina|wifi|aire acondicionado"
                    }
                ],
                "expectedLanguage": "es",
                "noPreamble": true
            },
            "notes": "Removes the auto-generated prefix (date, 'Casa entera: casa de campo') and rewrites the rest faithfully."
        },
