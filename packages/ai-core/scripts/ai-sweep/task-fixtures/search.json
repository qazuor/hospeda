{
    "feature": "search",
    "cases": [
        {
            "id": "search-intent-cabin-4-colon-pool",
            "call": "search_intent",
            "input": {
                "locale": "es",
                "message": "Busco una cabaña para 4 personas en Colón con pileta"
            },
            "checks": {
                "expect": [
                    { "path": "entities.accommodationType", "op": "equals", "value": "CABIN" },
                    { "path": "entities.minGuests", "op": "equals", "value": 4 },
                    {
                        "path": "entities.maxGuests",
                        "op": "absent",
                        "label": "no maxGuests for 'para 4' (minimum only)"
                    },
                    { "path": "entities.city", "op": "matches", "value": "col[oó]n" },
                    {
                        "anyOf": [
                            { "path": "entities.hasPool", "op": "equals", "value": true },
                            { "path": "entities.amenitySlugs", "op": "contains", "value": "pool" }
                        ],
                        "label": "pool requested"
                    }
                ],
                "allowedFields": [
                    "confidence",
                    "isNewSearch",
                    "entities.accommodationType",
                    "entities.minGuests",
                    "entities.city",
                    "entities.locationType",
                    "entities.hasPool",
                    "entities.amenitySlugs"
                ]
            },
            "notes": "Single-turn extraction: CABIN, minGuests 4 (no max), city Colón, pool as hasPool or amenity slug. Nothing else."
        },
        {
            "id": "search-intent-apartment-price-dates",
            "call": "search_intent",
            "input": {
                "locale": "es",
                "message": "Departamento en Concepción del Uruguay del 10 al 14 de enero de 2027, hasta 80 mil por noche, con wifi y cochera"
            },
            "checks": {
                "expect": [
                    { "path": "entities.accommodationType", "op": "equals", "value": "APARTMENT" },
                    { "path": "entities.maxPrice", "op": "equals", "value": 80000 },
                    { "path": "entities.minPrice", "op": "absent" },
                    { "path": "entities.checkIn", "op": "equals", "value": "2027-01-10" },
                    { "path": "entities.checkOut", "op": "equals", "value": "2027-01-14" },
                    {
                        "anyOf": [
                            { "path": "entities.hasWifi", "op": "equals", "value": true },
                            { "path": "entities.amenitySlugs", "op": "contains", "value": "wifi" }
                        ],
                        "label": "wifi requested"
                    },
                    {
                        "anyOf": [
                            { "path": "entities.hasParking", "op": "equals", "value": true },
                            {
                                "path": "entities.amenitySlugs",
                                "op": "contains",
                                "value": "parking"
                            }
                        ],
                        "label": "parking requested"
                    }
                ],
                "allowedFields": [
                    "confidence",
                    "isNewSearch",
                    "entities.accommodationType",
                    "entities.maxPrice",
                    "entities.currency",
                    "entities.checkIn",
                    "entities.checkOut",
                    "entities.city",
                    "entities.locationType",
                    "entities.hasWifi",
                    "entities.hasParking",
                    "entities.amenitySlugs"
                ]
            },
            "notes": "APARTMENT, maxPrice 80000 (no minPrice), ISO dates 2027-01-10 / 2027-01-14, wifi and parking, city Concepción del Uruguay."
        },
        {
            "id": "search-intent-english-pets-house",
            "call": "search_intent",
            "input": {
                "locale": "en",
                "message": "Pet-friendly house for 6 people in Gualeguaychú"
            },
            "checks": {
                "expect": [
                    { "path": "entities.accommodationType", "op": "equals", "value": "HOUSE" },
                    { "path": "entities.minGuests", "op": "equals", "value": 6 },
                    { "path": "entities.maxGuests", "op": "absent" },
                    { "path": "entities.allowsPets", "op": "equals", "value": true },
                    { "path": "entities.city", "op": "matches", "value": "gualeguaych" }
                ],
                "allowedFields": [
                    "confidence",
                    "isNewSearch",
                    "entities.accommodationType",
                    "entities.minGuests",
                    "entities.allowsPets",
                    "entities.city",
                    "entities.locationType"
                ]
            },
            "notes": "English query: HOUSE, minGuests 6, allowsPets true, city Gualeguaychú. Field names stay English."
        },
        {
            "id": "search-intent-portuguese-hotel",
            "call": "search_intent",
            "input": {
