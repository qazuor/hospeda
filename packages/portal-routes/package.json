{
    "name": "@repo/portal-routes",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "license": "MIT",
    "description": "Map of the owner portal's web pages and the builder that turns a destination into a URL. Shared by apps/api (MCP tools) and the help center. HOS-2410 PR-2.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "build:ts": "tsup",
        "dev": "echo 'Dev mode uses tsconfig paths (no build)'",
        "typecheck": "tsc --noEmit --project ./tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check": "biome check --write .",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@repo/schemas": "workspace:*"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "tsup": "^8.5.1",
        "typescript": "6.0.3",
        "vitest": "^5.1.0"
    }
}
