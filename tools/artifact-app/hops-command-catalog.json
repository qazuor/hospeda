                            "label": "1 · Inicio",
                            "detail": "hops issue-preflight HOS-NNN y luego start-issue en dry-run."
                        },
                        {
                            "label": "2 · Contexto",
                            "detail": "hops context HOS-NNN --json; el agente resume sólo lo necesario."
                        },
                        {
                            "label": "3 · Verificación",
                            "detail": "hops verify --changed; --json para agentes; --full queda reservado para casos justificados."
                        },
                        {
                            "label": "4 · CI",
                            "detail": "hops ci y hops merge informan el gate; no hacen merge ni mutan GitHub."
                        },
                        {
                            "label": "5 · Cierre",
                            "detail": "hops close-issue --plan; el cierre mutante sigue pendiente."
                        },
                        {
                            "label": "6 · Handoff",
                            "detail": "hops handoff --plan --json y hops-handoff agregan hallazgos y próximo paso."
                        }
                    ]
