{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
    "config": {
        "default": true,
        "MD001": false,
        "MD007": {
            "indent": 2,
            "start_indented": false
        },
        "MD012": {
            "maximum": 1
        },
        "MD013": false,
        "MD022": true,
        "MD024": {
            "siblings_only": true
        },
        "MD025": {
            "front_matter_title": ""
        },
        "MD026": {
            "punctuation": ".,;:!"
        },
        "MD029": false,
        "MD031": true,
        "MD032": true,
        "MD033": false,
        "MD036": true,
        "MD040": false,
        "MD041": false,
        "MD051": true,
        "MD058": true,
        "MD060": false
    },
    // The HOS-1352 program design corpus is reviewed as a whole and kept verbatim
    // (the PDR is immutable). CI does not lint .specs. Owner decision 2026-10-06.
    "ignores": [
        "node_modules/**",
        "**/node_modules/**",
        "dist/**",
        "build/**",
        ".claude/**",
        ".specs/HOS-1352-*/**",
        ".specs/HOS-1353-*/**",
        ".specs/HOS-1354-*/**"
    ]
}
