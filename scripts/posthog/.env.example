# PostHog operator-only setup variables.
# DO NOT expose these in browser bundles.

# PostHog app host.
# US Cloud: https://us.posthog.com
# EU Cloud: https://eu.posthog.com
POSTHOG_HOST=https://us.posthog.com

# Numeric PostHog project ID.
# Obtain from: PostHog -> Project settings -> Project ID
POSTHOG_PROJECT_ID=

# Personal API key with scopes:
# - dashboard:read
# - dashboard:write
# - insight:read
# - insight:write
# - cohort:read
# - cohort:write
# - annotation:read
# - annotation:write
POSTHOG_PERSONAL_API_KEY=

# Optional release annotation support.
# If set, `pnpm posthog:setup` creates a global annotation for the deploy.
POSTHOG_RELEASE=
POSTHOG_DEPLOY_SHA=
# Optional explicit text/date override.
POSTHOG_ANNOTATION_CONTENT=
POSTHOG_ANNOTATION_DATE=

# Optional local planning mode. When true, the script prints and simulates
# creation without calling the real PostHog API.
POSTHOG_DRY_RUN=false
