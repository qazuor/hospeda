{
    "name": "@hospeda/client-tools",
    "version": "1.0.0",
    "private": true,
    "description": "Developer CLI for the Hospeda monorepo \u2014 repo statistics, worktree cleanup and issue bootstrap behind a single `hops` command.",
    "type": "module",
    "bin": {
        "hops": "./bin/hops",
        "hops-stats": "./bin/hops-stats",
        "hops-wt-clean": "./bin/hops-wt-clean",
        "hops-start-issue": "./bin/hops-start-issue",
        "hops-artifact": "./bin/hops-artifact",
        "hops-handoff": "./bin/hops-handoff",
        "hops-smoke-plan": "./bin/hops-smoke-plan",
        "hops-context": "./bin/hops-context",
        "hops-issue-preflight": "./bin/hops-issue-preflight",
        "hops-recap": "./bin/hops-recap",
        "hops-close-issue": "./bin/hops-close-issue",
        "hops-ci": "./bin/hops-ci",
        "hops-db-fresh": "./bin/hops-db-fresh",
        "hops-db-migrate": "./bin/hops-db-migrate",
        "hops-db-seed": "./bin/hops-db-seed",
        "hops-db-start": "./bin/hops-db-start",
        "hops-db-stop": "./bin/hops-db-stop",
        "hops-db-studio": "./bin/hops-db-studio",
        "hops-db-update-template": "./bin/hops-db-update-template",
        "hops-engram": "./bin/hops-engram",
        "hops-env": "./bin/hops-env",
        "hops-gentle-sdd-status": "./bin/hops-gentle-sdd-status",
        "hops-gentle-status": "./bin/hops-gentle-status",
        "hops-merge": "./bin/hops-merge",
        "hops-run": "./bin/hops-run",
        "hops-servers-down": "./bin/hops-servers-down",
        "hops-servers-up": "./bin/hops-servers-up",
        "hops-test": "./bin/hops-test",
        "hops-update": "./bin/hops-update",
        "hops-whats-new": "./bin/hops-whats-new",
        "hops-verify": "./bin/hops-verify"
    },
    "scripts": {
        "dev": "bun run src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@types/bun": "^1.1.14",
        "@types/node": "^22.10.0",
        "typescript": "^5.7.2"
    },
    "engines": {
        "bun": ">=1.1.0"
    }
}
